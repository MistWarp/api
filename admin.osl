def loadAdmins() array (
    auto result = readFile(adminsFile)
    if !result.ok (
        return []
    )
    object data = result.data.assert(object)
    return data.admins.assert(array)
)

def saveAdmins(array admins) boolean (
    adminsCache.delete("admins")
    return writeFile(adminsFile, {admins: admins})
)

def cachedAdmins() array (
    if adminsCache.has("admins") (
        return adminsCache.get("admins").assert(array)
    )
    array admins = loadAdmins()
    adminsCache.set("admins", admins)
    return admins
)

def loadBans() object (
    auto result = readFile(bansFile)
    if !result.ok (
        return {bans: {}}
    )
    return result.data.assert(object)
)

def saveBans(object data) boolean (
    bansCache.delete("bans")
    sharedProjectsCache.delete("projects")
    return writeFile(bansFile, data)
)

def cachedBans() object (
    if bansCache.has("bans") (
        return bansCache.get("bans").assert(object)
    )
    object data = loadBans()
    bansCache.set("bans", data)
    return data
)

def isBannedUser(string username) boolean (
    string key = normalizeUsername(username)
    if key == "" (
        return false
    )
    object data = cachedBans()
    object bans = data.bans
    return bans.contains(key)
)

def banReasonFor(string username) string (
    string key = normalizeUsername(username)
    if key == "" (
        return ""
    )
    object data = cachedBans()
    object bans = data.bans
    if !bans.contains(key) (
        return ""
    )
    object entry = bans[key]
    if entry.contains("reason") and entry.reason != null (
        return entry.reason.toStr()
    )
    return ""
)

def banUser(string username, string reason, string actor) boolean (
    string key = normalizeUsername(username)
    if !isSafePathPart(key) (
        return false
    )
    object data = loadBans()
    object bans = data.bans
    bans[key] = {reason: reason, by: actor, created: timestamp}
    return saveBans(data)
)

def unbanUser(string username) boolean (
    string key = normalizeUsername(username)
    object data = loadBans()
    object bans = data.bans
    if !bans.contains(key) (
        return false
    )
    bans.delete(key)
    return saveBans(data)
)

def isSuperAdmin(string username) boolean (
    return adminUsers.contains(normalizeUsername(username))
)

def handleListAdmins(*serve.Context c) (
    array stored = loadAdmins()
    array all = []
    for i adminUsers.len (
        all.append({username: adminUsers[i], super: true})
    )
    for i stored.len (
        string name = stored[i].toStr()
        if !adminUsers.contains(normalizeUsername(name)) (
            all.append({username: name, super: false})
        )
    )
    c.json(200, {ok: true, admins: all})
)

def handleAddAdmin(*serve.Context c) (
    if !isSuperAdmin(c.getString("username")) (
        c.forbidden("only super admins can manage admins")
        return
    )
    object body = c.bodyJSON()
    string name = normalizeUsername(body.username.toStr())
    if !isSafePathPart(name) (
        c.badRequest("invalid username")
        return
    )
    array admins = loadAdmins()
    if admins.contains(name) (
        c.json(200, {ok: true})
        return
    )
    admins.append(name)
    saveAdmins(admins)
    c.json(200, {ok: true})
)

def handleRemoveAdmin(*serve.Context c) (
    if !isSuperAdmin(c.getString("username")) (
        c.forbidden("only super admins can manage admins")
        return
    )
    object body = c.bodyJSON()
    string name = normalizeUsername(body.username.toStr())
    array admins = loadAdmins()
    if !admins.contains(name) (
        c.notFound("not an admin")
        return
    )
    saveAdmins(removeString(admins, name))
    c.json(200, {ok: true})
)

def handleBanUser(*serve.Context c) (
    object body = c.bodyJSON()
    string name = body.username.toStr()
    string reason = ""
    if body.contains("reason") and body.reason != null (
        reason = body.reason.toStr().strip()
    )
    if normalizeUsername(name) == "" (
        c.badRequest("username is required")
        return
    )
    if isAdminUser(name) (
        c.badRequest("cannot ban an admin")
        return
    )
    if !banUser(name, reason, c.getString("username")) (
        c.badRequest("could not ban that user")
        return
    )
    c.json(200, {ok: true})
)

def handleUnbanUser(*serve.Context c) (
    object body = c.bodyJSON()
    if !unbanUser(body.username.toStr()) (
        c.notFound("that user is not banned")
        return
    )
    c.json(200, {ok: true})
)

def handleListBans(*serve.Context c) (
    object data = loadBans()
    object bans = data.bans
    array keys = bans.getKeys().toArray()
    array out = []
    for i keys.len (
        string key = keys[i].toStr()
        object ban = bans[key]
        out.append({username: key, reason: ban.reason, by: ban.by, created: ban.created})
    )
    c.json(200, {ok: true, bans: out})
)

def handleListUsers(*serve.Context c) (
    array userFiles = fs.readDir(usersDir).toArray()
    array projects = projectSearchDocs.all()
    object ownerCounts = {}
    for i projects.len (
        object entry = projects[i].assert(object)
        string owner = normalizeUsername(entry.owner.toStr())
        number prev = 0
        if ownerCounts.contains(owner) (
            prev = ownerCounts[owner].toNum()
        )
        ownerCounts[owner] = prev + 1
    )
    array out = []
    for i userFiles.len (
        string f = userFiles[i].toStr()
        if f.endsWith(".json") (
            string key = f.replace(".json", "")
            object profile = loadProfile(key)
            object quota = quotaDetails(key)
            number projectCount = 0
            if ownerCounts.contains(key) (
                projectCount = ownerCounts[key].toNum()
            )
            out.append({
                username: profile.username,
                created: profile.created,
                followerCount: profile.followers.assert(array).len,
                projectCount: projectCount,
                quotaUsed: quota.used,
                quotaLimit: quota.limit,
                quotaOldestEventMs: quota.oldestEventMs,
                quotaEventCount: quota.eventCount,
                banned: isBannedUser(key)
            })
        )
    )
    out.sortBy("quotaUsed", "descending")
    c.json(200, {ok: true, users: out})
)

def handleAdminStats(*serve.Context c) (
    array projects = projectSearchDocs.all()
    number totalProjects = projects.len
    number sharedProjects = 0
    number totalBytes = 0
    number totalViews = 0
    number totalLoves = 0
    object projectsByDay = {}
    for i projects.len (
        object entry = projects[i].assert(object)
        if entry.shared == true (
            sharedProjects = sharedProjects + 1
        )
        if entry.contains("sizeBytes") and entry.sizeBytes != null (
            totalBytes = totalBytes + entry.sizeBytes.toNum()
        )
        if entry.contains("views") and entry.views != null (
            totalViews = totalViews + entry.views.toNum()
        )
        if entry.contains("loveCount") and entry.loveCount != null (
            totalLoves = totalLoves + entry.loveCount.toNum()
        )
        string dk = (entry.created.toNum() / 86400000).toInt().toStr()
        number prev = 0
        if projectsByDay.contains(dk) (
            prev = projectsByDay[dk].toNum()
        )
        projectsByDay[dk] = prev + 1
    )
    array userFiles = fs.readDir(usersDir).toArray()
    number totalUsers = 0
    for i userFiles.len (
        if userFiles[i].toStr().endsWith(".json") (
            totalUsers = totalUsers + 1
        )
    )
    array sessionFiles = fs.readDir(sessionsDir).toArray()
    object loginsByDay = {}
    number activeSessions = 0
    for i sessionFiles.len (
        string sf = sessionFiles[i].toStr()
        if sf.endsWith(".json") (
            auto res = readFile(sessionsDir ++ sf)
            if res.ok (
                object s = res.data.assert(object)
                activeSessions = activeSessions + 1
                string dk = (s.createdAt.toNum() / 86400000).toInt().toStr()
                number prev = 0
                if loginsByDay.contains(dk) (
                    prev = loginsByDay[dk].toNum()
                )
                loginsByDay[dk] = prev + 1
            )
        )
    )
    array reports = loadReports()
    number openReports = 0
    for i reports.len (
        object r = reports[i]
        boolean isResolved = r.contains("resolved") and r.resolved == true
        if !isResolved (
            openReports = openReports + 1
        )
    )
    object banData = loadBans()
    object bans = banData.bans
    number bannedUsers = bans.getKeys().toArray().len
    array news = loadNews()
    object payoutStore = loadPendingPayouts()
    array pendingPayouts = payoutStore.payouts.assert(array)
    number pendingPayoutAmount = 0
    for i pendingPayouts.len (
        pendingPayoutAmount = pendingPayoutAmount + pendingPayouts[i].amount.toNum()
    )
    c.json(200, {
        ok: true,
        totalProjects: totalProjects,
        sharedProjects: sharedProjects,
        unsharedProjects: totalProjects - sharedProjects,
        totalUsers: totalUsers,
        totalBytes: totalBytes,
        totalViews: totalViews,
        totalLoves: totalLoves,
        activeSessions: activeSessions,
        openReports: openReports,
        bannedUsers: bannedUsers,
        newsPosts: news.len,
        pendingPayouts: pendingPayouts.len,
        pendingPayoutAmount: pendingPayoutAmount,
        projectsByDay: projectsByDay,
        loginsByDay: loginsByDay
    })
)

def handleAdminSearchProjects(*serve.Context c) (
    string q = c.query("q").toLower().strip()
    array projects = projectSearchDocs.all()
    array matches = []
    for i projects.len (
        object entry = projects[i].assert(object)
        string hay = (entry.title.toStr() ++ " " ++ entry.owner.toStr() ++ " " ++ entry.id.toStr()).toLower()
        if q == "" or hay.contains(q) (
            matches.append(entry)
        )
    )
    matches.sortBy("edited", "descending")
    if matches.len > 60 (
        matches = matches.trim(1, 60)
    )
    c.json(200, {ok: true, projects: matches})
)

def reportTargetUser(object found) string (
    string name = found.target.toStr()
    if found.type.toStr() == "project" (
        auto result = loadProject(found.target.toStr())
        if result.ok (
            object project = result.project.assert(object)
            name = project.owner.toStr()
        )
    )
    return name
)

def handleReportAction(*serve.Context c) (
    object body = c.bodyJSON()
    string id = body.id.toStr()
    string action = body.action.toStr()
    boolean validAction = action == "dismiss" or action == "unshare_project" or action == "ban_user" or action == "warn_user"
    if !validAction (
        c.badRequest("invalid action")
        return
    )

    array reports = loadReports()
    object found = {}
    boolean hasReport = false
    for i reports.len (
        object report = reports[i]
        if report.id.toStr() == id (
            found = report
            hasReport = true
        )
    )
    if !hasReport (
        c.notFound("report not found")
        return
    )

    if action == "unshare_project" (
        auto result = loadProject(found.target.toStr())
        if !result.ok (
            c.notFound("project not found")
            return
        )
        object project = result.project.assert(object)
        project.shared = false
        project.visibility = "private"
        project.viewKey = randomString(16)
        project.edited = timestamp
        saveProject(project)
        upsertIndexEntry(project)
        object ownerProfile = loadProfile(project.owner.toStr())
        if ownerProfile.featuredProject.toStr() == project.id.toStr() (
            ownerProfile.featuredProject = ""
            saveProfile(ownerProfile)
        )
    )
    if action == "ban_user" (
        string name = reportTargetUser(found)
        if isAdminUser(name) (
            c.badRequest("cannot ban an admin")
            return
        )
        banUser(name, "report " ++ id, c.getString("username"))
    )
    if action == "warn_user" (
        string name = reportTargetUser(found)
        if isAdminUser(name) (
            c.badRequest("cannot warn an admin")
            return
        )
        string reason = ""
        if body.contains("reason") and body.reason != null (
            reason = body.reason.toStr().strip()
        )
        if reason == "" (
            reason = "report " ++ id
        )
        setStanding(name, "warning", reason, c.getString("username"))
        if found.type.toStr() == "project" (
            auto pr = loadProject(found.target.toStr())
            if pr.ok (
                object removedProject = pr.project.assert(object)
                purgeProject(removedProject)
                deleteProjectCommunityRecords(found.target.toStr())
                removeProjectFromSpaces(found.target.toStr())
                object ownerProfile = loadProfile(removedProject.owner.toStr())
                if ownerProfile.featuredProject.toStr() == removedProject.id.toStr() (
                    ownerProfile.featuredProject = ""
                    saveProfile(ownerProfile)
                )
            )
        )
    )

    found.resolved = true
    found.resolvedBy = c.getString("username")
    found.action = action
    found.resolvedAt = timestamp
    saveReports(reports)
    if found.type.toStr() == "project" (
        maybeClearProjectEvidence(found.target.toStr())
    )
    addNotification(found.reporter.toStr(), c.getString("username"), "report_update", {action: action, reportType: found.type})
    c.json(200, {ok: true})
)
