import "std:testing"
import "std:crypto"
import "std:regex"
import "std:fs"
import "std:json"
import "go:mistwarp.local/storagefs"
import "../core/utils.osl"
import "./project-refusal.osl"
import "./project-update-policy.osl"

object free = {customProjectBranding: false, vanityProjectUrls: false}
object pro = {customProjectBranding: true, vanityProjectUrls: true}

object project = {id: "p1", title: "Old"}
testing.assert(!isRefused(applyBranding(project, {}, free)) and !project.contains("branding"), "branding is left alone when not sent")
testing.assert(applyBranding(project, {branding: {accentColor: "red"}}, pro).message == "branding accent must be a six-digit hex colour", "accents must be hex colours")
testing.assert(applyBranding(project, {branding: {tagline: "t" * 121}}, pro).message == "branding tagline is too long", "taglines are capped")
testing.assert(applyBranding(project, {branding: {accentColor: "#123456"}}, free).status == 403, "custom branding needs a plan")
testing.assert(!isRefused(applyBranding(project, {branding: {}}, free)) and project.branding.len == 0, "anyone can clear branding")
testing.assert(!isRefused(applyBranding(project, {branding: {accentColor: " #ABCDEF ", tagline: " Hi "}}, pro)) and project.branding.accentColor == "#ABCDEF" and project.branding.tagline == "Hi", "plans can set trimmed branding")
testing.assert(!isRefused(applyBranding(project, {branding: {accentColor: "#ABCDEF", tagline: "Hi"}}, free)), "keeping existing branding needs no plan")

testing.assert(vanitySlugRefusal("game", "", free).status == 403, "vanity URLs need Pro")
testing.assert(!isRefused(vanitySlugRefusal("game", "game", free)), "a lapsed plan can keep its slug")
testing.assert(!isRefused(vanitySlugRefusal("", "game", free)), "anyone can clear a slug")
testing.assert(vanitySlugRefusal("ab", "", pro).status == 400 and isRefused(vanitySlugRefusal("-ab", "", pro)) and isRefused(vanitySlugRefusal("a" * 41, "", pro)), "slugs are 3 to 40 safe characters")
testing.assert(!isRefused(vanitySlugRefusal("my-game", "", pro)), "valid slugs are accepted")

object text = {id: "p1", title: "Old"}
testing.assert(applyProjectText(text, {title: "   "}).message == "invalid title", "titles cannot be blank")
testing.assert(isRefused(applyProjectText(text, {title: "t" * 101})), "titles are capped")
testing.assert(!isRefused(applyProjectText(text, {title: " New ", description: "d", instructions: "i", notes: "n"})) and text.title == "New" and text.notes == "n", "text fields are saved")
testing.assert(applyProjectText(text, {description: "d" * 5001}).message == "description too long" and text.description == "d", "long descriptions are refused")
testing.assert(applyProjectText(text, {title: "Kept", notes: "n" * 5001}).message == "notes too long" and text.title == "Kept", "fields before a refused one are already applied")

object credited = {id: "p1"}
testing.assert(!isRefused(applyCredits(credited, {credits: [{who: " Ada ", role: "Art", url: "https://a.example"}, {who: "", role: "x"}, {who: "Bo", role: "Music", url: null}]})), "credits are accepted")
testing.assert(credited.credits.len == 2 and credited.credits[1].url == "https://a.example" and !credited.credits[2].assert(object).contains("url"), "blank credits are dropped and empty URLs omitted")
testing.assert(applyCredits(credited, {credits: [{who: "A", role: "B", url: "ftp://x"}]}).message == "credit URL must use http or https", "credit URLs must be web links")
testing.assert(applyCredits(credited, {credits: [{who: "A", role: "B", url: "https://" ++ ("u" * 500)}]}).message == "credit URL too long", "credit URLs are capped")
array manyCredits = []
for i 51 (
  manyCredits.append({who: "A", role: "B"})
)
testing.assert(applyCredits(credited, {credits: manyCredits}).message == "too many credits", "credits are capped at 50")
testing.assert(applyCredits(credited, {credits: "x"}).message == "credits must be a list" and applyCredits(credited, {credits: null}).status == 400, "credits must be a list")
testing.assert(applyCredits(credited, {credits: ["Ada"]}).message == "each credit must be an object", "each credit must be an object")
testing.assert(credited.credits.len == 2, "refused credits leave the saved credits alone")

object flagged = {id: "p1"}
applyProjectFlags(flagged, {commentsOff: "yes", remixable: 0, seeInside: false})
testing.assert(flagged.commentsOff == false and flagged.remixable == true and flagged.seeInside == false, "flags only switch on an exact boolean")
testing.assert(projectSaleRefusal({price: 5}).body.code == "project_sales_ended" and !isRefused(projectSaleRefusal({price: 0})) and !isRefused(projectSaleRefusal({})), "only a non-zero price is refused")
testing.assert(applyRemixShare(flagged, 51).status == 400 and isRefused(applyRemixShare(flagged, -1)), "remix shares are 0 to 50")
testing.assert(!isRefused(applyRemixShare(flagged, 50)) and flagged.remixShare == 50, "remix shares are saved")

object tagged = {id: "p1"}
applyTags(tagged, {tags: ["Games", "games", "#Puzzle", "bad tag!", "a", "b", "c", "d", "e", "f", "g", "h", "i"]})
testing.assert(tagged.tags == ["games", "puzzle", "a", "b", "c", "d", "e", "f", "g", "h"], "tags are normalized, unique and capped at 10")
testing.assert(applyTags(tagged, {tags: "games"}).message == "tags must be a list" and tagged.tags.len == 10, "tags must be a list")

object product = {id: "Pack", name: "Pack", description: "d", price: 10, grantsItem: "sword", icon: "https://i.example/i.png"}
object shop = {id: "p1"}
def productWith(object base, string id, string name, number price, string icon, string grantsItem) object (
  object copy = base.clone()
  copy.id = id
  copy.name = name
  copy.price = price
  copy.icon = icon
  copy.grantsItem = grantsItem
  return copy
)
testing.assert(!isRefused(applyGameProducts(shop, {gameProducts: [product]})) and shop.gameProducts[1].id == "pack", "product ids are lowercased")
testing.assert(applyGameProducts(shop, {gameProducts: [product, product]}).message == "game product ids must be unique lowercase identifiers", "product ids are unique")
testing.assert(applyGameProducts(shop, {gameProducts: [productWith(product, "x", "", 1, "", "")]}).message == "invalid game product name or description", "products need a name")
testing.assert(applyGameProducts(shop, {gameProducts: [productWith(product, "x", "X", 1001, "", "")]}).message == "game product prices must be between 0 and 1000 credits", "product prices are capped")
testing.assert(applyGameProducts(shop, {gameProducts: [productWith(product, "x", "X", 1, "ftp://i", "")]}).message == "game product icons must be image data URLs or image URLs", "product icons are images")
testing.assert(applyGameProducts(shop, {gameProducts: [productWith(product, "x", "X", 1, "data:image/png," ++ ("a" * 100000), "")]}).message == "game product icons must be smaller than 100KB", "product icons are capped in bytes")
testing.assert(applyGameProducts(shop, {gameProducts: [productWith(product, "x", "X", 1, "", "Bad!")]}).message == "invalid portable item id on game product", "granted item ids are checked")

testing.assert(portableItemVisual({type: "image", url: "https://i.example/a.png"}).visual.url == "https://i.example/a.png", "HTTPS images are kept")
testing.assert(portableItemVisual({type: "image", url: "http://i.example/a.png"}).error == "portable item images must use a short HTTPS URL", "plain HTTP images are refused")
testing.assert(portableItemVisual({type: "image", url: "data:image/png," ++ ("a" * 100000)}).error == "portable item images must be smaller than 100KB", "data images are capped")
testing.assert(portableItemVisual({type: "Costume", assetId: "abcdefgh", dataFormat: "SVG"}).visual.dataFormat == "svg", "costumes are normalized")
testing.assert(portableItemVisual({type: "costume", assetId: "short", dataFormat: "png"}).error == "invalid portable item costume asset", "costume ids are checked")
testing.assert(portableItemVisual({}).error == "portable items need an image or costume", "items need a visual")

object items = {id: "p1"}
testing.assert(!isRefused(applyGameItems(items, {gameItems: [{id: "Sword", name: "Sword", image: "https://i.example/s.png"}, {id: "hat", name: "Hat", visual: {type: "costume", assetId: "abcdefgh", dataFormat: "png"}, gameAwardable: false}]})), "items are accepted")
testing.assert(items.gameItems[1].id == "sword" and items.gameItems[1].visual.type == "image" and items.gameItems[1].gameAwardable == true and items.gameItems[2].gameAwardable == false, "item images fall back and awardability defaults on")
testing.assert(applyGameItems(items, {gameItems: [{id: "a", name: "A", image: "https://i"}, {id: "A", name: "A", image: "https://i"}]}).message == "portable item ids must be unique lowercase identifiers", "item ids are unique")
testing.assert(applyGameItems(items, {gameItems: [{id: "a", name: "", image: ""}]}).message == "invalid portable item definition", "items need a name")
testing.assert(applyGameItems(items, {gameItems: [{id: "a", name: "A", image: ""}]}).message == "portable items need an image or costume", "item visual errors reach the caller")

object granted = {id: "p1", gameProducts: [{id: "pack", grantsItem: "sword"}], gameItems: [{id: "sword"}]}
testing.assert(!isRefused(gameGrantRefusal(granted, {gameItems: []})), "products may grant defined items")
testing.assert(!isRefused(gameGrantRefusal({id: "p1", gameProducts: [{grantsItem: "ghost"}]}, {title: "x"})), "the grant check only runs when products or items change")
testing.assert(gameGrantRefusal({id: "p1", gameProducts: [{grantsItem: "ghost"}], gameItems: []}, {gameProducts: []}).message == "a game product refers to an undefined portable item", "products cannot grant undefined items")

object inventory = {id: "p1"}
testing.assert(applyInventoryPolicy(inventory, {inventoryPolicy: {mode: "some"}}).message == "inventory policy must be none, allowlist, or all", "inventory modes are fixed")
testing.assert(applyInventoryPolicy(inventory, {inventoryPolicy: {mode: "all", allowedProjects: ["../x"]}}).message == "invalid portable item source project", "source projects must be safe ids")
testing.assert(applyInventoryPolicy(inventory, {inventoryPolicy: {mode: "all", allowedItems: ["nope"]}}).message == "invalid global portable item id", "allowed items are global ids")
testing.assert(!isRefused(applyInventoryPolicy(inventory, {inventoryPolicy: {mode: " Allowlist ", allowedItems: ["p1:sword", "p1:sword"], allowedProjects: ["p1", "p1"]}})), "a valid allowlist is accepted")
testing.assert(inventory.inventoryPolicy.mode == "allowlist" and inventory.inventoryPolicy.allowedItems == ["p1:sword"] and inventory.inventoryPolicy.allowedProjects == ["p1"], "allowlists are deduplicated")

object compatible = {id: "p1"}
applyCompatibility(compatible, {compatibility: null})
testing.assert(!compatible.contains("compatibility"), "null compatibility is ignored")
applyCompatibility(compatible, {compatibility: {mobile: true, controller: "yes"}})
testing.assert(compatible.compatibility.mobile == true and compatible.compatibility.keyboard == false and compatible.compatibility.controller == false, "compatibility only accepts true")
testing.assert(applyCompatibility(compatible, {compatibility: "mobile"}).message == "compatibility must be an object" and compatible.compatibility.mobile == true, "compatibility must be an object")
