export {
  forkFailureResponse,
  forkProjectFor
}

def remixEntryVisibleInList(object entry,*serve.Context c) boolean (
  if projectHiddenFrom(entry, c) (
    return false
  )
  if projectsVisibleTo([entry], c).len == 0 (
    return false
  )
  if entry.shared == true and projectVisibility(entry) == "public" (
    return true
  )
  if !contextBool(c, "authenticated") (
    return false
  )
  auto res = loadProject(entry.id.toStr())
  if !res.ok (
    return false
  )
  object project = res.project.assert(object)
  return projectRole(project, contextString(c, "username")) != "" or canEditProject(project, c)
)

def handleGetRemixes(*serve.Context c) (
  string id = c.param("id")
  array entries = projectSearchDocs.where("remixParent", "==", id).sort("sharedAt", "desc").all()
  array remixes = []
  for i entries.len (
    object entry = entries[i]
    if remixEntryVisibleInList(entry, c) (
      remixes.append(entry)
    )
  )
  c.json(200, {ok: true, remixes: remixes})
)

def handleGetRemixTree(*serve.Context c) (
  string id = c.param("id")
  auto res = loadProject(id)
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canViewProject(project, c) (
    c.notFound("project not found")
    return
  )

  string rootId = id
  object current = indexEntryFromProject(project)
  array ancestors = [current]
  number hops = 0
  boolean walking = true
  while walking and hops < 100 (
    string parent = current.remixParent.toStr()
    if parent == "" or parent == rootId (
      walking = false
    ) else (
      auto parentResult = loadProject(parent)
      if parentResult.ok and canViewProject(parentResult.project.assert(object), c) (
        rootId = parent
        current = indexEntryFromProject(parentResult.project.assert(object))
        ancestors.append(current)
      ) else (
        walking = false
      )
    )
    hops += 1
  )

  array nodes = []
  object seen = {}
  object root = (projectSearchDocs.findById(rootId) ?? {})
  if root.len > 0 (
    nodes.append(root)
    seen[rootId] = true
  )
  for i ancestors.len (
    object ancestor = ancestors[i].assert(object)
    string ancestorId = ancestor.id.toStr()
    if ancestorId != "" and !seen.contains(ancestorId) (
      nodes.append(ancestor)
      seen[ancestorId] = true
    )
  )
  array treeEntries = projectSearchDocs.where("remixRoot", "==", rootId).limit(499).all()
  for i treeEntries.len (
    object entry = treeEntries[i].assert(object)
    string entryId = entry.id.toStr()
    if !seen.contains(entryId) and remixEntryVisibleInList(entry, c) (
      nodes.append(entry)
      seen[entryId] = true
    )
  )
  number scan = 1
  while scan <= nodes.len and nodes.len < 500 (
    object parentNode = nodes[scan].assert(object)
    string parentId = parentNode.id.toStr()
    array directChildren = projectSearchDocs.where("remixParent", "==", parentId).limit(500 - nodes.len).all()
    for i directChildren.len (
      object child = directChildren[i].assert(object)
      string childId = child.id.toStr()
      if !seen.contains(childId) and remixEntryVisibleInList(child, c) (
        nodes.append(child)
        seen[childId] = true
      )
    )
    scan += 1
  )
  if !seen.contains(id) and nodes.len < 500 (
    nodes.append(indexEntryFromProject(project))
  )

  c.json(200, {ok: true, root: rootId, nodes: nodes})
)

type ForkRequest (
  string id = ""
  string username = ""
  string userId = ""
  object benefits = {}
  string title = ""
  string branch = ""
  boolean enforceLimits = true
)

type PreparedFork (
  object failure = {}
  object parent = {}
  byte[] history = []
  object manifest = {}
  object hold = {}
  string holdKey = ""
)

type ForkOutcome (
  Refusal refusal = Refusal()
  object forked = {}
  string keptHoldKey = ""
)

def handleRemixProject(*serve.Context c) (
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  object body = requestJSON(c)
  string forkId = generateId()
  for attempt 3 (
    if !remixProjectOnce(c, body, benefits, forkId) (
      return
    )
  )
  c.json(409, {ok: false, code: "project_changed", error: "The project changed while it was being remixed. Try again."})
)

def remixProjectOnce(*serve.Context c, object body, object benefits, string forkId) boolean (
  UpdateLookups lookups = UpdateLookups()
  ForkOutcome outcome = ForkOutcome()
  defer (
    releaseStorageHolds(lookups, outcome.keptHoldKey)
  )
  holdRemixStorage(c, body, benefits, forkId, lookups)
  lookups.replay = true
  runLocked(projectSaveLock(c.param("id")), def() -> (
    remixProjectLocked(c, body, benefits, forkId, lookups, outcome)
  ))
  if lookups.missed (
    return true
  )
  finishRemix(c, outcome)
  return false
)

def holdRemixStorage(*serve.Context c, object body, object benefits, string forkId, UpdateLookups lookups) (
  if !usesRoturStorage(contextString(c, "userId")) (
    return
  )
  auto res = loadProject(c.param("id"))
  if !res.ok (
    return
  )
  object parent = res.project.assert(object)
  if isRefused(remixRefusal(c, parent)) (
    return
  )
  void prepareFork(parent, remixForkRequest(c, body, benefits, forkId, parent), lookups)
)

def remixProjectLocked(*serve.Context c, object body, object benefits, string forkId, UpdateLookups lookups, ForkOutcome outcome) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    outcome.refusal = refuse(404, "project not found")
    return
  )
  object parent = res.project.assert(object)
  outcome.refusal = remixRefusal(c, parent)
  if isRefused(outcome.refusal) (
    return
  )
  forkProjectWith(parent, remixForkRequest(c, body, benefits, forkId, parent), lookups, outcome)
)

def remixRefusal(*serve.Context c, object parent) Refusal (
  if !canViewProject(parent, c) (
    return refuse(404, "project not found")
  )
  if !canRemixProject(parent, c) (
    return refuse(403, "this project cannot be remixed")
  )
  return noRefusal()
)

def remixForkRequest(*serve.Context c, object body, object benefits, string forkId, object parent) ForkRequest (
  string forkTitle = parent.title.toStr() ++ " fork"
  if body.contains("title") and body.title != null and body.title.toStr().strip() != "" (
    forkTitle = body.title.toStr().strip().trim(1, 100)
  )
  string forkBranch = ""
  if body.contains("branch") and body.branch != null (
    forkBranch = body.branch.toStr().strip()
  )
  return ForkRequest{id: forkId, username: contextString(c, "username"), userId: contextString(c, "userId"), benefits: benefits, title: forkTitle, branch: forkBranch, enforceLimits: !contextBool(c, "isAdmin")}
)

def finishRemix(*serve.Context c, ForkOutcome outcome) (
  if refused(c, outcome.refusal) (
    return
  )
  if outcome.forked.ok != true (
    forkFailureResponse(c, outcome.forked)
    return
  )
  object project = outcome.forked.project.assert(object)
  c.json(201, {
    ok: true,
    id: project.id,
    projectJsonUrl: projectJsonUrlFor(project),
    assetsBase: assetsBaseUrl()
  })
)

def forkFailureResponse(*serve.Context c, object forked) (
  if forked.code == "storage_full" and forked.contains("refusal") (
    roturStorageFullResponse(c, forked.refusal.assertElse(object, {}))
    return
  )
  if forked.code == "storage_full" (
    object details = storageDetails(forked.username.toStr())
    storageFullResponse(c, details, forked.bytes.toNum() - details.remaining.toNum())
    return
  )
  c.json(forked.status.toNum().toInt(), {ok: false, code: forked.code, error: forked.error})
)

def forkProjectFor(object source, string username, string userId, object benefits, string forkTitle, string requestedBranch, boolean enforceLimits) object (
  UpdateLookups lookups = UpdateLookups()
  ForkOutcome outcome = ForkOutcome()
  defer (
    releaseStorageHolds(lookups, outcome.keptHoldKey)
  )
  ForkRequest request = ForkRequest{id: generateId(), username: username, userId: userId, benefits: benefits, title: forkTitle, branch: requestedBranch, enforceLimits: enforceLimits}
  forkProjectWith(source, request, lookups, outcome)
  return outcome.forked
)

def forkProjectWith(object source, ForkRequest request, UpdateLookups lookups, ForkOutcome outcome) (
  PreparedFork prepared = prepareFork(source, request, lookups)
  if lookups.missed or prepared.failure.len > 0 (
    outcome.forked = prepared.failure
    return
  )
  outcome.forked = createFork(prepared, request, outcome)
)

def forkRefused(number status, string code, string message) PreparedFork (
  return PreparedFork{failure: {ok: false, status: status, code: code, error: message}}
)

def forkStorageChanges(object parent, string forkId, number historyBytes) object (
  object forkSummary = projectStorageSummary(parent, loadAssetsIndex().assets.assertElse(object, {}))
  object forkHistoryBlob = {}
  forkHistoryBlob["incoming:" ++ forkId] = historyBytes
  forkSummary.history = forkHistoryBlob
  object saving = {}
  saving[forkId] = forkSummary
  return {projects: saving}
)

def prepareFork(object source, ForkRequest request, UpdateLookups lookups) PreparedFork (
  object parent = source
  number projectLimit = request.benefits.maxProjects.toNum()
  if request.enforceLimits and ownedProjectSlotCount(request.userId, request.username) >= projectLimit (
    return forkRefused(413, "project_limit", "project limit reached; delete a trashed project permanently or upgrade your plan")
  )
  string forkBranch = "main"
  if parent.contains("gitBranch") and parent.gitBranch != null and parent.gitBranch.toStr() != "" (
    forkBranch = parent.gitBranch.toStr()
  )
  if request.branch != "" (
    forkBranch = request.branch
  )
  if forkBranch.len > 100 or forkBranch.contains(" ") or forkBranch.contains("\\") or forkBranch.contains("..") or forkBranch.startsWith("/") (
    return forkRefused(400, "invalid_branch", "invalid branch name")
  )

  object jsonSnapshot = ensureProjectJsonSnapshot(parent)
  if !jsonSnapshot.ok (
    return forkRefused(500, "copy_failed", "could not copy the original project, try again")
  )
  parent = jsonSnapshot.project.assert(object)
  object workspaceSnapshots = ensureProjectWorkspaceSnapshots(parent)
  if !workspaceSnapshots.ok (
    return forkRefused(500, "history_failed", "could not prepare the original project history, try again")
  )
  parent = workspaceSnapshots.project.assert(object)

  if !projectHasWorkspace(parent) (
    return forkRefused(409, "history_unavailable", "prepare the original project's history before remixing")
  )
  string forkPath = tmpDir ++ request.id ++ ".fork.mwp"
  object archived = writeForkHistoryArchive(parent, forkBranch, request.id, forkPath)
  if archived.ok != true (
    return forkRefused(409, "history_unavailable", "requested branch history is unavailable")
  )
  object forkHistory = archived.manifest.assert(object)
  byte[] forkBody = fs.readFileBytes(forkPath).unwrapOr("".toBytes())
  void fs.remove(forkPath)
  PreparedFork prepared = PreparedFork{parent: parent, history: forkBody, manifest: forkHistory, hold: noStorageHold()}
  number forkBytes = projectSizeBytes(parent) + forkBody.len
  if usesRoturStorage(request.userId) (
    object changes = forkStorageChanges(parent, request.id, forkBody.len)
    prepared.holdKey = storageHoldKey(request.userId, changes, request.enforceLimits)
    prepared.hold = lookupStorageHold(lookups, request.userId, changes, request.enforceLimits)
    if prepared.hold.ok != true (
      prepared.failure = {ok: false, status: 413, code: "storage_full", error: "storage full", refusal: prepared.hold.refusal}
    )
  ) else if request.enforceLimits and storageAllowance(request.benefits.storageBytes.toNum(), ownerStorageBytes(request.username), 0) < forkBytes (
    prepared.failure = {ok: false, status: 413, code: "storage_full", error: "storage full", username: request.username, bytes: forkBytes}
  )
  return prepared
)

def createFork(PreparedFork prepared, ForkRequest request, ForkOutcome outcome) object (
  object parent = prepared.parent
  string id = request.id
  string parentId = parent.id.toStr()
  byte[] forkBody = prepared.history
  object forkHistory = prepared.manifest
  string forkKey = projectWorkspaceSnapshotKey(contentHash(forkBody))
  if !stageR2Blob(forkKey, forkBody, "application/x-mistwarp-project", "") (
    return {ok: false, status: 500, code: "store_failed", error: "could not store fork history"}
  )

  object project = {
    id: id,
    owner: request.username,
    ownerId: request.userId,
    title: request.title,
    description: "",
    instructions: "",
    repo: null,
    workspaceKey: forkKey,
    workspaceLayers: [forkKey],
    jsonKey: parent.jsonKey,
    viewKey: randomString(16),
    created: timestamp,
    edited: timestamp,
    sharedAt: 0,
    shared: false,
    lastUploadAt: timestamp,
    jsonGzip: true,
    inheritedJson: true,
    storedJsonBytes: parent.storedJsonBytes ?? 0,
    remixParent: parent.id,
    remixRoot: parent.id,
    remixShare: 10,
    remixNotified: false,
    scratchOrigin: "",
    views: 0,
    loves: [],
    brokenhearts: [],
    assets: parent.assets,
    sizeBytes: projectSizeBytes(parent),
    historyBytes: forkBody.len,
    gitHead: forkHistory.head,
    remixBaseCommit: forkHistory.head,
    gitBranch: forkHistory.branch,
    gitCommits: forkHistory.commits,
    gitGraph: forkHistory.graph,
    collaborators: []
  }
  object parentEntry = (projectSearchDocs.findById(parentId) ?? {})
  if parentEntry.len > 0 and parentEntry.contains("remixRoot") and parentEntry.remixRoot.toStr() != "" (
    project.remixRoot = parentEntry.remixRoot
  )
  array inheritedFields = ["jsonBytes", "assetBytes", "extensions", "extensionsIndexed"]
  for i inheritedFields.len (
    string field = inheritedFields[i].toStr()
    if parent.contains(field) (
      project[field] = parent[field]
    )
  )

  if !storeProjectExtensions(id, [], storedProjectExtensions(project), {}) (
    return {ok: false, status: 500, code: "extensions_failed", error: "could not index project extensions"}
  )
  if !saveProject(project) (
    return {ok: false, status: 500, code: "save_failed", error: "could not save fork"}
  )
  outcome.keptHoldKey = prepared.holdKey
  upsertIndexEntry(project)
  if usesRoturStorage(request.userId) (
    thread.new(storageSettle, request.userId, prepared.hold)
  )
  return {ok: true, project: project}
)
