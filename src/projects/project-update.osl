export {}

def handleUpdateProject(*serve.Context c) (
  runLocked("project-upload:" ++ c.param("id"), def() -> (
    handleUpdateProjectLocked(c)
  ))
)

def handleUpdateProjectLocked(*serve.Context c) (
  object? loaded = loadRequestedProject(c)
  if loaded == null return
  object project = loaded
  array previousTeam = project.collaborators.assertElse(array, [])
  if !canEditProject(project, c) (
    c.forbidden("not your project")
    return
  )
  object body = requestJSON(c)
  if refused(c, updateScopeRefusal(c, project, body)) return

  OwnerTransfer transfer = OwnerTransfer()
  if refused(c, applyOwnerTransfer(c, project, body, transfer)) return
  if refused(c, applyGroupTag(c, project, body)) return
  object creatorBenefits = mistwarpBenefitsForProject(project)
  if refused(c, applyBranding(project, body, creatorBenefits)) return
  if refused(c, applyVanitySlug(project, body, creatorBenefits)) return
  if refused(c, applyProjectText(project, body)) return
  if refused(c, applyCredits(project, body)) return
  applyProjectFlags(project, body)
  if refused(c, projectSaleRefusal(body)) return
  if refused(c, applyRemixShareUpdate(c, project, body)) return
  if refused(c, applyTags(project, body)) return
  if refused(c, applyGameProducts(project, body)) return
  if refused(c, applyGameItems(project, body)) return
  if refused(c, applyInventoryPolicy(project, body)) return
  if refused(c, gameGrantRefusal(project, body)) return
  if refused(c, applyCompatibility(project, body)) return
  if refused(c, applyTeamUpdate(c, project, body)) return

  if refused(c, holdTransferredStorage(c, project, transfer)) return
  project.edited = timestamp
  if !saveProject(project) (
    storageHoldRelease(transfer.toId, transfer.hold)
    c.internalError("could not save project access")
    return
  )
  upsertIndexEntry(project)
  settleTransferredStorage(transfer)
  if body.contains("collaborators") (
    notifyNewTeammates(project, previousTeam, contextString(c, "username"))
  )
  c.json(200, {ok: true, project: projectResponse(project, c)})
)

def updateScopeRefusal(*serve.Context c, object project, object body) Refusal (
  if isEditorSession(c) and !editorProjectUpdateAllowed(body.getKeys()) (
    return editorScopeRefusal("Open MistWarp to do this.")
  )
  if isStudentUserId((project.ownerId ?? "").toStr()) and !contextBool(c, "isAdmin") and !studentProjectUpdateAllowed(body.getKeys()) (
    return refuseWithBody(403, {ok: false, code: "student_restricted", error: "Class work can only change its title, description, instructions, notes and credits."})
  )
  return noRefusal()
)

def isOwnerOrAdmin(*serve.Context c, object project) boolean (
  return projectRole(project, contextString(c, "username")) == "owner" or contextBool(c, "isAdmin")
)

def applyOwnerTransfer(*serve.Context c, object project, object body, OwnerTransfer transfer) Refusal (
  if !body.contains("owner") (
    return noRefusal()
  )
  boolean canTransfer = contextBool(c, "isAdmin") or projectRole(project, contextString(c, "username")) == "owner" or canManageGroupContent(project, c)
  if !canTransfer (
    return refuse(403, "you cannot transfer this project")
  )
  string requestedOwner = body.owner.toStr().strip()
  string nextOwnerId = discoverUserIdentity(requestedOwner)
  if nextOwnerId == "" (
    return refuse(400, "Rotur user not found")
  )
  string nextOwner = usernameForId(nextOwnerId)
  if nextOwner == "" (
    return refuse(400, "Rotur user not found")
  )
  number nextOwnerLimit = mistwarpBenefitsForUserId(nextOwnerId).maxProjects.toNum()
  boolean sameOwner = identityMatches((project.ownerId ?? "").toStr(), project.owner.toStr(), nextOwnerId, nextOwner)
  if !sameOwner and ownedProjectSlotCount(nextOwnerId, nextOwner) >= nextOwnerLimit (
    return refuse(400, "the new owner has reached their project limit")
  )
  if !sameOwner (
    transfer.fromId = projectOwnerId(project)
  )
  project.owner = nextOwner
  project.ownerId = nextOwnerId
  if !body.contains("keepGroup") or body.keepGroup != true (
    project.groupTag = ""
  )
  return noRefusal()
)

def applyGroupTag(*serve.Context c, object project, object body) Refusal (
  if !body.contains("groupTag") (
    return noRefusal()
  )
  string nextGroupTag = normalizeGroupTag(body.groupTag.toStr())
  if body.groupTag.toStr().strip() == "" (
    nextGroupTag = ""
  ) else if nextGroupTag == "" (
    return refuse(400, "invalid group tag")
  ) else if !canManageGroupTag(nextGroupTag, c) (
    return refuse(403, "you cannot move this project into that group")
  )
  project.groupTag = nextGroupTag
  return noRefusal()
)

def vanitySlugHeldElsewhere(object project, string slug) boolean (
  array matches = vanityClaimEntries(slug)
  for i matches.len (
    object holder = matches[i].assert(object)
    string holderId = holder.id.toStr()
    if holderId != project.id.toStr() (
      string holderEligibility = vanityEligibility(holder)
      string holderLock = "project-upload:" ++ holderId
      boolean held = true
      if sync.tryLock(holderLock) (
        held = applyVanityLapseLocked(holderId, slug, holderEligibility) == slug
        sync.unlock(holderLock)
      )
      if held (
        return true
      )
    )
  )
  return false
)

def applyVanitySlug(object project, object body, object creatorBenefits) Refusal (
  if !body.contains("vanitySlug") (
    return noRefusal()
  )
  string slug = body.vanitySlug.toStr().toLower().strip()
  string currentSlug = if project.contains("vanitySlug") then project.vanitySlug.toStr() else ""
  Refusal invalidSlug = vanitySlugRefusal(slug, currentSlug, creatorBenefits)
  if isRefused(invalidSlug) (
    return invalidSlug
  )
  if slug != "" and slug != currentSlug and vanitySlugHeldElsewhere(project, slug) (
    return refuseWithBody(409, {ok: false, error: "that vanity URL is already taken"})
  )
  if slug != currentSlug (
    project.delete("vanityLapsedAt")
  )
  project.vanitySlug = slug
  return noRefusal()
)

def applyRemixShareUpdate(*serve.Context c, object project, object body) Refusal (
  if !body.contains("remixShare") (
    return noRefusal()
  )
  if !isOwnerOrAdmin(c, project) (
    return refuse(403, "only the owner can change the remix share")
  )
  return applyRemixShare(project, body.remixShare.toNum())
)

def applyTeamUpdate(*serve.Context c, object project, object body) Refusal (
  if !body.contains("collaborators") (
    return noRefusal()
  )
  if !isOwnerOrAdmin(c, project) (
    return refuse(403, "only the owner can manage the project team")
  )
  if typeof(body.collaborators) != "array" (
    return refuse(400, "collaborators must be a list")
  )
  return applyCollaborators(project, body.collaborators.assert(array))
)

def holdTransferredStorage(*serve.Context c, object project, OwnerTransfer transfer) Refusal (
  transfer.hold = noStorageHold()
  transfer.toId = projectOwnerId(project)
  if transfer.fromId == "" or !usesRoturStorage(transfer.toId) (
    return noRefusal()
  )
  object moving = {}
  moving[project.id.toStr()] = projectStorageSummary(project, loadAssetsIndex().assets.assertElse(object, {}))
  transfer.hold = storageHold(transfer.toId, {projects: moving}, !contextBool(c, "isAdmin"))
  if transfer.hold.ok != true (
    object storageRefusal = transfer.hold.refusal.assertElse(object, {})
    return refuseWithBody(413, {ok: false, code: "storage_full", error: "The new owner's Rotur storage doesn't have room for this project.", needed: (storageRefusal.needed ?? 0).toNum()})
  )
  return noRefusal()
)

def settleTransferredStorage(OwnerTransfer transfer) (
  if transfer.fromId == "" (
    return
  )
  storageSettleSoon(transfer.fromId)
  if usesRoturStorage(transfer.toId) (
    thread.new(storageSettle, transfer.toId, transfer.hold)
  )
)
