string tmpDir = "/tmp/mistwarp-extensions-test-" ++ timestamp.toStr() ++ "/"
string extensionsDir = tmpDir ++ "extensions/"
string extensionsFile = tmpDir ++ "extensions.json"
string projectsDir = tmpDir ++ "projects/"
number maxProjectJsonBytes = 1048576
number maxProjectExtensions = 20
number maxExtensionSourceBytes = 2097152
number maxProjectExtensionBytes = 10485760
void fs.mkdir(extensionsDir, {recursive: true})

def readFile(string path) object (
  auto text = fs.readFile(path)
  if text.isErr() (
    return {ok: false}
  )
  auto parsed = json.parse(text.unwrap())
  if parsed.isErr() (
    return {ok: false}
  )
  return {ok: true, data: parsed.unwrap()}
)
def writeFile(string path, object data) boolean (
  return fs.writeFile(path, json.stringify(data))
)
def randomString(number length) string (
  return "r" * length
)
def removeString(array items, string value) array (
  array kept = []
  for i items.len (
    if items[i].toStr() != value (
      kept.append(items[i])
    )
  )
  return kept
)
