def registerProjectUploadRoutes(*serve.Router uploads) (
  uploads.POST("/projects/:id/upload", serve.maxBodySize(maxProjectUploadRequestBytes), requireAuth, requireCurrentAgreement, handleUploadProject)
  uploads.POST("/projects/:id/upload-parts/:token/chunk", serve.maxBodySize(maxUploadChunkRequestBytes), requireAuth, requireCurrentAgreement, handleUploadProjectPartChunk)
  uploads.POST("/projects/:id/history/bootstrap", serve.maxBodySize(maxWorkspaceBootstrapRequestBytes), requireAuth, requireCurrentAgreement, handleBootstrapProjectHistory)
  uploads.POST("/projects/:id/thumbnail", serve.maxBodySize(maxThumbnailRequestBytes), requireAuth, handleSetThumbnail)

  uploads.POST("/admin/projects/:id/extensions/index", serve.maxBodySize(maxExtensionIndexRequestBytes), requireAdmin, handleAdminIndexProjectExtensions)
)

def registerProjectRoutes(*serve.Router api) (
  api.GET("/me/quota", requireAuth, handleGetMyQuota)
  api.GET("/me/stats", requireAuth, handleGetMyStats)

  api.GET("/me/shared-projects", requireAuth, handleGetSharedProjects)

  api.GET("/me/trash", requireAuth, handleGetMyTrash)

  api.GET("/explore", handleExplore)
  api.GET("/vanity/:slug", handleResolveVanityProject)

  api.GET("/leaderboard", handleLeaderboard)

  api.POST("/projects", requireAuth, serve.limitRequests(30, {window: 3600000}), handleCreateProject)
  api.POST("/projects/:id/live", requireAuth, serve.limitRequests(120, {window: 60000}), handleLiveCollaboration)
  api.POST("/projects/:id/assets/check", requireAuth, handleCheckProjectAssets)
  api.POST("/projects/:id/upload-parts", requireAuth, requireCurrentAgreement, handleCreateProjectUploadPart)
  api.POST("/projects/:id/upload-parts/:token/complete", requireAuth, requireCurrentAgreement, handleCompleteProjectUploadPart)
  api.GET("/projects/random", handleRandomProject)
  api.GET("/projects/featured", handleFeaturedProject)
  api.GET("/projects/:id/related", handleRelatedProjects)
  api.GET("/sitemap.xml", handleSitemap)
  api.GET("/projects/:id/project.json", handleGetProjectJson)
  api.GET("/projects/:id/trusted-extensions", handleGetProjectTrustedExtensions)

  api.GET("/projects/:id/extensions/:hash/source", handleGetProjectExtensionSource)
  api.GET("/projects/:id/editor", handleGetEditorProject)
  api.GET("/projects/:id", handleGetProject)

  api.PUT("/projects/:id", requireAuth, handleUpdateProject)
  api.DELETE("/projects/:id", requireAuth, handleDeleteProject)
  api.POST("/projects/:id/restore", requireAuth, handleRestoreProject)
  api.DELETE("/trash/:id", requireAuth, handlePurgeTrashedProject)
  api.POST("/projects/:id/publish", requireAuth, requireGoodStanding, handlePublishProject)
  api.POST("/projects/:id/unpublish", requireAuth, handleUnpublishProject)
  api.POST("/projects/:id/visibility", requireAuth, requireGoodStanding, handleSetVisibility)
  api.POST("/projects/:id/purchase/intent", handleProjectSalesEnded)
  api.POST("/projects/:id/purchase/confirm", handleProjectSalesEnded)
  api.POST("/projects/:id/view", handleViewProject)

  api.POST("/projects/:id/react", requireAuth, handleReactProject)
  api.GET("/projects/:id/remixes", handleGetRemixes)
  api.GET("/projects/:id/remixtree", handleGetRemixTree)
  api.POST("/projects/:id/remix", requireAuth, serve.limitRequests(30, {window: 3600000}), handleRemixProject)

  api.GET("/admin/extensions", requireAdmin, handleAdminGetExtensions)

  api.GET("/admin/extensions/:hash/source", requireAdmin, handleAdminGetExtensionSource)
  api.POST("/admin/extensions/policy", requireAdmin, handleAdminSetExtensionPolicy)
  api.POST("/admin/extensions/url-policy", requireAdmin, handleAdminSetExtensionUrlPolicy)
)
