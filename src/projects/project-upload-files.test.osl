testing.assert(megabytes(10485760) == 10 and megabytes(1572864) == 1, "limits are whole megabytes")
testing.assert(assetSizeFailure("a.svg", 10, 10).len == 0, "an asset at the limit is accepted")
object bigAsset = assetSizeFailure("a.svg", 10485761, 10485760)
testing.assert(bigAsset.status == 413 and bigAsset.error == "an asset exceeds your 10 MB limit: a.svg", "an oversized asset names the limit and file")
testing.assert(projectAssetsFailure(5, 5).len == 0 and projectAssetsFailure(6, 5).code == "project_too_large", "project assets are capped")
testing.assert(storageAllowanceFailure(100, -1).len == 0, "a negative allowance means storage is counted elsewhere")
testing.assert(storageAllowanceFailure(100, 100).len == 0, "a project that exactly fits is accepted")
object full = storageAllowanceFailure(150, 100)
testing.assert(full.code == "storage_full" and full.overBytes == 50 and full.status == 413, "a full allowance reports the overflow")
