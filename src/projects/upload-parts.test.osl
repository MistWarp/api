string tmpDir = "/tmp/mistwarp-upload-parts-test-" ++ timestamp.toStr() ++ "/"
void fs.mkdir(tmpDir, {recursive: true})

for index 3 (
  void fs.writeFile(uploadPartChunkPath("tok", index - 1), "part" ++ (index - 1).toStr() ++ ";")
)
testing.assert(assembleUploadPart("tok", 3, 18), "chunks stored from index 0 assemble")
testing.assert(fs.readFile(stagedUploadPartDataPath("tok")).unwrapOr("") == "part0;part1;part2;", "chunks are joined in order")
removeUploadPartChunks("tok", 3)
testing.assert(!fs.exists(uploadPartChunkPath("tok", 0)) and !fs.exists(uploadPartChunkPath("tok", 2)), "every chunk is removed")

void writeFile(stagedUploadPartMetaPath("open"), {projectId: "p1", kind: "workspace", userId: "u1", size: 4, chunks: 1, complete: false, expires: timestamp + 60000})
testing.assert(consumeStagedUploadPart("open", "p1", "workspace", "u1").error == "staged upload is incomplete", "an unfinished upload is refused")
testing.assert(fs.exists(stagedUploadPartMetaPath("open")), "refusing an unfinished upload keeps it so it can still complete")
void fs.writeFile(stagedUploadPartDataPath("open"), "data")
object finished = readFile(stagedUploadPartMetaPath("open")).data.assert(object)
finished.complete = true
void writeFile(stagedUploadPartMetaPath("open"), finished)
object consumed = consumeStagedUploadPart("open", "p1", "workspace", "u1")
testing.assert(consumed.ok == true and consumed.file.size == 4, "a completed upload is consumed")
testing.assert(consumeStagedUploadPart("open", "p1", "workspace", "u1").ok == false, "a consumed upload cannot be used again")

void fs.remove(tmpDir)
