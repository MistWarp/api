export {
  cleanupExpiredStagedUploadParts
}

number stagedUploadPartTtlMs = 900000

def stagedUploadPartMetaPath(string token) string (
  return tmpDir ++ "upload-part-" ++ token ++ ".json"
)

def stagedUploadPartDataPath(string token) string (
  return tmpDir ++ "upload-part-" ++ token ++ ".bin"
)

def validStagedUploadPartKind(string kind) boolean (
  return kind == "workspace" or kind == "mergeTree"
)

def removeStagedUploadPart(string token, object metadata) (
  void fs.remove(stagedUploadPartDataPath(token))
  void fs.remove(stagedUploadPartMetaPath(token))
)

def consumeStagedUploadPart(string token, string projectId, string kind, string userId) object (
  if token == "" or token.len > 64 or !regex.match("^[A-Za-z0-9]+$", token) (
    return {ok: false, error: "invalid staged upload token"}
  )
  auto loaded = readFile(stagedUploadPartMetaPath(token))
  if !loaded.ok (
    return {ok: false, error: "staged upload expired; upload it again"}
  )
  object metadata = loaded.data.assert(object)
  if metadata.projectId.toStr() != projectId or metadata.kind.toStr() != kind or metadata.userId.toStr() != userId (
    return {ok: false, error: "staged upload does not match this project"}
  )
  if metadata.contains("complete") and metadata.complete != true and metadata.expires.toNum() >= timestamp (
    return {ok: false, error: "staged upload is incomplete"}
  )
  if metadata.expires.toNum() < timestamp or !fs.exists(stagedUploadPartDataPath(token)) (
    removeStagedUploadPart(token, metadata)
    return {ok: false, error: "staged upload expired; upload it again"}
  )
  byte[] data = fs.readFileBytes(stagedUploadPartDataPath(token)).unwrapOr("".toBytes())
  if data.len != metadata.size.toNum() (
    removeStagedUploadPart(token, metadata)
    return {ok: false, error: "staged upload is incomplete"}
  )
  removeStagedUploadPart(token, metadata)
  return {ok: true, file: {data: data, size: data.len}}
)

def cleanupExpiredStagedUploadParts() (
  array files = fs.readDir(tmpDir).unwrapOr([])
  for i files.len (
    string filename = files[i].toStr()
    if filename.startsWith("upload-part-") and filename.endsWith(".json") (
      string token = filename.replace("upload-part-", "").replace(".json", "")
      auto loaded = readFile(tmpDir ++ filename)
      if !loaded.ok or loaded.data.expires.toNum() < timestamp (
        object metadata = if loaded.ok then loaded.data.assert(object) else {}
        if metadata.contains("chunks") (
          removeUploadPartChunks(token, metadata.chunks.toNum())
        )
        removeStagedUploadPart(token, metadata)
      )
    )
  )
)

def handleUploadProjectAsset(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canSaveLiveProject(project, c) (
    c.forbidden("not your project")
    return
  )
  string name = c.param("name")
  if !isValidMd5Ext(name) (
    c.badRequest("invalid asset name")
    return
  )
  auto fileResult = c.formFile("asset")
  if fileResult.isErr() (
    c.badRequest("missing asset file")
    return
  )
  object file = fileResult.unwrap()
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  number assetLimit = benefits.maxProjectAssetBytes.toNum()
  if assetLimit > maxWorkspaceBytes (
    assetLimit = maxWorkspaceBytes
  )
  if file.size.toNum() > assetLimit (
    c.json(413, {ok: false, error: "asset exceeds the 90 MB upload limit", code: "asset_too_large"})
    return
  )
  string content = file.data.toStr()
  if content.hashMD5() != md5PartOf(name) (
    c.badRequest("asset filename does not match its content")
    return
  )

  if storeProjectAssetLocked(c, project, name, file) (
    c.json(201, {ok: true, uploaded: true, name: name})
  )
)

def storeProjectAssetLocked(*serve.Context c, object project, string name, object file) boolean (
  string assetLock = "asset-upload-" ++ name
  sync.lock(assetLock)
  defer sync.unlock(assetLock)
  object assetsIndex = loadAssetsIndex()
  object knownAssets = assetsIndex.assets
  if knownAssets.contains(name) (
    c.json(200, {ok: true, uploaded: false, name: name})
    return false
  )
  if !holdUploadAhead(c, project, name, file.size.toNum()) (
    return false
  )
  if !stageR2Blob(assetObjectKey(name), file.data, contentTypeForExt(extPartOf(name)), "") (
    releaseUploadAhead(c, project, [name])
    c.internalError("asset upload failed")
    return false
  )
  knownAssets[name] = file.size
  if !saveAssetsIndex(assetsIndex) (
    r2Remove(assetObjectKey(name))
    c.internalError("asset index update failed")
    return false
  )
  return true
)

def handleStageProjectUploadPart(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canSaveLiveProject(project, c) (
    c.forbidden("not your project")
    return
  )
  string kind = c.param("kind")
  if !validStagedUploadPartKind(kind) (
    c.badRequest("invalid upload part")
    return
  )
  auto fileResult = c.formFile("file")
  if fileResult.isErr() (
    c.badRequest("missing upload part")
    return
  )
  object file = fileResult.unwrap()
  if file.size.toNum() > maxWorkspaceBytes (
    c.json(413, {ok: false, error: "upload part exceeds the 90 MB limit", code: "upload_part_too_large"})
    return
  )
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  number expandedLimit = maxProjectJsonBytes + benefits.maxProjectAssetsBytes.toNum()
  boolean readContents = kind == "workspace"
  if !validateZipArchive(file.data, maxWorkspaceBytes, expandedLimit, maxWorkspaceFiles, readContents) (
    c.badRequest("invalid or unsafe upload part")
    return
  )
  string token = randomString(32)
  if !fs.writeFileBytes(stagedUploadPartDataPath(token), file.data) or !writeFile(stagedUploadPartMetaPath(token), {
    projectId: project.id,
    kind: kind,
    userId: contextString(c, "userId"),
    size: file.size,
    expires: timestamp + stagedUploadPartTtlMs
  }) (
  removeStagedUploadPart(token, {})
  c.internalError("could not stage upload part")
  return
)
  c.json(201, {ok: true, token: token, size: file.size, expiresInMs: stagedUploadPartTtlMs})
)

def uploadPartChunkPath(string token, number index) string (
  return tmpDir ++ "upload-part-" ++ token ++ ".chunk." ++ index.toInt().toStr()
)

def removeUploadPartChunks(string token, number count) (
  for i count (
    void fs.remove(uploadPartChunkPath(token, i - 1))
  )
)

def assembleUploadPart(string token, number count, number expectedBytes) boolean (
  string outputPath = stagedUploadPartDataPath(token)
  array chunkPaths = []
  for i count (
    chunkPaths.append(uploadPartChunkPath(token, i - 1))
  )
  return storagefs.ConcatenateFiles(outputPath, chunkPaths, expectedBytes)
)

def handleCreateProjectUploadPart(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canSaveLiveProject(project, c) (
    c.forbidden("not your project")
    return
  )
  object body = requestJSON(c)
  string kind = (body.kind ?? "").toStr()
  string name = (body.name ?? "").toStr()
  number size = body.size.toNum().toInt()
  number chunks = body.chunks.toNum().toInt()
  if kind != "asset" and kind != "workspace" and kind != "mergeTree" (
    c.badRequest("invalid upload part")
    return
  )
  if size < 1 or size > maxWorkspaceBytes or chunks < 1 or chunks > 64 or chunks * maxUploadChunkBytes < size (
    c.badRequest("invalid upload size")
    return
  )
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  if kind == "asset" (
    if !isValidMd5Ext(name) or size > benefits.maxProjectAssetBytes.toNum() (
      c.badRequest("invalid or oversized asset")
      return
    )
    object knownAssets = loadAssetsIndex().assets
    if knownAssets.contains(name) (
      c.json(200, {ok: true, alreadyPresent: true, name: name})
      return
    )
  )
  if kind == "asset" and !holdUploadAhead(c, project, name, size) (
    return
  )
  string token = randomString(32)
  object metadata = {
    projectId: project.id,
    kind: kind,
    name: name,
    userId: contextString(c, "userId"),
    size: size,
    chunks: chunks,
    nextChunk: 0,
    received: 0,
    complete: false,
    expires: timestamp + stagedUploadPartTtlMs
  }
  if !writeFile(stagedUploadPartMetaPath(token), metadata) (
    if kind == "asset" (
      releaseUploadAhead(c, project, [name])
    )
    c.internalError("could not start upload")
    return
  )
  c.json(201, {ok: true, token: token, chunkBytes: maxUploadChunkBytes, expiresInMs: stagedUploadPartTtlMs})
)

def loadOwnedUploadPart(*serve.Context c) object (
  string token = c.param("token")
  if token == "" or token.len > 64 or !regex.match("^[A-Za-z0-9]+$", token) (
    return {ok: false, error: "invalid upload token"}
  )
  auto loaded = readFile(stagedUploadPartMetaPath(token))
  if !loaded.ok (
    return {ok: false, error: "upload expired; start it again"}
  )
  object metadata = loaded.data.assert(object)
  if metadata.projectId.toStr() != c.param("id") or metadata.userId.toStr() != contextString(c, "userId") (
    return {ok: false, error: "upload token does not match this project"}
  )
  if metadata.expires.toNum() < timestamp (
    removeUploadPartChunks(token, metadata.chunks.toNum())
    removeStagedUploadPart(token, metadata)
    return {ok: false, error: "upload expired; start it again"}
  )
  return {ok: true, token: token, metadata: metadata}
)

def handleUploadProjectPartChunk(*serve.Context c) (
  object loaded = loadOwnedUploadPart(c)
  if !loaded.ok (
    c.badRequest(loaded.error.toStr())
    return
  )
  string token = loaded.token.toStr()
  object metadata = loaded.metadata.assert(object)
  if metadata.complete == true (
    c.badRequest("upload is already complete")
    return
  )
  auto chunkResult = c.formFile("chunk")
  if chunkResult.isErr() (
    c.badRequest("missing upload chunk")
    return
  )
  object chunk = chunkResult.unwrap()
  number index = (c.formValue("index") ?? "").toNum().toInt()
  if index != metadata.nextChunk.toNum() or chunk.size.toNum() < 1 or chunk.size.toNum() > maxUploadChunkBytes (
    c.badRequest("unexpected upload chunk")
    return
  )
  if metadata.received.toNum() + chunk.size.toNum() > metadata.size.toNum() (
    c.badRequest("upload exceeds its declared size")
    return
  )
  if !fs.writeFileBytes(uploadPartChunkPath(token, index), chunk.data) (
    c.internalError("could not store upload chunk")
    return
  )
  metadata.nextChunk = index + 1
  metadata.received = metadata.received.toNum() + chunk.size.toNum()
  metadata.expires = timestamp + stagedUploadPartTtlMs
  if !writeFile(stagedUploadPartMetaPath(token), metadata) (
    void fs.remove(uploadPartChunkPath(token, index))
    c.internalError("could not update upload")
    return
  )
  c.json(200, {ok: true, received: metadata.received, size: metadata.size})
)

def handleCompleteProjectUploadPart(*serve.Context c) (
  object loaded = loadOwnedUploadPart(c)
  if !loaded.ok (
    c.badRequest(loaded.error.toStr())
    return
  )
  string token = loaded.token.toStr()
  object metadata = loaded.metadata.assert(object)
  if metadata.received.toNum() != metadata.size.toNum() or metadata.nextChunk.toNum() != metadata.chunks.toNum() (
    c.badRequest("upload is incomplete")
    return
  )
  if !assembleUploadPart(token, metadata.chunks.toNum(), metadata.size.toNum()) (
    c.internalError("could not assemble upload")
    return
  )
  removeUploadPartChunks(token, metadata.chunks.toNum())
  byte[] data = fs.readFileBytes(stagedUploadPartDataPath(token)).unwrapOr("".toBytes())
  string kind = metadata.kind.toStr()
  if kind == "asset" (
    string name = metadata.name.toStr()
    if data.toStr().hashMD5() != md5PartOf(name) (
      removeStagedUploadPart(token, metadata)
      c.badRequest("asset filename does not match its content")
      return
    )
    boolean stored = storeStagedAssetLocked(name, data, metadata.size.toNum())
    removeStagedUploadPart(token, metadata)
    if !stored (
      c.internalError("could not store asset")
      return
    )
    c.json(201, {ok: true, complete: true, kind: kind, name: name})
    return
  )
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  number expandedLimit = maxProjectJsonBytes + benefits.maxProjectAssetsBytes.toNum()
  boolean readContents = kind == "workspace"
  if !validateZipArchive(data, metadata.size.toNum(), expandedLimit, maxWorkspaceFiles, readContents) (
    removeStagedUploadPart(token, metadata)
    c.badRequest("invalid or unsafe upload part")
    return
  )
  metadata.complete = true
  metadata.expires = timestamp + stagedUploadPartTtlMs
  if !writeFile(stagedUploadPartMetaPath(token), metadata) (
    removeStagedUploadPart(token, metadata)
    c.internalError("could not finish upload")
    return
  )
  c.json(201, {ok: true, complete: true, token: token, kind: kind})
)

def storeStagedAssetLocked(string name, byte[] data, number size) boolean (
  string assetLock = "asset-upload-" ++ name
  sync.lock(assetLock)
  defer sync.unlock(assetLock)
  object assetsIndex = loadAssetsIndex()
  object knownAssets = assetsIndex.assets
  boolean stored = knownAssets.contains(name)
  if !stored (
    stored = stageR2Blob(assetObjectKey(name), data, contentTypeForExt(extPartOf(name)), "")
    if stored (
      knownAssets[name] = size
      stored = saveAssetsIndex(assetsIndex)
    )
  )
  return stored
)
