string work = "/tmp/mistwarp-remix-test-" ++ timestamp.toStr()
void fs.mkdir(work, {recursive: true})
string tmpDir = work ++ "/"
auto testDb = db.open(work ++ "/community.db")
*db.Collection projectSearchDocs = testDb.collection("project_search")

def lockIsFree(string lockName) boolean (
  boolean free = thread.new(def() -> (
    boolean taken = sync.tryLock(lockName)
    if taken (
      sync.unlock(lockName)
    )
    return taken
  )).wait()
  return free
)

number parentBytes = 100
number loads = 0
number growOnLoad = 0
number revokeViewOnLoad = 0
number revokeRemixOnLoad = 0
boolean growEveryLoad = false
boolean roturStorage = true
boolean storageFull = false
boolean saveWorks = true
boolean failing = false
number holdsAsked = 0
number ids = 0
array holdLockFree = []
array released = []
array settled = []

def resetScenario() (
  parentBytes = 100
  loads = 0
  growOnLoad = 0
  revokeViewOnLoad = 0
  revokeRemixOnLoad = 0
  growEveryLoad = false
  roturStorage = true
  storageFull = false
  saveWorks = true
  failing = false
  holdsAsked = 0
  holdLockFree = []
  released = []
  settled = []
)

def parentProject() object (
  return {id: "p1", title: "Parent", jsonKey: "project-json/parent", storedJsonBytes: parentBytes, assets: [], gitBranch: "main"}
)

def loadProject(string id) object (
  loads += 1
  if growEveryLoad or loads == growOnLoad (
    parentBytes += 1
  )
  if id != "p1" (
    return {ok: false}
  )
  object project = parentProject()
  project.viewRevoked = revokeViewOnLoad > 0 and loads >= revokeViewOnLoad
  project.remixRevoked = revokeRemixOnLoad > 0 and loads >= revokeRemixOnLoad
  return {ok: true, project: project}
)

