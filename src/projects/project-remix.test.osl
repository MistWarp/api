def storageFullResponse(*serve.Context c, object details, number neededBytes) (
  c.json(413, {ok: false, code: "storage_full"})
)
def roturStorageFullResponse(*serve.Context c, object refusal) (
  c.json(413, {ok: false, code: "storage_full", needed: refusal.needed})
)

import "./project-remix.osl"

*serve.Router app = serve.new()
app.POST("/projects/:id/remix", handleRemixProject)
app.GET("/ready", def(*serve.Context c) -> (
  c.json(200, {ok: true})
))
def runApp() (
  app.run(":18362")
)
thread.new(runApp)
string base = "http://127.0.0.1:18362"
for i 50 (
  if requests.get(base ++ "/ready").isOk() (
    break
  )
  wait 0.1
)

def remix(string id) object (
  object resp = requests.post(base ++ "/projects/" ++ id ++ "/remix", {body: "{}"}).unwrapOr({status: 0, body: "{}"})
  object body = json.parse((resp.body ?? "{}").toStr(), {type: "object"}).unwrapOr({})
  wait 0.2
  return {status: resp.status.toNum(), body: body}
)

object made = remix("p1")
testing.assert(made.status == 201 and made.body.id == "fork1", "a remix of an unchanged project is created")
testing.assert(holdsAsked == 1 and holdLockFree == [true], "the storage hold is taken once, with the save lock free")
testing.assert(released.len == 0 and settled == ["hold1"], "a successful remix keeps its hold and settles it")

resetScenario()
growOnLoad = 2
made = remix("p1")
testing.assert(made.status == 201 and holdsAsked == 2 and holdLockFree == [true, true], "a project that changed before the lock is held again on the next try")
testing.assert(released == ["hold1"] and settled == ["hold2"], "the stale hold is released and the fresh one kept")

resetScenario()
growEveryLoad = true
made = remix("p1")
testing.assert(made.status == 409 and made.body.code == "project_changed", "a project that keeps changing is refused after three tries")
testing.assert(holdsAsked == 3 and released == ["hold1", "hold2", "hold3"] and settled.len == 0, "every try's hold is released")

resetScenario()
storageFull = true
made = remix("p1")
testing.assert(made.status == 413 and made.body.code == "storage_full" and made.body.needed == 5, "full Rotur storage refuses the remix")
testing.assert(holdsAsked == 1 and settled.len == 0, "the refusal is not asked for again under the lock")

resetScenario()
saveWorks = false
made = remix("p1")
testing.assert(made.status == 500 and made.body.code == "save_failed", "a fork that can't be saved fails")
testing.assert(released == ["hold1"] and settled.len == 0, "a failed save releases the hold")

resetScenario()
failing = true
made = remix("p1")
testing.assert(made.status >= 500 and released == ["hold1"] and settled.len == 0, "a remix that throws releases its hold")
testing.assert(lockIsFree("project-history-p1"), "a remix that throws releases the save lock")

resetScenario()
roturStorage = false
made = remix("p1")
testing.assert(made.status == 201 and holdsAsked == 0 and loads == 1, "accounts outside Rotur storage remix in one pass without a hold")

resetScenario()
revokeViewOnLoad = 2
made = remix("p1")
testing.assert(made.status == 404 and holdsAsked == 1, "a parent made private before the lock is not remixed")
testing.assert(released == ["hold1"] and settled.len == 0, "the hold for a parent made private is released")

resetScenario()
revokeRemixOnLoad = 2
made = remix("p1")
testing.assert(made.status == 403 and holdsAsked == 1, "a parent closed to remixes before the lock is not remixed")
testing.assert(released == ["hold1"] and settled.len == 0, "the hold for a parent closed to remixes is released")

resetScenario()
made = remix("missing")
testing.assert(made.status == 404 and holdsAsked == 0, "a missing project is not found")

resetScenario()
object copied = forkProjectFor(parentProject(), "teacher", "u_teacher", mistwarpBenefitsForUserId("u_teacher"), "Copy", "", false)
wait 0.2
testing.assert(copied.ok == true and copied.project.title == "Copy" and copied.project.owner == "teacher", "a classroom copy is forked directly")
testing.assert(holdsAsked == 1 and released.len == 0 and settled == ["hold1"], "a classroom copy keeps and settles its hold")

resetScenario()
saveWorks = false
copied = forkProjectFor(parentProject(), "teacher", "u_teacher", mistwarpBenefitsForUserId("u_teacher"), "Copy", "", false)
testing.assert(copied.code == "save_failed" and released == ["hold1"], "a classroom copy that can't be saved releases its hold")

testDb.close()
void fs.remove(work, {force: true})
