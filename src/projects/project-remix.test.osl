def storageAllowance(number limit, number used, number currentBytes) number (
  return limit - used
)
def ownerStorageBytes(string username) number (
  return 0
)
def usesRoturStorage(string userId) boolean (
  return roturStorage and userId != ""
)
def noStorageHold() object (
  return {ok: true, reservations: []}
)
def storageHold(string userId, object changes, boolean enforce) object (
  holdsAsked += 1
  holdLockFree.append(lockIsFree("project-history-p1"))
  if storageFull (
    return {ok: false, refusal: {needed: 5}}
  )
  return {ok: true, reservations: [{id: "hold" ++ holdsAsked.toStr()}]}
)
def storageHoldRelease(string userId, object hold) (
  array reservations = (hold.reservations ?? []).assertElse(array, [])
  for i reservations.len (
    released.append(reservations[i].assertElse(object, {}).id.toStr())
  )
)
def storageSettle(string userId, object hold) (
  array reservations = (hold.reservations ?? []).assertElse(array, [])
  for i reservations.len (
    settled.append(reservations[i].assertElse(object, {}).id.toStr())
  )
)
def projectWorkspaceSnapshotKey(string hash) string (
  return "project-workspaces/" ++ hash
)
def contentHash(any body) string (
  return "hash"
)
def stageR2Blob(string key, any body, string contentType, string contentEncoding) boolean (
  if failing (
    throw "IOError: staging failed"
  )
  return true
)
