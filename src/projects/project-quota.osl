export {
  ownerStorageBytes,
  pendingUploadEvents,
  quotaPath,
  roturMembershipUrl,
  roturStorageFullResponse,
  storageDetails,
  storageFullResponse,
  trashedProjectsOwnedBy
}

def handleGetMyQuota(*serve.Context c) (
  string username = contextString(c, "username")
  object details = storageDetails(username)
  array projects = []
  array entries = ownerIndexEntries(username, true)
  for i entries.len (
    object entry = entries[i].assert(object)
    projects.append({id: entry.id, title: entry.title, bytes: (entry.sizeBytes ?? 0).toNum() + (entry.historyBytes ?? 0).toNum(), trashed: false})
  )
  array trashed = trashedProjectsOwnedBy(contextString(c, "userId"), username)
  for i trashed.len (
    object project = trashed[i].assert(object)
    projects.append({id: project.id, title: project.title, bytes: projectStorageBytes(project), trashed: true})
  )
  projects.sortBy("bytes", "descending")
  // shared: used, limit and remaining are the person's whole Rotur storage,
  // and mistwarp is what MistWarp holds of it.
  c.json(200, {
    ok: true,
    shared: details.shared,
    known: details.known,
    used: details.used,
    pending: details.pending,
    limit: details.limit,
    remaining: details.remaining,
    mistwarp: details.mistwarp,
    backpack: backpackStoredBytes(contextString(c, "userId")),
    largest: paginate(projects, 0, 5),
    membershipUrl: roturMembershipUrl
  })
)

def quotaPath(string username) string (
  return quotaDir ++ normalizeUsername(username) ++ ".json"
)

def pendingUploadEvents(string username) array (
  auto res = readFile(quotaPath(username))
  if !res.ok (
    return []
  )
  object data = res.data.assertElse(object, {})
  if !data.contains("pending") (
    return []
  )
  return quotaPruneEvents(data.pending.assertElse(array, []), timestamp, quotaWindowMs)
)

def trashedProjectsOwnedBy(string userId, string username) array (
  array owned = []
  array trashFiles = fs.readDir(trashDir).unwrapOr([])
  for i trashFiles.len (
    string file = trashFiles[i].toStr()
    if file.endsWith(".json") (
      auto loaded = readFile(trashDir ++ file)
      if loaded.ok (
        object project = loaded.data.assert(object)
        if identityMatches((project.ownerId ?? "").toStr(), project.owner.toStr(), userId, username) (
          owned.append(project)
        )
      )
    )
  )
  return owned
)

def ownerStorageBytes(string username) number (
  number total = 0
  array entries = ownerIndexEntries(username, true)
  for i entries.len (
    object entry = entries[i].assert(object)
    total += (entry.sizeBytes ?? 0).toNum() + (entry.historyBytes ?? 0).toNum()
  )
  array trashed = trashedProjectsOwnedBy(userIdForUsername(username), username)
  for i trashed.len (
    total += projectStorageBytes(trashed[i].assert(object))
  )
  total += backpackStoredBytes(userIdForUsername(username))
  return total
)

// shared is true for Rotur accounts, whose used, limit and remaining are their
// whole Rotur storage, shared with Rotur's other apps; mistwarp is MistWarp's
// part of it. known is false when Rotur couldn't say.
def storageDetails(string username) object (
  string userId = userIdForUsername(username)
  if usesRoturStorage(userId) (
    object allowance = ledgerAllowance(userId)
    if allowance.ok != true (
      return {shared: true, known: false, used: 0, pending: 0, limit: 0, remaining: 0, mistwarp: ownerStorageBytes(username)}
    )
    return {shared: true, known: true, used: allowance.used, pending: 0, limit: allowance.max, remaining: allowance.available, mistwarp: allowance.bytes + allowance.reserved}
  )
  number limit = mistwarpBenefitsForUsername(username).storageBytes.toNum()
  number used = ownerStorageBytes(username)
  number pending = quotaTotalBytes(pendingUploadEvents(username), timestamp, quotaWindowMs)
  number remaining = limit - used - pending
  if remaining < 0 (
    remaining = 0
  )
  return {shared: false, known: true, used: used, pending: pending, limit: limit, remaining: remaining, mistwarp: used}
)

string roturMembershipUrl = "https://rotur.dev/membership"

// The ledger refused something because the person's Rotur storage is full.
def roturStorageFullResponse(*serve.Context c, object refusal) (
  c.json(413, {
    ok: false,
    code: "storage_full",
    shared: true,
    error: "Your Rotur storage is full. Delete projects or backpack items you no longer need and empty the trash, or get more storage with a Rotur membership at rotur.dev/membership.",
    used: (refusal.used ?? 0).toNum(),
    pending: 0,
    limit: (refusal.max ?? 0).toNum(),
    remaining: (refusal.available ?? 0).toNum(),
    needed: (refusal.needed ?? 0).toNum(),
    membershipUrl: roturMembershipUrl
  })
)

def storageFullResponse(*serve.Context c, object details, number neededBytes) (
  number usedMb = ((details.used.toNum() + details.pending.toNum()) / 1048576).toInt()
  number limitMb = (details.limit.toNum() / 1048576).toInt()
  number neededMb = (neededBytes / 1048576).toInt() + 1
  c.json(413, {ok: false, code: "storage_full", error: "Your projects and backpack use " ++ usedMb.toStr() ++ " MB of your " ++ limitMb.toStr() ++ " MB of storage, and this needs about " ++ neededMb.toStr() ++ " MB more. Delete projects or backpack items you no longer need and empty the trash, or upgrade your plan.", used: details.used, pending: details.pending, limit: details.limit, remaining: details.remaining})
)

// Assets uploaded ahead of a save count against storage until a saved
// project references them or they age out.
def reservePendingUpload(string username, string name, number bytes, number limit, boolean enforceLimit) object (
  string lockName = "upload-quota-" ++ normalizeUsername(username)
  sync.lock(lockName)
  array events = pendingUploadEvents(username)
  number used = ownerStorageBytes(username) + quotaTotalBytes(events, timestamp, quotaWindowMs)
  if enforceLimit and used + bytes > limit (
    sync.unlock(lockName)
    return {ok: false, used: used}
  )
  events.append({t: timestamp, bytes: bytes, name: name})
  writeFile(quotaPath(username), {pending: events})
  sync.unlock(lockName)
  return {ok: true, used: used}
)

def releasePendingUploads(string username, array names) (
  if names.len == 0 (
    return
  )
  string lockName = "upload-quota-" ++ normalizeUsername(username)
  sync.lock(lockName)
  array events = pendingUploadEvents(username)
  if events.len > 0 (
    writeFile(quotaPath(username), {pending: quotaWithoutNames(events, names, timestamp, quotaWindowMs)})
  )
  sync.unlock(lockName)
)

// The most a student's project may occupy after a save, or -1 when the
// owner's storage is counted by Rotur instead.
def projectStorageAllowance(object project) number (
  if usesRoturStorage(projectOwnerId(project)) (
    return -1
  )
  number limit = mistwarpBenefitsForProject(project).storageBytes.toNum()
  return storageAllowance(limit, ownerStorageBytes(project.owner.toStr()), projectStorageBytes(project))
)

// Holds room for an asset uploaded ahead of the save that uses it, or
// answers that there isn't any.
def holdUploadAhead(*serve.Context c, object project, string name, number bytes) boolean (
  boolean enforce = !contextBool(c, "isAdmin")
  string ownerId = projectOwnerId(project)
  if usesRoturStorage(ownerId) (
    object held = pendingAssetHold(ownerId, project.owner.toStr(), name, bytes, enforce)
    if held.ok != true (
      roturStorageFullResponse(c, held.refusal.assertElse(object, {}))
      return false
    )
    return true
  )
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  object reservation = reservePendingUpload(contextString(c, "username"), name, bytes, benefits.storageBytes.toNum(), enforce)
  if !reservation.ok (
    storageFullResponse(c, storageDetails(contextString(c, "username")), bytes)
    return false
  )
  return true
)

def releaseUploadAhead(*serve.Context c, object project, array names) (
  string ownerId = projectOwnerId(project)
  if usesRoturStorage(ownerId) (
    releasePendingAssetHolds(ownerId, project.owner.toStr(), names)
    return
  )
  releasePendingUploads(contextString(c, "username"), names)
)
