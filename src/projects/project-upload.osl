export {}

def handleCheckProjectAssets(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canSaveLiveProject(project, c) (
    c.forbidden("not your project")
    return
  )
  object body = requestJSON(c)
  if !body.contains("assets") or typeof(body.assets) != "array" (
    c.badRequest("assets list is required")
    return
  )
  array requested = body.assets.assert(array)
  if requested.len > maxAssetCount (
    c.badRequest("too many assets")
    return
  )
  object assetsIndex = loadAssetsIndex()
  object knownAssets = assetsIndex.assets
  array missing = []
  for i requested.len (
    string name = requested[i].toStr()
    if !isValidMd5Ext(name) (
      c.badRequest("invalid asset name: " ++ name)
      return
    )
    if !knownAssets.contains(name) (
      missing.append(name)
    )
  )
  c.json(200, {ok: true, missing: missing})
)

def handleUploadProject(*serve.Context c) (
  runLocked("project-history-" ++ c.param("id"), def() -> (
    handleUploadProjectLocked(c)
  ))
)

def handleUploadProjectLocked(*serve.Context c) (
  object? loaded = loadRequestedProject(c)
  if loaded == null return
  object project = loaded
  if !canSaveLiveProject(project, c) (
    c.forbidden("not your project")
    return
  )
  UploadRequest request = readUploadRequest(c)
  if refused(c, editorReplaceRefusal(c, request, project)) return
  UploadHistory history = newUploadHistory(request, projectGitHead(project))
  if refused(c, liveContributorRefusal(request, canEditProject(project, c))) return
  if refused(c, staleUploadRefusal(request, project, history.currentHead)) return
  if refused(c, readUploadGitMetadata(history, projectHasWorkspace(project))) return
  if refused(c, restoreCommitRefusal(request)) return

  UploadArchive archive = UploadArchive()
  if refused(c, receiveProjectArchive(c, archive)) return
  object benefits = mistwarpBenefitsForUserId(contextString(c, "userId"))
  string uploader = normalizeUsername(contextString(c, "username"))
  if refused(c, receiveHistoryParts(c, project, request, history)) return
  number storageAllowanceBytes = if contextBool(c, "isAdmin") then -1 else projectStorageAllowance(project)
  if refused(c, unpackProjectArchive(project, benefits, archive)) return

  if refused(c, archive.discardOn(replaceWithoutWorkspaceRefusal(request, history))) return
  if refused(c, archive.discardOn(checkUploadedWorkspace(project, request, history, archive))) return
  if refused(c, archive.discardOn(unchangedVersionCheck(project, request, history, archive))) return
  object extensionResult = collectProjectExtensions(archive.extractDir ++ "/project.json", request.extensions)
  if refused(c, archive.discardOn(extensionRefusal(extensionResult))) return
  if refused(c, archive.discardOn(createMergeCommit(project, request, history, archive, uploader))) return
  if refused(c, archive.discardOn(createRestoreCommit(project, request, history, archive, uploader))) return
  if refused(c, archive.discardOn(checkGeneratedHistory(project, history))) return

  UploadRollback rollback = UploadRollback()
  rollback.previousWorkspaceKeys = projectWorkspaceKeys(project)
  if refused(c, archive.discardOn(storeUploadedHistory(project, request, history, archive))) return
  object uploadResult = uploadProjectFiles(project, archive.extractDir, benefits, storageAllowanceBytes, !contextBool(c, "isAdmin"))
  rollback.ownerId = projectOwnerId(project)
  rollback.hold = (uploadResult.hold ?? {}).assertElse(object, {})
  if !uploadResult.ok (
    rejectProjectFiles(c, project, uploadResult, rollback, archive)
    return
  )
  if refused(c, archive.discardOn(storeUploadExtensions(project, extensionResult, rollback))) return
  saveUploadThumbnail(c, project.id.toStr())

  applyUploadedFiles(project, uploadResult, extensionResult, rollback)
  if !publishProjectJson(project, uploadResult) (
    abandonUnpublishedUpload(c, project, rollback, archive)
    return
  )
  recordCreatingDay(contextString(c, "username"))
  if !saveProject(project) (
    abandonUnsavedUpload(c, project, rollback, archive)
    return
  )
  settleSavedUpload(project, rollback, uploader)
  archive.discard()

  project = projectWithUploadHistory(project)
  if refused(c, completeUploadPull(project, request, contextString(c, "username"))) return
  c.json(200, uploadResponse(project, uploadResult))
)

def handleBootstrapProjectHistory(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canEditProject(project, c) (
    c.forbidden("not your project")
    return
  )
  object ensured = ensureGeneratedProjectHistory(project, {}, false)
  if !ensured.ok or !projectHasWorkspace(ensured.project.assertElse(object, {})) (
    c.json(409, {ok: false, code: "history_unavailable", error: "stored history could not be prepared; retry or recover the original repository"})
    return
  )
  project = ensured.project.assert(object)
  c.json(200, {
    ok: true, usedExisting: true,
    workspaceUrl: appURL ++ "/v1/projects/" ++ project.id.toStr() ++ "/workspace.mwp",
    head: projectGitHead(project), branch: project.gitBranch,
    remixBaseCommit: project.remixBaseCommit
  })
)

def handleSetThumbnail(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canEditProject(project, c) (
    c.forbidden("not your project")
    return
  )

  auto thumbResult = c.formFile("thumbnail")
  if thumbResult.isErr() (
    c.badRequest("missing thumbnail file")
    return
  )
  object thumb = thumbResult.unwrap()
  if thumb.size.toNum() > maxThumbBytes (
    c.badRequest("thumbnail too large")
    return
  )
  if !fs.writeFileBytes(thumbnailPath(project.id.toStr()), thumb.data) (
    c.internalError("thumbnail save failed")
    return
  )
  project.edited = timestamp
  if !saveProject(project) (
    c.internalError("failed to save the remix")
    return
  )
  upsertIndexEntry(project)
  thread.new(warmShareCard, project.id.toStr())
  c.json(200, {ok: true, thumbUrl: viewerThumbUrlFor(project)})
)
