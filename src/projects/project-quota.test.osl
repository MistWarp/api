def lockIsFree(string lockName) boolean (
  boolean free = thread.new(def() -> (
    boolean taken = sync.tryLock(lockName)
    if taken (
      sync.unlock(lockName)
    )
    return taken
  )).wait()
  return free
)

import "./project-quota.osl"

object reserved = reservePendingUpload("Sam", "a.svg", 10, 100, true)
testing.assert(reserved.ok == true and pendingUploadEvents("sam").len == 1 and lockIsFree("upload-quota-sam"), "an upload is reserved and the quota lock released")
testing.assert(reservePendingUpload("sam", "b.svg", 95, 100, true).ok == false and lockIsFree("upload-quota-sam"), "a refused reservation releases the quota lock")
failing = true
testing.assert(try(reservePendingUpload("sam", "c.svg", 1, 100, true)).isErr(), "a failure while reserving reaches the caller")
testing.assert(lockIsFree("upload-quota-sam"), "the quota lock is released when reserving throws")
def releaseThrows() boolean (
  releasePendingUploads("sam", ["a.svg"])
  return true
)
testing.assert(try(releaseThrows()).isErr() and lockIsFree("upload-quota-sam"), "the quota lock is released when releasing throws")
failing = false
releasePendingUploads("sam", ["a.svg"])
testing.assert(pendingUploadEvents("sam").len == 0 and lockIsFree("upload-quota-sam"), "the quota can be used again after a failure")
