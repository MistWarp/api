export {}

type OwnerTransfer (
  string fromId = ""
  string toId = ""
  object hold = {}
  string holdKey = ""
)

def applyBranding(object project, object body, object creatorBenefits) Refusal (
  if !body.contains("branding") (
    return noRefusal()
  )
  object incomingBranding = body.branding.assertElse(object, {})
  boolean clearingBranding = incomingBranding.getKeys().len == 0
  string accentColor = (incomingBranding.accentColor ?? "").toStr().strip()
  string tagline = (incomingBranding.tagline ?? "").toStr().strip()
  if accentColor != "" and !regex.match("^#[0-9a-fA-F]{6}$", accentColor) (
    return refuse(400, "branding accent must be a six-digit hex colour")
  )
  if tagline.len > 120 (
    return refuse(400, "branding tagline is too long")
  )
  object nextBranding = if clearingBranding then {} else {accentColor: accentColor, tagline: tagline}
  object currentBranding = if project.contains("branding") then project.branding.assertElse(object, {}) else {}
  if creatorBenefits.customProjectBranding != true and json.stringify(nextBranding) != json.stringify(currentBranding) (
    return refuse(403, "custom project branding requires Rotur Plus or Pro")
  )
  project.branding = nextBranding
  return noRefusal()
)

def vanitySlugRefusal(string slug, string currentSlug, object creatorBenefits) Refusal (
  if slug != "" and slug != currentSlug and creatorBenefits.vanityProjectUrls != true (
    return refuse(403, "vanity project URLs require Rotur Pro")
  )
  if slug != "" and (slug.len < 3 or slug.len > 40 or !regex.match("^[a-z0-9][a-z0-9-]*[a-z0-9]$", slug)) (
    return refuse(400, "vanity URLs must be 3 to 40 letters, numbers, or hyphens")
  )
  return noRefusal()
)

def applyProjectText(object project, object body) Refusal (
  if body.contains("title") (
    string title = (body.title ?? "").toStr().strip()
    if title == "" or title.len > 100 (
      return refuse(400, "invalid title")
    )
    project.title = title
  )
  if body.contains("description") (
    string description = (body.description ?? "").toStr()
    if description.len > 5000 (
      return refuse(400, "description too long")
    )
    project.description = description
  )
  if body.contains("instructions") (
    string instructions = (body.instructions ?? "").toStr()
    if instructions.len > 5000 (
      return refuse(400, "instructions too long")
    )
    project.instructions = instructions
  )
  if body.contains("notes") (
    string notes = (body.notes ?? "").toStr()
    if notes.len > 5000 (
      return refuse(400, "notes too long")
    )
    project.notes = notes
  )
  return noRefusal()
)

def applyCredits(object project, object body) Refusal (
  if !body.contains("credits") (
    return noRefusal()
  )
  if typeof(body.credits) != "array" (
    return refuse(400, "credits must be a list")
  )
  array incoming = body.credits.assert(array)
  if incoming.len > 50 (
    return refuse(400, "too many credits")
  )
  array credits = []
  for i incoming.len (
    if typeof(incoming[i]) != "object" (
      return refuse(400, "each credit must be an object")
    )
    object entry = incoming[i].assert(object)
    string who = (entry.who ?? "").toStr().strip()
    string role = (entry.role ?? "").toStr().strip()
    string creditUrl = ""
    if entry.contains("url") and entry.url != null (
      creditUrl = entry.url.toStr().strip()
    )
    if creditUrl != "" and (!creditUrl.startsWith("https://") and !creditUrl.startsWith("http://")) (
      return refuse(400, "credit URL must use http or https")
    )
    if creditUrl.len > 500 (
      return refuse(400, "credit URL too long")
    )
    if who != "" and who.len <= 60 and role.len <= 120 (
      object credit = {who: who, role: role}
      if creditUrl != "" (
        credit.url = creditUrl
      )
      credits.append(credit)
    )
  )
  project.credits = credits
  return noRefusal()
)

def applyProjectFlags(object project, object body) (
  if body.contains("commentsOff") (
    project.commentsOff = body.commentsOff == true
  )
  if body.contains("remixable") (
    project.remixable = body.remixable != false
  )
  if body.contains("seeInside") (
    project.seeInside = body.seeInside != false
  )
)

def projectSaleRefusal(object body) Refusal (
  if body.contains("price") and (body.price ?? 0).toNum() != 0 (
    return refuseWithBody(400, {ok: false, code: "project_sales_ended", error: "Projects can no longer be sold on MistWarp."})
  )
  return noRefusal()
)

def applyRemixShare(object project, number remixShare) Refusal (
  if remixShare < 0 or remixShare > 50 (
    return refuse(400, "remix share must be between 0 and 50 percent")
  )
  project.remixShare = remixShare
  return noRefusal()
)

def applyTags(object project, object body) Refusal (
  if !body.contains("tags") (
    return noRefusal()
  )
  if typeof(body.tags) != "array" (
    return refuse(400, "tags must be a list")
  )
  array incoming = body.tags.assert(array)
  array tags = []
  for i incoming.len (
    if tags.len < 10 (
      string t = normalizeTag((incoming[i] ?? "").toStr())
      if t != "" and !tags.contains(t) (
        tags.append(t)
      )
    )
  )
  project.tags = tags
  return noRefusal()
)

def applyGameProducts(object project, object body) Refusal (
  if !body.contains("gameProducts") (
    return noRefusal()
  )
  array incomingProducts = body.gameProducts.assertElse(array, [])
  if incomingProducts.len > 50 (
    return refuse(400, "projects can have at most 50 game products")
  )
  array products = []
  array productIds = []
  for i incomingProducts.len (
    object incomingProduct = incomingProducts[i].assertElse(object, {})
    string productId = (incomingProduct.id ?? "").toStr().toLower().strip()
    string productName = (incomingProduct.name ?? "").toStr().strip()
    string productDescription = (incomingProduct.description ?? "").toStr().strip()
    number productPrice = (incomingProduct.price ?? 0).toNum()
    string grantsItem = (incomingProduct.grantsItem ?? "").toStr().toLower().strip()
    string productIcon = (incomingProduct.icon ?? "").toStr().strip()
    if !regex.match("^[a-z0-9_-]{1,40}$", productId) or productIds.contains(productId) (
      return refuse(400, "game product ids must be unique lowercase identifiers")
    )
    if productName.len < 1 or productName.len > 80 or productDescription.len > 300 (
      return refuse(400, "invalid game product name or description")
    )
    if productPrice < 0 or productPrice > 1000 (
      return refuse(400, "game product prices must be between 0 and 1000 credits")
    )
    if productIcon != "" and productIcon.toBytes().len > 100000 (
      return refuse(400, "game product icons must be smaller than 100KB")
    )
    if productIcon != "" and !productIcon.startsWith("data:image/") and !productIcon.startsWith("https://") and !productIcon.startsWith("http://") (
      return refuse(400, "game product icons must be image data URLs or image URLs")
    )
    if grantsItem != "" and !regex.match("^[a-z0-9_-]{1,40}$", grantsItem) (
      return refuse(400, "invalid portable item id on game product")
    )
    productIds.append(productId)
    products.append({id: productId, name: productName, description: productDescription, price: productPrice, grantsItem: grantsItem, icon: productIcon})
  )
  project.gameProducts = products
  return noRefusal()
)

def portableItemVisual(object visual) object (
  string visualType = (visual.type ?? "").toStr().toLower().strip()
  if visualType == "image" (
    string itemImage = (visual.url ?? "").toStr().strip()
    if itemImage.startsWith("data:image/") (
      if itemImage.toBytes().len > 100000 (
        return {error: "portable item images must be smaller than 100KB"}
      )
      return {visual: {type: "image", url: itemImage}}
    )
    if !itemImage.startsWith("https://") or itemImage.len > 500 (
      return {error: "portable item images must use a short HTTPS URL"}
    )
    return {visual: {type: "image", url: itemImage}}
  )
  if visualType == "costume" (
    string assetId = (visual.assetId ?? "").toStr().strip()
    string dataFormat = (visual.dataFormat ?? "").toStr().toLower().strip()
    if !regex.match("^[A-Za-z0-9_-]{8,128}$", assetId) or (dataFormat != "png" and dataFormat != "jpg" and dataFormat != "jpeg" and dataFormat != "svg") (
      return {error: "invalid portable item costume asset"}
    )
    return {visual: {type: "costume", assetId: assetId, dataFormat: dataFormat}}
  )
  return {error: "portable items need an image or costume"}
)

def applyGameItems(object project, object body) Refusal (
  if !body.contains("gameItems") (
    return noRefusal()
  )
  array incomingItems = body.gameItems.assertElse(array, [])
  if incomingItems.len > 100 (
    return refuse(400, "projects can define at most 100 portable items")
  )
  array items = []
  array itemIds = []
  for i incomingItems.len (
    object incomingItem = incomingItems[i].assertElse(object, {})
    string itemId = (incomingItem.id ?? "").toStr().toLower().strip()
    string itemName = (incomingItem.name ?? "").toStr().strip()
    object visual = incomingItem.visual.assertElse(object, {})
    string itemImage = (incomingItem.image ?? "").toStr().strip()
    if visual.getKeys().len == 0 and itemImage != "" (
      visual = {type: "image", url: itemImage}
    )
    if !regex.match("^[a-z0-9_-]{1,40}$", itemId) or itemIds.contains(itemId) (
      return refuse(400, "portable item ids must be unique lowercase identifiers")
    )
    if itemName.len < 1 or itemName.len > 80 (
      return refuse(400, "invalid portable item definition")
    )
    object cleaned = portableItemVisual(visual)
    if cleaned.contains("error") (
      return refuse(400, cleaned.error.toStr())
    )
    itemIds.append(itemId)
    items.append({id: itemId, name: itemName, visual: cleaned.visual, gameAwardable: incomingItem.gameAwardable != false})
  )
  project.gameItems = items
  return noRefusal()
)

def applyInventoryPolicy(object project, object body) Refusal (
  if !body.contains("inventoryPolicy") (
    return noRefusal()
  )
  object incomingPolicy = body.inventoryPolicy.assertElse(object, {})
  string mode = (incomingPolicy.mode ?? "").toStr().toLower().strip()
  if mode != "none" and mode != "allowlist" and mode != "all" (
    return refuse(400, "inventory policy must be none, allowlist, or all")
  )
  array allowedItems = incomingPolicy.allowedItems.assertElse(array, [])
  array allowedProjects = incomingPolicy.allowedProjects.assertElse(array, [])
  if allowedItems.len > 100 or allowedProjects.len > 50 (
    return refuse(400, "portable item allowlist is too large")
  )
  array cleanItems = []
  for i allowedItems.len (
    string globalId = (allowedItems[i] ?? "").toStr().strip()
    if !regex.match("^[A-Za-z0-9_-]{1,80}:[a-z0-9_-]{1,40}$", globalId) (
      return refuse(400, "invalid global portable item id")
    )
    if !cleanItems.contains(globalId) (
      cleanItems.append(globalId)
    )
  )
  array cleanProjects = []
  for i allowedProjects.len (
    string allowedProject = (allowedProjects[i] ?? "").toStr().strip()
    if !isSafePathPart(allowedProject) (
      return refuse(400, "invalid portable item source project")
    )
    if !cleanProjects.contains(allowedProject) (
      cleanProjects.append(allowedProject)
    )
  )
  project.inventoryPolicy = {mode: mode, allowedItems: cleanItems, allowedProjects: cleanProjects}
  return noRefusal()
)

def gameGrantRefusal(object project, object body) Refusal (
  if !body.contains("gameProducts") and !body.contains("gameItems") (
    return noRefusal()
  )
  array configuredProducts = project.gameProducts.assertElse(array, [])
  array configuredItems = project.gameItems.assertElse(array, [])
  array configuredItemIds = []
  for i configuredItems.len (
    configuredItemIds.append(configuredItems[i].assert(object).id.toStr())
  )
  for i configuredProducts.len (
    string grantedItem = configuredProducts[i].assert(object).grantsItem.toStr()
    if grantedItem != "" and !configuredItemIds.contains(grantedItem) (
      return refuse(400, "a game product refers to an undefined portable item")
    )
  )
  return noRefusal()
)

def applyCompatibility(object project, object body) Refusal (
  if !body.contains("compatibility") or body.compatibility == null (
    return noRefusal()
  )
  if typeof(body.compatibility) != "object" (
    return refuse(400, "compatibility must be an object")
  )
  object compatibilityInfo = body.compatibility.assert(object)
  project.compatibility = {
    mobile: compatibilityInfo.contains("mobile") and compatibilityInfo.mobile == true,
    keyboard: compatibilityInfo.contains("keyboard") and compatibilityInfo.keyboard == true,
    controller: compatibilityInfo.contains("controller") and compatibilityInfo.controller == true
  }
  return noRefusal()
)
