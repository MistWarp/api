export {}

object funnelEventVariants = {
  editor_open: [],
  home_view: [],
  project_view: ["signed_in", "signed_out"],
  project_play_start: [],
  start_creating: ["home"],
  signin_prompt_shown: ["remix", "save", "library", "react", "comment", "follow"],
  signin_completed: [],
  signup_completed: [],
  project_created: [],
  project_published: [],
  project_remixed: [],
  contribution_sent: [],
  scratch_import: ["home", "compare"],
  share_opened: ["save", "update", "remix"],
  project_saved: ["cloud", "download"],
  project_edited: [],
  project_run: [],
  project_resumed: [],
  starter_opened: ["clicker", "explorer", "animation"],
  backup_restored: [],
  embed_code_copied: [],
  next_project_click: [],
  related_project_click: [],
  suggested_creator_followed: [],
  community_join_open: [],
  community_join: ["originchats", "discord"]
}

def funnelEventKey(string name, string variant) string (
  string cleanName = name.toLower().strip()
  if !funnelEventVariants.contains(cleanName) (
    return ""
  )
  array variants = funnelEventVariants[cleanName].assert(array)
  string cleanVariant = variant.toLower().strip()
  if cleanVariant != "" and variants.contains(cleanVariant) (
    return cleanName ++ ":" ++ cleanVariant
  )
  return cleanName
)

def isFunnelOrigin(string origin) boolean (
  if origin == "https://mistwarp.org" (
    return true
  )
  if !origin.startsWith("https://") or !origin.endsWith(".mistwarp.org") (
    return false
  )
  string host = origin.replace("https://", "")
  return host.len > 13 and !host.contains("/") and !host.contains(":") and !host.contains("@")
)

def funnelDayKey(number now) string (
  return (now / 86400000).toInt().toStr()
)
