import "std:testing"
import "std:db"
import "std:fs"
import "std:json"
import "std:regex"
import "std:requests"
import "std:serve"
import "std:sync"
import "std:thread"
import "std:url"
import "../http/request-body.osl"
import "./classroom-policy.osl"
import "./classroom-switch-policy.osl"

string dbPath = "/tmp/mistwarp-classroom-switch-" ++ timestamp.toStr() ++ ".db"
*db.DB testDb = db.open(dbPath)
*db.Collection classDocs = testDb.collection("classes")
number maxStandardRequestBytes = 200

def configValue(string name, string fallback) string (
  return ""
)

def usernameForId(string id) string (
  if id == "u_mist" (
    return "mist"
  )
  if id == "u_teen" (
    return "teen"
  )
  return ""
)

def isAdminUser(string username) boolean (
  return username == "mist"
)

object students = {
  mwc_admin: {_id: "mwc_admin", classId: "cls_admin", disabled: false},
  mwc_other: {_id: "mwc_other", classId: "cls_other", disabled: false},
  mwc_off: {_id: "mwc_off", classId: "cls_admin", disabled: true}
}

def loadStudent(string id) object (
  return (students[id] ?? {}).assertElse(object, {})
)

def loadClass(string id) object (
  return (classDocs.findById(id) ?? {})
)

void classDocs.insertOne({_id: "cls_admin", code: "ADMIN234", ownerId: "u_mist", owner: "mist"})
void classDocs.insertOne({_id: "cls_other", code: "OTHER234", ownerId: "u_teen", owner: "teen"})

object claims = {
  ADMINCLAIM: {_id: "ADMINCLAIM", studentId: "mwc_admin"},
  OTHERCLAIM: {_id: "OTHERCLAIM", studentId: "mwc_other"}
}

def loadClassroomClaim(string code) object (
  return (claims[code] ?? {}).assertElse(object, {})
)

array timerRuns = []
def classroomRetentionLoop() (
  timerRuns.append(timestamp)
)

import "./classroom-switch.osl"

testing.assert(!classroomEnabled, "Classroom is off unless the flag is set")

def fakeAuth(*serve.Context c) (
  string who = (c.header("X-Test-User") ?? "")
  c.set("authenticated", who != "")
  c.set("isAdmin", who == "mist")
  c.set("isStudent", who.startsWith("mwc_"))
  c.set("isMinor", who.startsWith("mwc_"))
  c.set("username", who)
  c.set("userId", if who.startsWith("mwc_") then who else "u_" ++ who)
  c.next()
)

def handleState(*serve.Context c) (
  c.json(200, {ok: true, authenticated: contextBool(c, "authenticated"), isStudent: contextBool(c, "isStudent")})
)

def handleLogin(*serve.Context c) (
  object body = requestJSON(c)
  c.json(200, {ok: true, studentId: (body.studentId ?? "").toStr()})
)

*serve.Router app = serve.new()
app.use(fakeAuth)
app.use(classroomSwitchGuard)
app.GET("/v1/me", handleState)
app.GET("/v1/classroom", handleState)
app.GET("/api/classroom", handleState)
app.GET("/v1/classroom/join/:code", handleState)
app.POST("/v1/classroom/login", handleLogin)
app.GET("/v1/classroom/available", handleClassroomAvailable)

array stackRoutes = [
  ["POST", "/v1/classroom/billing/checkout", "Stripe checkout"],
  ["POST", "/v1/classroom/billing/portal", "the Stripe billing portal"],
  ["POST", "/v1/classroom/billing/webhook", "the Stripe webhook"],
  ["POST", "/v1/classroom/trial", "the trial"],
  ["GET", "/v1/classroom/classes/cls_other/groups", "listing groups"],
  ["POST", "/v1/classroom/classes/cls_other/groups", "creating groups"],
  ["DELETE", "/v1/classroom/classes/cls_other/groups/g1", "deleting groups"],
  ["POST", "/v1/classroom/classes/cls_other/students/mwc_other/release", "release links"],
  ["DELETE", "/v1/classroom/classes/cls_other/students/mwc_other/release", "cancelling release links"],
  ["GET", "/v1/classroom/claim/OTHERCLAIM", "the claim page"],
  ["POST", "/v1/classroom/claim/OTHERCLAIM", "claiming"],
  ["GET", "/v1/classroom/school", "the school page"],
  ["GET", "/v1/classroom/school/audit", "the school audit log"],
  ["GET", "/v1/classroom/school/export", "the school download"],
  ["POST", "/v1/classroom/school/teachers", "adding school teachers"],
  ["DELETE", "/v1/classroom/school/teachers/u_x", "removing school teachers"],
  ["PUT", "/v1/classroom/school/teachers/u_x/admin", "school admin changes"],
  ["POST", "/v1/classroom/classes/cls_other/present", "starting present mode"],
  ["DELETE", "/v1/classroom/classes/cls_other/present", "stopping present mode"],
  ["POST", "/v1/classroom/terms/accept", "terms acceptance"],
  ["GET", "/v1/classroom/classes/cls_other/export", "class downloads"],
  ["GET", "/v1/classroom/classes/cls_other/students/mwc_other/export", "student downloads"]
]
for i stackRoutes.len (
  array route = stackRoutes[i].assert(array)
  string method = route[1].toStr()
  string routePath = route[2].toStr().replace("OTHERCLAIM", ":code")
  if method == "GET" (
    app.GET(routePath, handleState)
  ) else if method == "POST" (
    app.POST(routePath, handleState)
  ) else if method == "PUT" (
    app.PUT(routePath, handleState)
  ) else (
    app.DELETE(routePath, handleState)
  )
)

def runApp() (
  app.run(":18341")
)
thread.new(runApp)
string base = "http://127.0.0.1:18341"
for i 50 (
  if requests.get(base ++ "/v1/me").isOk() (
    break
  )
  wait 0.1
)

def call(string method, string path, string who, string body) object (
  object options = {headers: {"X-Test-User": who, "Content-Type": "application/json"}}
  object res = {}
  if method == "POST" (
    options.body = body
    res = requests.post(base ++ path, options).unwrapOr({status: 0, body: ""})
  ) else if method == "PUT" (
    options.body = body
    res = requests.put(base ++ path, options).unwrapOr({status: 0, body: ""})
  ) else if method == "DELETE" (
    res = requests.delete(base ++ path, options).unwrapOr({status: 0, body: ""})
  ) else (
    res = requests.get(base ++ path, options).unwrapOr({status: 0, body: ""})
  )
  object parsed = json.parse((res.body ?? "{}").toStr()) catch (err) (
    return {status: res.status, data: {}}
  )
  return {status: res.status, data: parsed}
)

object r = call("GET", "/v1/classroom", "teen", "")
testing.assert(r.status == 404 and r.data.code == "classroom_unavailable", "teachers who are not admins get 404 while Classroom is off")
testing.assert(call("GET", "/api/classroom", "teen", "").status == 404, "legacy classroom paths are held back too")
testing.assert(call("GET", "/v1/classroom", "", "").status == 404, "signed-out visitors get 404")
testing.assert(call("GET", "/v1/classroom", "mist", "").status == 200, "admins can test Classroom")
testing.assert(call("GET", "/v1/classroom/join/OTHER234", "", "").status == 404, "join codes of other classes are hidden")
testing.assert(call("GET", "/v1/classroom/join/admin-234", "", "").status == 200, "join codes of admin classes still work")
testing.assert(call("GET", "/v1/classroom/join/NOPE2345", "", "").status == 404, "unknown join codes get 404")

r = call("POST", "/v1/classroom/login", "", "{\"studentId\":\"mwc_admin\"}")
testing.assert(r.status == 200 and r.data.studentId == "mwc_admin", "students of admin classes can sign in and the handler still reads the body")
testing.assert(call("POST", "/v1/classroom/login", "", "{\"studentId\":\"mwc_other\"}").status == 404, "students of other classes cannot sign in")
testing.assert(call("POST", "/v1/classroom/login", "", "{\"studentId\":\"mwc_off\"}").status == 404, "disabled students cannot sign in")
testing.assert(call("POST", "/v1/classroom/login", "", "{\"studentId\":\"mwc_admin\",\"pad\":\"" ++ ("x" * 300) ++ "\"}").status == 404, "large login bodies are refused without being read")
testing.assert(call("POST", "/v1/classroom/login", "", "not json").status == 404, "unreadable login bodies get 404")

r = call("GET", "/v1/classroom", "mwc_admin", "")
testing.assert(r.status == 200 and r.data.isStudent == true, "students of admin classes keep their session")
r = call("GET", "/v1/me", "mwc_other", "")
testing.assert(r.status == 200 and r.data.authenticated == false and r.data.isStudent == false, "other students are signed out everywhere")
testing.assert(call("GET", "/v1/classroom", "mwc_other", "").status == 404, "other students get 404 on classroom routes")
r = call("GET", "/v1/me", "mwc_off", "")
testing.assert(r.data.authenticated == false, "disabled students are signed out")
r = call("GET", "/v1/me", "teen", "")
testing.assert(r.status == 200 and r.data.authenticated == true, "other routes are unchanged")

for i stackRoutes.len (
  array route = stackRoutes[i].assert(array)
  string method = route[1].toStr()
  string routePath = route[2].toStr()
  string what = route[3].toStr()
  testing.assert(call(method, routePath, "teen", "{}").status == 404, "while Classroom is off, " ++ what ++ " is hidden from teachers who are not admins")
  testing.assert(call(method, routePath, "", "{}").status == 404, "while Classroom is off, " ++ what ++ " is hidden from signed-out visitors")
  testing.assert(call(method, routePath, "mist", "{}").status == 200, "admins can test " ++ what ++ " while Classroom is off")
)
testing.assert(call("GET", "/v1/classroom/claim/ADMINCLAIM", "", "").status == 200, "release links for students of admin classes still open")
testing.assert(call("POST", "/v1/classroom/claim/ADMINCLAIM", "teen", "{}").status == 200, "a family can redeem a release link from an admin class")
testing.assert(call("GET", "/v1/classroom/claim/NOPECLAIM", "", "").status == 404, "unknown release links get 404")

r = call("GET", "/v1/classroom/available", "teen", "")
testing.assert(r.status == 200 and r.data.available == false, "Classroom is not offered to teachers who are not admins while it is off")
r = call("GET", "/v1/classroom/available", "", "")
testing.assert(r.status == 200 and r.data.available == false, "Classroom is not offered to signed-out visitors while it is off")
r = call("GET", "/v1/classroom/available", "mist", "")
testing.assert(r.status == 200 and r.data.available == true, "admins see Classroom while it is off")

testing.assert(!startClassroomTimers() and timerRuns.len == 0, "the retention sweep does not start while Classroom is off")
testing.assert(!classroomFeatureOpen({_id: "cls_other", ownerId: "u_teen", owner: "teen"}), "classes of other teachers get no Classroom features while it is off")
testing.assert(classroomFeatureOpen({_id: "cls_admin", ownerId: "u_mist", owner: "mist"}), "admin classes keep Classroom features while it is off")

testing.assert(classroomSessionAllowed("u_teen"), "Rotur sessions are always allowed")
testing.assert(classroomSessionAllowed("mwc_admin"), "sessions of students in admin classes are allowed")
testing.assert(!classroomSessionAllowed("mwc_other"), "sessions of other students are refused")
testing.assert(!classroomSessionAllowed("mwc_off"), "sessions of disabled students are refused")
testing.assert(!classroomSessionAllowed("mwc_missing"), "sessions of deleted students are refused")

boolean classroomEnabled = true
testing.assert(call("GET", "/v1/classroom", "teen", "").status == 200, "with the flag on, every teacher can use Classroom")
testing.assert(call("GET", "/v1/classroom/join/OTHER234", "", "").status == 200, "with the flag on, every join code works")
testing.assert(call("POST", "/v1/classroom/login", "", "{\"studentId\":\"mwc_other\"}").status == 200, "with the flag on, every student can sign in")
r = call("GET", "/v1/me", "mwc_other", "")
testing.assert(r.data.authenticated == true and r.data.isStudent == true, "with the flag on, student sessions are left alone")
testing.assert(classroomSessionAllowed("mwc_other"), "with the flag on, student sessions are allowed")
testing.assert(!classroomSessionAllowed("mwc_off"), "disabled students stay refused with the flag on")
r = call("GET", "/v1/classroom/available", "", "")
testing.assert(r.status == 200 and r.data.available == true, "with the flag on, anyone can see that Classroom is available")
testing.assert(call("POST", "/v1/classroom/trial", "teen", "{}").status == 200, "with the flag on, teachers reach the stack's routes")
testing.assert(classroomFeatureOpen({_id: "cls_other", ownerId: "u_teen", owner: "teen"}), "with the flag on, every class gets Classroom features")
testing.assert(startClassroomTimers(), "with the flag on, the retention sweep starts")
for i 50 (
  if timerRuns.len > 0 (
    break
  )
  wait 0.1
)
testing.assert(timerRuns.len == 1, "the retention sweep runs once it is started")

testDb.close()
void fs.remove(dbPath)
