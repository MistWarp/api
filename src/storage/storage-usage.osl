export {
  backfillProjectHistoryBytes,
  backfillReleaseJsonBytes
}

def storedKeyBytes(string key, object inventory) number (
  string path = localBlobPath(key)
  if fs.exists(path) (
    return fs.size(path).unwrapOr(0)
  )
  if inventory.contains(key) (
    return inventory[key].assertElse(object, {}).size.toNum()
  )
  return -1
)

def measuredHistoryBytes(object project, object inventory) number (
  array keys = projectWorkspaceKeys(project)
  number total = 0
  for i keys.len (
    number bytes = storedKeyBytes(keys[i].toStr(), inventory)
    if bytes < 0 (
      return -1
    )
    total += bytes
  )
  return total
)

def backfillLiveProjectHistoryBytes(string id, object inventory) boolean (
  string lockName = "project-history-" ++ id
  sync.lock(lockName)
  defer sync.unlock(lockName)
  auto loaded = loadProject(id)
  if !loaded.ok (
    return true
  )
  object project = loaded.project.assert(object)
  if project.contains("historyBytes") (
    return true
  )
  number bytes = measuredHistoryBytes(project, inventory)
  if bytes < 0 (
    return false
  )
  project.historyBytes = bytes
  boolean saved = saveProject(project)
  if saved (
    upsertIndexEntry(project)
  )
  return saved
)

def backfillTrashedProjectHistoryBytes(string file, object inventory) boolean (
  auto loaded = readFile(trashDir ++ file)
  if !loaded.ok (
    return true
  )
  object project = loaded.data.assert(object)
  if project.contains("historyBytes") (
    return true
  )
  number bytes = measuredHistoryBytes(project, inventory)
  if bytes < 0 (
    return false
  )
  project.historyBytes = bytes
  return writeFile(trashDir ++ file, project)
)

// What R2 holds, by key, with sizes: { ok, objects } (none when blobs are
// only on this machine), or { ok: false, error }.
def storageInventory() object (
  if r2Local (
    return {ok: true, objects: {}}
  )
  object synced = syncR2StorageInventory(true)
  if synced.ok != true (
    return {ok: false, error: (synced.error ?? "R2 inventory unavailable").toStr()}
  )
  auto loaded = readFile(r2StorageIndexFile)
  if !loaded.ok (
    return {ok: true, objects: {}}
  )
  return {ok: true, objects: (loaded.data.assertElse(object, {}).objects ?? {}).assertElse(object, {})}
)

// Projects saved before storage limits have no recorded history size.
// Measure them once from local copies or the R2 inventory.
def backfillProjectHistoryBytes() (
  string migrationId = "migration:project-history-bytes-v1"
  if (diagnosticDocs.findById(migrationId) ?? {}).len > 0 (
    return
  )
  object listing = storageInventory()
  if listing.ok != true (
    log "Storage size backfill skipped: " ++ listing.error.toStr()
    return
  )
  object inventory = listing.objects.assertElse(object, {})
  number unresolved = 0
  array files = fs.readDir(projectsDir).unwrapOr([])
  for i files.len (
    string file = files[i].toStr()
    if file.endsWith(".json") and !backfillLiveProjectHistoryBytes(file.replace(".json", ""), inventory) (
      unresolved += 1
    )
  )
  array trashFiles = fs.readDir(trashDir).unwrapOr([])
  for i trashFiles.len (
    string file = trashFiles[i].toStr()
    if file.endsWith(".json") and !backfillTrashedProjectHistoryBytes(file, inventory) (
      unresolved += 1
    )
  )
  if unresolved > 0 (
    log "Storage size backfill left " ++ unresolved.toStr() ++ " projects without a history size; it will retry on the next start"
    return
  )
  putDocument(diagnosticDocs, migrationId, {_id: migrationId, completedAt: timestamp})
  log "Storage size backfill complete"
)

// Releases made before their snapshot's size was recorded, which counts
// against the owner's Rotur storage. Measured once from local copies or the
// R2 inventory.
def backfillReleaseJsonBytes() boolean (
  string migrationId = "migration:release-json-bytes-v1"
  if (diagnosticDocs.findById(migrationId) ?? {}).len > 0 (
    return true
  )
  object listing = storageInventory()
  if listing.ok != true (
    log "Release size backfill skipped: " ++ listing.error.toStr()
    return false
  )
  object inventory = listing.objects.assertElse(object, {})
  number unresolved = 0
  array releases = releaseDocs.all()
  for i releases.len (
    object release = releases[i].assertElse(object, {})
    string key = (release.jsonKey ?? "").toStr()
    if key != "" and (!release.contains("jsonBytes") or release.jsonBytes == null) (
      number bytes = storedKeyBytes(key, inventory)
      if bytes < 0 (
        unresolved += 1
      ) else (
        release.jsonBytes = bytes
        putDocument(releaseDocs, release["_id"].toStr(), release)
      )
    )
  )
  if unresolved > 0 (
    log "Release size backfill left " ++ unresolved.toStr() ++ " releases without a size; it will retry on the next start"
    return false
  )
  putDocument(diagnosticDocs, migrationId, {_id: migrationId, completedAt: timestamp})
  log "Release size backfill complete"
  return true
)
