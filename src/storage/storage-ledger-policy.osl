export {
  projectStorageSummary
}

array ledgerKinds = ["projects", "assets", "backpack"]

def projectStorageSummary(object project, object assetSizes) object (
  array assets = (project.assets ?? []).assertElse(array, [])
  object jsonBlobs = {}
  string jsonKey = (project.jsonKey ?? "").toStr()
  if jsonKey != "" (
    number jsonBytes = 0
    if project.contains("storedJsonBytes") and project.storedJsonBytes != null (
      jsonBytes = project.storedJsonBytes.toNum()
    ) else (
      number assetBytes = 0
      for i assets.len (
        assetBytes += (assetSizes[assets[i].toStr()] ?? 0).toNum()
      )
      jsonBytes = (project.sizeBytes ?? 0).toNum() - assetBytes
    )
    jsonBlobs[jsonKey] = max(0, jsonBytes)
  )
  object historyBlobs = {}
  array layers = projectWorkspaceKeys(project)
  if layers.len > 0 (
    historyBlobs[layers.join("|")] = max(0, (project.historyBytes ?? 0).toNum())
  )
  return {json: jsonBlobs, history: historyBlobs, assets: assets}
)

def addReleaseBlob(object summary, string key, number bytes) object (
  if key != "" (
    object jsonBlobs = (summary.json ?? {}).assertElse(object, {})
    jsonBlobs[key] = max(bytes, (jsonBlobs[key] ?? 0).toNum())
    summary.json = jsonBlobs
  )
  return summary
)

def storageTotals(array summaries, object assetSizes, array backpack) object (
  object jsonSeen = {}
  object historySeen = {}
  object assetSeen = {}
  number projectBytes = 0
  number assetBytes = 0
  for i summaries.len (
    object summary = summaries[i].assertElse(object, {})
    object jsonBlobs = (summary.json ?? {}).assertElse(object, {})
    for key of jsonBlobs (
      if !jsonSeen.contains(key) (
        jsonSeen[key] = true
        projectBytes += jsonBlobs[key].toNum()
      )
    )
    object historyBlobs = (summary.history ?? {}).assertElse(object, {})
    for key of historyBlobs (
      if !historySeen.contains(key) (
        historySeen[key] = true
        projectBytes += historyBlobs[key].toNum()
      )
    )
    array assets = (summary.assets ?? []).assertElse(array, [])
    for j assets.len (
      string name = assets[j].toStr()
      if !assetSeen.contains(name) (
        assetSeen[name] = true
        assetBytes += (assetSizes[name] ?? 0).toNum()
      )
    )
  )
  object bodySeen = {}
  number backpackBytes = 0
  for i backpack.len (
    object item = backpack[i].assertElse(object, {})
    string key = (item.bodyKey ?? "").toStr()
    if key != "" and !bodySeen.contains(key) (
      bodySeen[key] = true
      backpackBytes += (item.bodyBytes ?? 0).toNum()
    )
  )
  return {projects: projectBytes, assets: assetBytes, backpack: backpackBytes}
)

def ledgerGrowth(object counted, object totals) array (
  array grown = []
  for i ledgerKinds.len (
    string kind = ledgerKinds[i].toStr()
    if (totals[kind] ?? 0).toNum() > (counted[kind] ?? 0).toNum() (
      grown.append(kind)
    )
  )
  return grown
)

def ledgerChanges(object counted, object totals) array (
  array changes = []
  for i ledgerKinds.len (
    string kind = ledgerKinds[i].toStr()
    number want = (totals[kind] ?? 0).toNum()
    boolean listed = counted.contains(kind)
    if (listed and ((counted[kind] ?? 0).toNum() != want or want == 0)) or (!listed and want > 0) (
      changes.append({kind: kind, bytes: want})
    )
  )
  return changes
)
