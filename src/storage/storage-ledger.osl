export {
  ledgerAllowance,
  ledgerFreeAll,
  logLedgerSetup,
  noStorageHold,
  pendingAssetHold,
  projectOwnerId,
  releasePendingAssetHolds,
  storageHold,
  storageHoldRelease,
  storageReport,
  storageSettle,
  storageSettleLoop,
  storageSettleProject,
  storageSettleSoon,
  usesRoturStorage
}

// MistWarp's projects, assets and backpack count against each person's one
// Rotur storage allowance (storage-ledger-policy.osl says what counts). The
// Rotur API keeps the count in its storage ledger:
//
//   - Before something is stored, the kinds it makes bigger are reserved at
//     their new totals (storageHold). The ledger only holds what they grow by,
//     and answers 413 when that doesn't fit. Making things smaller always fits.
//   - Once it's stored, the totals are worked out again from what's really
//     there and the ledger is set to them (storageSettle), committing what was
//     reserved. Deleting, emptying the trash and anything else that only frees
//     space just settles.
//   - Every six hours everyone is settled, which catches anything a settle
//     missed while Rotur couldn't be reached.
//
// When Rotur can't be asked, MistWarp saves anyway rather than lose someone's
// work, and the next settle counts it. Classroom students aren't Rotur
// accounts: their class's plan gives them storage, worked out here as before.
//
// mistwarp-api runs on the same machine as the Rotur API, so it calls it
// directly as the official app "mistwarp" with ROTUR_SERVICE_SECRET.
// ROTUR_LOCAL_API_URL replaces http://127.0.0.1:5602 and has to be a loopback
// address, so the secret never leaves the machine.

string ledgerSecret = configValue("ROTUR_SERVICE_SECRET", "")
string ledgerBaseSetting = configValue("ROTUR_LOCAL_API_URL", "")
number ledgerPendingTtlSeconds = 604800
auto projectStorageSummaries = cache.new({capacity: 200000, ttl: 86400000})
auto storageSettleQueued = cache.new({capacity: 100000, ttl: 60000})

def ledgerBase() string (
  string base = ledgerBaseSetting.strip()
  while base.endsWith("/") (
    base = base.left(base.len - 1)
  )
  if base == "" (
    return "http://127.0.0.1:5602"
  )
  return base
)

// http://127.0.0.1:<port>, http://localhost:<port> or http://[::1]:<port>,
// with nothing after the port.
def ledgerIsLoopback(string base) boolean (
  array prefixes = ["http://127.0.0.1:", "http://localhost:", "http://[::1]:"]
  for i prefixes.len (
    string prefix = prefixes[i].toStr()
    if base.startsWith(prefix) (
      string port = base.right(base.len - prefix.len)
      return port != "" and port.toNum() > 0 and port.toNum().toInt().toStr() == port
    )
  )
  return false
)

def ledgerReady() boolean (
  return ledgerSecret.strip() != "" and ledgerIsLoopback(ledgerBase())
)

def logLedgerSetup() (
  if ledgerSecret.strip() == "" (
    log "WARNING: ROTUR_SERVICE_SECRET isn't set, so MistWarp storage isn't counted against anyone's Rotur storage"
  ) else if !ledgerIsLoopback(ledgerBase()) (
    log "WARNING: ROTUR_LOCAL_API_URL has to be a loopback address such as http://127.0.0.1:5602, so MistWarp storage isn't counted"
  )
)

// Rotur accounts count through the ledger. Students and projects without a
// known Rotur owner don't.
def usesRoturStorage(string userId) boolean (
  return userId != "" and !isStudentUserId(userId)
)

def projectOwnerId(object project) string (
  string ownerId = (project.ownerId ?? "").toStr()
  if ownerId == "" and project.contains("owner") and project.owner != null (
    ownerId = userIdForUsername(project.owner.toStr())
  )
  return ownerId
)

// { status, body }: status 0 when the ledger couldn't be asked at all.
def ledgerCall(string method, string path, object body) object (
  if !ledgerReady() (
    return {status: 0, body: {}}
  )
  object options = {timeout: 10, headers: {
    "Content-Type": "application/json",
    "X-Rotur-Service-Secret": ledgerSecret.strip(),
    "X-Rotur-App": "mistwarp"
  }}
  if body.getKeys().len > 0 (
    options.body = json.stringify(body)
  )
  string target = ledgerBase() ++ path
  object failed = {body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false}
  object resp = {}
  if method == "GET" (
    resp = requests.get(target, options).unwrapOr(failed)
  ) else if method == "POST" (
    resp = requests.post(target, options).unwrapOr(failed)
  ) else (
    resp = requests.delete(target, options).unwrapOr(failed)
  )
  number status = (resp.status ?? 0).toNum().toInt()
  object data = {}
  auto parsed = json.parse((resp.body ?? "").toStr(), {type: "object"})
  if !parsed.isErr() (
    data = parsed.unwrap().assertElse(object, {})
  )
  return {status: status, body: data}
)

// The account's whole Rotur storage: { ok, used, max, available, bytes,
// reserved }, where bytes and reserved are MistWarp's part of it.
def ledgerAllowance(string userId) object (
  object resp = ledgerCall("GET", "/v2/storage-ledger/usage?user_id=" ++ url.escape(userId), {})
  if resp.status != 200 (
    return {ok: false}
  )
  object body = resp.body
  return {
    ok: true,
    used: (body.usage ?? 0).toNum(),
    max: (body.max ?? 0).toNum(),
    available: (body.available ?? 0).toNum(),
    bytes: (body.bytes ?? 0).toNum(),
    reserved: (body.reserved ?? 0).toNum()
  }
)

// What the ledger counts for MistWarp: { ok, objects: {name: bytes} }.
def ledgerCounted(string userId) object (
  object resp = ledgerCall("GET", "/v2/storage-ledger/objects?user_id=" ++ url.escape(userId), {})
  if resp.status != 200 (
    return {ok: false, objects: {}, status: resp.status}
  )
  object objects = {}
  array listed = (resp.body.objects ?? []).assertElse(array, [])
  for i listed.len (
    object entry = listed[i].assertElse(object, {})
    objects[(entry.object ?? "").toStr()] = (entry.bytes ?? 0).toNum()
  )
  return {ok: true, objects: objects}
)

// Holds room for object at bytes. { ok: true }, or { ok: false, status } with
// used, max, available and needed when the allowance is full (413). ttl is
// in seconds, 0 for the ledger's hour.
def ledgerReserve(string userId, string reservation, string objectName, number bytes, number ttl) object (
  object body = {id: reservation, user_id: userId, object: objectName, bytes: bytes}
  if ttl > 0 (
    body.ttl_seconds = ttl
  )
  object resp = ledgerCall("POST", "/v2/storage-ledger/reservations", body)
  if resp.status == 200 or resp.status == 201 (
    return {ok: true, status: resp.status}
  )
  object answer = resp.body
  if resp.status == 413 (
    return {
      ok: false,
      status: 413,
      used: (answer.usage ?? 0).toNum(),
      max: (answer.max ?? 0).toNum(),
      available: (answer.available ?? 0).toNum(),
      needed: (answer.needed ?? 0).toNum()
    }
  )
  if resp.status != 0 (
    log "[ledger] reserving " ++ objectName ++ " for " ++ userId ++ " failed: " ++ resp.status.toStr() ++ " " ++ (answer.code ?? "").toStr()
  )
  return {ok: false, status: resp.status}
)

// Counts a reservation as stored. Sent again, the ledger answers with the
// first commit, so it's tried a few times.
def ledgerCommit(string userId, string reservation, number bytes) boolean (
  for attempt 3 (
    object resp = ledgerCall("POST", "/v2/storage-ledger/reservations/" ++ reservation ++ "/commit", {user_id: userId, bytes: bytes})
    if resp.status == 200 (
      return true
    )
    if resp.status != 0 and resp.status < 500 (
      log "[ledger] committing " ++ reservation ++ " for " ++ userId ++ " failed: " ++ resp.status.toStr() ++ " " ++ (resp.body.code ?? "").toStr()
      return false
    )
    if !ledgerReady() (
      return false
    )
    wait 0.5
  )
  log "[ledger] couldn't reach Rotur to commit " ++ reservation ++ " for " ++ userId
  return false
)

// Gives a reservation back. One that isn't released expires on its own.
def ledgerRelease(string userId, string reservation) (
  object resp = ledgerCall("DELETE", "/v2/storage-ledger/reservations/" ++ reservation ++ "?user_id=" ++ url.escape(userId), {})
  if resp.status != 200 and resp.status != 0 (
    log "[ledger] releasing " ++ reservation ++ " for " ++ userId ++ " failed: " ++ resp.status.toStr()
  )
)

def ledgerRemove(string userId, object body) boolean (
  body.user_id = userId
  for attempt 3 (
    object resp = ledgerCall("POST", "/v2/storage-ledger/objects/remove", body)
    // A deleted account's ledger went with it.
    if resp.status == 200 or (resp.status == 404 and (resp.body.code ?? "").toStr() == "account_not_found") (
      return true
    )
    if resp.status != 0 and resp.status < 500 (
      log "[ledger] freeing storage for " ++ userId ++ " failed: " ++ resp.status.toStr() ++ " " ++ (resp.body.code ?? "").toStr()
      return false
    )
    if !ledgerReady() (
      return false
    )
    wait 0.5
  )
  log "[ledger] couldn't reach Rotur to free storage for " ++ userId ++ "; the next settle will"
  return false
)

// Frees everything MistWarp counted for an account, when it's deleted.
def ledgerFreeAll(string userId) boolean (
  if !usesRoturStorage(userId) (
    return true
  )
  return ledgerRemove(userId, {all: true})
)

// ---------- What someone stores ----------

// A project file's summary, kept while the file is unchanged, with whose it
// is: { ownerId, owner, id, summary }.
def storedProjectSummary(string path, object assetSizes) object (
  if !fs.exists(path) (
    return {}
  )
  object stat = fs.stat(path)
  string stamp = (stat.modTime ?? 0).toStr() ++ ":" ++ (stat.size ?? 0).toStr()
  if projectStorageSummaries.has(path) (
    object cached = projectStorageSummaries.get(path).assertElse(object, {})
    if (cached.stamp ?? "").toStr() == stamp (
      return cached
    )
  )
  auto loaded = readFile(path)
  if !loaded.ok (
    return {}
  )
  object project = loaded.data.assertElse(object, {})
  object entry = {
    stamp: stamp,
    id: (project.id ?? "").toStr(),
    ownerId: projectOwnerId(project),
    owner: (project.owner ?? "").toStr(),
    summary: projectStorageSummary(project, assetSizes)
  }
  projectStorageSummaries.set(path, entry)
  return entry
)

def storedFor(object stored, string userId, string username) boolean (
  if stored.len == 0 (
    return false
  )
  string storedId = (stored.ownerId ?? "").toStr()
  if storedId != "" (
    return storedId == userId
  )
  return username != "" and normalizeUsername((stored.owner ?? "").toStr()) == normalizeUsername(username)
)

// The project.json snapshots a project's releases keep.
def addReleaseBlobs(string projectId, object summary) object (
  array releases = releaseDocs.where("projectId", "==", projectId).all()
  for i releases.len (
    object release = releases[i].assertElse(object, {})
    string key = (release.jsonKey ?? "").toStr()
    if key != "" (
      summary = addReleaseBlob(summary, key, releaseJsonBytes(release, summary))
    ) else (
      string legacyPath = releasesDir ++ (release["_id"] ?? "").toStr().replace(":", "-") ++ ".json"
      if fs.exists(legacyPath) (
        summary = addReleaseBlob(summary, "release:" ++ (release["_id"] ?? "").toStr(), fs.size(legacyPath).unwrapOr(0))
      )
    )
  )
  return summary
)

// A release's snapshot size: recorded when it was made, or the project's own
// when it's the same snapshot, or the copy on this machine.
def releaseJsonBytes(object release, object summary) number (
  if release.contains("jsonBytes") and release.jsonBytes != null (
    return release.jsonBytes.toNum()
  )
  string key = (release.jsonKey ?? "").toStr()
  object jsonBlobs = (summary.json ?? {}).assertElse(object, {})
  if jsonBlobs.contains(key) (
    return jsonBlobs[key].toNum()
  )
  string path = localBlobPath(key)
  if fs.exists(path) (
    return fs.size(path).unwrapOr(0)
  )
  return 0
)

// One person's totals. changes.projects swaps in summaries by project id,
// for a project about to be saved, and changes.backpack adds backpack items
// about to be stored.
def ownerStorageTotals(string userId, object changes) object (
  object assetSizes = loadAssetsIndex().assets.assertElse(object, {})
  string username = usernameForId(userId)
  object byId = {}
  array entries = projectSearchDocs.where("ownerId", "==", userId).all()
  if username != "" (
    entries ++= ownerIndexEntries(username, true)
  )
  for i entries.len (
    string id = (entries[i].assertElse(object, {}).id ?? "").toStr()
    if isSafePathPart(id) and !byId.contains(id) (
      object stored = storedProjectSummary(projectsDir ++ id ++ ".json", assetSizes)
      if storedFor(stored, userId, username) (
        byId[id] = stored.summary
      )
    )
  )
  array trashFiles = fs.readDir(trashDir).unwrapOr([])
  for i trashFiles.len (
    string file = trashFiles[i].toStr()
    if file.endsWith(".json") (
      object stored = storedProjectSummary(trashDir ++ file, assetSizes)
      if storedFor(stored, userId, username) (
        byId[stored.id.toStr()] = stored.summary
      )
    )
  )
  object swapped = (changes.projects ?? {}).assertElse(object, {})
  for id of swapped (
    byId[id] = swapped[id]
  )
  array summaries = []
  for id of byId (
    summaries.append(addReleaseBlobs(id, byId[id].assertElse(object, {})))
  )
  array backpack = loadBackpackItems(userId)
  backpack ++= (changes.backpack ?? []).assertElse(array, [])
  return storageTotals(summaries, assetSizes, backpack)
)

// Everyone's totals at once, for the storage report and the six-hourly
// settle: { userId: totals } for every Rotur account with anything stored.
def everyoneStorageTotals() object (
  object assetSizes = loadAssetsIndex().assets.assertElse(object, {})
  object summariesByOwner = {}
  array directories = [projectsDir, trashDir]
  for d directories.len (
    string directory = directories[d].toStr()
    array files = fs.readDir(directory).unwrapOr([])
    for i files.len (
      string file = files[i].toStr()
      if file.endsWith(".json") (
        object stored = storedProjectSummary(directory ++ file, assetSizes)
        string ownerId = (stored.ownerId ?? "").toStr()
        if stored.len > 0 and usesRoturStorage(ownerId) (
          if !summariesByOwner.contains(ownerId) (
            summariesByOwner[ownerId] = {}
          )
          object owned = summariesByOwner[ownerId].assertElse(object, {})
          owned[stored.id.toStr()] = stored.summary
          summariesByOwner[ownerId] = owned
        )
      )
    )
  )
  array people = summariesByOwner.getKeys()
  array known = loadUserIds().users.assertElse(object, {}).getKeys()
  for i known.len (
    string userId = known[i].toStr()
    if usesRoturStorage(userId) and !people.contains(userId) (
      people.append(userId)
    )
  )
  object totals = {}
  for i people.len (
    string userId = people[i].toStr()
    object owned = (summariesByOwner[userId] ?? {}).assertElse(object, {})
    array summaries = []
    for id of owned (
      summaries.append(addReleaseBlobs(id, owned[id].assertElse(object, {})))
    )
    object mine = storageTotals(summaries, assetSizes, loadBackpackItems(userId))
    if mine.projects.toNum() + mine.assets.toNum() + mine.backpack.toNum() > 0 (
      totals[userId] = mine
    )
  )
  return totals
)

// ---------- Holding and settling ----------

def noStorageHold() object (
  return {ok: true, reservations: []}
)

// Reserves what a change would add for userId. { ok: true, reservations },
// or { ok: false, refusal } when their Rotur storage is full and enforce is
// set. Without enforce (admins), a full allowance doesn't stop the change.
def storageHold(string userId, object changes, boolean enforce) object (
  if !usesRoturStorage(userId) or !ledgerReady() (
    return noStorageHold()
  )
  object listed = ledgerCounted(userId)
  if !listed.ok (
    if listed.status != 0 (
      log "[ledger] couldn't read what's counted for " ++ userId ++ ": " ++ listed.status.toStr()
    )
    return noStorageHold()
  )
  object totals = ownerStorageTotals(userId, changes)
  array grown = ledgerGrowth(listed.objects, totals)
  array reservations = []
  for i grown.len (
    string kind = grown[i].toStr()
    string id = "hold-" ++ randomString(20) ++ "-" ++ kind
    number bytes = totals[kind].toNum()
    object held = ledgerReserve(userId, id, kind, bytes, 0)
    if held.ok (
      reservations.append({id: id, kind: kind, bytes: bytes})
    ) else if held.status == 413 and enforce (
      for j reservations.len (
        ledgerRelease(userId, reservations[j].assertElse(object, {}).id.toStr())
      )
      return {ok: false, refusal: held}
    )
  )
  return {ok: true, reservations: reservations}
)

def storageHoldRelease(string userId, object hold) (
  array reservations = (hold.reservations ?? []).assertElse(array, [])
  for i reservations.len (
    ledgerRelease(userId, reservations[i].assertElse(object, {}).id.toStr())
  )
)

// Sets the ledger to what userId really stores now, committing hold.
def storageSettle(string userId, object hold) (
  if !usesRoturStorage(userId) or !ledgerReady() (
    return
  )
  string lockName = "storage-ledger-" ++ userId
  sync.lock(lockName)
  defer sync.unlock(lockName)
  object totals = ownerStorageTotals(userId, {})
  settleTotalsLocked(userId, totals, hold)
)

def settleTotalsLocked(string userId, object totals, object hold) (
  object listed = ledgerCounted(userId)
  if !listed.ok (
    // What was reserved expires, and the six-hourly settle counts it.
    return
  )
  object counted = listed.objects
  array reservations = (hold.reservations ?? []).assertElse(array, [])
  for i reservations.len (
    object reservation = reservations[i].assertElse(object, {})
    string kind = reservation.kind.toStr()
    number bytes = min(totals[kind].toNum(), reservation.bytes.toNum())
    if bytes > 0 and ledgerCommit(userId, reservation.id.toStr(), bytes) (
      counted[kind] = bytes
    ) else (
      ledgerRelease(userId, reservation.id.toStr())
    )
  )
  array changes = ledgerChanges(counted, totals)
  for i changes.len (
    object change = changes[i].assertElse(object, {})
    string kind = change.kind.toStr()
    number bytes = change.bytes.toNum()
    if bytes == 0 (
      void ledgerRemove(userId, {objects: [kind]})
    ) else (
      string id = "settle-" ++ randomString(20) ++ "-" ++ kind
      object held = ledgerReserve(userId, id, kind, bytes, 0)
      if held.ok (
        void ledgerCommit(userId, id, bytes)
      ) else if held.status == 413 (
        // Over their allowance: they keep what they have, uncounted past it,
        // and can't add more until they're under it.
        log "[ledger] " ++ userId ++ " stores more than their Rotur storage allows; " ++ kind ++ " stays at what was counted"
      )
    )
  )
)

// Settles userId shortly, once however many changes arrive meanwhile, for
// changes that only free space.
def storageSettleSoon(string userId) (
  if !usesRoturStorage(userId) or !ledgerReady() (
    return
  )
  if !queueStorageSettleLocked(userId) (
    thread.new(settleQueued, userId)
  )
)

def queueStorageSettleLocked(string userId) boolean (
  sync.lock("storage-settle-queue")
  defer sync.unlock("storage-settle-queue")
  boolean queued = storageSettleQueued.has(userId)
  if !queued (
    storageSettleQueued.set(userId, true)
  )
  return queued
)

def settleQueued(string userId) (
  wait 2
  forgetStorageSettleLocked(userId)
  storageSettle(userId, noStorageHold())
)

def forgetStorageSettleLocked(string userId) (
  sync.lock("storage-settle-queue")
  defer sync.unlock("storage-settle-queue")
  storageSettleQueued.delete(userId)
)

def storageSettleProject(object project) (
  storageSettleSoon(projectOwnerId(project))
)

def settleEveryoneOnce() number (
  if !ledgerReady() (
    return 0
  )
  object totals = everyoneStorageTotals()
  object zero = {projects: 0, assets: 0, backpack: 0}
  array people = totals.getKeys()
  array known = loadUserIds().users.assertElse(object, {}).getKeys()
  for i known.len (
    if !people.contains(known[i].toStr()) (
      people.append(known[i].toStr())
    )
  )
  number settled = 0
  for i people.len (
    string userId = people[i].toStr()
    if usesRoturStorage(userId) and settleChangedLocked(userId, (totals[userId] ?? zero).assertElse(object, zero)) (
      settled += 1
    )
  )
  return settled
)

def settleChangedLocked(string userId, object mine) boolean (
  string lockName = "storage-ledger-" ++ userId
  sync.lock(lockName)
  defer sync.unlock(lockName)
  object listed = ledgerCounted(userId)
  if listed.ok and ledgerChanges(listed.objects, mine).len > 0 (
    settleTotalsLocked(userId, ownerStorageTotals(userId, {}), noStorageHold())
    return true
  )
  return false
)

def storageSettleLoop() (
  wait 120
  while true (
    result pass = try(settleEveryoneOnce())
    if pass.isErr() (
      log "[ledger] settling everyone failed: " ++ pass.unwrapErr().toStr()
    ) else if pass.unwrap() > 0 (
      log "[ledger] brought " ++ pass.unwrap().toStr() ++ " people's Rotur storage in line with what MistWarp stores"
    )
    wait 21600
  )
)

// ---------- Files uploaded ahead of a save ----------

// An asset uploaded before the project that uses it is saved holds room for
// up to a week, released when the project is saved.
def pendingAssetHold(string ownerId, string username, string name, number bytes, boolean enforce) object (
  object held = ledgerReserve(ownerId, "pending-" ++ name, "pending-" ++ name, bytes, ledgerPendingTtlSeconds)
  if !held.ok and held.status == 413 and enforce (
    return {ok: false, refusal: held}
  )
  if held.ok (
    recordPendingAssetLocked(username, name, bytes)
  )
  return {ok: true}
)

def recordPendingAssetLocked(string username, string name, number bytes) (
  string lockName = "upload-quota-" ++ normalizeUsername(username)
  sync.lock(lockName)
  defer sync.unlock(lockName)
  array events = pendingUploadEvents(username)
  events.append({t: timestamp, bytes: bytes, name: name})
  writeFile(quotaPath(username), {pending: events})
)

// Releases the holds of assets a save now counts, or that failed to upload.
def releasePendingAssetHolds(string ownerId, string username, array names) (
  if names.len == 0 (
    return
  )
  array releasing = forgetPendingAssetsLocked(username, names)
  for i releasing.len (
    ledgerRelease(ownerId, "pending-" ++ releasing[i].toStr())
  )
)

def forgetPendingAssetsLocked(string username, array names) array (
  string lockName = "upload-quota-" ++ normalizeUsername(username)
  sync.lock(lockName)
  defer sync.unlock(lockName)
  array events = pendingUploadEvents(username)
  object wanted = {}
  for i names.len (
    wanted[names[i].toStr()] = true
  )
  array releasing = []
  for i events.len (
    string name = (events[i].assertElse(object, {}).name ?? "").toStr()
    if wanted.contains(name) and !releasing.contains(name) (
      releasing.append(name)
    )
  )
  if releasing.len > 0 (
    writeFile(quotaPath(username), {pending: quotaWithoutNames(events, releasing, timestamp, quotaWindowMs)})
  )
  return releasing
)

// ---------- Backfill ----------

// What MistWarp stores for everyone, for the Rotur API's one-off
// `claw storage-backfill`: { service, accounts: { id: { kind: bytes } } }.
def storageReport() object (
  object totals = everyoneStorageTotals()
  object accounts = {}
  for userId of totals (
    object mine = totals[userId].assertElse(object, {})
    object objects = {}
    for i ledgerKinds.len (
      string kind = ledgerKinds[i].toStr()
      if (mine[kind] ?? 0).toNum() > 0 (
        objects[kind] = mine[kind].toNum()
      )
    )
    accounts[userId] = objects
  )
  return {service: "mistwarp", accounts: accounts}
)
