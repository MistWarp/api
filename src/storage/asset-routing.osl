def assetUrlForLocation(string name, boolean localExists, string localAssetsBase, string r2PublicBase) string (
  if localExists or r2PublicBase == "" (
    return localAssetsBase ++ "/" ++ name
  )
  return r2PublicBase ++ "/assets/" ++ name
)

def removeLocalAssetAfterUpload(string path, boolean uploadedToR2) boolean (
  if uploadedToR2 and fs.exists(path) (
    return fs.remove(path)
  )
  return true
)

def assetNeedsUpload(boolean known, boolean localExists, boolean remoteConfigured) boolean (
  return !known or (remoteConfigured and localExists)
)
