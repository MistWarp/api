def lockIsFree(string lockName) boolean (
  boolean free = thread.new(def() -> (
    boolean taken = sync.tryLock(lockName)
    if taken (
      sync.unlock(lockName)
    )
    return taken
  )).wait()
  return free
)

import "./backpack.osl"

string backpackLock = backpackLockName("u_sam")
void saveBackpackItems("u_sam", [{id: "b1", type: "costume", name: "Cat", bodyKey: "backpack/x/body.svg", bodyBytes: 5, thumbnailKey: "", thumbnailBytes: 0}])
testing.assert(renameBackpackItemLocked("u_sam", "b1", "Dog").saved == true and loadBackpackItems("u_sam")[1].name == "Dog" and lockIsFree(backpackLock), "an item is renamed and the backpack lock released")
failing = true
testing.assert(try(renameBackpackItemLocked("u_sam", "b1", "Fox")).isErr() and lockIsFree(backpackLock), "the backpack lock is released when renaming throws")
testing.assert(try(deleteBackpackItems("u_sam", ["b1"])).isErr() and lockIsFree(backpackLock), "the backpack lock is released when deleting throws")
def purgeThrows() boolean (
  purgeBackpackForUser("u_sam")
  return true
)
testing.assert(try(purgeThrows()).isErr() and lockIsFree(backpackLock), "the backpack lock is released when purging throws")
failing = false
testing.assert(deleteBackpackItems("u_sam", ["b1"]).deleted == 1 and loadBackpackItems("u_sam").len == 0 and lockIsFree(backpackLock), "the backpack works again after a failure")

*serve.Router app = serve.new()
app.POST("/backpack", handleCreateBackpackItem)
app.GET("/ready", def(*serve.Context c) -> (
  c.json(200, {ok: true})
))
def runApp() (
  app.run(":18354")
)
thread.new(runApp)
string base = "http://127.0.0.1:18354"
for i 50 (
  if requests.get(base ++ "/ready").isOk() (
    break
  )
  wait 0.1
)
string boundary = "smokeboundary"
def formPart(string name, string value) string (
  return "--" ++ boundary ++ "\r\nContent-Disposition: form-data; name=\"" ++ name ++ "\"\r\n\r\n" ++ value ++ "\r\n"
)
string form = formPart("type", "costume") ++ formPart("mime", "image/svg+xml") ++ formPart("name", "Cat") ++ "--" ++ boundary ++ "\r\nContent-Disposition: form-data; name=\"body\"; filename=\"body.svg\"\r\nContent-Type: image/svg+xml\r\n\r\n<svg/>\r\n--" ++ boundary ++ "--\r\n"
object formOptions = {body: form, headers: {"Content-Type": "multipart/form-data; boundary=" ++ boundary}}

failing = true
number failedStatus = requests.post(base ++ "/backpack", formOptions).unwrapOr({status: 0}).status.toNum()
testing.assert(failedStatus >= 500, "a failure while adding an item is a server error")
testing.assert(lockIsFree("upload-quota-sam") and lockIsFree(backpackLock), "the quota and backpack locks are both released when adding an item throws")
failing = false
number addedStatus = requests.post(base ++ "/backpack", formOptions).unwrapOr({status: 0}).status.toNum()
testing.assert(addedStatus == 200 and loadBackpackItems("u_sam").len == 1 and lockIsFree("upload-quota-sam") and lockIsFree(backpackLock), "items can be added again after a failure")
