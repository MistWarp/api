boolean failing = false
object written = {}
def readFile(string path) object (
  if failing (
    throw "IOError: disk gone"
  )
  if written.contains(path) (
    return {ok: true, data: written[path]}
  )
  return {ok: false}
)
def writeFile(string path, object data) boolean (
  written[path] = data
  return true
)
def normalizeUsername(string username) string (
  return username.toLower().strip()
)
