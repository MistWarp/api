// The accounting works in a folder of its own.
string work = "/tmp/mistwarp-storage-ledger-" ++ timestamp.toStr()
void fs.mkdir(work, {recursive: true})
string projectsDir = work ++ "/projects/"
string trashDir = work ++ "/trash/"
string releasesDir = work ++ "/releases/"
string quotaDir = work ++ "/quota/"
void fs.mkdir(projectsDir, {recursive: true})
void fs.mkdir(trashDir, {recursive: true})
void fs.mkdir(quotaDir, {recursive: true})
number quotaWindowMs = 604800000

*db.DB testDb = db.open(work ++ "/community.db")
*db.Collection projectSearchDocs = testDb.collection("project_search")
*db.Collection releaseDocs = testDb.collection("releases")

string secret = "s" * 40
def configValue(string name, string fallback) string (
  return fallback
)

object assetIndex = {assets: {}}
object backpacks = {}
object userNames = {"u-ana": "ana", "u-bea": "bea", "u-cy": "cy"}

def isStudentUserId(string userId) boolean (
  return userId.startsWith("mwc_")
)

def usernameForId(string userId) string (
  return (userNames[userId] ?? "").toStr()
)

def userIdForUsername(string username) string (
  for id of userNames (
    if userNames[id].toStr() == username.toLower() (
      return id
    )
  )
  return ""
)

def ownerIndexEntries(string username, boolean includeUnshared) array (
  array found = projectSearchDocs.where("ownerKey", "==", username.toLower()).all()
  return found
)

def loadAssetsIndex() object (
  return assetIndex
)

def loadBackpackItems(string userId) array (
  return (backpacks[userId] ?? []).assertElse(array, [])
)

def loadUserIds() object (
  return {users: userNames}
)

def localBlobPath(string key) string (
  return work ++ "/blobs/" ++ key
)

def readFile(string path) object (
  if !fs.exists(path) (
    return {ok: false}
  )
  auto parsed = json.parse(fs.readFile(path).unwrapOr(""), {type: "object"})
  if parsed.isErr() (
    return {ok: false}
  )
  return {ok: true, data: parsed.unwrap()}
)

def writeFile(string path, object data) boolean (
  return fs.writeFile(path, json.stringify(data))
)

def quotaPath(string username) string (
  return quotaDir ++ username.toLower() ++ ".json"
)

def pendingUploadEvents(string username) array (
  auto res = readFile(quotaPath(username))
  if !res.ok (
    return []
  )
  return quotaPruneEvents((res.data.assertElse(object, {}).pending ?? []).assertElse(array, []), timestamp, quotaWindowMs)
)

import "../core/utils.osl"
import "./storage-addressing.osl"
import "./quota-policy.osl"
import "./storage-ledger-policy.osl"
import "./storage-ledger.osl"

testing.assert(ledgerIsLoopback("http://127.0.0.1:5602"), "loopback")
testing.assert(ledgerIsLoopback("http://localhost:18760"), "localhost")
testing.assert(ledgerIsLoopback("http://[::1]:5602"), "IPv6 loopback")
testing.assert(!ledgerIsLoopback("https://api.rotur.dev"), "the public API")
testing.assert(!ledgerIsLoopback("http://127.0.0.1:5602/v2"), "a path after the port")
testing.assert(!ledgerIsLoopback("http://127.0.0.1.example.com:80"), "a host that only starts like loopback")
testing.assert(!ledgerReady(), "without the service secret, nothing is counted")
testing.equal(storageHold("u-ana", {}, true), {ok: true, reservations: []}, "and nothing is refused")
testing.assert(usesRoturStorage("u-ana") and !usesRoturStorage("mwc_123") and !usesRoturStorage(""), "students and unknown owners aren't Rotur accounts")

// ---------- A stand-in for the Rotur API's storage ledger ----------

object stub = {max: 0, failing: false, calls: 0, lastApp: ""}
object stubObjects = {}
object stubReservations = {}

def stubKey(string userId, string name) string (
  return userId ++ "/" ++ name
)

def stubUsed(string userId) number (
  number used = 0
  for key of stubObjects (
    if key.startsWith(userId ++ "/") (
      used += stubObjects[key].toNum()
    )
  )
  for id of stubReservations (
    object r = stubReservations[id].assertElse(object, {})
    if r.user.toStr() == userId (
      used += r.held.toNum()
    )
  )
  return used
)

def stubAllowed(*serve.Context c) boolean (
  stub.calls = stub.calls.toNum() + 1
  stub.lastApp = (c.header("X-Rotur-App") ?? "").toStr()
  if stub.failing == true (
    c.json(500, {error: "down"})
    return false
  )
  if (c.header("X-Rotur-Service-Secret") ?? "").toStr() != secret or stub.lastApp != "mistwarp" (
    c.json(403, {code: "not_a_service"})
    return false
  )
  return true
)

*serve.Router fakeLedger = serve.new()
fakeLedger.get("/v2/storage-ledger/usage", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  string userId = (c.query("user_id") ?? "").toStr()
  number used = stubUsed(userId)
  number top = stub.max.toNum()
  c.json(200, {usage: used, max: top, available: max(0, top - used), bytes: used, reserved: 0})
))
fakeLedger.get("/v2/storage-ledger/objects", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  string userId = (c.query("user_id") ?? "").toStr()
  array listed = []
  for key of stubObjects (
    if key.startsWith(userId ++ "/") (
      listed.append({object: key.right(key.len - userId.len - 1), bytes: stubObjects[key]})
    )
  )
  c.json(200, {objects: listed})
))
fakeLedger.post("/v2/storage-ledger/reservations", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  object body = c.bodyJSON()
  string userId = body.user_id.toStr()
  string id = body.id.toStr()
  string name = body.object.toStr()
  number size = body.bytes.toNum()
  if stubReservations.contains(id) (
    c.json(200, {id: id})
    return
  )
  number held = max(0, size - (stubObjects[stubKey(userId, name)] ?? 0).toNum())
  number used = stubUsed(userId)
  number top = stub.max.toNum()
  if held > 0 and used + held > top (
    c.json(413, {code: "storage_full", usage: used, max: top, available: max(0, top - used), needed: held})
    return
  )
  stubReservations[id] = {user: userId, object: name, bytes: size, held: held, ttl: (body.ttl_seconds ?? 0).toNum()}
  c.json(201, {id: id})
))
fakeLedger.post("/v2/storage-ledger/reservations/:id/commit", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  string id = c.param("id")
  if !stubReservations.contains(id) (
    c.json(404, {code: "reservation_not_found"})
    return
  )
  object r = stubReservations[id].assertElse(object, {})
  number size = c.bodyJSON().bytes.toNum()
  if size > r.bytes.toNum() (
    c.json(400, {code: "invalid_bytes"})
    return
  )
  stubReservations.delete(id)
  stubObjects[stubKey(r.user.toStr(), r.object.toStr())] = size
  c.json(200, {id: id, bytes: size})
))
fakeLedger.delete("/v2/storage-ledger/reservations/:id", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  stubReservations.delete(c.param("id"))
  c.json(200, {released: true})
))
fakeLedger.post("/v2/storage-ledger/objects/remove", def(*serve.Context c) -> (
  if !stubAllowed(c) return
  object body = c.bodyJSON()
  string userId = body.user_id.toStr()
  number removed = 0
  for key in stubObjects.getKeys() (
    string k = key.toStr()
    string name = k.right(k.len - userId.len - 1)
    if k.startsWith(userId ++ "/") and (body.all == true or (body.objects ?? []).assertElse(array, []).contains(name)) (
      stubObjects.delete(k)
      removed += 1
    )
  )
  c.json(200, {removed: removed})
))
thread.new(def() -> (
  fakeLedger.run("127.0.0.1:18761")
))
wait 0.3
string ledgerSecret = secret
string ledgerBaseSetting = "http://127.0.0.1:18761/"
testing.assert(ledgerReady(), "with the secret and a loopback address, storage counts")

def countedFor(string userId) object (
  object out = {}
  for key of stubObjects (
    if key.startsWith(userId ++ "/") (
      out[key.right(key.len - userId.len - 1)] = stubObjects[key]
    )
  )
  return out
)

def heldFor(string userId) array (
  array out = []
  for id of stubReservations (
    if stubReservations[id].assertElse(object, {}).user.toStr() == userId (
      out.append(id)
    )
  )
  return out
)

def putProject(string dir, object project) (
  void fs.writeFile(dir ++ project.id.toStr() ++ ".json", json.stringify(project))
  if dir == projectsDir (
    void projectSearchDocs.insertOne({_id: project.id, id: project.id, ownerId: project.ownerId ?? "", ownerKey: (project.owner ?? "").toStr().toLower()})
  )
)

// ---------- What Ana stores ----------

string a1 = "a" * 32 ++ ".png"
string a2 = "b" * 32 ++ ".wav"
string a3 = "c" * 32 ++ ".svg"
assetIndex.assets = {}
assetIndex.assets[a1] = 1000
assetIndex.assets[a2] = 20000
assetIndex.assets[a3] = 300

putProject(projectsDir, {
  id: "p1", owner: "ana", ownerId: "u-ana",
  jsonKey: "project-json/j1.json.gz", storedJsonBytes: 500,
  workspaceKey: "project-workspaces/h1.mwp", workspaceLayers: ["project-workspaces/h1.mwp"], historyBytes: 4000,
  assets: [a1, a2]
})
// Her untouched remix of it shares its project.json and assets.
putProject(projectsDir, {
  id: "p2", owner: "ana", ownerId: "u-ana", remixParent: "p1", inheritedJson: true,
  jsonKey: "project-json/j1.json.gz", storedJsonBytes: 500,
  workspaceLayers: ["project-workspaces/h2.mwp"], historyBytes: 3000,
  assets: [a1, a2]
})
// An older project from before ownerIds, in the trash.
putProject(trashDir, {
  id: "p3", owner: "Ana",
  jsonKey: "projects/p3/project.json", sizeBytes: 1300,
  assets: [a3]
})
// Bea's project uses one of the same assets; that counts for her too.
putProject(projectsDir, {
  id: "p4", owner: "bea", ownerId: "u-bea",
  jsonKey: "project-json/j4.json.gz", storedJsonBytes: 70,
  assets: [a1]
})
// A release keeps p1's previous project.json.
void releaseDocs.insertOne({_id: "p1:r1", projectId: "p1", jsonKey: "project-json/j0.json.gz", jsonBytes: 450})
backpacks["u-ana"] = [{bodyKey: "backpack/x/body.png", bodyBytes: 800, thumbnailKey: "backpack/x/thumbnail.png", thumbnailBytes: 90}]

object anaTotals = ownerStorageTotals("u-ana", {})
testing.equal(anaTotals.projects, 500 + 4000 + 3000 + 1000 + 450, "each project.json and history once, plus the release's")
testing.equal(anaTotals.assets, 21300, "assets shared between her projects count once")
testing.equal(anaTotals.backpack, 800, "the backpack item, not its preview")

object report = storageReport()
testing.equal(report.service, "mistwarp")
testing.equal(report.accounts["u-ana"], {projects: 8950, assets: 21300, backpack: 800}, "the report has what she stores")
testing.equal(report.accounts["u-bea"], {projects: 70, assets: 1000}, "and Bea's, with her own copy of the shared asset")
testing.assert(!report.accounts.assertElse(object, {}).contains("u-cy"), "someone who stores nothing isn't in it")

// ---------- Settling sets the ledger to what's stored ----------

stub.max = 100000
storageSettle("u-ana", noStorageHold())
testing.equal(countedFor("u-ana"), {projects: 8950, assets: 21300, backpack: 800}, "settling counts what she stores")
testing.equal(stub.lastApp, "mistwarp", "MistWarp calls as itself")
number before = stub.calls.toNum()
storageSettle("u-ana", noStorageHold())
testing.equal(stub.calls.toNum() - before, 1, "settling again only asks what's counted")

// ---------- A save holds what it adds ----------

object grown = projectStorageSummary(readFile(projectsDir ++ "p1.json").data.assertElse(object, {}), assetIndex.assets)
grown.json = {"incoming:p1": 600}
grown.assets = [a1, a2, a3]
object saving = {p1: grown}
object hold = storageHold("u-ana", {projects: saving}, true)
testing.assert(hold.ok, "a save with room is held")
testing.equal(hold.reservations.len, 1, "only the kind that grows")
testing.equal(hold.reservations[1].kind, "projects", "its project.json is new; the asset is already counted from the trash")
testing.equal(stubReservations[hold.reservations[1].id.toStr()].held, 600, "the ledger holds only the growth")

// The save lands: p1's project.json is replaced.
putProject(projectsDir, {
  id: "p1", owner: "ana", ownerId: "u-ana",
  jsonKey: "project-json/j2.json.gz", storedJsonBytes: 600,
  workspaceKey: "project-workspaces/h1.mwp", workspaceLayers: ["project-workspaces/h1.mwp"], historyBytes: 4000,
  assets: [a1, a2, a3]
})
storageSettle("u-ana", hold)
testing.equal(heldFor("u-ana"), [], "settling commits what was held")
testing.equal(countedFor("u-ana").projects, 9550, "at what was really stored: the remix still keeps the old project.json")

// ---------- Full ----------

stub.max = stubUsed("u-ana") + 100
object bigger = projectStorageSummary(readFile(projectsDir ++ "p1.json").data.assertElse(object, {}), assetIndex.assets)
bigger.history = {"incoming:p1": 4500}
object refused = storageHold("u-ana", {projects: {p1: bigger}}, true)
testing.assert(!refused.ok, "a save past her allowance is refused")
testing.equal(refused.refusal.status, 413)
testing.equal(refused.refusal.needed, 500, "with how much more it needed")
testing.equal(heldFor("u-ana"), [], "and holds nothing")
testing.assert(storageHold("u-ana", {projects: {p1: bigger}}, false).ok, "an admin's save isn't stopped")
for id in heldFor("u-ana") (
  stubReservations.delete(id.toStr())
)

stub.max = 10
object smaller = projectStorageSummary(readFile(projectsDir ++ "p1.json").data.assertElse(object, {}), assetIndex.assets)
smaller.history = {"incoming:p1": 10}
testing.assert(storageHold("u-ana", {projects: {p1: smaller}}, true).ok, "over her allowance, she can still make a project smaller")
testing.assert(storageHold("u-ana", {}, true).ok, "or save without adding anything")

// ---------- Deleting frees ----------

stub.max = 100000
void fs.remove(trashDir ++ "p3.json")
storageSettle("u-ana", noStorageHold())
testing.equal(countedFor("u-ana").projects, 9550 - 1000, "emptying the trash frees its project.json")
testing.equal(countedFor("u-ana").assets, 21300, "but its asset stays counted, as p1 now uses it too")
backpacks["u-ana"] = []
storageSettle("u-ana", noStorageHold())
testing.assert(!countedFor("u-ana").contains("backpack"), "an empty backpack stops counting")

// ---------- Uploads ahead of a save ----------

string d1 = "d" * 32 ++ ".png"
string e1 = "e" * 32 ++ ".png"
object ahead = pendingAssetHold("u-ana", "ana", d1, 5000, true)
testing.assert(ahead.ok, "an asset uploaded ahead holds room")
object pendingReservation = stubReservations["pending-" ++ d1].assertElse(object, {})
testing.equal(pendingReservation.ttl, 604800, "for up to a week")
testing.equal(pendingReservation.held, 5000)
testing.equal(pendingUploadEvents("ana").len, 1, "and MistWarp remembers it")
stub.max = stubUsed("u-ana") + 10
testing.assert(!pendingAssetHold("u-ana", "ana", e1, 5000, true).ok, "one past her allowance is refused")
testing.equal(pendingUploadEvents("ana").len, 1, "and isn't remembered")
releasePendingAssetHolds("u-ana", "ana", [d1, a1])
testing.assert(!stubReservations.contains("pending-" ++ d1), "the save that uses it releases it")
testing.equal(pendingUploadEvents("ana").len, 0)
stub.max = 100000

// ---------- Rotur can't be reached ----------

stub.failing = true
object down = storageHold("u-ana", {projects: {p9: grown}}, true)
testing.equal(down, {ok: true, reservations: []}, "MistWarp saves anyway rather than lose work")
storageSettle("u-ana", noStorageHold())
stub.failing = false

// ---------- Everyone, every six hours ----------

stubObjects[stubKey("u-cy", "projects")] = 999
putProject(projectsDir, {id: "p5", owner: "ana", ownerId: "u-ana", jsonKey: "project-json/j5.json.gz", storedJsonBytes: 40, assets: []})
number settled = settleEveryoneOnce()
testing.equal(settled, 3, "Ana's missed change, Bea's first count and Cy's leftover")
testing.equal(countedFor("u-ana").projects, 8550 + 40, "a project saved while Rotur was down is counted")
testing.equal(countedFor("u-bea"), {projects: 70, assets: 1000})
testing.equal(countedFor("u-cy"), {}, "what's counted for someone who stores nothing is freed")
testing.equal(settleEveryoneOnce(), 0, "and once in line, nothing changes")

// ---------- Students and deleted accounts ----------

before = stub.calls.toNum()
storageSettle("mwc_student", noStorageHold())
testing.assert(storageHold("mwc_student", {}, true).ok, "a student's storage comes from their class")
testing.equal(stub.calls.toNum(), before, "and never reaches Rotur")

testing.assert(ledgerFreeAll("u-ana"), "deleting her MistWarp data")
testing.equal(countedFor("u-ana"), {}, "frees everything MistWarp counted for her")

void fs.remove(work, {force: true})
