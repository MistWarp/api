export {
  loadThumbnailSecret,
  thumbnailIsPublic
}

def loadThumbnailSecret(string path) string (
  string stored = fs.readFile(path).unwrapOr("").strip()
  if stored != "" (
    return stored
  )
  string secret = crypto.randomString(32)
  if !fs.writeFile(path, secret) (
    log "WARNING: could not save " ++ path ++ "; private thumbnail links will change on restart"
  )
  return secret
)

def thumbnailKey(string secret, string id, string viewKey) string (
  return crypto.hmac("sha256", secret, "thumbnail:" ++ id ++ ":" ++ viewKey).trim(1, 24)
)

def thumbnailKeyMatches(string secret, string id, string viewKey, string given) boolean (
  return secret != "" and given != "" and crypto.constantTimeCompare(given, thumbnailKey(secret, id, viewKey))
)

def thumbnailIsPublic(string visibility, boolean ownerBanned) boolean (
  return !ownerBanned and visibility != "private"
)

def thumbnailCacheHeaders(boolean isPublic) object (
  if isPublic (
    return {cache: "public, max-age=3600", cdn: "public, max-age=60"}
  )
  return {cache: "private, max-age=3600", cdn: "private, no-store"}
)
