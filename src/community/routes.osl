def registerCommunityUploadRoutes(*serve.Router uploads) (
  uploads.POST("/spaces/:id/thumbnail", serve.maxBodySize(maxThumbnailRequestBytes), requireAuth, handleSetSpaceThumbnail)
)

def registerCommunityRoutes(*serve.Router api) (
  api.POST("/milestones/followers/:name", requireAuth, handleCheckFollowerMilestones)
  api.POST("/milestones/posts/:id", requireAuth, handleCheckPostMilestones)
  api.POST("/milestones/themes/:id", requireAuth, handleCheckThemeMilestones)
  api.GET("/notifications", requireAuth, handleGetNotifications)
  api.POST("/notifications/read", requireAuth, handleReadNotifications)

  api.GET("/me/library", requireAuth, handleGetMyLibrary)

  api.PUT("/me/library/:project/visibility", requireAuth, handleSetLibraryProjectVisibility)

  api.GET("/me/purchases", requireAuth, handleGetMyPurchases)

  api.GET("/groups/:tag", handleGetMistWarpGroup)

  api.GET("/development/pulls", handleDevelopmentPulls)
  api.GET("/roadmap", handleListIdeas)
  api.POST("/roadmap", requireAuth, requireGoodStanding, handleCreateIdea)
  api.POST("/roadmap/:id/vote", requireAuth, handleVoteIdea)
  api.PUT("/roadmap/:id", requireAdmin, handleUpdateIdea)
  api.GET("/roadmap/:id/comments", handleGetIdeaComments)
  api.POST("/roadmap/:id/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreateIdeaComment)
  api.DELETE("/roadmap/:id/comments/:cid", requireAuth, handleDeleteIdeaComment)
  api.PUT("/roadmap/:id/comments/:cid", requireAuth, handleEditIdeaComment)
  api.POST("/roadmap/:id/comments/:cid/react", requireAuth, handleReactIdeaComment)
  api.GET("/spaces", handleListSpaces)
  api.POST("/spaces", requireAuth, requireGoodStanding, handleCreateSpace)
  api.GET("/spaces/:id", handleGetSpace)
  api.GET("/spaces/:id/manage", requireAuth, handleGetSpaceManagement)
  api.PUT("/spaces/:id", requireAuth, handleUpdateSpace)
  api.DELETE("/spaces/:id", requireAuth, handleDeleteSpace)
  api.POST("/spaces/:id/projects/:project", requireAuth, handleAddSpaceProject)
  api.DELETE("/spaces/:id/projects/:project", requireAuth, handleRemoveSpaceProject)
  api.POST("/spaces/:id/follow", requireAuth, handleFollowSpace)
  api.DELETE("/spaces/:id/follow", requireAuth, handleUnfollowSpace)
  api.POST("/spaces/:id/curators", requireAuth, handleInviteSpaceCurator)
  api.DELETE("/spaces/:id/curators/:username", requireAuth, handleRemoveSpaceCurator)
  api.POST("/spaces/:id/invitations/respond", requireAuth, handleRespondSpaceCuratorInvite)
  api.DELETE("/spaces/:id/invitations/:username", requireAuth, handleCancelSpaceCuratorInvite)
  api.POST("/spaces/:id/judges", requireAuth, handleInviteChallengeJudge)
  api.DELETE("/spaces/:id/judges/:username", requireAuth, handleRemoveChallengeJudge)
  api.POST("/spaces/:id/judge-invitations/respond", requireAuth, handleRespondChallengeJudgeInvite)
  api.POST("/spaces/:id/join", requireAuth, requireGoodStanding, handleJoinChallenge)
  api.DELETE("/spaces/:id/join", requireAuth, handleLeaveChallenge)
  api.PUT("/spaces/:id/entries/:project/score", requireAuth, handleScoreChallengeEntry)
  api.PUT("/spaces/:id/entries/:project/vote", requireAuth, handleVoteChallengeEntry)
  api.POST("/spaces/:id/results", requireAuth, handlePublishChallengeResults)
  api.POST("/spaces/:id/react", requireAuth, handleReactSpace)
  api.GET("/spaces/:id/comments", handleGetSpaceComments)
  api.POST("/spaces/:id/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreateSpaceComment)
  api.DELETE("/spaces/:id/comments/:cid", requireAuth, handleDeleteSpaceComment)
  api.PUT("/spaces/:id/comments/:cid", requireAuth, handleEditSpaceComment)
  api.POST("/spaces/:id/comments/:cid/react", requireAuth, handleReactSpaceComment)
  api.POST("/spaces/:id/comments/:cid/pin", requireAuth, handlePinSpaceComment)
  api.GET("/me/spaces", requireAuth, handleMySpaces)

  api.GET("/projects/:id/card.svg", handleProjectCard)
  api.GET("/projects/:id/card.png", handleProjectSharePng)

  api.POST("/projects/:id/save", requireAuth, handleSaveProject)
  api.DELETE("/projects/:id/save", requireAuth, handleUnsaveProject)

  api.POST("/projects/:id/preview", requireAuth, serve.limitRequests(30, {window: 3600000}), handleCreatePreview)
  api.GET("/projects/:id/releases", handleListReleases)
  api.GET("/projects/:id/releases/:release/project.json", handleGetReleaseProjectJson)
  api.POST("/projects/:id/releases", requireAuth, serve.limitRequests(30, {window: 3600000}), handleCreateRelease)
  api.DELETE("/projects/:id/releases/:release", requireAuth, handleDeleteRelease)
  api.POST("/projects/:id/contribute", requireAuth, handleCreateContribution)
  api.POST("/projects/:id/diagnostics", serve.limitRequests(120, {window: 60000}), handleRecordDiagnostic)
  api.GET("/projects/:id/diagnostics", requireAuth, handleGetDiagnostics)
  api.POST("/projects/:id/feedback", requireAuth, requireGoodStanding, serve.limitRequests(20, {window: 3600000}), handleCreateProjectFeedback)
  api.GET("/projects/:id/feedback", requireAuth, handleGetProjectFeedback)
  api.PUT("/projects/:id/feedback/:feedback", requireAuth, handleUpdateProjectFeedback)
  api.GET("/projects/:id/reviews", handleListProjectReviews)
  api.PUT("/projects/:id/reviews/me", requireAuth, requireGoodStanding, handleSaveProjectReview)
  api.DELETE("/projects/:id/reviews/me", requireAuth, handleDeleteProjectReview)

  api.GET("/projects/:id/comments", handleGetProjectComments)
  api.POST("/projects/:id/comments/donation/intent", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleProjectCommentDonationIntent)
  api.POST("/projects/:id/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreateProjectComment)
  api.DELETE("/projects/:id/comments/:cid", requireAuth, handleDeleteProjectComment)
  api.PUT("/projects/:id/comments/:cid", requireAuth, handleEditProjectComment)
  api.POST("/projects/:id/comments/:cid/react", requireAuth, handleReactProjectComment)
  api.POST("/projects/:id/comments/:cid/pin", requireAuth, handlePinProjectComment)

  api.GET("/bounties/:id/activity", handleGetBountyActivity)
  api.POST("/bounties/:id/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreateBountyComment)
  api.PUT("/bounties/:id/comments/:cid", requireAuth, handleEditBountyComment)
  api.DELETE("/bounties/:id/comments/:cid", requireAuth, handleDeleteBountyComment)
  api.POST("/bounties/:id/workers/me", requireAuth, requireGoodStanding, handleJoinBounty)
  api.DELETE("/bounties/:id/workers/me", requireAuth, handleLeaveBounty)

  api.GET("/search/users", handleSearchUsers)
  api.GET("/users/:name", handleGetUser)
  api.GET("/users/:name/library", handleGetUserPlaytimeLibrary)
  api.GET("/users/:name/reviews", handleListUserReviews)
  api.PUT("/me/profile", requireAuth, handleUpdateProfile)
  api.POST("/users/:name/follow", requireAuth, handleFollowUser)
  api.DELETE("/users/:name/follow", requireAuth, handleUnfollowUser)
  api.GET("/users/:name/projects", handleGetUserProjects)
  api.GET("/activity", handleGetActivity)
  api.GET("/users/:name/followers", handleGetUserFollowers)
  api.GET("/users/:name/following", handleGetUserFollowing)
  api.GET("/users/:name/comments", handleGetProfileComments)
  api.POST("/users/:name/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreateProfileComment)
  api.DELETE("/users/:name/comments/:cid", requireAuth, handleDeleteProfileComment)
  api.PUT("/users/:name/comments/:cid", requireAuth, handleEditProfileComment)
  api.POST("/users/:name/comments/:cid/react", requireAuth, handleReactProfileComment)
  api.POST("/users/:name/comments/:cid/pin", requireAuth, handlePinProfileComment)

  api.GET("/news", handleGetNews)
  api.GET("/news/:id", handleGetNewsItem)
  api.POST("/news/:id/view", serve.limitRequests(120, {window: 3600000}), handleViewNews)
  api.POST("/news", requireAdmin, handleCreateNews)
  api.PUT("/news/:id", requireAdmin, handleUpdateNews)
  api.DELETE("/news/:id", requireAdmin, handleDeleteNews)
  api.POST("/news/:id/react", requireAuth, handleReactNews)
  api.POST("/news/:id/poll", requireAuth, handleVoteNewsPoll)

  api.POST("/report", requireAuth, serve.limitRequests(10, {window: 3600000}), handleCreateReport)
  api.POST("/reports", requireAuth, serve.limitRequests(10, {window: 3600000}), handleCreateReport)
  api.POST("/support", serve.limitRequests(5, {window: 3600000}), handleCreateSupportRequest)

  api.GET("/admin/reports", requireAdmin, handleGetReports)
  api.GET("/admin/reports/evidence/:id", requireAdmin, handleGetReportEvidence)
  api.POST("/admin/reports/resolve", requireAdmin, handleResolveReport)

  api.POST("/admin/reports/escalate", requireAdmin, handleEscalateReport)

  api.POST("/admin/standing", requireAdmin, handleSetStanding)

  api.POST("/admin/user/message", requireAdmin, handleMessageUser)
  api.POST("/admin/user/profile", requireAdmin, handleAdminUpdateProfile)
)
