export {
  canAccessPullWorkspace,
  completeNativePull,
  createNativePull,
  livePullHead,
  pullTargetBranchRefusal,
  projectBranchHead,
  projectGitHead,
  projectHasWorkspace,
  pullCommentKey,
  pullDocument
}

def projectGitHead(object project) string (
  return canonicalHistoryHead(project)
)

def projectHasWorkspace(object project) boolean (
  return projectWorkspaceKeys(project).len > 0 and projectGitHead(project) != ""
)

def projectBranchNames(object project) array (
  object graph = projectVersionHistory(project).graph.assertElse(object, {})
  return if graph.contains("branches") then graph.branches.assertElse(array, []) else []
)

def livePullHead(object pull, object source) string (
  string sourceBranch = pullSourceBranch(pull, projectBranchNames(source))
  string currentBranch = if source.contains("gitBranch") and source.gitBranch != null and source.gitBranch.toStr() != "" then source.gitBranch.toStr() else "main"
  string branchHead = if sourceBranch == "" then "" else projectBranchHead(source, sourceBranch)
  return livePullHeadFrom(pull, sourceBranch, branchHead, currentBranch, projectGitHead(source))
)

def pullTargetBranch(object pull) string (
  return (pull.targetBranch ?? "").toStr()
)

def pullTargetHead(object pull, object target) string (
  string branch = pullTargetBranch(pull)
  string branchHead = if branch == "" then "" else projectBranchHead(target, branch)
  if branchHead != "" (
    return branchHead
  )
  if pullTargetBranchRefusalCode(branch, projectCurrentBranch(target), projectBranchNames(target)) == "target_branch_missing" (
    return ""
  )
  return projectGitHead(target)
)

def livePullBase(object pull, string targetWorkspacePath, string targetHead, string sourceWorkspacePath, string sourceHead) string (
  string stored = (pull.baseCommit ?? "").toStr()
  if (pull.state ?? "").toStr() != "open" or targetHead == "" or sourceHead == "" (
    return stored
  )
  auto parsed = json.parse(gitinspection.RemixMergeBase(targetWorkspacePath, targetHead, sourceWorkspacePath, sourceHead), {type: "object"})
  if parsed.isErr() (
    return stored
  )
  object found = parsed.unwrap().assert(object)
  if found.ok != true (
    return stored
  )
  return (found.base ?? stored).toStr()
)

def livePullResponse(object pull, string baseCommit, string headCommit) object (
  object response = pullResponse(pull)
  response.baseCommit = baseCommit
  response.headCommit = headCommit
  return response
)

def pullDocument(string targetId, string index) object (
  return (pullDocs.findById(targetId ++ ":" ++ index) ?? {})
)

def pullCommentKey(object pull) string (
  return "pull-" ++ pull.targetProjectId.toStr() ++ "-" ++ pull.index.toStr()
)

def commitsAfter(array commits, string stopSha, number created) array (
  array newer = []
  boolean reachedStop = false
  for i commits.len (
    object commit = commits[i].assert(object)
    if stopSha != "" and commit.sha.toStr() == stopSha (
      reachedStop = true
    ) else if !reachedStop (
      boolean include = stopSha != ""
      if !include and commit.contains("date") and commit.date != null (
        include = commit.date.toNum() >= created
      )
      if include (
        newer.append(commit)
      )
    )
  )
  return newer
)

def commitsNotIn(array commits, array excluded) array (
  array excludedShas = []
  for i excluded.len (
    excludedShas.append(excluded[i].assert(object).sha.toStr())
  )
  array unique = []
  for i commits.len (
    object commit = commits[i].assert(object)
    if !excludedShas.contains(commit.sha.toStr()) (
      unique.append(commit)
    )
  )
  return unique
)

def pullResponse(object pull) object (
  number commentCount = storedPullCommentCount(pull)
  if commentCount < 0 (
    commentCount = loadComments(pullCommentKey(pull)).len
  )
  return {
    id: pull["_id"],
    index: pull.index,
    title: pull.title,
    body: pull.body,
    state: pull.state,
    user: pull.author,
    sourceOwner: pull.sourceOwner,
    sourceProjectId: pull.sourceProjectId,
    sourceTitle: pull.sourceTitle,
    targetProjectId: pull.targetProjectId,
    baseCommit: pull.baseCommit,
    headCommit: pull.headCommit,
    targetHead: pull.targetHead,
    baseBranch: pull.targetBranch,
    headBranch: pull.sourceBranch,
    created: pull.created,
    updated: pull.updated,
    merged: pull.state.toStr() == "merged",
    mergedCommit: pull.mergedCommit,
    commentCount: commentCount
  }
)

def isPullSourceOwnerWithSource(object pull, object source,*serve.Context c) boolean (
  if !contextBool(c, "authenticated") (
    return false
  )
  if source.len > 0 and projectRole(source, contextString(c, "username")) == "owner" (
    return true
  )
  return identityMatches(
    (pull.sourceOwnerId ?? "").toStr(),
    pull.sourceOwner.toStr(),
    contextString(c, "userId"),
    contextString(c, "username")
  )
)

def isPullSourceOwner(object pull,*serve.Context c) boolean (
  if !contextBool(c, "authenticated") (
    return false
  )
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  object source = if sourceResult.ok then sourceResult.project.assert(object) else {}
  return isPullSourceOwnerWithSource(pull, source, c)
)

def canClosePullWithSource(object pull, object target, object source,*serve.Context c) boolean (
  return canEditProject(target, c) or isPullSourceOwnerWithSource(pull, source, c)
)

def canClosePull(object pull, object target,*serve.Context c) boolean (
  return canEditProject(target, c) or isPullSourceOwner(pull, c)
)

def canInspectPullWithSource(object pull, object target, object source,*serve.Context c) boolean (
  if !sourcePolicyAllowsViewer(target, c) or projectHiddenFrom(target, c) (
    return false
  )
  if source.len == 0 or !sourcePolicyAllowsViewer(source, c) or projectHiddenFrom(source, c) (
    return false
  )
  if canSeeInsideProject(target, c) (
    return true
  )
  if !contextBool(c, "authenticated") (
    return false
  )
  return canEditProject(target, c) or isPullSourceOwnerWithSource(pull, source, c)
)

def canInspectPull(object pull, object target,*serve.Context c) boolean (
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  object source = if sourceResult.ok then sourceResult.project.assert(object) else {}
  return canInspectPullWithSource(pull, target, source, c)
)

def createNativePull(*serve.Context c, object target, object source, string title, string description, string bountyId) object (
  if !projectHasWorkspace(target) or !projectHasWorkspace(source) (
    return {ok: false, status: 400, error: "both projects need MistWarp history before changes can be sent"}
  )
  if projectRole(source, contextString(c, "username")) != "owner" (
    return {ok: false, status: 403, error: "use a remix you own"}
  )
  if source.remixParent.toStr() != target.id.toStr() (
    return {ok: false, status: 400, error: "the source project is not a direct remix of this project"}
  )
  if title == "" or title.len > 200 (
    return {ok: false, status: 400, error: "invalid title"}
  )
  string baseCommit = ""
  if source.contains("remixBaseCommit") and source.remixBaseCommit != null (
    baseCommit = source.remixBaseCommit.toStr()
  )
  if baseCommit == "" (
    return {ok: false, status: 400, error: "the remix does not record where it started"}
  )
  number sequence = 0
  if target.contains("nativePullSeq") and target.nativePullSeq != null (
    sequence = target.nativePullSeq.toNum()
  )
  object inserted = insertNativePullLocked(target, source, title, description, bountyId, baseCommit, sequence, contextString(c, "username"), contextString(c, "userId"))
  if inserted.ok != true (
    return inserted
  )
  object pull = inserted.pull.assert(object)
  sequence = pull.index.toNum()
  addNotification(target.owner.toStr(), contextString(c, "username"), "contribution", {projectId: target.id, projectTitle: target.title, pull: sequence})
  return {ok: true, pull: pullResponse(pull)}
)

def insertNativePullLocked(object target, object source, string title, string description, string bountyId, string baseCommit, number sequence, string author, string authorId) object (
  string sequenceLock = "native-pull-sequence:" ++ target.id.toStr()
  sync.lock(sequenceLock)
  defer sync.unlock(sequenceLock)
  array latestPulls = pullDocs.where("targetProjectId", "==", target.id.toStr()).sort("index", "desc").limit(1).all()
  sequence = nextPullSequence(sequence, latestPulls)

  string id = target.id.toStr() ++ ":" ++ sequence.toStr()
  string sourceBranch = "main"
  if source.contains("gitBranch") and source.gitBranch != null (
    sourceBranch = source.gitBranch.toStr()
  )
  string targetBranch = "main"
  if target.contains("gitBranch") and target.gitBranch != null (
    targetBranch = target.gitBranch.toStr()
  )
  object pull = {
    _id: id,
    index: sequence,
    title: title,
    body: description.trim(1, 5000),
    state: "open",
    author: author,
    authorId: authorId,
    sourceOwner: source.owner,
    sourceOwnerId: source.ownerId,
    sourceProjectId: source.id,
    sourceTitle: source.title,
    sourceBranch: sourceBranch,
    targetProjectId: target.id,
    targetBranch: targetBranch,
    baseCommit: baseCommit,
    headCommit: projectGitHead(source),
    targetHead: projectGitHead(target),
    created: timestamp,
    updated: timestamp,
    mergedCommit: "",
    commentCount: 0,
    bountyId: bountyId
  }
  if pullDocs.insertOne(pull).isErr() (
    return {ok: false, status: 409, error: "another pull request was created at the same time, try again"}
  )
  return {ok: true, pull: pull}
)

def handleGetCommits(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  auto res = loadProject(c.param("id"))
  if !res.ok or !canViewProject(res.project.assert(object), c) (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  object history = projectVersionHistory(project)
  boolean canSeeInside = canSeeInsideProject(project, c)
  string etag = "\"project-history-v2-" ++ projectWorkspaceFingerprint(project) ++ "-" ++ projectGitHead(project) ++ "-" ++ (project.edited ?? 0).toStr() ++ "-" ++ (if canSeeInside then "1" else "0") ++ "-" ++ json.stringify(history).hashSHA256() ++ "\""
  c.setHeader("ETag", etag)
  c.setHeader("Vary", "Authorization, Cookie")
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  if (c.header("If-None-Match") ?? "").contains(etag) (
    c.status(304)
    return
  )
  object response = {
    ok: true,
    head: projectGitHead(project),
    branch: history.branch,
    commits: history.commits,
    graph: history.graph,
    virtual: history.virtual
  }
  if canSeeInside and projectHasWorkspace(project) (
    object uncommitted = projectUncommittedSummary(project)
    if uncommitted.len > 0 (
      response.uncommitted = uncommitted
    )
  )
  c.json(200, response)
)

def projectBranchHead(object project, string branch) string (
  object history = projectVersionHistory(project)
  object graph = history.graph.assertElse(object, {})
  array oids = graphBranchLog(graph, branch)
  if oids.len > 0 and validGitObjectId(oids[1].toStr()) (
    return oids[1].toStr()
  )
  return ""
)

def projectBranchResponse(object project) array (
  object history = projectVersionHistory(project)
  object graph = history.graph.assertElse(object, {})
  array names = if graph.contains("branches") then graph.branches.assertElse(array, []) else []
  array branches = []
  string active = history.branch.toStr()
  for i names.len (
    string name = names[i].toStr()
    string head = projectBranchHead(project, name)
    if name != "" and head != "" (
      object branch = {name: name, head: head, current: name == active}
      array nodes = if graph.contains("nodes") then graph.nodes.assertElse(array, []) else []
      for j nodes.len (
        object node = nodes[j].assertElse(object, {})
        if node.sha.toStr() == head (
          branch.message = (node.message ?? "").toStr()
          branch.author = (node.author ?? "").toStr()
          branch.date = if node.contains("date") then node.date else 0
        )
      )
      branches.append(branch)
    )
  )
  return branches
)

def handleListProjectBranches(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  auto res = loadProject(c.param("id"))
  if !res.ok or !canViewProject(res.project.assert(object), c) (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  c.json(200, {ok: true, current: projectVersionHistory(project).branch, branches: projectBranchResponse(project)})
)

def handleProjectBranchMutation(*serve.Context c, string action) (
  object response = mutateProjectBranchesLocked(c, action)
  if response.len > 0 (
    c.json(200, response)
  )
)

def mutateProjectBranchesLocked(*serve.Context c, string action) object (
  string lockName = "project-history-" ++ c.param("id")
  sync.lock(lockName)
  defer sync.unlock(lockName)
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return {}
  )
  object project = res.project.assert(object)
  if !canEditProject(project, c) or !canSeeInsideProject(project, c) (
    c.forbidden("only project maintainers can manage branches")
    return {}
  )
  object body = requestJSON(c)
  string branch = (body.branch ?? "").toStr().strip()
  string name = (body.name ?? "").toStr().strip()
  string from = (body.from ?? "").toStr().strip()
  if action == "create" and from == "" (
    from = projectVersionHistory(project).branch.toStr()
  )
  string sourcePath = tmpDir ++ project.id.toStr() ++ ".branches-source." ++ randomString(8) ++ ".mwp"
  string outputPath = tmpDir ++ project.id.toStr() ++ ".branches-output." ++ randomString(8) ++ ".mwp"
  if !copyProjectWorkspaceToPath(project, sourcePath) (
    void fs.remove(sourcePath)
    c.json(409, {ok: false, error: "save the project before managing its branches", code: "branch_history_unavailable"})
    return {}
  )
  object history = projectVersionHistory(project)
  history.head = projectGitHead(project)
  string historyJson = json.stringify(history)
  string rewriteJson = gitinspection.ManageBranchArchiveJSON(sourcePath, outputPath, action, branch, name, from, historyJson)
  auto parsedRewrite = json.parse(rewriteJson, {type: "object"})
  void fs.remove(sourcePath)
  if parsedRewrite.isErr() or parsedRewrite.unwrap().assert(object).ok != true or !fs.exists(outputPath) (
    string message = if parsedRewrite.isErr() then "could not update the branch" else (parsedRewrite.unwrap().assert(object).error ?? "could not update the branch").toStr()
    void fs.remove(outputPath)
    c.json(409, {ok: false, error: message, code: "branch_update_unavailable"})
    return {}
  )
  object rewrite = parsedRewrite.unwrap().assert(object)
  object manifest = rewrite.manifest.assert(object)
  byte[] workspaceBody = fs.readFileBytes(outputPath).unwrapOr("".toBytes())
  void fs.remove(outputPath)
  if workspaceBody.len > maxWorkspaceBytes (
    c.json(413, {ok: false, error: "MistWarp project history exceeds the 512 MB limit", code: "workspace_too_large"})
    return {}
  )
  string workspaceKey = projectWorkspaceSnapshotKey(contentHash(workspaceBody))
  if !stageR2Blob(workspaceKey, workspaceBody, "application/x-mistwarp-project", "") (
    c.internalError("could not store the updated branch history")
    return {}
  )
  array previousWorkspaceKeys = projectWorkspaceKeys(project)
  project.workspaceKey = workspaceKey
  project.workspaceLayers = [workspaceKey]
  project.historyBytes = workspaceBody.len
  project.gitHead = manifest.head
  project.gitBranch = manifest.branch
  if manifest.contains("commits") and manifest.commits != null (
    project.gitCommits = paginate(manifest.commits.assert(array), 0, 50)
  )
  project.gitGraph = manifest.graph.assertElse(object, {branches: [], branchLogs: [], nodes: []})
  project.edited = timestamp
  if !saveProject(project) (
    removeProjectStorageKeyIfOrphaned(workspaceKey, project.id.toStr(), true)
    c.internalError("could not save the updated branches")
    return {}
  )
  for i previousWorkspaceKeys.len (
    string previousKey = previousWorkspaceKeys[i].toStr()
    if previousKey != workspaceKey (
      removeProjectStorageKeyIfOrphaned(previousKey, project.id.toStr(), true)
    )
  )
  object response = {
    ok: true,
    current: project.gitBranch,
    branches: projectBranchResponse(project)
  }
  return response
)

def handleCreateProjectBranch(*serve.Context c) (
  handleProjectBranchMutation(c, "create")
)

def handleRenameProjectBranch(*serve.Context c) (
  handleProjectBranchMutation(c, "rename")
)

def handleDeleteProjectBranch(*serve.Context c) (
  handleProjectBranchMutation(c, "delete")
)

def handlePrepareBranchMerge(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok or !canEditProject(res.project.assert(object), c) or !canSeeInsideProject(res.project.assert(object), c) (
    c.forbidden("only project maintainers can merge branches")
    return
  )
  object project = res.project.assert(object)
  object body = requestJSON(c)
  string sourceBranch = (body.source ?? "").toStr().strip()
  string targetBranch = (body.target ?? "").toStr().strip()
  if sourceBranch == "" or targetBranch == "" or sourceBranch == targetBranch (
    c.badRequest("choose two different branches")
    return
  )
  string sourceHead = projectBranchHead(project, sourceBranch)
  string targetHead = projectBranchHead(project, targetBranch)
  if sourceHead == "" or targetHead == "" (
    c.notFound("branch not found")
    return
  )
  string workspacePath = cachedProjectWorkspacePath(project)
  if workspacePath == "" (
    c.internalError("could not assemble project history")
    return
  )
  string mergeJson = gitinspection.PrepareBranchMergeJSON(workspacePath, targetHead, sourceHead)
  auto parsedMerge = json.parse(mergeJson, {type: "object"})
  if parsedMerge.isErr() or parsedMerge.unwrap().assert(object).ok != true (
    string message = if parsedMerge.isErr() then "could not prepare the branch merge" else (parsedMerge.unwrap().assert(object).error ?? "could not prepare the branch merge").toStr()
    c.json(409, {ok: false, error: message, code: "branch_merge_unavailable"})
    return
  )
  object merge = parsedMerge.unwrap().assert(object)
  c.json(200, {
    ok: true,
    merge: merge,
    targetProjectId: project.id,
    sourceBranch: sourceBranch,
    targetBranch: targetBranch,
    sourceHead: sourceHead,
    targetHead: targetHead,
    expectedHead: targetHead
  })
)

def handleListPulls(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok or !canViewProject(res.project.assert(object), c) (
    c.notFound("project not found")
    return
  )
  array stored = pullDocs.where("targetProjectId", "==", c.param("id")).sort("created", "desc").limit(200).all()
  array pulls = []
  for i stored.len (
    pulls.append(pullResponse(stored[i].assert(object)))
  )
  c.json(200, {ok: true, pulls: pulls})
)

def handleCreatePull(*serve.Context c) (
  auto targetResult = loadProject(c.param("id"))
  object body = requestJSON(c)
  auto sourceResult = loadProject(body.sourceProjectId.toStr())
  if !targetResult.ok or !sourceResult.ok (
    c.notFound("project not found")
    return
  )
  string description = ""
  if body.contains("body") and body.body != null (
    description = body.body.toStr()
  )
  string bountyId = ""
  if body.contains("bountyId") and body.bountyId != null (
    bountyId = body.bountyId.toStr().strip()
  )
  object created = createNativePull(c, targetResult.project.assert(object), sourceResult.project.assert(object), body.title.toStr().strip(), description, bountyId)
  if !created.ok (
    c.json(created.status.toInt(), {ok: false, error: created.error})
    return
  )
  c.json(201, created)
)

def handleGetPull(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  auto targetResult = loadProject(pull.targetProjectId.toStr())
  if !targetResult.ok or !canViewProject(targetResult.project.assert(object), c) (
    c.notFound("pull request not found")
    return
  )
  object response = pullResponse(pull)
  object target = targetResult.project.assert(object)
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  object source = if sourceResult.ok then sourceResult.project.assert(object) else {}
  response.canClose = canClosePullWithSource(pull, target, source, c)
  response.canInspect = canInspectPullWithSource(pull, target, source, c)
  response.baseBranchMissing = pullTargetBranchRefusalCode(pullTargetBranch(pull), projectCurrentBranch(target), projectBranchNames(target)) == "target_branch_missing"
  if response.canInspect == true and source.len > 0 (
    response.headCommit = livePullHead(pull, source)
  )
  response.canMerge = canEditProject(target, c) and response.canInspect == true
  c.json(200, {ok: true, pull: response})
)

def handleGetPullTimeline(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  auto targetResult = loadProject(pull.targetProjectId.toStr())
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  if !targetResult.ok or !sourceResult.ok or !canViewProject(targetResult.project.assert(object), c) (
    c.notFound("project not found")
    return
  )
  object target = targetResult.project.assert(object)
  object source = sourceResult.project.assert(object)
  array comments = loadComments(pullCommentKey(pull))
  for i comments.len (
    comments[i] = commentResponse(comments[i].assert(object), contextString(c, "username"))
  )
  array sourceCommits = []
  array targetCommits = []
  if canInspectPullWithSource(pull, target, source, c) (
    array targetHistory = projectVersionHistory(target).commits.assert(array)
    sourceCommits = commitsAfter(projectVersionHistory(source).commits.assert(array), pull.baseCommit.toStr(), pull.created.toNum())
    sourceCommits = commitsNotIn(sourceCommits, targetHistory)
    targetCommits = commitsAfter(targetHistory, pull.targetHead.toStr(), pull.created.toNum())
  )
  c.json(200, {
    ok: true,
    comments: comments,
    commits: sourceCommits,
    targetCommits: targetCommits
  })
)

def handleCreatePullComment(*serve.Context c) (
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  auto res = loadProject(pull.targetProjectId.toStr())
  if !res.ok or !canViewProject(res.project.assert(object), c) (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if usersAreBlocked(contextString(c, "username"), project.owner.toStr()) (
    c.forbidden("you cannot comment on this pull request")
    return
  )
  object body = requestJSON(c)
  if !body.contains("content") or body.content == null (
    c.badRequest("comment content is required")
    return
  )
  object created = createComment(pullCommentKey(pull), contextString(c, "username"), contextString(c, "userId"), body.content.toStr(), "", "comment", 0, "")
  if !created.ok (
    c.badRequest(created.error.toStr())
    return
  )
  countCreatedPullCommentLocked(pull)
  string commenter = contextString(c, "username")
  object notificationData = {projectId: project.id, projectTitle: project.title, pull: pull.index, commentId: created.comment.id, preview: created.comment.content.toStr()}
  if normalizeUsername(pull.author.toStr()) != normalizeUsername(commenter) (
    addNotification(pull.author.toStr(), commenter, "comment", notificationData)
  )
  if normalizeUsername(project.owner.toStr()) != normalizeUsername(commenter) and normalizeUsername(project.owner.toStr()) != normalizeUsername(pull.author.toStr()) (
    addNotification(project.owner.toStr(), commenter, "comment", notificationData)
  )
  notifyMentions(created.comment.content.toStr(), commenter, [project.owner.toStr(), pull.author.toStr()], notificationData)
  created.comment = commentResponse(created.comment.assert(object), commenter)
  c.json(201, created)
)

def handleDeletePullComment(*serve.Context c) (
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  auto res = loadProject(pull.targetProjectId.toStr())
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  object deleted = deleteComment(pullCommentKey(pull), c.param("cid"), contextString(c, "username"), project.owner.toStr(), contextBool(c, "isAdmin"))
  if !deleted.ok (
    c.json(deleted.status.toInt(), {ok: false, error: deleted.error})
    return
  )
  countDeletedPullCommentLocked(pull, deleted.removed.toNum())
  c.json(200, {ok: true})
)

def countCreatedPullCommentLocked(object pull) (
  string lockName = "pull-comment-count:" ++ pull["_id"].toStr()
  sync.lock(lockName)
  defer sync.unlock(lockName)
  object latestPull = pullDocument(pull.targetProjectId.toStr(), pull.index.toStr())
  if latestPull.len > 0 (
    number storedCount = storedPullCommentCount(latestPull)
    number actualCount = 0
    if storedCount < 0 (
      actualCount = loadComments(pullCommentKey(latestPull)).len
    )
    latestPull.commentCount = pullCommentCountAfterCreate(latestPull, actualCount)
    putDocument(pullDocs, latestPull["_id"].toStr(), latestPull)
  )
)

def countDeletedPullCommentLocked(object pull, number removed) (
  string lockName = "pull-comment-count:" ++ pull["_id"].toStr()
  sync.lock(lockName)
  defer sync.unlock(lockName)
  object latestPull = pullDocument(pull.targetProjectId.toStr(), pull.index.toStr())
  if latestPull.len > 0 (
    number storedCount = storedPullCommentCount(latestPull)
    number actualCount = 0
    if storedCount < 0 (
      actualCount = loadComments(pullCommentKey(latestPull)).len
    )
    latestPull.commentCount = pullCommentCountAfterDelete(latestPull, removed, actualCount)
    putDocument(pullDocs, latestPull["_id"].toStr(), latestPull)
  )
)

def handleEditPullComment(*serve.Context c) (
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  object body = requestJSON(c)
  if !body.contains("content") or body.content == null (
    c.badRequest("comment content is required")
    return
  )
  object edited = editComment(pullCommentKey(pull), c.param("cid"), contextString(c, "username"), body.content.toStr())
  if !edited.ok (
    c.json(edited.status.toInt(), {ok: false, error: edited.error})
    return
  )
  edited.comment = commentResponse(edited.comment.assert(object), contextString(c, "username"))
  c.json(200, edited)
)

def canAccessPullWorkspace(object project, string pullIndex,*serve.Context c) boolean (
  if !sourcePolicyAllowsViewer(project, c) or !contextBool(c, "authenticated") (
    return false
  )
  array matches = []
  object targetPull = pullDocument(project.id.toStr(), pullIndex)
  if targetPull.len > 0 (
    matches.append(targetPull)
  )
  array sourcePulls = pullDocs.where("sourceProjectId", "==", project.id.toStr()).where("index", "==", pullIndex.toNum()).limit(20).all()
  for i sourcePulls.len (
    object sourcePull = sourcePulls[i].assert(object)
    if targetPull.len == 0 or sourcePull["_id"].toStr() != targetPull["_id"].toStr() (
      matches.append(sourcePull)
    )
  )
  for i matches.len (
    object pull = matches[i].assert(object)
    boolean related = pull.sourceProjectId.toStr() == project.id.toStr() or pull.targetProjectId.toStr() == project.id.toStr()
    if related (
      auto targetResult = loadProject(pull.targetProjectId.toStr())
      if targetResult.ok (
        object target = targetResult.project.assert(object)
        if canInspectPull(pull, target, c) and (canEditProject(target, c) or isPullSourceOwner(pull, c)) (
          return true
        )
      )
    )
  )
  return false
)

def canAccessPullProjectCommit(object project, string targetId, string pullIndex, string sha,*serve.Context c) boolean (
  if !sourcePolicyAllowsViewer(project, c) (
    return false
  )
  object pull = pullDocument(targetId, pullIndex)
  if pull.len == 0 (
    return false
  )
  boolean isTarget = pull.targetProjectId.toStr() == project.id.toStr()
  boolean isSource = pull.sourceProjectId.toStr() == project.id.toStr()
  if !isTarget and !isSource (
    return false
  )
  object target = project
  if !isTarget (
    auto targetResult = loadProject(pull.targetProjectId.toStr())
    if !targetResult.ok (
      return false
    )
    target = targetResult.project.assert(object)
  )
  if !canInspectPull(pull, target, c) (
    return false
  )
  if pullCommitRecordedFor(pull, isTarget, isSource, sha) (
    return true
  )
  if isSource (
    return livePullHead(pull, project) == sha
  )
  return isLivePullBase(pull, project, sha)
)

def isLivePullBase(object pull, object target, string sha) boolean (
  if (pull.state ?? "").toStr() != "open" (
    return false
  )
  auto sourceResult = loadProject((pull.sourceProjectId ?? "").toStr())
  if !sourceResult.ok (
    return false
  )
  object source = sourceResult.project.assert(object)
  string targetWorkspacePath = cachedProjectWorkspacePath(target)
  string sourceWorkspacePath = cachedProjectWorkspacePath(source)
  if targetWorkspacePath == "" or sourceWorkspacePath == "" (
    return false
  )
  return livePullBase(pull, targetWorkspacePath, pullTargetHead(pull, target), sourceWorkspacePath, livePullHead(pull, source)) == sha
)

def pullInspectionJSON(string view, string inline, string targetWorkspacePath, string baseCommit, string sourceWorkspacePath, string headCommit) string (
  if view == "changes" (
    return gitinspection.CompareArchivesChangesJSON(targetWorkspacePath, baseCommit, sourceWorkspacePath, headCommit)
  )
  if inline == "1" (
    return gitinspection.CompareArchivesInlineJSON(targetWorkspacePath, baseCommit, sourceWorkspacePath, headCommit)
  )
  return gitinspection.CompareArchivesJSON(targetWorkspacePath, baseCommit, sourceWorkspacePath, headCommit)
)

def handleGetPullDiff(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 (
    c.notFound("pull request not found")
    return
  )
  auto targetResult = loadProject(pull.targetProjectId.toStr())
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  if !targetResult.ok or !sourceResult.ok (
    c.notFound("project not found")
    return
  )
  object target = targetResult.project.assert(object)
  object source = sourceResult.project.assert(object)
  if !canInspectPullWithSource(pull, target, source, c) (
    c.forbidden("only the fork owner and project maintainers can inspect this pull request")
    return
  )
  string targetWorkspacePath = cachedProjectWorkspacePath(target)
  string sourceWorkspacePath = cachedProjectWorkspacePath(source)
  if targetWorkspacePath == "" or sourceWorkspacePath == "" (
    c.internalError("could not assemble pull request history")
    return
  )
  string headCommit = livePullHead(pull, source)
  string baseCommit = livePullBase(pull, targetWorkspacePath, pullTargetHead(pull, target), sourceWorkspacePath, headCommit)
  string inspectionJson = pullInspectionJSON((c.query("view") ?? ""), (c.query("inline") ?? ""), targetWorkspacePath, baseCommit, sourceWorkspacePath, headCommit)
  auto parsedInspection = json.parse(inspectionJson, {type: "object"})
  if parsedInspection.isErr() (
    c.internalError("could not inspect pull request changes")
    return
  )
  object inspection = parsedInspection.unwrap().assert(object)
  if !inspection.contains("ok") or inspection.ok != true (
    c.json(409, {ok: false, error: (inspection.error ?? "could not inspect pull request changes").toStr(), code: "pull_history_unavailable"})
    return
  )
  string suffix = "?pull=" ++ pull.index.toStr()
  c.json(200, {
    ok: true,
    pull: livePullResponse(pull, baseCommit, headCommit),
    inspection: inspection,
    targetProjectId: target.id,
    sourceProjectId: source.id,
    targetWorkspaceUrl: appURL ++ "/v1/projects/" ++ target.id.toStr() ++ "/workspace.mwp" ++ suffix,
    sourceWorkspaceUrl: appURL ++ "/v1/projects/" ++ source.id.toStr() ++ "/workspace.mwp" ++ suffix,
    expectedHead: projectGitHead(target)
  })
)

def pullMergeRefusesBeforePrepare(object branchRefusal) boolean (
  return branchRefusal.len > 0 and (branchRefusal.code ?? "").toStr() != "target_branch_missing"
)

def pullMergeAlreadyMerged(object prepared) boolean (
  return prepared.ok == true and (prepared.alreadyMerged ?? false) == true
)

def handleMergePull(*serve.Context c) (
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 or pull.state.toStr() != "open" (
    c.notFound("open pull request not found")
    return
  )
  auto res = loadProject(c.param("id"))
  if !res.ok or !canEditProject(res.project.assert(object), c) (
    c.forbidden("only the project owner can merge")
    return
  )
  object target = res.project.assert(object)
  auto sourceResult = loadProject(pull.sourceProjectId.toStr())
  if !sourceResult.ok (
    c.notFound("source project not found")
    return
  )
  object source = sourceResult.project.assert(object)
  if !canInspectPullWithSource(pull, target, source, c) (
    c.forbidden("project source is restricted to its owner")
    return
  )
  string currentTargetHead = projectGitHead(target)
  object branchRefusal = pullTargetBranchRefusal(pull, target)
  if pullMergeRefusesBeforePrepare(branchRefusal) (
    c.json(409, branchRefusal)
    return
  )
  string sourceHead = livePullHead(pull, source)
  string targetWorkspacePath = cachedProjectWorkspacePath(target)
  string sourceWorkspacePath = cachedProjectWorkspacePath(source)
  if targetWorkspacePath == "" or sourceWorkspacePath == "" (
    if branchRefusal.len > 0 (
      c.json(409, branchRefusal)
      return
    )
    c.internalError("could not assemble pull request history")
    return
  )
  object prepared = preparePullMerge(pull, targetWorkspacePath, currentTargetHead, sourceWorkspacePath, sourceHead)
  if pullMergeAlreadyMerged(prepared) (
    closeAlreadyMergedPullLocked(c, pull, target.id.toStr(), currentTargetHead, sourceHead)
    return
  )
  if branchRefusal.len > 0 (
    c.json(409, branchRefusal)
    return
  )
  if prepared.ok != true (
    c.json(409, {ok: false, error: prepared.error.toStr(), code: "pull_merge_unavailable"})
    return
  )
  object merge = prepared
  if projectUncommittedSummary(target).len > 0 (
    c.json(409, {ok: false, error: "Commit the changes saved in this project before merging this pull request.", code: "uncommitted_changes"})
    return
  )
  boolean sourceClean = projectUncommittedSummary(source).len == 0
  if (merge.fastForward ?? false) == true and sourceClean and sourceHead == projectGitHead(source) (
    object merged = fastForwardPullLocked(c, pull, target, source, targetWorkspacePath, sourceWorkspacePath, currentTargetHead, sourceHead)
    if merged.ok != true (
      return
    )
    target = merged.target.assert(object)
    string previousJsonKey = merged.previousJsonKey.toStr()
    array previousWorkspaceKeys = merged.previousWorkspaceKeys.assert(array)
    if previousJsonKey != target.jsonKey.toStr() (
      removeProjectStorageKeyIfOrphaned(previousJsonKey, target.id.toStr(), false)
    )
    array keptWorkspaceKeys = projectWorkspaceKeys(target)
    for i previousWorkspaceKeys.len (
      string previousWorkspaceKey = previousWorkspaceKeys[i].toStr()
      if !keptWorkspaceKeys.contains(previousWorkspaceKey) (
        removeProjectStorageKeyIfOrphaned(previousWorkspaceKey, target.id.toStr(), true)
      )
    )
    c.json(200, {ok: true, merged: true, fastForward: true, pull: pullResponse(pullDocument(target.id.toStr(), pull.index.toStr())), head: projectGitHead(target)})
    return
  )
  recordPreparedPullHead(target.id.toStr(), pull.index.toStr(), sourceHead)
  c.json(200, {
    ok: true,
    merged: false,
    pull: livePullResponse(pull, (merge.baseHead ?? pull.baseCommit ?? "").toStr(), sourceHead),
    merge: merge,
    expectedHead: currentTargetHead,
    sourceHead: sourceHead,
    targetProjectId: target.id,
    sourceProjectId: source.id
  })
)

def projectCurrentBranch(object project) string (
  return if project.contains("gitBranch") and project.gitBranch != null and project.gitBranch.toStr() != "" then project.gitBranch.toStr() else "main"
)

def pullTargetBranchRefusal(object pull, object target) object (
  string targetBranch = pullTargetBranch(pull)
  string code = pullTargetBranchRefusalCode(targetBranch, projectCurrentBranch(target), projectBranchNames(target))
  if code == "target_branch_changed" (
    return {ok: false, error: "Switch this project to the " ++ targetBranch ++ " branch before merging this pull request.", code: code, branch: targetBranch}
  )
  if code == "target_branch_missing" (
    return {ok: false, error: "This pull request targets the " ++ targetBranch ++ " branch, which no longer exists.", code: code, branch: targetBranch}
  )
  return {}
)

def recordPreparedPullHead(string targetId, string pullIndex, string sourceHead) (
  string saveLock = "project-history-" ++ targetId
  sync.lock(saveLock)
  defer sync.unlock(saveLock)
  string pullLock = "pull-comment-count:" ++ targetId ++ ":" ++ pullIndex
  sync.lock(pullLock)
  defer sync.unlock(pullLock)
  object latest = pullDocument(targetId, pullIndex)
  if latest.len == 0 or (latest.state ?? "").toStr() != "open" or (latest.preparedSourceHead ?? "").toStr() == sourceHead (
    return
  )
  latest.preparedSourceHead = sourceHead
  putDocument(pullDocs, latest["_id"].toStr(), latest)
)

def closeAlreadyMergedPullLocked(*serve.Context c, object pull, string targetId, string expectedHead, string sourceHead) (
  string saveLock = "project-history-" ++ targetId
  sync.lock(saveLock)
  defer sync.unlock(saveLock)
  auto latestResult = loadProject(targetId)
  if !latestResult.ok or projectGitHead(latestResult.project.assert(object)) != expectedHead (
    c.json(409, {ok: false, error: "This project changed while the merge was processing. Merge again to include the latest changes.", code: "head_changed"})
    return
  )
  object latest = latestResult.project.assert(object)
  if !completeNativePull(latest, pull.index.toStr(), expectedHead, sourceHead, canEditProject(latest, c)) (
    if (pullDocument(targetId, pull.index.toStr()).state ?? "").toStr() == "open" (
      c.internalError("these changes are already in this project, but the pull request could not be closed")
      return
    )
    c.json(409, {ok: false, error: "the pull request is no longer open", code: "pull_not_open"})
    return
  )
  c.json(200, {ok: true, merged: true, alreadyMerged: true, pull: pullResponse(pullDocument(targetId, pull.index.toStr())), head: expectedHead})
)

def preparePullMerge(object pull, string targetWorkspacePath, string targetHead, string sourceWorkspacePath, string sourceHead) object (
  string fallback = "the pull request could not be merged on the server"
  auto parsed = json.parse(gitinspection.PrepareRemixMergeJSON(targetWorkspacePath, targetHead, sourceWorkspacePath, sourceHead, "target", "pull request"), {type: "object"})
  if !parsed.isErr() and parsed.unwrap().assert(object).ok == true (
    return parsed.unwrap().assert(object)
  )
  string failureMessage = if parsed.isErr() then fallback else (parsed.unwrap().assert(object).error ?? fallback).toStr()
  string storedBase = (pull.baseCommit ?? "").toStr()
  if !validGitObjectId(storedBase) (
    return {ok: false, error: failureMessage}
  )
  auto storedParsed = json.parse(gitinspection.PrepareMergeJSON(targetWorkspacePath, targetHead, sourceWorkspacePath, sourceHead, storedBase), {type: "object"})
  if storedParsed.isErr() or storedParsed.unwrap().assert(object).ok != true (
    return {ok: false, error: failureMessage}
  )
  return storedParsed.unwrap().assert(object)
)

def fastForwardPullLocked(*serve.Context c, object pull, object target, object source, string targetWorkspacePath, string sourceWorkspacePath, string currentTargetHead, string currentSourceHead) object (
  string lockName = "project-history-" ++ target.id.toStr()
  sync.lock(lockName)
  defer sync.unlock(lockName)
  auto latestTargetResult = loadProject(target.id.toStr())
  auto latestSourceResult = loadProject(source.id.toStr())
  if !latestTargetResult.ok or !latestSourceResult.ok or projectGitHead(latestTargetResult.project.assert(object)) != currentTargetHead or projectGitHead(latestSourceResult.project.assert(object)) != currentSourceHead (
    c.json(409, {ok: false, error: "a project changed while this merge was processing", code: "head_changed"})
    return {ok: false}
  )
  target = latestTargetResult.project.assert(object)
  source = latestSourceResult.project.assert(object)
  if projectUncommittedSummary(target).len > 0 or projectUncommittedSummary(source).len > 0 (
    c.json(409, {ok: false, error: "Commit the changes saved in this project before merging this pull request.", code: "uncommitted_changes"})
    return {ok: false}
  )
  object sourceJsonSnapshot = ensureProjectJsonSnapshot(source)
  if !sourceJsonSnapshot.ok (
    c.internalError("could not prepare the source project")
    return {ok: false}
  )
  source = sourceJsonSnapshot.project.assert(object)
  object sourceWorkspaceSnapshots = ensureProjectWorkspaceSnapshots(source)
  if !sourceWorkspaceSnapshots.ok (
    c.internalError("could not prepare the source project history")
    return {ok: false}
  )
  source = sourceWorkspaceSnapshots.project.assert(object)
  string mergeArchivePath = tmpDir ++ target.id.toStr() ++ "." ++ randomString(8) ++ ".pull-merge.mwp"
  string targetBranch = if target.contains("gitBranch") and target.gitBranch != null then target.gitBranch.toStr() else "main"
  string targetRemixParent = if target.contains("remixParent") and target.remixParent != null then target.remixParent.toStr() else ""
  string targetBaseCommit = if target.contains("remixBaseCommit") and target.remixBaseCommit != null then target.remixBaseCommit.toStr() else ""
  string targetId = target.id.toStr()
  string mergeAuthor = normalizeUsername(contextString(c, "username"))
  string mergeMessage = "Merge pull request #" ++ pull.index.toStr()
  number mergeTimestamp = timestamp
  string mergeArchiveJson = gitinspection.CreateFastForwardMergeArchiveJSON(targetWorkspacePath, currentTargetHead, sourceWorkspacePath, currentSourceHead, mergeArchivePath, targetId, targetRemixParent, targetBaseCommit, targetBranch, mergeAuthor, mergeMessage, mergeTimestamp / 1000)
  auto parsedMergeArchive = json.parse(mergeArchiveJson, {type: "object"})
  if parsedMergeArchive.isErr() or parsedMergeArchive.unwrap().assert(object).ok != true or !fs.exists(mergeArchivePath) (
    void fs.remove(mergeArchivePath)
    c.internalError("could not create the pull request merge commit")
    return {ok: false}
  )
  object mergeArchiveResult = parsedMergeArchive.unwrap().assert(object)
  object mergeArchiveGit = mergeArchiveResult.manifest.assert(object)
  byte[] mergeArchiveBody = fs.readFileBytes(mergeArchivePath).unwrapOr("".toBytes())
  void fs.remove(mergeArchivePath)
  object checkedHistory = validateUploadedHistory(target, mergeArchiveBody, json.stringify(mergeArchiveGit), currentTargetHead)
  if !checkedHistory.ok (
    c.json(409, {ok: false, code: "invalid_workspace", error: checkedHistory.error})
    return {ok: false}
  )
  mergeArchiveBody = checkedHistory.data.assert(byte[])
  mergeArchiveGit = checkedHistory.manifest.assert(object)
  if mergeArchiveBody.len > maxWorkspaceBytes (
    c.json(413, {ok: false, error: "MistWarp project history exceeds the 90 MB limit", code: "workspace_too_large"})
    return {ok: false}
  )
  string mergeArchiveKey = projectWorkspaceSnapshotKey(contentHash(mergeArchiveBody))
  if !stageR2Blob(mergeArchiveKey, mergeArchiveBody, "application/x-mistwarp-project", "") (
    c.internalError("could not store the pull request merge history")
    return {ok: false}
  )
  string previousJsonKey = target.jsonKey.toStr()
  array previousWorkspaceKeys = projectWorkspaceKeys(target)
  array previousExtensions = storedProjectExtensions(target)
  target.jsonKey = source.jsonKey
  target.jsonGzip = true
  target.inheritedJson = true
  target.pendingJson = false
  target.workspaceKey = mergeArchiveKey
  target.workspaceLayers = [mergeArchiveKey]
  target.historyBytes = mergeArchiveBody.len
  target.gitHead = mergeArchiveGit.head
  target.gitBranch = mergeArchiveGit.branch
  target.gitCommits = mergeArchiveGit.commits
  target.gitGraph = mergeArchiveGit.graph
  target.assets = source.assets
  target.sizeBytes = projectSizeBytes(source)
  target.edited = timestamp
  target.lastUploadAt = timestamp
  if source.contains("jsonBytes") (
    target.jsonBytes = source.jsonBytes
  )
  if source.contains("storedJsonBytes") (
    target.storedJsonBytes = source.storedJsonBytes
  )
  if source.contains("assetBytes") (
    target.assetBytes = source.assetBytes
  )
  if source.contains("extensions") (
    target.extensions = source.extensions
  ) else (
    target.extensions = []
  )
  target.extensionsIndexed = source.contains("extensionsIndexed") and source.extensionsIndexed == true
  if !storeProjectExtensions(target.id.toStr(), previousExtensions, storedProjectExtensions(target), {}) or !saveProject(target) (
    removeProjectStorageKeyIfOrphaned(mergeArchiveKey, target.id.toStr(), true)
    c.internalError("could not save the merged project")
    return {ok: false}
  )
  upsertIndexEntry(target)
  storageSettleProject(target)
  if !completeNativePull(target, pull.index.toStr(), currentTargetHead, currentSourceHead, canEditProject(target, c)) (
    c.internalError("the project merged, but the pull request could not be closed")
    return {ok: false}
  )
  return {ok: true, target: target, previousJsonKey: previousJsonKey, previousWorkspaceKeys: previousWorkspaceKeys}
)

def handleClosePull(*serve.Context c) (
  object pull = pullDocument(c.param("id"), c.param("index"))
  if pull.len == 0 or pull.state.toStr() != "open" (
    c.notFound("open pull request not found")
    return
  )
  auto targetResult = loadProject(pull.targetProjectId.toStr())
  if !targetResult.ok (
    c.notFound("project not found")
    return
  )
  object target = targetResult.project.assert(object)
  if !canClosePull(pull, target, c) (
    c.forbidden("only the fork owner and project maintainers can close this pull request")
    return
  )
  object closed = closePullLocked(target.id.toStr(), pull.index.toStr())
  if (closed.writeFailed ?? false) == true (
    c.internalError("could not close pull request")
    return
  )
  if closed.len == 0 (
    c.json(409, {ok: false, error: "the pull request is no longer open", code: "pull_not_open"})
    return
  )
  object response = pullResponse(closed)
  response.canClose = true
  response.canMerge = canEditProject(target, c)
  c.json(200, {ok: true, pull: response})
)

def closePullLocked(string targetId, string pullIndex) object (
  string pullLock = "pull-comment-count:" ++ targetId ++ ":" ++ pullIndex
  sync.lock(pullLock)
  defer sync.unlock(pullLock)
  object latest = pullDocument(targetId, pullIndex)
  if latest.len == 0 or (latest.state ?? "").toStr() != "open" (
    return {}
  )
  latest.state = "closed"
  latest.updated = timestamp
  if !putDocument(pullDocs, latest["_id"].toStr(), latest) (
    return {writeFailed: true}
  )
  return latest
)

def markPullMergedLocked(object project, string pullIndex, string mergedHead) object (
  string pullLock = "pull-comment-count:" ++ project.id.toStr() ++ ":" ++ pullIndex
  sync.lock(pullLock)
  defer sync.unlock(pullLock)
  object pull = pullDocument(project.id.toStr(), pullIndex)
  if pull.len == 0 or (pull.state ?? "").toStr() != "open" (
    return {}
  )
  pull.state = "merged"
  pull.mergedCommit = projectGitHead(project)
  if mergedHead != "" (
    pull.headCommit = mergedHead
  )
  pull.updated = timestamp
  if !putDocument(pullDocs, pull["_id"].toStr(), pull) (
    return {}
  )
  return pull
)

def completeNativePull(object project, string pullIndex, string expectedHead, string mergedHead, boolean canMerge) boolean (
  if !canMerge or expectedHead == "" (
    return false
  )
  object pull = markPullMergedLocked(project, pullIndex, mergedHead)
  if pull.len == 0 (
    return false
  )

  number acceptedChanges = 0
  if project.contains("acceptedChanges") and project.acceptedChanges != null (
    acceptedChanges = project.acceptedChanges.toNum()
  )
  project.acceptedChanges = acceptedChanges + 1
  array mergedContributors = []
  if project.contains("mergedContributors") and project.mergedContributors != null (
    mergedContributors = project.mergedContributors.assert(array)
  )
  string contributor = pull.sourceOwner.toStr()
  if contributor != "" and !mergedContributors.contains(contributor) (
    mergedContributors.append(contributor)
  )
  project.mergedContributors = mergedContributors
  saveProject(project)
  upsertIndexEntry(project)
  addNotification(pull.sourceOwner.toStr(), project.owner.toStr(), "contribution_merged", {projectId: project.id, projectTitle: project.title, pull: pull.index})
  if pull.contains("bountyId") and pull.bountyId != null and pull.bountyId.toStr() != "" (
    boolean bountyPaid = awardContributionBounty(pull.bountyId.toStr(), project.id.toStr(), pull.sourceOwner.toStr())
    if !bountyPaid (
      log "WARNING: could not award contribution bounty " ++ pull.bountyId.toStr()
    )
  )
  return true
)
