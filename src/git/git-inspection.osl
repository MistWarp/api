export {
  cachedProjectWorkspacePath,
  projectRecordsCommit,
  projectWorkspaceFingerprint,
  validGitObjectId,
  writeForkHistoryArchive
}

*cache.Cache gitInspectionPruneCache = cache.new({capacity: 4, ttl: 300000})

def projectWorkspaceFingerprint(object project) string (
  array keys = projectWorkspaceKeys(project)
  string identity = ""
  for i keys.len (
    identity ++= keys[i].toStr().toBytes().len.toStr() ++ ":" ++ keys[i].toStr() ++ ";"
  )
  return identity.hashSHA256()
)

def gitInspectionCacheVersion() string (
  return "v3"
)

def pruneGitInspectionCache(string cacheDir, string preserveName) (
  number calls = 0
  if gitInspectionPruneCache.has(cacheDir) (
    calls = gitInspectionPruneCache.get(cacheDir).toNum()
  )
  calls += 1
  gitInspectionPruneCache.set(cacheDir, calls)
  if !shouldPruneGitInspectionCache(calls) (
    return
  )
  storagefs.PruneCacheDir(cacheDir, preserveName)
)

def cachedProjectWorkspacePath(object project) string (
  array keys = projectWorkspaceKeys(project)
  if keys.len == 0 (
    return ""
  )
  if keys.len == 1 (
    string localPath = localBlobPath(keys[1].toStr())
    if fs.exists(localPath) (
      return localPath
    )
  )
  string cacheDir = tmpDir ++ "git-inspection/"
  void fs.mkdir(cacheDir, {recursive: true})
  string cacheName = projectWorkspaceFingerprint(project) ++ ".mwp"
  pruneGitInspectionCache(cacheDir, cacheName)
  string cachedPath = cacheDir ++ cacheName
  if fs.exists(cachedPath) (
    return cachedPath
  )
  string lockName = "git-inspection-workspace-" ++ cacheName
  sync.lock(lockName)
  defer sync.unlock(lockName)
  if fs.exists(cachedPath) (
    return cachedPath
  )
  string temporaryPath = cachedPath ++ ".tmp." ++ randomString(8)
  if !copyProjectWorkspaceToPath(project, temporaryPath) (
    void fs.remove(temporaryPath)
    return ""
  )
  if !fs.rename(temporaryPath, cachedPath) (
    void fs.remove(temporaryPath)
    if !fs.exists(cachedPath) (
      return ""
    )
  )
  return cachedPath
)

def writeForkHistoryArchive(object project, string branch, string forkId, string outputPath) object (
  string forkJson = gitinspection.ForkHistoryArchiveJSON(cachedProjectWorkspacePath(project), outputPath, branch, forkId, project.id.toStr())
  auto parsed = json.parse(forkJson, {type: "object"})
  if parsed.isErr() or parsed.unwrap().assert(object).ok != true (
    void fs.remove(outputPath)
    return {ok: false}
  )
  return {ok: true, manifest: parsed.unwrap().assert(object).manifest.assert(object)}
)

def validGitObjectId(string oid) boolean (
  return regex.match("^[a-f0-9]{40}$", oid)
)

def projectGitAllowedHeads(object project) array (
  array heads = []
  string head = projectGitHead(project)
  if validGitObjectId(head) (
    heads.append(head)
  )
  if project.contains("gitGraph") and project.gitGraph != null (
    object graph = project.gitGraph.assertElse(object, {})
    if graph.contains("branchLogs") and graph.branchLogs != null (
      array logs = graph.branchLogs.assertElse(array, [])
      for i logs.len (
        object branchLog = logs[i].assertElse(object, {})
        if branchLog.contains("oids") and branchLog.oids != null (
          array oids = branchLog.oids.assertElse(array, [])
          if oids.len > 0 (
            string branchHead = oids[1].toStr()
            if validGitObjectId(branchHead) and !heads.contains(branchHead) (
              heads.append(branchHead)
            )
          )
        )
      )
    )
  )
  return heads
)

def projectGitAllowedHeadsString(object project) string (
  array heads = projectGitAllowedHeads(project)
  string joined = ""
  for i heads.len (
    if joined != "" (
      joined ++= ","
    )
    joined ++= heads[i].toStr()
  )
  return joined
)

def projectRecordsCommit(object project, string sha) boolean (
  if projectGitHead(project) == sha (
    return true
  )
  if project.contains("gitCommits") and project.gitCommits != null (
    array commits = project.gitCommits.assertElse(array, [])
    for i commits.len (
      object commit = commits[i].assertElse(object, {})
      if commit.contains("sha") and commit.sha.toStr() == sha (
        return true
      )
    )
  )
  if project.contains("gitGraph") and project.gitGraph != null (
    object graph = project.gitGraph.assertElse(object, {})
    if graph.contains("nodes") and graph.nodes != null (
      array nodes = graph.nodes.assertElse(array, [])
      for i nodes.len (
        object node = nodes[i].assertElse(object, {})
        if node.contains("sha") and node.sha.toStr() == sha (
          return true
        )
      )
    )
  )
  return false
)

def validGitFilePath(string path) boolean (
  if path == "" or path.len > 1024 or path.startsWith("/") or path.contains("\\") or path.contains("\x00") (
    return false
  )
  array parts = path.split("/")
  for i parts.len (
    string part = parts[i].toStr()
    if part == "" or part == "." or part == ".." (
      return false
    )
  )
  return true
)

def cachedWorkspaceGitInspectionJSON(object project, string workspacePath, string sha, string operation, string requestedPath, string allowedHeads) string (
  string cacheDir = tmpDir ++ "git-inspection-results/"
  void fs.mkdir(cacheDir, {recursive: true})
  string cacheKey = projectWorkspaceFingerprint(project) ++ "." ++ allowedHeads.hashSHA256() ++ "." ++ sha ++ "." ++ operation ++ "." ++ requestedPath.hashSHA256()
  string cacheName = gitInspectionCacheVersion() ++ "." ++ cacheKey.hashSHA256() ++ ".json"
  pruneGitInspectionCache(cacheDir, cacheName)
  string cachePath = cacheDir ++ cacheName
  if fs.exists(cachePath) and fs.size(cachePath).unwrapOr(0) <= 33554432 (
    return fs.readFile(cachePath).unwrapOr("")
  )
  string resultJson = gitinspection.Inspect(workspacePath, sha, operation, requestedPath, allowedHeads)
  if resultJson.toBytes().len <= 1048576 and gitinspection.InspectionError(resultJson) == "" (
    string temporaryPath = cachePath ++ ".tmp." ++ randomString(8)
    if !fs.writeFile(temporaryPath, resultJson) or !fs.rename(temporaryPath, cachePath) (
      void fs.remove(temporaryPath)
    )
  )
  return resultJson
)

def gitInspectionResponse(*serve.Context c, object project, string sha, string operation, string requestedPath) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  string pullIndex = (c.query("pull") ?? "")
  string pullTarget = (c.query("pullTarget") ?? "")
  boolean pullCommit = pullIndex != "" and pullTarget != "" and canAccessPullProjectCommit(project, pullTarget, pullIndex, sha, c)
  if !canSeeInsideProject(project, c) and !pullCommit (
    c.notFound("commit not found")
    return
  )
  if !validGitObjectId(sha) (
    c.notFound("commit not found")
    return
  )
  if !projectRecordsCommit(project, sha) and !pullCommit (
    c.notFound("commit not found")
    return
  )
  if operation == "file" and !validGitFilePath(requestedPath) (
    c.badRequest("invalid file path")
    return
  )
  string allowedHeads = projectGitAllowedHeadsString(project)
  if allowedHeads == "" (
    c.notFound("commit not found")
    return
  )
  string fingerprint = projectWorkspaceFingerprint(project)
  string historyFingerprint = allowedHeads.hashSHA256()
  string etag = "\"git-" ++ gitInspectionCacheVersion() ++ "-" ++ fingerprint ++ "-" ++ historyFingerprint ++ "-" ++ sha ++ "-" ++ operation ++ "-" ++ requestedPath.hashSHA256() ++ "\""
  c.setHeader("ETag", etag)
  c.setHeader("Vary", "Authorization, Cookie")
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  if (c.header("If-None-Match") ?? "").contains(etag) (
    c.status(304)
    return
  )
  string workspacePath = cachedProjectWorkspacePath(project)
  if workspacePath == "" (
    c.notFound("workspace not found")
    return
  )
  string resultJson = if operation == "file" then gitinspection.Inspect(workspacePath, sha, operation, requestedPath, allowedHeads) else cachedWorkspaceGitInspectionJSON(project, workspacePath, sha, operation, requestedPath, allowedHeads)
  string problem = gitinspection.InspectionError(resultJson)
  if problem == "could not inspect project history" (
    c.internalError(problem)
    return
  )
  if problem != "" (
    c.notFound(problem)
    return
  )
  c.send(200, "application/json; charset=utf-8", resultJson)
)

def handleGetCommitInspection(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  string operation = if (c.query("inline") ?? "") == "1" then "commit-inline" else "commit"
  gitInspectionResponse(c, res.project.assert(object), c.param("sha"), operation, "")
)

def handleGetCommitChanges(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  gitInspectionResponse(c, res.project.assert(object), c.param("sha"), "changes", "")
)

def handleGetCommitTree(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  gitInspectionResponse(c, res.project.assert(object), c.param("sha"), "tree", "")
)

def handleGetCommitLastCommits(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  gitInspectionResponse(c, res.project.assert(object), c.param("sha"), "last-commits", "")
)

def handleGetCommitFile(*serve.Context c) (
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  gitInspectionResponse(c, res.project.assert(object), c.param("sha"), "file", (c.query("path") ?? ""))
)

def commitSummaryCacheDir() string (
  return tmpDir ++ "git-summaries/"
)

def commitSummaryCacheVersion() string (
  return "s1"
)

def commitSummaryCacheName(object project) string (
  return commitSummaryCacheVersion() ++ "." ++ project.id.toStr().hashSHA256() ++ ".json"
)

def readCommitSummaryCache(string cachePath) object (
  if !fs.exists(cachePath) or fs.size(cachePath).unwrapOr(0) > 8388608 (
    return {}
  )
  auto parsed = json.parse(fs.readFile(cachePath).unwrapOr(""), {type: "object"})
  if parsed.isErr() (
    return {}
  )
  return parsed.unwrap().assert(object)
)

def computeCommitSummary(string workspacePath, string sha, string allowedHeads) object (
  auto parsed = json.parse(gitinspection.Inspect(workspacePath, sha, "summary", "", allowedHeads), {type: "object"})
  if parsed.isErr() (
    return {ok: false, failedAt: timestamp}
  )
  object summary = parsed.unwrap().assert(object)
  if !summary.contains("ok") or summary.ok != true (
    return {ok: false, failedAt: timestamp}
  )
  return summary
)

def storeCommitSummaries(string cacheDir, string cacheName, object computed) (
  string cachePath = cacheDir ++ cacheName
  string lockName = "git-summaries-" ++ cacheName
  sync.lock(lockName)
  defer sync.unlock(lockName)
  object cached = mergedCommitSummaryCache(readCommitSummaryCache(cachePath), computed)
  string temporaryPath = cachePath ++ ".tmp." ++ randomString(8)
  if fs.writeFile(temporaryPath, json.stringify(cached)) (
    if !fs.rename(temporaryPath, cachePath) (
      void fs.remove(temporaryPath)
    )
  )
  pruneGitInspectionCache(cacheDir, cacheName)
)

def handleGetCommitSummaries(*serve.Context c) (
  c.setHeader("Cache-Control", "private, no-store")
  c.setHeader("CDN-Cache-Control", "private, no-store")
  auto res = loadProject(c.param("id"))
  if !res.ok (
    c.notFound("project not found")
    return
  )
  object project = res.project.assert(object)
  if !canSeeInsideProject(project, c) (
    c.notFound("project not found")
    return
  )
  array shas = requestedCommitShas((c.query("shas") ?? ""))
  object summaries = {}
  string allowedHeads = projectGitAllowedHeadsString(project)
  if shas.len == 0 or allowedHeads == "" (
    c.json(200, {ok: true, summaries: summaries})
    return
  )
  string cacheDir = commitSummaryCacheDir()
  void fs.mkdir(cacheDir, {recursive: true})
  string cacheName = commitSummaryCacheName(project)
  object cached = readCommitSummaryCache(cacheDir ++ cacheName)
  object computed = {}
  string workspacePath = ""
  boolean workspaceMissing = false
  for i shas.len (
    string sha = shas[i].toStr()
    if projectRecordsCommit(project, sha) (
      object entry = cachedCommitSummary(cached, sha, timestamp)
      if entry.contains("ok") (
        if entry.ok == true (
          summaries[sha] = entry
        )
      ) else if !workspaceMissing (
        if workspacePath == "" (
          workspacePath = cachedProjectWorkspacePath(project)
          workspaceMissing = workspacePath == ""
        )
        if !workspaceMissing (
          object summary = computeCommitSummary(workspacePath, sha, allowedHeads)
          computed[sha] = summary
          if summary.ok == true (
            summaries[sha] = summary
          )
        )
      )
    )
  )
  if computed.len > 0 (
    storeCommitSummaries(cacheDir, cacheName, computed)
  )
  c.json(200, {ok: true, summaries: summaries})
)
