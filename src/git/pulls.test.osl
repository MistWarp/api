import "./pulls.osl"

object made = insertNativePullLocked({id: "p1"}, {id: "p2"}, "Pull", "Body", "", "base", 0, "sam", "u_sam")
testing.assert(made.ok == true and made.pull.index == 1 and lockIsFree("native-pull-sequence:p1"), "a pull is numbered and the sequence lock released")
failing = true
testing.assert(try(insertNativePullLocked({id: "p1"}, {id: "p2"}, "Pull", "Body", "", "base", 0, "sam", "u_sam")).isErr(), "a failure while numbering a pull reaches the caller")
testing.assert(lockIsFree("native-pull-sequence:p1"), "the sequence lock is released when numbering throws")
failing = false

object legacyPull = {"_id": "p1:1", targetProjectId: "p1", index: 1}
void putDocument(pullDocs, "p1:1", legacyPull)
countCreatedPullCommentLocked(legacyPull)
testing.assert(pullDocument("p1", "1").commentCount == 1 and lockIsFree("pull-comment-count:p1:1"), "a new comment is counted")
void putDocument(pullDocs, "p1:1", legacyPull)
def countCreated() boolean (
  countCreatedPullCommentLocked(legacyPull)
  return true
)
def countDeleted() boolean (
  countDeletedPullCommentLocked(legacyPull, 1)
  return true
)
failing = true
testing.assert(try(countCreated()).isErr() and lockIsFree("pull-comment-count:p1:1"), "the comment count lock is released when counting a new comment throws")
testing.assert(try(countDeleted()).isErr() and lockIsFree("pull-comment-count:p1:1"), "the comment count lock is released when counting a deleted comment throws")
failing = false

string pullBaseA = "a" * 40
string pullBaseB = "b" * 40
object closedForBase = {state: "closed", baseCommit: pullBaseA}
testing.assert(livePullBase(closedForBase, "", pullBaseB, "", pullBaseB) == pullBaseA, "closed pulls keep their recorded base")
testing.assert(livePullBase({state: "open", baseCommit: pullBaseA}, "", "", "", pullBaseB) == pullBaseA, "a missing target head keeps the recorded base")
testing.assert(livePullBase({state: "open", baseCommit: pullBaseA}, tmpDir ++ "none.mwp", pullBaseB, tmpDir ++ "none.mwp", pullBaseB) == pullBaseA, "unreadable histories keep the recorded base")
testing.assert(livePullBase({state: "open"}, "", "", "", "") == "", "a pull without a base reports none rather than null")

object openForMerge = {"_id": "p9:1", targetProjectId: "p9", index: 1, state: "open", headCommit: pullBaseA, sourceOwner: "mist"}
void putDocument(pullDocs, "p9:1", openForMerge)
recordPreparedPullHead("p9", "1", pullBaseB)
testing.assert(pullDocument("p9", "1").preparedSourceHead == pullBaseB and lockIsFree("project-history-p9"), "a prepared merge records the remix head it used")
testing.assert(!completeNativePull({id: "p9", gitHead: pullBaseB}, "1", pullBaseA, pullBaseB, false), "only people who can edit the project can complete a pull")
testing.assert(completeNativePull({id: "p9", gitHead: pullBaseB}, "1", pullBaseA, pullBaseB, true), "an editor completes the pull")
object mergedPull = pullDocument("p9", "1")
testing.assert(mergedPull.state == "merged" and mergedPull.headCommit == pullBaseB and mergedPull.mergedCommit == pullBaseB and lockIsFree("pull-comment-count:p9:1"), "a completed pull records the merged remix head and the merge commit")
testing.assert(!completeNativePull({id: "p9", gitHead: pullBaseB}, "1", pullBaseA, pullBaseB, true), "a pull is only completed once")
testing.assert(closePullLocked("p9", "1").len == 0 and pullDocument("p9", "1").state == "merged" and lockIsFree("pull-comment-count:p9:1"), "closing a merged pull leaves it merged")
object openToClose = {"_id": "p9:2", targetProjectId: "p9", index: 2, state: "open", headCommit: pullBaseA}
void putDocument(pullDocs, "p9:2", openToClose)
testing.assert(closePullLocked("p9", "2").state == "closed" and pullDocument("p9", "2").state == "closed" and lockIsFree("pull-comment-count:p9:2"), "an open pull closes")
testing.assert(!completeNativePull({id: "p9", gitHead: pullBaseB}, "2", pullBaseA, pullBaseB, true), "a closed pull cannot be merged")
recordPreparedPullHead("p9", "1", pullBaseA)
testing.assert(pullDocument("p9", "1").preparedSourceHead == pullBaseB, "a merged pull keeps its prepared head")

testing.assert(!pullMergeRefusesBeforePrepare({}), "an empty target branch refusal allows preparePullMerge")
testing.assert(pullMergeRefusesBeforePrepare({code: "target_branch_changed"}), "target_branch_changed refuses before preparePullMerge")
testing.assert(!pullMergeRefusesBeforePrepare({code: "target_branch_missing"}), "target_branch_missing defers refusal until after preparePullMerge checks alreadyMerged")
testing.assert(pullMergeAlreadyMerged({ok: true, alreadyMerged: true}), "an already-merged preparation is recognized")
testing.assert(!pullMergeAlreadyMerged({ok: true, alreadyMerged: false}), "a non-merged preparation is not treated as already merged")
testing.assert(!pullMergeAlreadyMerged({ok: false, alreadyMerged: true}), "a failed preparation is not treated as already merged")

def handleTestMerge(*serve.Context c) (
  void fastForwardPullLocked(c, {index: 1}, {id: "p1"}, {id: "p2"}, "", "", "h1", "h2")
)
def handleTestBranches(*serve.Context c) (
  handleProjectBranchMutation(c, "create")
)
*serve.Router app = serve.new()
app.POST("/projects/:id/merge", handleTestMerge)
app.POST("/projects/:id/branches", handleTestBranches)
app.GET("/ready", def(*serve.Context c) -> (
  c.json(200, {ok: true})
))
def runApp() (
  app.run(":18353")
)
thread.new(runApp)
string base = "http://127.0.0.1:18353"
for i 50 (
  if requests.get(base ++ "/ready").isOk() (
    break
  )
  wait 0.1
)

failing = true
number mergeStatus = requests.post(base ++ "/projects/p1/merge", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(mergeStatus >= 500 and lockIsFree("project-history-p1"), "the save lock is released when a pull merge throws")
number branchStatus = requests.post(base ++ "/projects/p1/branches", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(branchStatus >= 500 and lockIsFree("project-history-p1"), "the save lock is released when a branch change throws")
failing = false
number missingStatus = requests.post(base ++ "/projects/p1/branches", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(missingStatus == 404 and lockIsFree("project-history-p1"), "branch changes still answer once the lock is free again")

testDb.close()
void fs.remove(dbPath)
