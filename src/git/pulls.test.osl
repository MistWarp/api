import "./pulls.osl"

object made = insertNativePullLocked({id: "p1"}, {id: "p2"}, "Pull", "Body", "", "base", 0, "sam", "u_sam")
testing.assert(made.ok == true and made.pull.index == 1 and lockIsFree("native-pull-sequence:p1"), "a pull is numbered and the sequence lock released")
failing = true
testing.assert(try(insertNativePullLocked({id: "p1"}, {id: "p2"}, "Pull", "Body", "", "base", 0, "sam", "u_sam")).isErr(), "a failure while numbering a pull reaches the caller")
testing.assert(lockIsFree("native-pull-sequence:p1"), "the sequence lock is released when numbering throws")
failing = false

object legacyPull = {"_id": "p1:1", targetProjectId: "p1", index: 1}
void putDocument(pullDocs, "p1:1", legacyPull)
countCreatedPullCommentLocked(legacyPull)
testing.assert(pullDocument("p1", "1").commentCount == 1 and lockIsFree("pull-comment-count:p1:1"), "a new comment is counted")
void putDocument(pullDocs, "p1:1", legacyPull)
def countCreated() boolean (
  countCreatedPullCommentLocked(legacyPull)
  return true
)
def countDeleted() boolean (
  countDeletedPullCommentLocked(legacyPull, 1)
  return true
)
failing = true
testing.assert(try(countCreated()).isErr() and lockIsFree("pull-comment-count:p1:1"), "the comment count lock is released when counting a new comment throws")
testing.assert(try(countDeleted()).isErr() and lockIsFree("pull-comment-count:p1:1"), "the comment count lock is released when counting a deleted comment throws")
failing = false

def handleTestMerge(*serve.Context c) (
  void fastForwardPullLocked(c, {index: 1}, {id: "p1"}, {id: "p2"}, "", "", "h1", "h2")
)
def handleTestBranches(*serve.Context c) (
  handleProjectBranchMutation(c, "create")
)
*serve.Router app = serve.new()
app.POST("/projects/:id/merge", handleTestMerge)
app.POST("/projects/:id/branches", handleTestBranches)
app.GET("/ready", def(*serve.Context c) -> (
  c.json(200, {ok: true})
))
def runApp() (
  app.run(":18353")
)
thread.new(runApp)
string base = "http://127.0.0.1:18353"
for i 50 (
  if requests.get(base ++ "/ready").isOk() (
    break
  )
  wait 0.1
)

failing = true
number mergeStatus = requests.post(base ++ "/projects/p1/merge", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(mergeStatus >= 500 and lockIsFree("project-history-p1"), "the save lock is released when a pull merge throws")
number branchStatus = requests.post(base ++ "/projects/p1/branches", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(branchStatus >= 500 and lockIsFree("project-history-p1"), "the save lock is released when a branch change throws")
failing = false
number missingStatus = requests.post(base ++ "/projects/p1/branches", {body: "{}"}).unwrapOr({status: 0}).status.toNum()
testing.assert(missingStatus == 404 and lockIsFree("project-history-p1"), "branch changes still answer once the lock is free again")

testDb.close()
void fs.remove(dbPath)
