export {
  registerGitRoutes
}

def registerGitRoutes(*serve.Router api) (
  api.GET("/projects/:id/commits", handleGetCommits)
  api.GET("/projects/:id/branches", handleListProjectBranches)
  api.POST("/projects/:id/branches", requireAuth, handleCreateProjectBranch)
  api.PATCH("/projects/:id/branches", requireAuth, handleRenameProjectBranch)
  api.DELETE("/projects/:id/branches", requireAuth, handleDeleteProjectBranch)
  api.POST("/projects/:id/branches/merge", requireAuth, handlePrepareBranchMerge)
  api.GET("/projects/:id/commits/:sha", handleGetCommitInspection)

  api.GET("/projects/:id/commits/:sha/tree", handleGetCommitTree)
  api.GET("/projects/:id/commits/:sha/file", handleGetCommitFile)
  api.GET("/projects/:id/pulls", handleListPulls)
  api.POST("/projects/:id/pulls", requireAuth, handleCreatePull)
  api.GET("/projects/:id/pulls/:index", handleGetPull)
  api.GET("/projects/:id/pulls/:index/timeline", handleGetPullTimeline)
  api.POST("/projects/:id/pulls/:index/comments", requireAuth, requireGoodStanding, serve.limitRequests(30, {window: 60000}), handleCreatePullComment)
  api.PUT("/projects/:id/pulls/:index/comments/:cid", requireAuth, handleEditPullComment)
  api.DELETE("/projects/:id/pulls/:index/comments/:cid", requireAuth, handleDeletePullComment)
  api.GET("/projects/:id/pulls/:index/diff", requireAuth, handleGetPullDiff)
  api.POST("/projects/:id/pulls/:index/merge", requireAuth, handleMergePull)
  api.POST("/projects/:id/pulls/:index/close", requireAuth, handleClosePull)
)
