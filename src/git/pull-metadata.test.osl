import "std:testing"
import "./pull-metadata.osl"

testing.assert(storedPullCommentCount({commentCount: 4}) == 4, "stored comment counts are used directly")
testing.assert(storedPullCommentCount({}) == -1, "legacy pulls report missing count metadata")
testing.assert(storedPullCommentCount({commentCount:-2}) == 0, "corrupt negative counts are clamped")
testing.assert(pullCommentCountAfterCreate({commentCount: 4}, 99) == 5, "new comments increment stored metadata")
testing.assert(pullCommentCountAfterCreate({}, 7) == 7, "legacy pulls backfill from the comment thread")
testing.assert(pullCommentCountAfterDelete({commentCount: 4}, 2, 99) == 2, "deleting a thread decrements by every removed comment")
testing.assert(pullCommentCountAfterDelete({commentCount: 1}, 3, 99) == 0, "deletes cannot make the count negative")
testing.assert(pullCommentCountAfterDelete({}, 2, 6) == 6, "legacy deletes backfill the remaining count")
testing.assert(nextPullSequence(4, []) == 5, "legacy sequence metadata remains usable")
testing.assert(nextPullSequence(4, [{index: 9}]) == 10, "stored pull documents repair a stale legacy sequence")
testing.assert(nextPullSequence(12, [{index: 9}]) == 13, "a newer legacy sequence is preserved")

string staleHead = "84223eef0258932ae0bf0bcb885ecb252431f6ec"
string branchHead = "ef2bedd84c4a6403078ab088c795fae166ea9baf"
object staleProject = {
  gitHead: staleHead,
  gitBranch: "main",
  gitGraph: {branchLogs: [{branch: "main", oids: [branchHead, staleHead]}]}
}
testing.assert(canonicalHistoryHead(staleProject) == branchHead, "the current branch tip wins over a stale stored head")
testing.assert(canonicalHistoryHead({head: staleHead, branch: "main", graph: {branchLogs: [{branch: "main", oids: [branchHead]}]}}) == branchHead, "uploaded history uses its branch tip")
testing.assert(canonicalHistoryHead({gitHead: staleHead}) == staleHead, "stored heads remain the fallback without branch metadata")

object openPull = {state: "open", headCommit: staleHead, sourceBranch: "main"}
testing.assert(livePullHeadFrom(openPull, "main", branchHead, "main", branchHead) == branchHead, "open pulls follow the source branch tip")
testing.assert(livePullHeadFrom(openPull, "main", "", "main", branchHead) == branchHead, "open pulls fall back to the current head of the same branch")
testing.assert(livePullHeadFrom(openPull, "main", "", "other", branchHead) == staleHead, "a missing source branch keeps the recorded head")
testing.assert(livePullHeadFrom({state: "merged", headCommit: staleHead, sourceBranch: "main"}, "main", branchHead, "main", branchHead) == staleHead, "merged pulls keep the head they merged")
testing.assert(livePullHeadFrom({state: "closed", headCommit: staleHead}, "main", branchHead, "main", branchHead) == staleHead, "closed pulls keep their recorded head")
testing.assert(livePullHeadFrom(openPull, "", branchHead, "main", branchHead) == staleHead, "an unknown source branch keeps the recorded head")

object legacyPull = {state: "open", headCommit: staleHead}
testing.assert(pullSourceBranch(openPull, ["main", "dev"]) == "main", "pulls name the branch they were opened from")
testing.assert(pullSourceBranch({state: "open", sourceBranch: "dev"}, ["main", "dev"]) == "dev", "pulls from another branch follow that branch")
testing.assert(pullSourceBranch(legacyPull, ["dev"]) == "dev", "legacy pulls from a one-branch remix follow that branch")
testing.assert(pullSourceBranch(legacyPull, []) == "main", "legacy pulls from a remix without branch metadata follow main")
testing.assert(pullSourceBranch(legacyPull, ["main", "dev"]) == "", "legacy pulls from a remix with several branches keep the recorded head")

testing.assert(pullTargetBranchRefusalCode("main", "main", ["main", "dev"]) == "", "a project on the target branch can merge")
testing.assert(pullTargetBranchRefusalCode("dev", "main", ["main", "dev"]) == "target_branch_changed", "a project on another branch must switch first")
testing.assert(pullTargetBranchRefusalCode("dev", "main", ["main"]) == "target_branch_missing", "a deleted target branch stops the merge")
testing.assert(pullTargetBranchRefusalCode("dev", "main", []) == "", "projects without branch metadata merge as before")
testing.assert(pullTargetBranchRefusalCode("", "main", ["main"]) == "", "pulls without a recorded target branch merge as before")
testing.assert(pullPreparedSourceHead({headCommit: staleHead, preparedSourceHead: branchHead}) == branchHead, "older clients merge the head the server last prepared")
testing.assert(pullPreparedSourceHead({headCommit: staleHead}) == staleHead, "without a prepared head the recorded head is used")
testing.assert(pullPreparedSourceHead({headCommit: staleHead, preparedSourceHead: ""}) == staleHead, "an empty prepared head falls back to the recorded head")
