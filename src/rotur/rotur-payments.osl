export {
  forgetPurchase,
  mistwarpFeeAccount,
  paidPurchase,
  startPurchase
}

*cache.Cache roturAppOwnerCache = cache.new({capacity: 4, ttl: 3600000})
number roturPaymentRequestLifetimeMs = 900000
number paymentRequestReuseMarginMs = 60000

def mistwarpFeeAccount() string (
  if mistwarpRoturUser != "" (
    return mistwarpRoturUser
  )
  if roturAppOwnerCache.has("owner") (
    return roturAppOwnerCache.get("owner").toStr()
  )
  object res = roturApp("GET", "", {})
  string owner = ""
  if res.ok (
    owner = (res.data.owner.username ?? "").toStr()
  )
  if owner != "" (
    roturAppOwnerCache.set("owner", owner)
  )
  return owner
)

def requestRoturPayment(string payer, string payee, array splits, number amount, string note, string reference, string returnUrl) object (
  object body = {payer: roturUserRef(payer), "to": roturUserRef(payee), amount: amount, note: note.trim(1, 160), reference: reference}
  if splits.len > 1 (
    array shares = []
    for i splits.len (
      object split = splits[i].assert(object)
      shares.append({"to": roturUserRef(split.username.toStr()), basis_points: split.basis_points})
    )
    body.splits = shares
  )
  if returnUrl != "" (
    body.return_url = returnUrl
  )
  object res = roturApp("POST", "/payment-requests", body)
  if !res.ok and (res.data.code ?? "").toStr() == "invalid_return_url" (
    body.delete("return_url")
    res = roturApp("POST", "/payment-requests", body)
  )
  if !res.ok (
    return {ok: false, error: (res.data.error ?? "payments are not available right now").toStr()}
  )
  number expiresAt = (res.data.expires_at ?? 0).toNum()
  if expiresAt <= 0 (
    expiresAt = timestamp + roturPaymentRequestLifetimeMs
  )
  return {ok: true, id: res.data.id.toStr(), approveUrl: res.data.approve_url.toStr(), expiresAt: expiresAt}
)

def splitsWithoutPayer(array splits, string payer) array (
  array kept = []
  number carried = 0
  for i splits.len (
    object split = splits[i].assertElse(object, {})
    number points = (split.basis_points ?? 0).toNum().toInt() + carried
    if split.username.toStr().toLower() == payer.toLower() (
      carried = points
    ) else (
      kept.append({username: split.username.toStr(), basis_points: points})
      carried = 0
    )
  )
  if carried > 0 and kept.len > 0 (
    object last = kept[kept.len].assertElse(object, {})
    last.basis_points = last.basis_points.toNum().toInt() + carried
    kept[kept.len] = last
  )
  return kept
)

def samePurchase(object stored, object entry, string prefix, string key) boolean (
  if !key.startsWith(prefix) or stored.paid == true or (stored.expiresAt ?? 0).toNum() < timestamp + paymentRequestReuseMarginMs or (stored.approveUrl ?? "").toStr() == "" (
    return false
  )
  array fields = entry.getKeys()
  for i fields.len (
    string field = fields[i].toStr()
    if json.stringify(stored[field]) != json.stringify(entry[field]) (
      return false
    )
  )
  return true
)

def roturPaymentStatus(string requestId) string (
  object res = roturApp("GET", "/payment-requests/" ++ url.escape(requestId), {})
  if !res.ok (
    return ""
  )
  return (res.data.status ?? "").toStr()
)

def roturPaymentPaid(string requestId, string reference) boolean (
  if requestId == "" (
    return false
  )
  object res = roturApp("GET", "/payment-requests/" ++ url.escape(requestId), {})
  return res.ok and res.data.status == "paid" and (res.data.reference ?? "").toStr() == reference
)

def startPurchase(string prefix, object entry, string payer, string payee, array splits, number amount, string note, string returnUrl) object (
  array shares = splitsWithoutPayer(splits, payer)
  entry.splits = shares
  string lock = "purchase-start:" ++ prefix ++ json.stringify(entry)
  sync.lock(lock)
  defer sync.unlock(lock)
  object open = loadPurchaseKeys().keys.assertElse(object, {})
  array openKeys = open.getKeys()
  for i openKeys.len (
    string openKey = openKeys[i].toStr()
    object stored = open[openKey].assertElse(object, {})
    if samePurchase(stored, entry, prefix, openKey) and roturPaymentStatus(stored.requestId.toStr()) == "pending" (
      return {ok: true, key: openKey, requestId: stored.requestId.toStr(), approveUrl: stored.approveUrl.toStr(), splits: shares}
    )
  )
  string key = prefix ++ randomString(16)
  object request = requestRoturPayment(payer, payee, shares, amount, note, key, returnUrl)
  if !request.ok (
    return request
  )
  entry.requestId = request.id
  entry.approveUrl = request.approveUrl
  entry.expiresAt = request.expiresAt
  entry.at = timestamp
  storePurchaseKeyLocked(key, entry)
  return {ok: true, key: key, requestId: request.id, approveUrl: request.approveUrl, splits: shares}
)

def storePurchaseKeyLocked(string key, object entry) (
  sync.lock("purchase-keys")
  defer sync.unlock("purchase-keys")
  object store = prunePurchaseKeys(loadPurchaseKeys())
  object keys = store.keys
  keys[key] = entry
  store.keys = keys
  savePurchaseKeys(store)
)

def paidPurchase(string key) object (
  object keys = loadPurchaseKeys().keys
  if key == "" or !keys.contains(key) (
    return {}
  )
  object entry = keys[key].assert(object)
  if entry.paid != true and !roturPaymentPaid((entry.requestId ?? "").toStr(), key) (
    return {}
  )
  entry.paid = true
  return entry
)

def forgetPurchase(string key) (
  sync.lock("purchase-keys")
  defer sync.unlock("purchase-keys")
  object store = loadPurchaseKeys()
  object keys = store.keys
  keys.delete(key)
  store.keys = keys
  savePurchaseKeys(store)
)

def completeRoturPayment(string reference, string requestId) (
  if !markPurchasePaidLocked(reference, requestId) (
    return
  )
  if reference.startsWith("mwbuy_") (
    completeProjectPurchase(reference)
  ) else if reference.startsWith("mwgame_") (
    completeGameProductPurchase(reference)
  )
)

def markPurchasePaidLocked(string reference, string requestId) boolean (
  sync.lock("purchase-keys")
  defer sync.unlock("purchase-keys")
  object store = loadPurchaseKeys()
  object keys = store.keys
  if !keys.contains(reference) or (keys[reference].requestId ?? "").toStr() != requestId (
    return false
  )
  object entry = keys[reference].assert(object)
  entry.paid = true
  keys[reference] = entry
  store.keys = keys
  savePurchaseKeys(store)
  return true
)
