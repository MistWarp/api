export {
  commentRefusal,
  isMessageNotification,
  roturMessageRefusal,
  roturPurchaseRefusal
}

*cache.Cache roturMessageSignals = cache.new({capacity: 10000, ttl: 60000})

def roturMessageSignal(string sender, string recipient) object (
  string senderKey = normalizeUsername(sender)
  string recipientKey = normalizeUsername(recipient)
  if senderKey == "" or recipientKey == "" or senderKey == recipientKey (
    return {allowed: true, code: "", reason: ""}
  )
  string cacheKey = senderKey ++ ">" ++ recipientKey
  if roturMessageSignals.has(cacheKey) (
    return roturMessageSignals.get(cacheKey).assertElse(object, {allowed: true, code: "", reason: ""})
  )
  object res = roturApp("POST", "/signals/message", {"from": roturUserRef(sender), "to": roturUserRef(recipient)})
  object signal = {allowed: true, code: "", reason: ""}
  if res.ok and res.data.allowed != true (
    signal = {
      allowed: false,
      code: (res.data.code ?? "settings").toStr(),
      reason: (res.data.reason ?? "Rotur settings don't allow this message.").toStr()
    }
  )
  if res.ok (
    roturMessageSignals.set(cacheKey, signal)
  )
  return signal
)

def roturMessageRefusal(string sender, string recipient) string (
  object signal = roturMessageSignal(sender, recipient)
  if signal.allowed == true (
    return ""
  )
  return signal.reason.toStr()
)

def isMessageNotification(string notifType) boolean (
  return ["comment", "reply", "mention", "profile_comment", "space_comment", "roadmap_comment", "donation"].contains(notifType)
)

def roturPurchaseRefusal(string buyer, number amount, string note) string (
  if buyer == "" or amount <= 0 (
    return ""
  )
  object res = roturApp("POST", "/signals/purchase", {user: roturUserRef(buyer), amount: amount, currency: "credits", record: false, note: note.trim(1, 80)})
  if !res.ok or res.data.allowed == true (
    return ""
  )
  return (res.data.reason ?? "Rotur settings don't allow this purchase.").toStr()
)

def commentRecipients(string key, string parentId) array (
  array recipients = []
  if key.startsWith("project-") (
    auto loaded = loadProject(key.replace("project-", ""))
    if loaded.ok (
      recipients.append(loaded.project.owner.toStr())
    )
  ) else if key.startsWith("profile-") (
    recipients.append(key.replace("profile-", ""))
  )
  if parentId != "" (
    array comments = loadComments(key)
    for i comments.len (
      object existing = comments[i].assert(object)
      if existing.id.toStr() == parentId (
        recipients.append(existing.author.toStr())
      )
    )
  )
  return recipients
)

def commentRefusal(string key, string author, string parentId) string (
  array recipients = commentRecipients(key, parentId)
  for i recipients.len (
    object signal = roturMessageSignal(author, recipients[i].toStr())
    if signal.allowed != true and (signal.code == "blocked" or signal.code == "banned") (
      return signal.reason.toStr()
    )
  )
  return ""
)
