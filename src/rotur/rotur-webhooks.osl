export {
  processRoturWebhooks
}

string roturWebhookSecret = configValue("ROTUR_WEBHOOK_SECRET", "")
string roturWebhooksFile = "data/rotur-webhooks.json"
number roturWebhookRetention = 604800000

def roturWebhookSignature(string secret, string id, string sentAt, string body) string (
  return "v1=" ++ crypto.hmac("sha256", secret, id ++ "." ++ sentAt ++ "." ++ body)
)

number roturWebhookMaxClockSkewSeconds = 300

def roturWebhookValid(string secret, string id, string sentAt, string body, string signature, number now) boolean (
  if secret == "" or id == "" or signature == "" or !regex.match("^[0-9]{1,12}$", sentAt) (
    return false
  )
  number sent = sentAt.toNum()
  if sent < now - roturWebhookMaxClockSkewSeconds or sent > now + roturWebhookMaxClockSkewSeconds (
    return false
  )
  return crypto.constantTimeCompare(signature, roturWebhookSignature(secret, id, sentAt, body))
)

def loadRoturWebhooks() object (
  auto res = readFile(roturWebhooksFile)
  if !res.ok (
    return {events: {}}
  )
  return res.data.assert(object)
)

def queueRoturWebhook(object event) boolean (
  string id = event.id.toStr()
  object data = {}
  if event.contains("data") and typeof(event.data) == "object" (
    data = event.data.assert(object)
  )
  sync.lock("rotur-webhooks")
  defer sync.unlock("rotur-webhooks")
  object store = loadRoturWebhooks()
  object events = store.events.assert(object)
  if events.contains(id) (
    return false
  )
  object kept = {}
  array ids = events.getKeys()
  for i ids.len (
    string existingId = ids[i].toStr()
    object existing = events[existingId].assert(object)
    if existing.done != true or timestamp - existing.received.toNum() < roturWebhookRetention (
      kept[existingId] = existing
    )
  )
  kept[id] = {
    type: event.type.toStr(),
    userId: (data.user_id ?? "").toStr(),
    kind: (data.kind ?? "").toStr(),
    reference: (data.reference ?? "").toStr(),
    paymentRequest: (data.payment_request ?? "").toStr(),
    received: timestamp,
    done: false
  }
  store.events = kept
  writeFile(roturWebhooksFile, store)
  return true
)

def markRoturWebhookDone(string id) (
  sync.lock("rotur-webhooks")
  defer sync.unlock("rotur-webhooks")
  object store = loadRoturWebhooks()
  object events = store.events.assert(object)
  if events.contains(id) (
    object event = events[id].assert(object)
    event.done = true
    events[id] = event
    store.events = events
    writeFile(roturWebhooksFile, store)
  )
)

def handleRoturEvent(object event) (
  string type = event.type.toStr()
  if type == "payment.completed" (
    completeRoturPayment((event.reference ?? "").toStr(), (event.paymentRequest ?? "").toStr())
    return
  )
  string userId = event.userId.toStr()
  if userId == "" or isStudentUserId(userId) (
    return
  )
  string username = usernameForId(userId)
  if type == "user.deleted" or type == "user.left" or type == "user.banned" (
    log "Erasing MistWarp data for " ++ userId ++ " after " ++ type
    eraseUser(userId, username)
  ) else if type == "privacy.request" and event.kind.toStr() == "erasure" (
    log "Erasing MistWarp data for " ++ userId ++ " on request"
    eraseUser(userId, username)
  ) else if type == "privacy.request" and event.kind.toStr() == "access" and username != "" (
    addNotification(username, "", "moderation", {message: "You asked Rotur for a copy of your MistWarp data. Download it any time from Settings, under Privacy."})
  )
)

def processRoturWebhooks() (
  sync.lock("rotur-webhooks-worker")
  defer sync.unlock("rotur-webhooks-worker")
  object store = loadRoturWebhooks()
  object events = store.events.assert(object)
  array ids = events.getKeys()
  for i ids.len (
    string id = ids[i].toStr()
    object event = events[id].assert(object)
    if event.done != true (
      handleRoturEvent(event)
      markRoturWebhookDone(id)
    )
  )
)

def handleRoturWebhook(*serve.Context c) (
  if roturWebhookSecret == "" (
    c.json(503, {ok: false, error: "Rotur webhooks are not configured"})
    return
  )
  string body = c.body()
  string id = (c.header("Rotur-Webhook-Id") ?? "")
  if !roturWebhookValid(roturWebhookSecret, id, (c.header("Rotur-Webhook-Timestamp") ?? ""), body, (c.header("Rotur-Signature") ?? ""), (timestamp / 1000).toInt()) (
    c.json(401, {ok: false, error: "invalid signature"})
    return
  )
  auto parsed = json.parse(body, {type: "object"})
  if parsed.isErr() (
    c.badRequest("invalid body")
    return
  )
  object event = parsed.unwrap().assert(object)
  if event.id.toStr() != id (
    c.badRequest("event id does not match")
    return
  )
  if queueRoturWebhook(event) (
    thread.new(processRoturWebhooks)
  )
  c.json(200, {ok: true})
)
