export {
  roturApp,
  roturAppReady,
  roturClientId,
  roturUserRef
}

string roturClientId = configValue("ROTUR_CLIENT_ID", "")
string roturClientSecret = configValue("ROTUR_CLIENT_SECRET", "")

def roturAppReady() boolean (
  return roturClientId != "" and roturClientSecret != ""
)

def roturUserRef(string username) string (
  string userId = userIdForUsername(username)
  if userId != "" (
    return userId
  )
  return username
)

def roturApp(string method, string path, object body) object (
  if !roturAppReady() (
    return {ok: false, status: 0, data: {}}
  )
  object options = {timeout: 10, headers: {
    "Authorization": "Basic " ++ btoa(roturClientId ++ ":" ++ roturClientSecret),
    "Content-Type": "application/json"
  }}
  if method == "POST" or method == "PUT" or method == "PATCH" (
    options.body = json.stringify(body)
  )
  string target = roturBase ++ "/v2/apps/" ++ url.escape(roturClientId) ++ path
  object resp = {}
  if method == "GET" (
    resp = requests.get(target, options).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  ) else if method == "POST" (
    resp = requests.post(target, options).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  ) else if method == "PUT" (
    resp = requests.put(target, options).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  ) else if method == "PATCH" (
    resp = requests.patch(target, options).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  ) else (
    resp = requests.delete(target, options).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  )
  number status = (resp.status ?? 0).toNum().toInt()
  object data = {}
  auto parsed = json.parse((resp.body ?? "").toStr(), {type: "object"})
  if !parsed.isErr() (
    data = parsed.unwrap().assert(object)
  )
  return {ok: status >= 200 and status < 300, status: status, data: data}
)
