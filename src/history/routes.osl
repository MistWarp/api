export {
  registerHistoryRoutes
}

def registerHistoryRoutes(*serve.Router api) (
  api.PATCH("/projects/:id/commits/:sha", requireAuth, handlePatchCommit)
  api.GET("/projects/:id/commits/:sha/co-authors", handleGetCommitCollaborators)
  api.GET("/projects/:id/commits/:sha/collaborators", handleGetCommitCollaborators)
)
