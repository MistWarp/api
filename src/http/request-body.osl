def requestJSON(*serve.Context c) object (
  object body = c.bodyJSON() catch (err) (
    if err.kind == "ParseError" (
      return {}
    )
    throw err
  )
  return body
)

def contextString(*serve.Context c, string key) string (
  string value = c.get(key) ?? ""
  return value
)

def contextBool(*serve.Context c, string key) boolean (
  boolean value = c.get(key) ?? false
  return value
)
