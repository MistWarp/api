def dotenvValue(string name) string (
  if !fs.exists(".env") (
    return ""
  )
  string contents = fs.readFile(".env") catch (err) (
    log "WARNING: could not read .env: " ++ err.toStr()
    return ""
  )
  array lines = contents.split("\n")
  for i lines.len (
    string line = lines[i].toStr().strip()
    if line.startsWith("export ") (
      line = line.replace("export ", "").strip()
    )
    if line != "" and !line.startsWith("#") and line.contains("=") (
      array parts = line.split("=")
      string key = parts[1].toStr().strip()
      if key == name (
        string value = parts[2].toStr().strip()
        for p parts.len (
          if p > 2 (
            value ++= "=" ++ parts[p].toStr()
          )
        )
        return value.replace("\"", "").replace("'", "")
      )
    )
  )
  return ""
)

def envValue(string name) string (
  string value = env.get(name, "") catch (err) (
    log "WARNING: could not read " ++ name ++ " from the environment: " ++ err.toStr()
    return ""
  )
  return value
)

def configValue(string name, string defaultValue) string (
  string value = envValue("MISTWARP_" ++ name)
  if value != "" (
    return value
  )
  value = dotenvValue(name)
  if value != "" (
    return value
  )
  value = envValue(name)
  if value != "" (
    return value
  )
  return defaultValue
)

