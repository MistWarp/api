def ownerIndexEntries(string owner, boolean includeUnshared) array (
    string ownerKey = normalizeUsername(owner)
    string ownerId = userIdForUsername(owner)
    array entries = []
    array stored = []
    if ownerId != "" (
        stored = projectSearchDocs.where("ownerId", db.equal, ownerId).sort("edited", db.desc).all()
    )
    if stored.len == 0 (
        stored = projectSearchDocs.where("ownerKey", db.equal, ownerKey).sort("edited", db.desc).all()
    )
    for i stored.len (
        object entry = stored[i].assert(object)
        if entry.shared == true or includeUnshared (
            entries.append(entry)
        )
    )
    return entries
)

def ownerIndexCount(string owner, boolean includeUnshared) number (
    string ownerKey = normalizeUsername(owner)
    if includeUnshared (
        return projectSearchDocs.where("ownerKey", db.equal, ownerKey).count()
    )
    return projectSearchDocs.where("ownerKey", db.equal, ownerKey).and("shared", db.equal, true).count()
)

def ownerIndexPage(string owner, boolean includeUnshared, number offset, number limit) array (
    string ownerKey = normalizeUsername(owner)
    number scanLimit = offset + limit
    array stored = []
    if includeUnshared (
        stored = projectSearchDocs.where("ownerKey", db.equal, ownerKey).sort("edited", db.desc).limit(scanLimit).all()
    ) else (
        stored = projectSearchDocs.where("ownerKey", db.equal, ownerKey).and("shared", db.equal, true).sort("edited", db.desc).limit(scanLimit).all()
    )
    return paginate(stored, offset, limit)
)

def isViewerOwner(*serve.Context c, string name) boolean (
    if !c.getBool("authenticated") (
        return false
    )
    if c.getBool("isAdmin") (
        return true
    )
    object profile = loadProfile(name)
    string profileId = ""
    if profile.contains("userId") and profile.userId != null (
        profileId = profile.userId.toStr()
    )
    return identityMatches(profileId, name, c.getString("userId"), c.getString("username"))
)

def recentProjectActivity(string name, number limit) array (
    string userId = userIdForUsername(name)
    array records = []
    if userId != "" (
        records = playtimeDocs.where("userId", db.equal, userId).sort("updated", db.desc).limit(limit * 3).all()
    )
    if records.len == 0 (
        records = playtimeDocs.where("username", db.equal, name).sort("updated", db.desc).limit(limit * 3).all()
    )
    array activity = []
    for i records.len (
        if activity.len < limit (
            object record = records[i].assert(object)
            object project = projectSearchDocs.findById(record.projectId.toStr())
            if project.isEmpty() == false and projectVisibility(project) == "public" (
                activity.append({
                    projectId: project.id,
                    title: project.title,
                    owner: project.owner,
                    thumbUrl: project.thumbUrl,
                    duration: record.duration,
                    lastPlayed: record.updated
                })
            )
        )
    )
    return activity
)

def handleGetUser(*serve.Context c) (
    string name = c.param("name")
    string key = normalizeUsername(name)
    if isSafePathPart(key) and !fs.exists(usersDir ++ key ++ ".json") (
        discoverUserIdentity(name)
    )
    boolean exists = profileExists(name)
    object profile = loadProfile(name)
    array followers = profile.followers.assert(array)
    array following = profile.following.assert(array)
    string viewer = normalizeUsername(c.getString("username"))
    object viewerSafety = {blocked: [], muted: []}
    if c.getBool("authenticated") and viewer != "" (
        viewerSafety = loadSafety(viewer)
    )
    number projectLimit = 24
    number projectTotal = ownerIndexCount(name, false)
    array projects = ownerIndexPage(name, false, 0, projectLimit)
    string featuredId = profile.featuredProject.toStr()
    if featuredId != "" (
        boolean featuredIncluded = false
        for i projects.len (
            if projects[i].id.toStr() == featuredId (
                featuredIncluded = true
            )
        )
        if !featuredIncluded (
            object featured = projectSearchDocs.findById(featuredId)
            if featured.isEmpty() == false and featured.shared == true and featured.ownerKey.toStr() == key (
                projects.append(featured)
            )
        )
    )

    boolean commentsOff = false
    if profile.contains("commentsOff") and profile.commentsOff == true (
        commentsOff = true
    )
    boolean recentActivityVisible = !profile.contains("showRecentActivity") or profile.showRecentActivity == true
    boolean ownsProfile = isViewerOwner(c, name)
    array recentActivity = []
    if recentActivityVisible or ownsProfile (
        recentActivity = recentProjectActivity(profile.username.toStr(), 6)
    )
    c.json(200, {
        ok: true,
        exists: exists or projectTotal > 0,
        username: profile.username,
        bio: profile.bio,
        featuredProject: profile.featuredProject,
        profileLayout: profile.contains("profileLayout") ? profile.profileLayout "classic",
        followerCount: followers.len,
        followingCount: following.len,
        isFollowing: followers.contains(viewer),
        viewerBlocked: viewerSafety.blocked.assert(array).contains(key),
        viewerMuted: viewerSafety.muted.assert(array).contains(key),
        commentsOff: commentsOff,
        recentActivityVisible: recentActivityVisible,
        recentActivity: recentActivity,
        projects: projects,
        projectTotal: projectTotal,
        projectOffset: projectLimit
    })
)

def handleSearchUsers(*serve.Context c) (
    string q = normalizeUsername(c.query("q"))
    if q == "" (
        c.json(200, {ok: true, users: []})
        return
    )
    array matches = []
    array found = profileSearchDocs.where("usernameKey", db.contains, q).limit(8).all()
    for i found.len (
        object profile = found[i].assert(object)
        number projectCount = projectSearchDocs.where("ownerKey", db.equal, profile.usernameKey).and("shared", db.equal, true).count()
        matches.append({username: profile.username, followers: profile.followers, projects: projectCount})
    )
    c.json(200, {ok: true, users: matches})
)

def handleUpdateProfile(*serve.Context c) (
    string username = c.getString("username")
    object profile = loadProfile(username)
    object body = c.bodyJSON()
    boolean changed = false

    if body.contains("bio") (
        string bio = body.bio.toStr()
        if bio.len > 300 (
            c.badRequest("bio too long")
            return
        )
        if profile.bio.toStr() != bio (
            profile.bio = bio
            changed = true
        )
    )

    if body.contains("featuredProject") (
        string featured = body.featuredProject.toStr()
        if featured != profile.featuredProject.toStr() and featured != "" (
            auto result = loadProject(featured)
            if !result.ok (
                c.badRequest("project not found")
                return
            )
            object project = result.project.assert(object)
            if projectRole(project, username) != "owner" (
                c.forbidden("not your project")
                return
            )
            if project.shared != true (
                c.badRequest("share the project before featuring it")
                return
            )
        )
        if profile.featuredProject.toStr() != featured (
            profile.featuredProject = featured
            changed = true
        )
    )

    if body.contains("commentsOff") (
        boolean commentsOff = body.commentsOff == true
        boolean currentCommentsOff = profile.contains("commentsOff") and profile.commentsOff == true
        if currentCommentsOff != commentsOff (
            profile.commentsOff = commentsOff
            changed = true
        )
    )

    if body.contains("showRecentActivity") (
        boolean showRecentActivity = body.showRecentActivity == true
        boolean currentShowRecentActivity = !profile.contains("showRecentActivity") or profile.showRecentActivity == true
        if currentShowRecentActivity != showRecentActivity (
            profile.showRecentActivity = showRecentActivity
            changed = true
        )
    )

    if body.contains("profileLayout") (
        string layout = body.profileLayout.toStr()
        if !unlockedProfileLayouts(profile).contains(layout) (
            c.forbidden("unlock this profile layout first")
            return
        )
        if (profile.profileLayout ?? "classic").toStr() != layout (
            profile.profileLayout = layout
            changed = true
        )
    )

    if changed (
        saveProfile(profile)
    )
    c.json(200, {ok: true})
)

def handleFollowUser(*serve.Context c) (
    string actor = c.getString("username")
    string target = c.param("name")
    string actorKey = normalizeUsername(actor)
    string targetKey = normalizeUsername(target)
    if actorKey == targetKey (
        c.badRequest("cannot follow yourself")
        return
    )
    if !profileExists(target) (
        c.notFound("user not found")
        return
    )
    if usersAreBlocked(actor, target) (
        c.forbidden("this user cannot be followed")
        return
    )

    object targetProfile = loadProfile(target)
    array followers = targetProfile.followers.assert(array)
    boolean wasFollowing = followers.contains(actorKey)
    if !wasFollowing (
        followers.append(actorKey)
        targetProfile.followers = followers
        saveProfile(targetProfile)
    )

    object actorProfile = loadProfile(actor)
    array following = actorProfile.following.assert(array)
    if !following.contains(targetKey) (
        following.append(targetKey)
        actorProfile.following = following
        saveProfile(actorProfile)
    )

    if !wasFollowing (
        addNotification(target, actor, "follow", {})
    )

    c.json(200, {ok: true})
)

def handleUnfollowUser(*serve.Context c) (
    string actor = c.getString("username")
    string target = c.param("name")
    string actorKey = normalizeUsername(actor)
    string targetKey = normalizeUsername(target)

    if profileExists(target) (
        object targetProfile = loadProfile(target)
        array followers = targetProfile.followers.assert(array)
        if followers.contains(actorKey) (
            targetProfile.followers = removeString(followers, actorKey)
            saveProfile(targetProfile)
        )
    )

    object actorProfile = loadProfile(actor)
    array following = actorProfile.following.assert(array)
    if following.contains(targetKey) (
        actorProfile.following = removeString(following, targetKey)
        saveProfile(actorProfile)
    )

    c.json(200, {ok: true})
)

def handleGetUserProjects(*serve.Context c) (
    string name = c.param("name")
    if userIdForUsername(name) == "" (
        discoverUserIdentity(name)
    )
    boolean includeUnshared = isViewerOwner(c, name) and c.queryBool("all", false)
    number requestedLimit = c.queryInt("limit", 0)
    if requestedLimit > 0 (
        number total = ownerIndexCount(name, includeUnshared)
        number offset = clampNumber(c.queryInt("offset", 0), 0, total)
        number limit = clampNumber(requestedLimit, 1, 100)
        c.json(200, {
            ok: true,
            projects: ownerIndexPage(name, includeUnshared, offset, limit),
            total: total,
            nextOffset: clampNumber(offset + limit, 0, total)
        })
        return
    )
    array projects = ownerIndexEntries(name, includeUnshared)
    c.json(200, {ok: true, projects: projects, total: projects.len})
)

def userLibrary(string userLower) array (
    object profile = loadProfile(userLower)
    if profile.contains("library") and profile.library != null (
        return profile.library.assert(array)
    )
    return []
)

def isInLibrary(string userLower, string projectId) boolean (
    if userLower == "" (
        return false
    )
    return userLibrary(userLower).contains(projectId)
)

def addToLibrary(string userLower, string projectId) boolean (
    object profile = loadProfile(userLower)
    array lib = []
    if profile.contains("library") and profile.library != null (
        lib = profile.library.assert(array)
    )
    if lib.contains(projectId) (
        return false
    )
    lib.append(projectId)
    profile.library = lib
    saveProfile(profile)
    return true
)

def bumpProjectSaves(string projectId, number delta) (
    auto res = loadProject(projectId)
    if !res.ok (
        return
    )
    object project = res.project.assert(object)
    number current = 0
    if project.contains("saves") and project.saves != null (
        current = project.saves.toNum()
    )
    number next = current + delta
    if next < 0 (
        next = 0
    )
    project.saves = next
    saveProject(project)
)

def handleSaveProject(*serve.Context c) (
    auto result = loadProject(c.param("id"))
    if !result.ok (
        c.notFound("project not found")
        return
    )
    object project = result.project.assert(object)
    if !canViewProject(project, c) (
        c.notFound("project not found")
        return
    )
    boolean added = addToLibrary(normalizeUsername(c.getString("username")), project.id.toStr())
    if added (
        bumpProjectSaves(project.id.toStr(), 1)
        addActivity(c.getString("username"), "favorite", {projectId: project.id, projectTitle: project.title, projectOwner: project.owner})
    )
    c.json(200, {ok: true, saved: true})
)

def handleUnsaveProject(*serve.Context c) (
    string me = normalizeUsername(c.getString("username"))
    object profile = loadProfile(me)
    array lib = []
    if profile.contains("library") and profile.library != null (
        lib = profile.library.assert(array)
    )
    string pid = c.param("id")
    boolean had = lib.contains(pid)
    if had (
        profile.library = removeString(lib, pid)
        saveProfile(profile)
        bumpProjectSaves(pid, -1)
    )
    c.json(200, {ok: true, saved: false})
)

def addPurchaseRecord(string userLower, object entry) (
    object profile = loadProfile(userLower)
    array list = []
    if profile.contains("purchases") and profile.purchases != null (
        list = profile.purchases.assert(array)
    )
    array next = [entry]
    for i list.len (
        if next.len < 200 (
            next.append(list[i])
        )
    )
    profile.purchases = next
    saveProfile(profile)
)

def handleGetMyPurchases(*serve.Context c) (
    object profile = loadProfile(normalizeUsername(c.getString("username")))
    array list = []
    if profile.contains("purchases") and profile.purchases != null (
        list = profile.purchases.assert(array)
    )
    c.json(200, {ok: true, purchases: list})
)

def handleGetMyLibrary(*serve.Context c) (
    object profile = loadProfile(normalizeUsername(c.getString("username")))
    array ids = []
    if profile.contains("library") and profile.library != null (
        ids = profile.library.assert(array)
    )
    array entries = []
    array validIds = []
    object seen = {}
    for i ids.len (
        string id = ids[i].toStr()
        object entry = projectSearchDocs.findById(id)
        if entry.isEmpty() == false and !seen.contains(id) (
            seen[id] = true
            validIds.append(id)
            entries.append(entry)
        )
    )
    if validIds.len != ids.len (
        profile.library = validIds
        saveProfile(profile)
    )
    entries.reverse()
    number total = entries.len
    number offset = clampNumber(c.queryInt("offset", 0), 0, total)
    number limit = clampNumber(c.queryInt("limit", 24), 1, 100)
    c.json(200, {
        ok: true,
        projects: paginate(entries, offset, limit),
        total: total,
        nextOffset: clampNumber(offset + limit, 0, total)
    })
)

def handleGetActivity(*serve.Context c) (
    array users = c.query("users").split(",")
    array items = []
    object selectedUsers = {}
    number count = 0
    for i users.len (
        if count < 50 (
            string username = normalizeUsername(users[i].toStr())
            if username != "" and !selectedUsers.contains(username) (
                selectedUsers[username] = true
                array userItems = loadActivity(username)
                number activityLimit = clampNumber(userItems.len, 0, 40)
                for j activityLimit (
                    items.append(userItems[j])
                )
                count = count + 1
            )
        )
    )
    array recentReviews = reviewDocs.sort("edited", db.desc).limit(500).all()
    number reviewItems = 0
    for i recentReviews.len (
        if reviewItems < 40 (
            object review = recentReviews[i].assert(object)
            string author = normalizeUsername(review.author.toStr())
            if selectedUsers.contains(author) (
                object project = projectSearchDocs.findById(review.projectId.toStr())
                if !project.isEmpty() and projectIsViewable(project) (
                    items.append({type: "review", actor: review.author, projectId: review.projectId, projectTitle: project.title, rating: review.rating, message: review.message, created: review.edited})
                    reviewItems = reviewItems + 1
                )
            )
        )
    )
    items.sortBy("created", "descending")
    if items.len > 40 (
        items = items.trim(1, 40)
    )
    c.json(200, {ok: true, activity: items})
)

def handleGetUserFollowers(*serve.Context c) (
    object profile = loadProfile(c.param("name"))
    c.json(200, {ok: true, users: profile.followers.assert(array)})
)

def handleGetUserFollowing(*serve.Context c) (
    object profile = loadProfile(c.param("name"))
    c.json(200, {ok: true, users: profile.following.assert(array)})
)
