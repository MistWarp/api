def projectContributionOnlyFlag(object project) boolean (
    return project.contains("contributionOnly") and project.contributionOnly == true
)

def remixIsContributionOnly(object parent, number parentPrice) boolean (
    return parentPrice > 0 or projectContributionOnlyFlag(parent)
)

// Buying access to play does not grant access to source or history.
def projectSourcePolicyAllows(object project, number price, boolean isOwner) boolean (
    if isOwner (
        return true
    )
    return price <= 0 and !(project.contains("seeInside") and project.seeInside == false)
)
