def escapeHtml(string value) string (
    return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
)

def metaText(string value) string (
    string flat = value.replace("\r", " ").replace("\n", " ").strip()
    if flat.len > 200 (
        return flat.trim(1, 197) ++ "..."
    )
    return flat
)

def siteDescription() string (
    return "MistWarp is a powerful Scratch mod. Create, share, and explore projects on the MistWarp community."
)

def siteImage() string (
    return editorOrigin ++ "/images/apple-touch-icon.png"
)

def metaTag(string property, string content) string (
    if content == "" (
        return ""
    )
    return "<meta property=\"" ++ property ++ "\" content=\"" ++ escapeHtml(content) ++ "\">"
)

def metaName(string name, string content) string (
    if content == "" (
        return ""
    )
    return "<meta name=\"" ++ name ++ "\" content=\"" ++ escapeHtml(content) ++ "\">"
)

def renderMetaPage(object meta) string (
    string title = meta.title.toStr()
    string description = metaText(meta.description.toStr())
    string canonical = meta.canonical.toStr()
    string image = meta.image.toStr()
    string embedSrc = ""
    if meta.contains("embedSrc") (
        embedSrc = meta.embedSrc.toStr()
    )
    string card = "summary"
    if meta.contains("card") (
        card = meta.card.toStr()
    )
    string oembedHref = appURL ++ "/api/oembed?url=" ++ url.escape(canonical) ++ "&format=json"

    string html = "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    html = html ++ "<title>" ++ escapeHtml(title) ++ "</title>"
    html = html ++ metaName("description", description)
    html = html ++ "<link rel=\"canonical\" href=\"" ++ escapeHtml(canonical) ++ "\">"
    html = html ++ "<link rel=\"alternate\" type=\"application/json+oembed\" href=\"" ++ escapeHtml(oembedHref) ++ "\" title=\"" ++ escapeHtml(title) ++ "\">"
    html = html ++ metaTag("og:site_name", "MistWarp")
    html = html ++ metaTag("og:type", "website")
    html = html ++ metaTag("og:title", title)
    html = html ++ metaTag("og:description", description)
    html = html ++ metaTag("og:url", canonical)
    html = html ++ metaTag("og:image", image)
    html = html ++ metaName("twitter:card", card)
    html = html ++ metaName("twitter:title", title)
    html = html ++ metaName("twitter:description", description)
    html = html ++ metaName("twitter:image", image)
    if embedSrc != "" (
        html = html ++ metaTag("og:video", embedSrc)
        html = html ++ metaTag("og:video:secure_url", embedSrc)
        html = html ++ metaTag("og:video:type", "text/html")
        html = html ++ metaTag("og:video:width", "480")
        html = html ++ metaTag("og:video:height", "360")
        html = html ++ metaName("twitter:player", embedSrc)
        html = html ++ metaName("twitter:player:width", "480")
        html = html ++ metaName("twitter:player:height", "360")
    )
    html = html ++ "<meta http-equiv=\"refresh\" content=\"0; url=" ++ escapeHtml(canonical) ++ "\">"
    html = html ++ "</head><body><a href=\"" ++ escapeHtml(canonical) ++ "\">" ++ escapeHtml(title) ++ "</a></body></html>"
    return html
)

def genericSiteMeta(string path) object (
    return {title: "MistWarp", description: siteDescription(), canonical: editorOrigin ++ path, image: siteImage(), card: "summary"}
)

def projectEmbedSrc(object project) string (
    string projectJson = projectJsonUrlFor(project)
    if projectJson == "" (
        return ""
    )
    return editorOrigin ++ "/embed.html?project_url=" ++ url.escape(projectJson) ++ "&mw_assets=" ++ url.escape(assetsBaseUrl())
)

def handleSiteMetaPage(*serve.Context c) (
    c.html(200, renderMetaPage(genericSiteMeta(c.path())))
)

def handleProjectMetaPage(*serve.Context c) (
    string id = c.param("id")
    string canonical = editorOrigin ++ "/project/" ++ id
    auto result = loadProject(id)
    if !result.ok (
        c.html(200, renderMetaPage(genericSiteMeta("/project/" ++ id)))
        return
    )
    object project = result.project.assert(object)
    if project.shared != true (
        c.html(200, renderMetaPage(genericSiteMeta("/project/" ++ id)))
        return
    )
    string title = project.title.toStr() ++ " by " ++ project.owner.toStr() ++ " - MistWarp"
    string description = project.instructions.toStr().strip()
    if description == "" (
        description = project.description.toStr().strip()
    )
    if description == "" (
        description = "Play " ++ project.title.toStr() ++ " on MistWarp."
    )
    string image = thumbUrlFor(project)
    string card = "summary"
    if image != "" (
        card = "summary_large_image"
    )
    string embedSrc = projectEmbedSrc(project)
    if embedSrc != "" (
        card = "player"
    )
    if image == "" (
        image = siteImage()
    )
    c.html(200, renderMetaPage({title: title, description: description, canonical: canonical, image: image, card: card, embedSrc: embedSrc}))
)

def handleUserMetaPage(*serve.Context c) (
    string name = c.param("name")
    string key = normalizeUsername(name)
    string canonical = editorOrigin ++ "/users/" ++ url.escape(name)
    if !isSafePathPart(key) (
        c.html(200, renderMetaPage(genericSiteMeta("/")))
        return
    )
    object profile = loadProfile(name)
    array projects = ownerIndexEntries(name, false)
    boolean exists = fs.exists(usersDir ++ key ++ ".json") or projects.len > 0
    if !exists (
        c.html(200, renderMetaPage(genericSiteMeta("/users/" ++ key)))
        return
    )
    string title = profile.username.toStr() ++ " on MistWarp"
    string description = profile.bio.toStr().strip()
    if description == "" (
        description = profile.username.toStr() ++ " has shared " ++ projects.len.toStr() ++ " projects on MistWarp."
    )
    string image = "https://avatars.rotur.dev/" ++ url.escape(key)
    c.html(200, renderMetaPage({title: title, description: description, canonical: canonical, image: image, card: "summary"}))
)

def handleOembed(*serve.Context c) (
    string format = c.queryDefault("format", "json")
    if format != "json" (
        c.json(501, {ok: false, error: "only json format is supported"})
        return
    )
    string pageUrl = c.query("url")
    if !pageUrl.contains("/project/") (
        c.notFound("no oembed for this url")
        return
    )
    array parts = pageUrl.split("/project/")
    string id = parts[2].toStr()
    id = id.split("?")[1].toStr()
    id = id.split("#")[1].toStr()
    id = id.split("/")[1].toStr()
    auto result = loadProject(id)
    if !result.ok (
        c.notFound("project not found")
        return
    )
    object project = result.project.assert(object)
    if project.shared != true (
        c.notFound("project not found")
        return
    )
    string embedSrc = projectEmbedSrc(project)
    if embedSrc == "" (
        c.notFound("project file not found")
        return
    )
    string iframe = "<iframe src=\"" ++ escapeHtml(embedSrc) ++ "\" width=\"480\" height=\"360\" allowtransparency=\"true\" frameborder=\"0\" scrolling=\"no\" allowfullscreen></iframe>"
    object payload = {
        type: "video",
        version: "1.0",
        title: project.title.toStr(),
        author_name: project.owner.toStr(),
        author_url: editorOrigin ++ "/users/" ++ url.escape(project.owner.toStr()),
        provider_name: "MistWarp",
        provider_url: editorOrigin,
        html: iframe,
        width: 480,
        height: 360
    }
    string thumb = thumbUrlFor(project)
    if thumb != "" (
        payload.thumbnail_url = thumb
        payload.thumbnail_width = 480
        payload.thumbnail_height = 360
    )
    c.json(200, payload)
)
