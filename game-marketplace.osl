def projectGameProducts(object project) array (
  if project.contains("gameProducts") and project.gameProducts != null (
    return project.gameProducts.assertElse(array, [])
  )
  return []
)

def findGameProduct(object project, string productId) object (
  array products = projectGameProducts(project)
  for i products.len (
    object product = products[i].assertElse(object, {})
    if product.id.toStr() == productId (
      return {ok: true, product: product}
    )
  )
  return {ok: false}
)

def gameEntitlementPath(string projectId, string userId) string (
  return gameEntitlementsDir ++ projectId ++ "/" ++ gameDataUserKey(userId) ++ ".json"
)

def loadGameEntitlements(string projectId, string userId) object (
  auto loaded = readFile(gameEntitlementPath(projectId, userId))
  if !loaded.ok (
    return {products: {}, updatedAt: 0}
  )
  return loaded.data.assert(object)
)

def ownsGameProduct(string projectId, string userId, string productId) boolean (
  object entitlements = loadGameEntitlements(projectId, userId)
  object products = entitlements.products.assertElse(object, {})
  return products.contains(productId)
)

def gameProductResponse(object project, object product,*serve.Context c) object (
  string grantsItem = product.grantsItem.toStr()
  if grantsItem != "" (
    grantsItem = globalGameItemId(project.id.toStr(), grantsItem)
  )
  return {
    id: product.id,
    name: product.name,
    description: product.description,
    price: product.price,
    grantsItem: grantsItem,
    icon: product.icon.toStr(),
    owned: c.getBool("authenticated") and ownsGameProduct(project.id.toStr(), c.getString("userId"), product.id.toStr())
  }
)

def grantGameProductItem(object project, object product, string userId, string paymentId) boolean (
  string itemId = product.grantsItem.toStr()
  if itemId == "" (
    return true
  )
  object found = findProjectGameItem(project, itemId)
  if !found.ok (
    return false
  )
  object granted = grantInventoryItem(userId, project, found.item.assert(object), 1, "purchase", "payment:" ++ paymentId)
  return granted.ok == true
)

def saveGameProductEntitlement(string projectId, string userId, string productId, string paymentId) boolean (
  string lockName = "game-entitlement-" ++ projectId ++ "-" ++ gameDataUserKey(userId)
  sync.lock(lockName)
  object entitlements = loadGameEntitlements(projectId, userId)
  object products = entitlements.products.assertElse(object, {})
  products[productId] = {purchasedAt: timestamp, paymentId: paymentId}
  entitlements.products = products
  entitlements.updatedAt = timestamp
  fs.mkdirAll(gameEntitlementsDir ++ projectId ++ "/")
  boolean saved = writeFile(gameEntitlementPath(projectId, userId), entitlements)
  sync.unlock(lockName)
  return saved
)

def removeGameProductEntitlement(string projectId, string userId, string productId) boolean (
  if !ownsGameProduct(projectId, userId, productId) (
    return true
  )
  string lockName = "game-entitlement-" ++ projectId ++ "-" ++ gameDataUserKey(userId)
  sync.lock(lockName)
  object entitlements = loadGameEntitlements(projectId, userId)
  object products = entitlements.products.assertElse(object, {})
  products.delete(productId)
  entitlements.products = products
  entitlements.updatedAt = timestamp
  fs.mkdirAll(gameEntitlementsDir ++ projectId ++ "/")
  boolean saved = writeFile(gameEntitlementPath(projectId, userId), entitlements)
  sync.unlock(lockName)
  return saved
)

def handleListGameProducts(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok or !projectIsViewable(loaded.project.assert(object)) (
    c.notFound("project not found")
    return
  )
  object project = loaded.project.assert(object)
  array source = projectGameProducts(project)
  array products = []
  for i source.len (
    products.append(gameProductResponse(project, source[i].assert(object), c))
  )
  c.json(200, {ok: true, products: products})
)

def handleOwnsGameProduct(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok (
    c.notFound("project not found")
    return
  )
  object found = findGameProduct(loaded.project.assert(object), c.param("product"))
  if !found.ok (
    c.notFound("game product not found")
    return
  )
  c.json(200, {ok: true, owned: ownsGameProduct(c.param("id"), c.getString("userId"), c.param("product"))})
)

def handleGameProductIntent(*serve.Context c) (
  if refuseOldPaymentClient(c) (
    return
  )
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok or !projectIsViewable(loaded.project.assert(object)) (
    c.notFound("project not found")
    return
  )
  object project = loaded.project.assert(object)
  object found = findGameProduct(project, c.param("product"))
  if !found.ok (
    c.notFound("game product not found")
    return
  )
  object product = found.product.assert(object)
  if product.price.toNum() <= 0 (
    if !saveGameProductEntitlement(project.id.toStr(), c.getString("userId"), product.id.toStr(), "free-claim") (
      c.internalError("failed to grant game product")
      return
    )
    if !grantGameProductItem(project, product, c.getString("userId"), "free-claim") (
      c.internalError("failed to grant the product's portable item")
      return
    )
    c.json(200, {ok: true, already: true, product: gameProductResponse(project, product, c)})
    return
  )
  if ownsGameProduct(project.id.toStr(), c.getString("userId"), product.id.toStr()) (
    object entitlements = loadGameEntitlements(project.id.toStr(), c.getString("userId"))
    object products = entitlements.products.assertElse(object, {})
    object ownedProduct = products[product.id.toStr()].assertElse(object, {})
    if !grantGameProductItem(project, product, c.getString("userId"), ownedProduct.paymentId.toStr()) (
      c.internalError("failed to grant the product's portable item")
      return
    )
    c.json(200, {ok: true, already: true, product: gameProductResponse(project, product, c)})
    return
  )
  string refusal = roturPurchaseRefusal(c.getString("username"), product.price.toNum(), (product.name ?? product.id).toStr())
  if refusal != "" (
    c.json(403, {ok: false, error: refusal})
    return
  )

  array splits = projectCommerceSplits(project)
  if splits.len == 0 (
    c.json(503, {ok: false, error: "MistWarp can't take payments right now. Try again in a few minutes."})
    return
  )
  object entry = {type: "game_product", projectId: project.id.toStr(), productId: product.id.toStr(), buyer: normalizeUsername(c.getString("username")), userId: c.getString("userId"), price: product.price}
  object started = startPurchase("mwgame_", entry, c.getString("username"), project.owner.toStr(), splits, product.price.toNum(), (product.name ?? product.id).toStr() ++ " in " ++ project.title.toStr(), (c.bodyJSON().returnUrl ?? "").toStr())
  if !started.ok (
    c.json(503, started)
    return
  )
  started.amount = product.price
  started.title = product.name
  c.json(200, started))

// Delivers a paid game product, once, whether the editor or Rotur's webhook
// gets here first.
def completeGameProductPurchase(string key) object (
  sync.lock("purchase:" ++ key)
  object entry = paidPurchase(key)
  auto loaded = loadProject((entry.projectId ?? "").toStr())
  if !entry.contains("paid") or !loaded.ok (
    sync.unlock("purchase:" ++ key)
    return {ok: false}
  )
  object project = loaded.project.assert(object)
  object found = findGameProduct(project, entry.productId.toStr())
  if !found.ok (
    sync.unlock("purchase:" ++ key)
    return {ok: false}
  )
  object product = found.product.assert(object)
  string userId = entry.userId.toStr()
  string buyer = entry.buyer.toStr()
  string paymentId = entry.requestId.toStr()
  if !ownsGameProduct(project.id.toStr(), userId, product.id.toStr()) (
    if !saveGameProductEntitlement(project.id.toStr(), userId, product.id.toStr(), paymentId) or !grantGameProductItem(project, product, userId, paymentId) (
      sync.unlock("purchase:" ++ key)
      return {ok: false, error: "failed to grant game product"}
    )
    // What the buyer paid, which a refund pays back.
    number paid = (entry.price ?? product.price).toNum()
    addPurchaseRecord(buyer, {projectId: project.id.toStr(), productId: product.id, title: product.name, seller: project.owner, amount: paid, at: timestamp, type: "game_product"})
    addNotification(project.owner.toStr(), buyer, "purchase", {projectId: project.id, projectTitle: project.title, productId: product.id, productName: product.name, amount: paid})
  )
  forgetPurchase(key)
  sync.unlock("purchase:" ++ key)
  return {ok: true, project: project, product: product}
)

def handleGameProductConfirm(*serve.Context c) (
  string key = (c.bodyJSON().key ?? "").toStr().strip()
  object pending = loadPurchaseKeys().keys[key] ?? {}
  boolean mine = key.startsWith("mwgame_") and (pending.userId ?? "").toStr() == c.getString("userId") and (pending.productId ?? "").toStr() == c.param("product")
  object completed = {ok: false}
  if mine (
    completed = completeGameProductPurchase(key)
  )
  if !completed.ok and ownsGameProduct(c.param("id"), c.getString("userId"), c.param("product")) (
    // Rotur's webhook got here first.
    auto loaded = loadProject(c.param("id"))
    object found = findGameProduct(loaded.project.assertElse(object, {}), c.param("product"))
    if loaded.ok and found.ok (
      c.json(200, {ok: true, already: true, product: gameProductResponse(loaded.project.assert(object), found.product.assert(object), c)})
      return
    )
  )
  if !mine (
    c.badRequest("this purchase expired, start again")
    return
  )
  if !completed.ok (
    c.json(402, {ok: false, pending: true, error: (completed.error ?? "payment not received yet, try again in a moment").toStr()})
    return
  )
  c.json(200, {ok: true, product: gameProductResponse(completed.project.assert(object), completed.product.assert(object), c)})
)

// What the buyer last paid for this product, from their purchase records, or 0
// if they never paid for it (a creator grant or a free claim).
def gameProductAmountPaid(string buyer, string projectId, string productId) number (
  object profile = loadProfile(normalizeUsername(buyer))
  array purchases = (profile.purchases ?? []).assertElse(array, [])
  for i purchases.len (
    object record = purchases[i].assertElse(object, {})
    if (record.type ?? "").toStr() == "game_product" and (record.projectId ?? "").toStr() == projectId and (record.productId ?? "").toStr() == productId (
      return (record.amount ?? 0).toNum()
    )
  )
  return 0
)

// The creator pays the buyer back through Rotur before revoking a paid
// product: this asks Rotur for that payment.
def handleGameProductRefundIntent(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok or !canEditProject(loaded.project.assert(object), c) (
    c.forbidden("only the project creator can refund products")
    return
  )
  object project = loaded.project.assert(object)
  object found = findGameProduct(project, c.param("product"))
  object body = c.bodyJSON()
  string buyer = body.username.toStr()
  string buyerId = userIdForUsername(buyer)
  if !found.ok or buyerId == "" or !ownsGameProduct(project.id.toStr(), buyerId, c.param("product")) (
    c.badRequest("they don't own this product")
    return
  )
  object product = found.product.assert(object)
  number paid = gameProductAmountPaid(buyer, project.id.toStr(), product.id.toStr())
  if paid <= 0 (
    c.badRequest("there's no payment from them to refund, revoke without a refund")
    return
  )
  object entry = {type: "game_refund", projectId: project.id.toStr(), productId: product.id.toStr(), buyer: normalizeUsername(c.getString("username")), refundTo: buyerId, amount: paid}
  object started = startPurchase("mwrefund_", entry, c.getString("username"), buyer, [], paid, "Refund for " ++ (product.name ?? product.id).toStr(), (body.returnUrl ?? "").toStr())
  if !started.ok (
    c.json(503, started)
    return
  )
  c.json(200, started)
)

def handleGrantGameProduct(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok (
    c.notFound("project not found")
    return
  )
  object project = loaded.project.assert(object)
  if !canEditProject(project, c) (
    c.forbidden("only the project creator can grant products")
    return
  )
  object found = findGameProduct(project, c.param("product"))
  if !found.ok (
    c.notFound("game product not found")
    return
  )
  object product = found.product.assert(object)
  object body = c.bodyJSON()
  string targetId = userIdForUsername(body.username.toStr())
  if targetId == "" (
    c.badRequest("could not find that user")
    return
  )
  if ownsGameProduct(project.id.toStr(), targetId, product.id.toStr()) (
    c.json(200, {ok: true, already: true, product: gameProductResponse(project, product, c)})
    return
  )
  if !saveGameProductEntitlement(project.id.toStr(), targetId, product.id.toStr(), "creator-grant") (
    c.internalError("failed to grant game product")
    return
  )
  if !grantGameProductItem(project, product, targetId, "creator-grant") (
    c.internalError("failed to grant the product's portable item")
    return
  )
  c.json(200, {ok: true, product: gameProductResponse(project, product, c)})
)

def handleRevokeGameProduct(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok (
    c.notFound("project not found")
    return
  )
  object project = loaded.project.assert(object)
  if !canEditProject(project, c) (
    c.forbidden("only the project creator can revoke products")
    return
  )
  object found = findGameProduct(project, c.param("product"))
  if !found.ok (
    c.notFound("game product not found")
    return
  )
  object product = found.product.assert(object)
  object body = c.bodyJSON()
  string targetUsername = body.username.toStr()
  string targetId = userIdForUsername(targetUsername)
  if targetId == "" (
    c.badRequest("could not find that user")
    return
  )
  if !ownsGameProduct(project.id.toStr(), targetId, product.id.toStr()) (
    c.json(200, {ok: true, removed: false})
    return
  )
  boolean refunded = false
  if product.price.toNum() > 0 and body.noRefund != true (
    string refundKey = (body.refundKey ?? "").toStr()
    object refund = paidPurchase(refundKey)
    if !refundKey.startsWith("mwrefund_") or (refund.refundTo ?? "").toStr() != targetId or (refund.projectId ?? "").toStr() != project.id.toStr() or (refund.productId ?? "").toStr() != product.id.toStr() (
      c.json(402, {ok: false, error: "refund payment not received yet, send the refund first or revoke without refund"})
      return
    )
    refunded = true
  )
  if !removeGameProductEntitlement(project.id.toStr(), targetId, product.id.toStr()) (
    // The refund key stays, so revoking can be tried again with it.
    c.internalError("failed to revoke game product")
    return
  )
  if refunded (
    forgetPurchase((body.refundKey ?? "").toStr())
  )
  c.json(200, {ok: true, removed: true, refunded: refunded})
)
