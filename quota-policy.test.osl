import "std:testing"
import "./quota-policy.osl"

array events = [
  {t: 1000, bytes: 50, name: "a.png"},
  {t: 2000, bytes: 30, name: "b.png"},
  {t: 3000, bytes: 20, name: "c.png"}
]

testing.assert(quotaTotalBytes(events, 4000, 100000) == 100, "totals all fresh events")
testing.assert(quotaTotalBytes(events, 101000, 100000) == 50, "expired oldest event drops out")

array cleared = quotaWithoutNames(events, ["b.png", "missing.png"], 4000, 100000)
testing.assert(cleared.len == 2, "saved assets leave the pending list")
testing.assert(quotaTotalBytes(cleared, 4000, 100000) == 70, "unsaved assets stay pending")
testing.assert(quotaWithoutNames(events, [], 101000, 100000).len == 2, "clearing also drops expired uploads")

testing.assert(storageAllowance(500, 200, 50) == 350, "a project may grow into the free space")
testing.assert(storageAllowance(500, 700, 50) == 50, "an over-limit user can keep a project's size")
testing.assert(storageAllowance(500, 500, 0) == 0, "a full account cannot add a new project")
