def stripeBillingConfigured() boolean (
  return stripeSecretKey != "" and stripeWebhookSecret != "" and classroomBillingIntervals(stripeClassroomPrice, stripeClassroomPriceYearly).len > 0
)

def stripeRequest(string path, array fields) object (
  object resp = requests.post("https://api.stripe.com/v1" ++ path, {
    timeout: 15,
    headers: {
      "Authorization": "Bearer " ++ stripeSecretKey,
      "Content-Type": "application/x-www-form-urlencoded"
    },
    body: formEncode(fields)
  })
  auto parsed = json.parse(resp.body, {type: "object"})
  number status = resp.status.toInt()
  if !resp.success or status < 200 or status >= 300 or parsed.isErr() (
    string message = "Stripe did not respond"
    if !parsed.isErr() (
      object failure = parsed.unwrap().assert(object)
      message = ((failure.error ?? {}).assertElse(object, {}).message ?? message).toStr()
    )
    log "stripe " ++ path ++ " failed: " ++ message
    return {ok: false, error: message}
  )
  return {ok: true, data: parsed.unwrap().assert(object)}
)

def classroomBillingInfo(string userId) object (
  object stored = classroomPlanDocs.findById(userId)
  boolean schoolManaged = schoolForTeacher(userId).len > 0
  return {
    available: stripeBillingConfigured() and !schoolManaged,
    schoolManaged: schoolManaged,
    seatPackSize: classroomSeatPackSize,
    seatPacksAvailable: stripeSeatPackPrice != "" or stripeSeatPackPriceYearly != "",
    intervals: classroomBillingIntervals(stripeClassroomPrice, stripeClassroomPriceYearly),
    seatPackIntervals: classroomBillingIntervals(stripeSeatPackPrice, stripeSeatPackPriceYearly),
    managedByStripe: (stored.source ?? "").toStr() == "stripe",
    canManage: (stored.stripeCustomerId ?? "").toStr() != "",
    status: (stored.stripeStatus ?? "").toStr(),
    trialAvailable: classroomTrialAvailable(stored, schoolManaged, timestamp),
    trialDays: classroomTrialDays,
    trialEndsAt: classroomTrialEndsAt(stored, timestamp)
  }
)

def handleStartClassroomTrial(*serve.Context c) (
  string userId = c.getString("userId")
  if schoolForTeacher(userId).len > 0 (
    c.json(409, {ok: false, code: "school_managed", error: "Your school manages your Classroom plan."})
    return
  )
  string lockName = "classroom-plan-" ++ userId
  sync.lock(lockName)
  object stored = classroomPlanDocs.findById(userId)
  if !classroomTrialAvailable(stored, false, timestamp) (
    sync.unlock(lockName)
    c.json(409, {ok: false, code: "trial_unavailable", error: "The free trial is for teachers who have not had a Classroom plan before."})
    return
  )
  object next = classroomTrialPlan(stored, timestamp)
  next._id = userId
  next.updatedAt = timestamp
  putDocument(classroomPlanDocs, userId, next)
  invalidateClassroomPool(userId)
  sync.unlock(lockName)
  c.json(200, {ok: true, plan: classroomPlanFor(userId), billing: classroomBillingInfo(userId)})
)

def handleClassroomCheckout(*serve.Context c) (
  if schoolForTeacher(c.getString("userId")).len > 0 (
    c.json(409, {ok: false, code: "school_managed", error: "Your school manages your Classroom plan."})
    return
  )
  if !stripeBillingConfigured() (
    c.json(503, {ok: false, code: "billing_unavailable", error: "Online payment is not set up yet. Contact MistWarp support to buy a plan."})
    return
  )
  string userId = c.getString("userId")
  object stored = classroomPlanDocs.findById(userId)
  if classroomSubscriptionActive((stored.stripeStatus ?? "").toStr()) (
    c.json(409, {ok: false, code: "already_subscribed", error: "You already have a Classroom subscription. Manage it from billing."})
    return
  )
  object body = c.bodyJSON()
  number seatPacks = clampNumber((body.seatPacks ?? 0).toNum().toInt(), 0, 50)
  string interval = classroomCheckoutInterval((body.interval ?? "").toStr(), classroomBillingIntervals(stripeClassroomPrice, stripeClassroomPriceYearly))
  string classroomPrice = classroomPriceForInterval(interval, stripeClassroomPrice, stripeClassroomPriceYearly)
  string seatPackPrice = classroomPriceForInterval(interval, stripeSeatPackPrice, stripeSeatPackPriceYearly)
  string returnBase = editorOrigin ++ "/classroom"
  array fields = [
    ["mode", "subscription"],
    ["success_url", returnBase ++ "?billing=success"],
    ["cancel_url", returnBase ++ "?billing=cancelled"],
    ["client_reference_id", userId],
    ["allow_promotion_codes", "true"],
    ["metadata[userId]", userId],
    ["subscription_data[metadata][userId]", userId],
    ["line_items[0][price]", classroomPrice],
    ["line_items[0][quantity]", "1"]
  ]
  if seatPacks > 0 and seatPackPrice != "" (
    fields.append(["line_items[1][price]", seatPackPrice])
    fields.append(["line_items[1][quantity]", seatPacks.toStr()])
  )
  string customerId = (stored.stripeCustomerId ?? "").toStr()
  if customerId != "" (
    fields.append(["customer", customerId])
  )
  object session = stripeRequest("/checkout/sessions", fields)
  if session.ok != true (
    c.json(502, {ok: false, code: "billing_failed", error: "Payment could not be started. Try again in a moment."})
    return
  )
  c.json(200, {ok: true, url: session.data.url})
)

def handleClassroomBillingPortal(*serve.Context c) (
  if !stripeBillingConfigured() (
    c.json(503, {ok: false, code: "billing_unavailable", error: "Online payment is not set up yet. Contact MistWarp support to change your plan."})
    return
  )
  object stored = classroomPlanDocs.findById(c.getString("userId"))
  string customerId = (stored.stripeCustomerId ?? "").toStr()
  if customerId == "" (
    c.json(404, {ok: false, code: "no_billing_account", error: "You have not bought a plan online yet."})
    return
  )
  object portal = stripeRequest("/billing_portal/sessions", [["customer", customerId], ["return_url", editorOrigin ++ "/classroom"]])
  if portal.ok != true (
    c.json(502, {ok: false, code: "billing_failed", error: "Billing could not be opened. Try again in a moment."})
    return
  )
  c.json(200, {ok: true, url: portal.data.url})
)

def storeStripePlan(string userId, object update, number eventCreated) (
  string lockName = "classroom-plan-" ++ userId
  sync.lock(lockName)
  object stored = classroomPlanDocs.findById(userId)
  if stored.len == 0 (
    stored = {_id: userId}
  )
  if eventCreated <= 0 or stripeEventIsNewer(stored, eventCreated) (
    object merged = stored ++ update
    if eventCreated > 0 (
      merged.stripeEventAt = eventCreated
    )
    merged.updatedAt = timestamp
    putDocument(classroomPlanDocs, userId, merged)
    invalidateClassroomPool(userId)
  )
  sync.unlock(lockName)
)

def applyStripeSubscription(object subscription, number eventCreated, boolean deleted) (
  string userId = ((subscription.metadata ?? {}).assertElse(object, {}).userId ?? "").toStr()
  if userId == "" (
    log "stripe subscription " ++ (subscription.id ?? "").toStr() ++ " has no userId metadata"
    return
  )
  string subscriptionId = (subscription.id ?? "").toStr()
  if !stripeEventMayChangePlan(classroomPlanDocs.findById(userId), subscriptionId) (
    return
  )
  object plan = classroomPlanFromSubscription(subscription, [stripeSeatPackPrice, stripeSeatPackPriceYearly])
  if deleted (
    plan = {tier: "free", seats: 0, expiresAt: 0, stripeStatus: "canceled"}
  )
  storeStripePlan(userId, plan ++ {
    source: "stripe",
    stripeSubscriptionId: subscriptionId,
    stripeCustomerId: (subscription.customer ?? "").toStr(),
    storageBytes: 0,
    maxClasses: 0
  }, eventCreated)
)

def handleStripeWebhook(*serve.Context c) (
  string payload = c.body()
  if !stripeSignatureValid(c.header("Stripe-Signature"), payload, stripeWebhookSecret, (timestamp / 1000).toInt()) (
    c.json(400, {ok: false, error: "invalid signature"})
    return
  )
  auto parsed = json.parse(payload, {type: "object"})
  if parsed.isErr() (
    c.json(400, {ok: false, error: "invalid event"})
    return
  )
  object event = parsed.unwrap().assert(object)
  string eventType = (event.type ?? "").toStr()
  number created = (event.created ?? 0).toNum()
  object dataObject = ((event.data ?? {}).assertElse(object, {}).object ?? {}).assertElse(object, {})
  if eventType == "checkout.session.completed" (
    string userId = (dataObject.client_reference_id ?? "").toStr()
    string customerId = (dataObject.customer ?? "").toStr()
    if userId != "" and customerId != "" and !isStudentUserId(userId) (
      storeStripePlan(userId, {stripeCustomerId: customerId}, 0)
    )
  ) else if eventType == "customer.subscription.created" or eventType == "customer.subscription.updated" (
    applyStripeSubscription(dataObject, created, false)
  ) else if eventType == "customer.subscription.deleted" (
    applyStripeSubscription(dataObject, created, true)
  )
  c.json(200, {ok: true, received: true})
)
