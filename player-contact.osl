def projectPlayerContactDeclaration(object project) object (
  return (project.playerContact ?? {}).assertElse(object, {})
)

def playerContactFlag(string hash) object (
  if playerContactFlagCache.has(hash) (
    return playerContactFlagCache.get(hash).assertElse(object, {})
  )
  object record = readExtensionRecord(hash)
  object flag = {connects: (record.connectsPlayers ?? false) == true, name: ""}
  if flag.connects == true and fs.exists(extensionSourcePath(hash)) (
    flag.name = (extensionMetadata(hash).name ?? "").toStr().strip()
  )
  playerContactFlagCache.set(hash, flag)
  return flag
)

def playerContactService(object extension) object (
  string extensionUrl = (extension.url ?? "").toStr()
  string galleryName = playerContactGalleryName(extensionUrl)
  if galleryName != "" (
    return {name: galleryName, url: extensionUrl, gallery: true}
  )
  string idName = playerContactIdName((extension.id ?? "").toStr())
  if idName != "" (
    return {name: idName, url: extensionReviewUrl(extensionUrl), gallery: isGalleryExtensionUrl(extensionUrl)}
  )
  string hash = (extension.hash ?? "").toStr()
  if !isExtensionHash(hash) (
    return {}
  )
  object flag = playerContactFlag(hash)
  if flag.connects != true (
    return {}
  )
  string name = flag.name.toStr()
  if name == "" and isGalleryExtensionUrl(extensionUrl) (
    name = playerContactFileName(extensionUrl)
  )
  return {name: name, url: extensionReviewUrl(extensionUrl), gallery: isGalleryExtensionUrl(extensionUrl)}
)

def projectPlayerContactServices(object project) array (
  array services = []
  array extensions = storedProjectExtensions(project)
  object seen = {}
  for i extensions.len (
    object service = playerContactService(extensions[i].assertElse(object, {}))
    if service.len > 0 (
      string key = service.name.toStr() ++ "|" ++ service.url.toStr()
      if !seen.contains(key) (
        seen[key] = true
        services.append(service)
      )
    )
  )
  return services
)

def projectConnectsPlayers(object project) boolean (
  return projectPlayerContactServices(project).len > 0
)

def projectPlayerContactMissing(object project) boolean (
  return playerContactMissing(projectConnectsPlayers(project), projectPlayerContactDeclaration(project))
)

def projectLetsPlayersTalk(object project) boolean (
  return projectConnectsPlayers(project) or playerContactDeclared(projectPlayerContactDeclaration(project))
)

def studentBlockedFromPlayerContact(object project,*serve.Context c) boolean (
  return contextBool(c, "isStudent") and !canEditProject(project, c) and projectLetsPlayersTalk(project)
)

def projectPlayerContactResponse(object project,*serve.Context c) object (
  array services = projectPlayerContactServices(project)
  object declaration = projectPlayerContactDeclaration(project)
  boolean declared = playerContactDeclared(declaration)
  boolean editor = canEditProject(project, c)
  array shownServices = []
  for i services.len (
    object service = services[i].assertElse(object, {})
    if editor or service.gallery == true (
      shownServices.append(service)
    ) else (
      shownServices.append({name: service.name, gallery: false})
    )
  )
  object response = {
    connects: services.len > 0 or declared,
    services: shownServices,
    declared: declared,
    contact: if declared then (declaration.contact ?? "").toStr() else "",
    required: services.len > 0,
    missing: playerContactMissing(services.len > 0, declaration),
    termsVersion: playerContactTermsVersion
  }
  if editor and declared (
    response.declaredBy = (declaration.declaredBy ?? "").toStr()
    response.declaredAt = (declaration.declaredAt ?? 0).toNum()
    response.termsCurrent = playerContactTermsCurrent(declaration)
  )
  if studentBlockedFromPlayerContact(project, c) (
    response.studentBlocked = true
  )
  return response
)

def playerContactRequiredResponse(*serve.Context c) (
  c.json(400, {
    ok: false,
    code: "player_contact_required",
    error: "This project lets players talk to each other. Add a contact for chat and accept the chat rules in its publishing settings before you share it."
  })
)

def notifyPlayerContactNeeded(object project) (
  if projectVisibility(project) == "private" or !projectPlayerContactMissing(project) (
    return
  )
  string notifiedId = "player-contact-notified:" ++ project.id.toStr() ++ ":" ++ normalizeUsername(project.owner.toStr())
  if (playerContactNoticeDocs.findById(notifiedId) ?? {}).len > 0 (
    return
  )
  putDocument(playerContactNoticeDocs, notifiedId, {_id: notifiedId, projectId: project.id.toStr(), notifiedAt: timestamp})
  array names = []
  array services = projectPlayerContactServices(project)
  for i services.len (
    string name = services[i].assertElse(object, {}).name.toStr()
    if name != "" and !names.contains(name) (
      names.append(name)
    )
  )
  addNotification(project.owner.toStr(), "MistWarp", "player_contact_needed", {projectId: project.id, projectTitle: project.title, services: names})
)

def handleSetPlayerContact(*serve.Context c) (
  string lockName = "project-upload:" ++ c.param("id")
  string historyLock = "project-history-" ++ c.param("id")
  sync.lock(lockName)
  sync.lock(historyLock)
  handleSetPlayerContactLocked(c)
  sync.unlock(historyLock)
  sync.unlock(lockName)
)

def handleSetPlayerContactLocked(*serve.Context c) (
  auto loaded = loadProject(c.param("id"))
  if !loaded.ok (
    c.notFound("project not found")
    return
  )
  object project = loaded.project.assert(object)
  if projectRole(project, contextString(c, "username")) != "owner" (
    c.forbidden("Only the project's owner can take responsibility for its chat.")
    return
  )
  if contextBool(c, "isStudent") (
    c.forbidden("Class accounts can't run projects that let players talk to each other.")
    return
  )
  object body = requestJSON(c)
  if (body.declared ?? false) == true (
    string contact = (body.contact ?? "").toStr().strip()
    if !playerContactContactValid(contact) (
      c.badRequest("Add a contact for chat between 3 and 200 characters, on one line.")
      return
    )
    if contextBool(c, "isMinor") and !playerContactContactIsLink(contact) (
      c.badRequest("Use a website link for your chat contact, not an email address or a username.")
      return
    )
    if (body.termsVersion ?? 0).toNum() != playerContactTermsVersion (
      c.json(400, {ok: false, code: "player_contact_terms", error: "Accept the current chat rules to continue."})
      return
    )
    project.playerContact = {
      declared: true,
      contact: contact,
      termsVersion: playerContactTermsVersion,
      declaredAt: timestamp,
      declaredBy: contextString(c, "username")
    }
  ) else (
    if !playerContactCanWithdraw(projectConnectsPlayers(project), projectVisibility(project)) (
      c.json(400, {
        ok: false,
        code: "player_contact_required",
        error: "This project still uses an extension that connects players. Remove it or make the project private first."
      })
      return
    )
    project.delete("playerContact")
  )
  if !saveProject(project) (
    c.internalError("could not save the chat details")
    return
  )
  upsertIndexEntry(project)
  if playerContactDeclared(projectPlayerContactDeclaration(project)) (
    void playerContactNoticeDocs.deleteOne({_id: "player-contact-notified:" ++ project.id.toStr() ++ ":" ++ normalizeUsername(project.owner.toStr())})
  )
  c.json(200, {ok: true, project: projectResponse(project, c)})
)

def reindexPlayerContactProject(string projectId, boolean notify) boolean (
  string lockName = "project-upload:" ++ projectId
  string historyLock = "project-history-" ++ projectId
  sync.lock(lockName)
  sync.lock(historyLock)
  auto loaded = loadProject(projectId)
  if !loaded.ok (
    sync.unlock(historyLock)
    sync.unlock(lockName)
    return false
  )
  object project = loaded.project.assert(object)
  upsertIndexEntry(project)
  sync.unlock(historyLock)
  sync.unlock(lockName)
  boolean needed = projectVisibility(project) != "private" and projectPlayerContactMissing(project)
  if notify and needed (
    notifyPlayerContactNeeded(project)
  )
  return needed
)

def reindexPlayerContactProjects(string hash, boolean notify) number (
  number affected = 0
  array files = fs.readDir(projectsDir).unwrapOr([])
  for i files.len (
    string file = files[i].toStr()
    if file.endsWith(".json") (
      auto result = readFile(projectsDir ++ file)
      if result.ok and projectContainsExtensionHash(result.data.assertElse(object, {}), hash) (
        if reindexPlayerContactProject(file.replace(".json", ""), notify) (
          affected += 1
        )
      )
    )
  )
  return affected
)

def handleAdminSetExtensionConnectsPlayers(*serve.Context c) (
  object body = requestJSON(c)
  string hash = (body.hash ?? "").toStr()
  if !isExtensionHash(hash) or !body.contains("connectsPlayers") (
    c.badRequest("hash and connectsPlayers are required")
    return
  )
  boolean connects = body.connectsPlayers == true
  string lockName = "extension-" ++ hash
  sync.lock(lockName)
  object record = readExtensionRecord(hash)
  if record.getKeys().len == 0 (
    sync.unlock(lockName)
    c.notFound("extension not found")
    return
  )
  if connects (
    record.connectsPlayers = true
  ) else (
    record.delete("connectsPlayers")
  )
  if !writeFile(extensionRecordPath(hash), record) (
    sync.unlock(lockName)
    c.internalError("could not save extension policy")
    return
  )
  sync.unlock(lockName)
  playerContactFlagCache.delete(hash)
  number affected = reindexPlayerContactProjects(hash, connects)
  c.json(200, {ok: true, affected: affected})
)

def migratePlayerContactIndex() (
  string migrationId = "migration:player-contact-index-v1"
  if (diagnosticDocs.findById(migrationId) ?? {}).len > 0 (
    return
  )
  array files = fs.readDir(projectsDir).unwrapOr([])
  number notified = 0
  for i files.len (
    string file = files[i].toStr()
    if file.endsWith(".json") (
      auto result = readFile(projectsDir ++ file)
      if result.ok and projectConnectsPlayers(result.data.assertElse(object, {})) (
        if reindexPlayerContactProject(file.replace(".json", ""), true) (
          notified += 1
        )
      )
    )
  )
  putDocument(diagnosticDocs, migrationId, {_id: migrationId, completedAt: timestamp, notified: notified})
  log "Player contact index migration complete, " ++ notified.toStr() ++ " shared projects need chat details"
)

def playerChatReportAllowed(object project,*serve.Context c) boolean (
  return canViewProject(project, c) and projectLetsPlayersTalk(project)
)

def notifyPlayerChatReport(object report) (
  auto loaded = loadProject(report.target.toStr())
  if !loaded.ok (
    return
  )
  object project = loaded.project.assert(object)
  string owner = project.owner.toStr()
  string reporter = (report.reporter ?? "").toStr()
  string reporterKey = normalizeUsername(reporter)
  if reporterKey == "" or reporterKey == normalizeUsername(owner) (
    return
  )
  object safety = loadSafety(owner)
  if safety.blocked.assertElse(array, []).contains(reporterKey) or safety.muted.assertElse(array, []).contains(reporterKey) (
    return
  )
  if userHasBlocked(reporter, owner) or userShadowBanned(reporter) (
    return
  )
  string throttleKey = reporterKey ++ "|" ++ project.id.toStr()
  if playerChatNotifyCache.has(throttleKey) (
    return
  )
  playerChatNotifyCache.set(throttleKey, true)
  object payload = {
    projectId: project.id,
    projectTitle: project.title,
    category: report.category.toStr()
  }
  if !isStudentUserId((project.ownerId ?? "").toStr()) and !profileIsMinor(loadProfile(owner)) (
    payload.player = (report.player ?? "").toStr()
    payload.preview = report.reason.toStr().trim(1, 300)
  )
  addNotification(owner, "MistWarp", "player_chat_report", payload)
)
