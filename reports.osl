def loadReports() array (
  auto result = readFile(reportsFile)
  if !result.ok (
    return []
  )
  object data = result.data.assert(object)
  return data.reports.assert(array)
)

def compactReports(array reports) array (
  array unresolved = []
  array resolved = []
  for i reports.len (
    object report = reports[i].assert(object)
    if report.resolved == true (
      resolved.append(report)
    ) else (
      unresolved.append(report)
    )
  )
  number resolvedLimit = 5000 - unresolved.len
  if resolvedLimit < 0 (
    resolvedLimit = 0
  )
  number resolvedOffset = resolved.len - resolvedLimit
  if resolvedOffset < 0 (
    resolvedOffset = 0
  )
  array kept = unresolved
  array recentResolved = paginate(resolved, resolvedOffset, resolvedLimit)
  for i recentResolved.len (
    kept.append(recentResolved[i])
  )
  return kept
)

def saveReports(array reports) boolean (
  return writeFile(reportsFile, {reports: compactReports(reports)})
)

def reportSourceKey(*serve.Context c) string (
  if c.getBool("authenticated") (
    return "user:" ++ c.getString("userId")
  )
  return "ip:" ++ c.ip().hashSHA256()
)

def canAppendPendingReport(array reports, string sourceKey) boolean (
  number totalPending = 0
  number sourcePending = 0
  for i reports.len (
    object report = reports[i].assert(object)
    if report.resolved != true (
      totalPending += 1
      if (report.sourceKey ?? "").toStr() == sourceKey (
        sourcePending += 1
      )
    )
  )
  return totalPending < 1000 and sourcePending < 10
)

// Reports also go to the MistWarp Rotur App's report queue. Reports in a
// priority category (child sexual exploitation or abuse, a threat to life,
// encouraging suicide or self-harm, terrorism) reach Rotur's safety team as
// soon as they're filed. MistWarp's own queue and tools are unchanged, and
// closing a report here closes it on Rotur too.
array roturReportCategories = ["spam", "harassment", "hate", "sexual", "violence", "scam", "other", "csea", "threat_to_life", "self_harm", "terrorism"]

def reportCategory(object body, string reason) string (
  string category = (body.category ?? "").toStr()
  if roturReportCategories.contains(category) (
    return category
  )
  // Older clients only send the category's wording at the start of the reason.
  object worded = {
    "Inappropriate or explicit content": "sexual",
    "Harassment or bullying": "harassment",
    "Spam or misleading": "spam",
    "Hateful or abusive behaviour": "hate",
    "Dangerous or illegal activity": "violence"
  }
  array wordings = worded.getKeys()
  for i wordings.len (
    if reason.startsWith(wordings[i].toStr()) (
      return worded[wordings[i].toStr()].toStr()
    )
  )
  return "other"
)

// The reported comment, by ID: in the store the report's context names, else
// in any store.
def findReportedComment(string id, string context) object (
  array keys = []
  if context.startsWith("project ") (
    keys.append("project-" ++ context.replace("project ", ""))
  )
  array files = fs.readDir(commentsDir)
  for i files.len (
    keys.append(files[i].toStr().replace(".jsonl", "").replace(".json", ""))
  )
  for i keys.len (
    array comments = loadComments(keys[i].toStr())
    for j comments.len (
      object comment = comments[j].assertElse(object, {})
      if (comment.id ?? "").toStr() == id (
        return comment
      )
    )
  )
  return {}
)

// What was reported, worked out here and not taken from the reporter: who it
// is about, and what it said, so Rotur's safety team sees it even if it's
// deleted later. user is "" when it can't be worked out.
def reportedContent(object report) object (
  string type = report.type.toStr()
  string target = report.target.toStr()
  if type == "user" and userIdForUsername(target) != "" (
    object profile = loadProfile(target)
    return {user: target, snapshot: "Profile @" ++ target ++ "\nBio: " ++ (profile.bio ?? "").toStr()}
  )
  if type == "project" (
    auto loaded = loadProject(target)
    if loaded.ok (
      object project = loaded.project.assert(object)
      return {user: project.owner.toStr(), snapshot: "Project: " ++ (project.title ?? "").toStr() ++ "\nDescription: " ++ (project.description ?? "").toStr() ++ "\nInstructions: " ++ (project.instructions ?? "").toStr() ++ "\nNotes: " ++ (project.notes ?? "").toStr()}
    )
  )
  if type == "comment" (
    object comment = findReportedComment(target, (report.context ?? "").toStr())
    if comment.len > 0 (
      return {user: (comment.author ?? "").toStr(), snapshot: "Comment by @" ++ (comment.author ?? "").toStr() ++ ":\n" ++ (comment.content ?? "").toStr()}
    )
  )
  return {user: "", snapshot: (report.context ?? "").toStr()}
)

def setReportRotur(string id, string state, string roturReportId) object (
  sync.lock("reports-storage")
  array reports = loadReports()
  object found = {}
  for i reports.len (
    object stored = reports[i].assert(object)
    if stored.id.toStr() == id (
      stored.rotur = state
      if roturReportId != "" (
        stored.roturReportId = roturReportId
      )
      reports[i] = stored
      found = stored
    )
  )
  saveReports(reports)
  sync.unlock("reports-storage")
  return found
)

// Files the report in the Rotur App's queue. Its rotur state is "filed" once
// Rotur has it, "unfiled" if Rotur won't take it (or nobody can be named), and
// stays "pending" to be tried again by the reconcile loop.
def fileRoturReport(object report) (
  string subject = (report.subject ?? "").toStr()
  if !roturAppReady() (
    return
  )
  if subject == "" (
    setReportRotur(report.id.toStr(), "unfiled", "")
    return
  )
  string targetType = "content"
  if report.type.toStr() == "user" (
    targetType = "user"
  )
  object request = {
    target_type: targetType,
    target_id: report.type.toStr() ++ ":" ++ report.target.toStr(),
    target_user: roturUserRef(subject),
    category: report.category.toStr(),
    reason: report.reason.toStr().trim(1, 1000),
    snapshot: (report.snapshot ?? report.context ?? "").toStr().trim(1, 4000)
  }
  string reporter = (report.reporter ?? "").toStr()
  if reporter != "" (
    request.reporter = roturUserRef(reporter)
  )
  object result = roturApp("POST", "/reports", request)
  if !result.ok and result.status == 400 and request.contains("reporter") (
    // Only people who have used MistWarp through Rotur can be named.
    request.delete("reporter")
    result = roturApp("POST", "/reports", request)
  )
  string state = "pending"
  if result.ok (
    state = "filed"
  ) else if result.status == 400 or result.status == 404 or result.status == 409 (
    state = "unfiled"
  )
  if state == "pending" (
    return
  )
  object stored = setReportRotur(report.id.toStr(), state, (result.data.report_id ?? "").toStr())
  // A moderator may have closed it while it was being filed.
  if state == "filed" and stored.resolved == true (
    closeRoturReport(stored, if (stored.action ?? "").toStr() == "dismiss" then "dismissed" else "resolved")
  )
)

// Tries again to file reports Rotur couldn't be reached for, from the
// reconcile loop.
def fileUnfiledRoturReports() (
  if !roturAppReady() (
    return
  )
  array reports = loadReports()
  for i reports.len (
    object report = reports[i].assert(object)
    if (report.rotur ?? "").toStr() == "pending" (
      fileRoturReport(report)
    )
  )
)

// outcome is "resolved" (action taken) or "dismissed". Rotur keeps reports
// it is reviewing, and says no to closing them, which is fine.
def closeRoturReport(object report, string outcome) (
  string reportId = (report.roturReportId ?? "").toStr()
  if reportId != "" (
    roturApp("POST", "/reports/" ++ url.escape(reportId) ++ "/resolve", {outcome: outcome})
  )
)

def handleCreateReport(*serve.Context c) (
  object body = c.bodyJSON()
  string reportType = body.type.toStr()
  string target = body.target.toStr()
  string reason = body.reason.toStr().strip()

  if reportType != "project" and reportType != "user" and reportType != "comment" and reportType != "bounty" (
    c.badRequest("invalid report type")
    return
  )
  if target == "" or target.len > 200 or reason == "" or reason.len > 1000 (
    c.badRequest("invalid report")
    return
  )
  if reportType == "project" and !loadProject(target).ok (
    c.badRequest("project not found")
    return
  )

  object report = {
    id: "r" ++ randomString(12),
    reporter: c.getString("username"),
    sourceKey: reportSourceKey(c),
    type: reportType,
    target: target,
    reason: reason,
    category: reportCategory(body, reason),
    created: timestamp,
    resolved: false
  }
  if body.contains("context") and body.context != null (
    report.context = body.context.toStr().trim(1, 5000)
  )
  // Who it's about comes from the content, never from the reporter.
  object reported = reportedContent(report)
  report.snapshot = reported.snapshot.toStr().trim(1, 4000)
  if reported.user.toStr() != "" (
    report.subject = reported.user.toStr()
    report.targetUser = reported.user.toStr()
  )
  if roturAppReady() (
    report.rotur = "pending"
  )
  sync.lock("reports-storage")
  array reports = loadReports()
  if !canAppendPendingReport(reports, report.sourceKey.toStr()) (
    sync.unlock("reports-storage")
    c.json(429, {ok: false, error: "too many pending reports"})
    return
  )
  reports.append(report)
  boolean saved = saveReports(reports)
  sync.unlock("reports-storage")
  if !saved (
    c.internalError("could not save report")
    return
  )
  if reportType == "project" (
    snapshotProjectEvidence(target)
  )
  thread.new(fileRoturReport, report)
  c.json(201, {ok: true})
)

def handleCreateSupportRequest(*serve.Context c) (
  object body = c.bodyJSON()
  string requestType = body.type.toStr().toLower().strip()
  string username = body.username.toStr().trim(1, 80)
  string subject = body.subject.toStr().strip()
  string message = body.message.toStr().strip()
  if c.getBool("authenticated") (
    username = c.getString("username")
  )
  if requestType != "account" and requestType != "safety" and requestType != "legal" and requestType != "appeal" (
    c.badRequest("choose a support topic")
    return
  )
  if username == "" or subject == "" or subject.len > 120 or message == "" or message.len > 3000 (
    c.badRequest("add your username, a subject, and a message")
    return
  )
  object report = {
    id: "s" ++ randomString(12),
    reporter: username,
    sourceKey: reportSourceKey(c),
    type: "support",
    supportType: requestType,
    target: username,
    reason: subject,
    context: message,
    created: timestamp,
    resolved: false
  }
  sync.lock("reports-storage")
  array reports = loadReports()
  if !canAppendPendingReport(reports, report.sourceKey.toStr()) (
    sync.unlock("reports-storage")
    c.json(429, {ok: false, error: "too many pending support requests"})
    return
  )
  reports.append(report)
  boolean saved = saveReports(reports)
  sync.unlock("reports-storage")
  if !saved (
    c.internalError("could not save support request")
    return
  )
  c.json(201, {ok: true, id: report.id})
)

def handleGetReports(*serve.Context c) (
  c.json(200, {ok: true, reports: loadReports()})
)

def handleResolveReport(*serve.Context c) (
  object body = c.bodyJSON()
  string id = body.id.toStr()
  sync.lock("reports-storage")
  array reports = loadReports()
  boolean found = false
  string projectTarget = ""
  object resolved = {}
  for i reports.len (
    object report = reports[i]
    if report.id.toStr() == id (
      report.resolved = true
      found = true
      resolved = report
      if report.type.toStr() == "project" (
        projectTarget = report.target.toStr()
      )
    )
  )
  if !found (
    sync.unlock("reports-storage")
    c.notFound("report not found")
    return
  )
  boolean saved = saveReports(reports)
  sync.unlock("reports-storage")
  if !saved (
    c.internalError("could not update report")
    return
  )
  if projectTarget != "" (
    maybeClearProjectEvidence(projectTarget)
  )
  closeRoturReport(resolved, "resolved")
  c.json(200, {ok: true})
)

// Reports someone filed stay for moderation, without saying who filed them.
def anonymiseReportsBy(string username, string userId) (
  string key = normalizeUsername(username)
  string sourceKey = "user:" ++ userId
  sync.lock("reports-storage")
  array reports = loadReports()
  boolean changed = false
  for i reports.len (
    object report = reports[i].assert(object)
    if normalizeUsername((report.reporter ?? "").toStr()) == key or (report.sourceKey ?? "").toStr() == sourceKey (
      report.reporter = "Deleted User"
      report.sourceKey = ""
      reports[i] = report
      changed = true
    )
  )
  if changed (
    saveReports(reports)
  )
  sync.unlock("reports-storage")
)
