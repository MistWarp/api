def themePath(string id) string (
    return themesDir ++ id ++ ".json"
)

def themePreviewPath(string id) string (
    return themePreviewsDir ++ id ++ ".png"
)

def validatedThemeData(*serve.Context c, any rawTheme) object (
    object data = rawTheme.assertElse(object, {})
    string name = (data.name ?? "").toStr().strip()
    string gui = (data.gui ?? "").toStr()
    string blocks = (data.blocks ?? "").toStr()
    string menuBarAlign = (data.menuBarAlign ?? "center").toStr()
    if name == "" or name.len > 100 (
        c.badRequest("theme data needs a name of 1 to 100 characters")
        return {ok: false}
    )
    if gui != "light" and gui != "dark" and gui != "midnight" (
        c.badRequest("theme gui must be light, dark, or midnight")
        return {ok: false}
    )
    if blocks != "three" and blocks != "dark" and blocks != "high-contrast" and blocks != "custom" (
        c.badRequest("theme blocks must be three, dark, high-contrast, or custom")
        return {ok: false}
    )
    if menuBarAlign != "left" and menuBarAlign != "center" and menuBarAlign != "right" (
        c.badRequest("theme menu bar alignment must be left, center, or right")
        return {ok: false}
    )
    return {ok: true, data: data}
)

def loadTheme(string id) object (
    if !isSafePathPart(id) (
        return {ok: false, error: "invalid theme id"}
    )
    auto result = readFile(themePath(id))
    if !result.ok (
        return {ok: false, error: "theme not found"}
    )
    return {ok: true, theme: result.data.assert(object)}
)

def saveTheme(object theme) boolean (
    return writeFile(themePath(theme.id.toStr()), theme)
)

def themeOwner(object theme, *serve.Context c) boolean (
    return identityMatches((theme.ownerId ?? "").toStr(), theme.owner.toStr(), c.getString("userId"), c.getString("username"))
)

def themeBuyers(object theme) array (
    if theme.contains("buyers") and theme.buyers != null (
        return theme.buyers.assert(array)
    )
    return []
)

def hasBoughtTheme(object theme, string username) boolean (
    string wanted = normalizeUsername(username)
    array buyers = themeBuyers(theme)
    for i buyers.len (
        object buyer = buyers[i].assert(object)
        if normalizeUsername(buyer.user.toStr()) == wanted (
            return true
        )
    )
    return false
)

def themePrice(object _) number (
    return 0
)

def themeSavedBy(object theme) array (
    if theme.contains("savedBy") and theme.savedBy != null (
        return theme.savedBy.assert(array)
    )
    return []
)

def themeDownloaders(object theme) array (
    if theme.contains("downloaders") and theme.downloaders != null (
        return theme.downloaders.assert(array)
    )
    return []
)

def themePreviewUrl(object theme) string (
    if fs.exists(themePreviewPath(theme.id.toStr())) (
        return appURL ++ "/theme-previews/" ++ theme.id.toStr() ++ ".png?v=" ++ theme.edited.toStr()
    )
    return ""
)

def themeVisual(object theme) object (
    object data = theme.theme.assertElse(object, {})
    return {
        gui: (data.gui ?? "light").toStr(),
        blocks: (data.blocks ?? "three").toStr(),
        menuBarAlign: (data.menuBarAlign ?? "center").toStr(),
        accent: data.accent ?? {},
        colors: data.colors ?? {}
    }
)

def themeResponse(object theme, *serve.Context c, boolean includeData) object (
    string viewer = normalizeUsername(c.getString("username"))
    boolean owner = themeOwner(theme, c) or c.getBool("isAdmin")
    number price = themePrice(theme)
    array likes = []
    if theme.contains("likes") and theme.likes != null (
        likes = theme.likes.assert(array)
    )
    object response = {
        id: theme.id,
        owner: theme.owner,
        name: theme.name,
        description: theme.description,
        price: price,
        previewUrl: themePreviewUrl(theme),
        visual: themeVisual(theme),
        created: theme.created,
        edited: theme.edited,
        published: theme.published == true,
        likes: likes.len,
        liked: likes.contains(viewer),
        downloads: themeDownloaders(theme).len,
        isOwner: owner,
        saved: themeSavedBy(theme).contains(viewer),
        locked: false
    }
    if includeData (
        response.theme = theme.theme
    )
    return response
)

def countPublishedThemes(string userId) number (
    number count = 0
    array files = fs.readDir(themesDir).toArray()
    for i files.len (
        string file = files[i].toStr()
        if file.endsWith(".json") (
            auto result = readFile(themesDir ++ file)
            if result.ok (
                object theme = result.data.assert(object)
                if (theme.ownerId ?? "").toStr() == userId and theme.published == true (
                    count = count + 1
                )
            )
        )
    )
    return count
)

def handleListThemes(*serve.Context c) (
    string owner = normalizeUsername(c.query("owner"))
    string viewer = normalizeUsername(c.getString("username"))
    array themes = []
    array files = fs.readDir(themesDir).toArray()
    for i files.len (
        string file = files[i].toStr()
        if file.endsWith(".json") (
            auto result = readFile(themesDir ++ file)
            if result.ok (
                object theme = result.data.assert(object)
                boolean mine = normalizeUsername(theme.owner.toStr()) == viewer
                boolean ownerMatch = owner == "" or normalizeUsername(theme.owner.toStr()) == owner
                if ownerMatch and (theme.published == true or mine or c.getBool("isAdmin")) (
                    themes.append(themeResponse(theme, c, false))
                )
            )
        )
    )
    string sort = c.queryDefault("sort", "likes")
    if sort == "likes" (
        themes.sortBy("likes", "descending")
    ) else if sort == "downloads" (
        themes.sortBy("downloads", "descending")
    ) else (
        themes.sortBy("created", "descending")
    )
    c.json(200, {ok: true, themes: themes})
)

def handleGetTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    if theme.published != true and !themeOwner(theme, c) and !c.getBool("isAdmin") (
        c.notFound("theme not found")
        return
    )
    c.json(200, {ok: true, theme: themeResponse(theme, c, true)})
)

def validateThemeFields(*serve.Context c, object body) object (
    string name = (body.name ?? "").toStr().strip()
    string description = (body.description ?? "").toStr().strip()
    if name == "" or name.len > 100 (
        c.badRequest("theme names must contain 1 to 100 characters")
        return {ok: false}
    )
    if description.len > 1000 (
        c.badRequest("theme descriptions must be 1,000 characters or fewer")
        return {ok: false}
    )
    return {ok: true, name: name, description: description}
)

def handleCreateTheme(*serve.Context c) (
    object body = c.bodyJSON()
    if !body.contains("theme") or body.theme == null (
        c.badRequest("theme data is required")
        return
    )
    object checkedTheme = validatedThemeData(c, body.theme)
    if !checkedTheme.ok (
        return
    )
    string encoded = json.stringify(checkedTheme.data)
    if encoded.len > 131072 (
        c.badRequest("theme data cannot exceed 128 KB")
        return
    )
    object benefits = mistwarpBenefitsForUserId(c.getString("userId"))
    boolean published = body.contains("published") and body.published == true
    if published (
        c.badRequest("create the theme as a draft, upload its preview, then publish it")
        return
    )
    if published and countPublishedThemes(c.getString("userId")) >= benefits.themeListingLimit.toNum() (
        c.json(403, {ok: false, code: "theme_limit", error: "your Rotur plan allows " ++ benefits.themeListingLimit.toStr() ++ " published themes"})
        return
    )
    object fields = validateThemeFields(c, body)
    if !fields.ok (
        return
    )
    string id = generateId()
    object theme = {
        id: id,
        owner: c.getString("username"),
        ownerId: c.getString("userId"),
        name: fields.name,
        description: fields.description,
        price: 0,
        theme: checkedTheme.data,
        published: published,
        created: timestamp,
        edited: timestamp,
        likes: [],
        downloaders: [],
        revenue: 0,
        buyers: [],
        savedBy: []
    }
    if !saveTheme(theme) (
        c.internalError("failed to save the theme")
        return
    )
    c.json(201, {ok: true, theme: themeResponse(theme, c, false)})
)

def handleUpdateTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    if !themeOwner(theme, c) and !c.getBool("isAdmin") (
        c.forbidden("not your theme")
        return
    )
    object body = c.bodyJSON()
    object benefits = mistwarpBenefitsForProject({ownerId: theme.ownerId, owner: theme.owner})
    object fields = validateThemeFields(c, {
        name: body.contains("name") ? body.name theme.name,
        description: body.contains("description") ? body.description theme.description
    })
    if !fields.ok (
        return
    )
    boolean nextPublished = body.contains("published") ? body.published == true theme.published == true
    if nextPublished and !fs.exists(themePreviewPath(theme.id.toStr())) (
        c.badRequest("upload a preview image before publishing this theme")
        return
    )
    if nextPublished and theme.published != true and countPublishedThemes(theme.ownerId.toStr()) >= benefits.themeListingLimit.toNum() (
        c.json(403, {ok: false, code: "theme_limit", error: "this account has reached its published theme limit"})
        return
    )
    theme.name = fields.name
    theme.description = fields.description
    theme.price = 0
    theme.published = nextPublished
    if body.contains("theme") and body.theme != null (
        object checkedTheme = validatedThemeData(c, body.theme)
        if !checkedTheme.ok (
            return
        )
        string encoded = json.stringify(checkedTheme.data)
        if encoded.len > 131072 (
            c.badRequest("theme data cannot exceed 128 KB")
            return
        )
        theme.theme = checkedTheme.data
    )
    theme.edited = timestamp
    saveTheme(theme)
    c.json(200, {ok: true, theme: themeResponse(theme, c, false)})
)

def handleSetThemePreview(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    if !themeOwner(theme, c) and !c.getBool("isAdmin") (
        c.forbidden("not your theme")
        return
    )
    auto previewResult = c.formFile("preview")
    if previewResult.isErr() (
        c.badRequest("missing PNG preview")
        return
    )
    object preview = previewResult.unwrap().assert(object)
    if preview.size.toNum() > 2097152 (
        c.badRequest("theme previews cannot exceed 2 MB")
        return
    )
    if !fs.writeFileBytes(themePreviewPath(theme.id.toStr()), preview.data) (
        c.internalError("failed to save the theme preview")
        return
    )
    theme.edited = timestamp
    saveTheme(theme)
    c.json(200, {ok: true, previewUrl: themePreviewUrl(theme)})
)

def handleDeleteTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    if !themeOwner(theme, c) and !c.getBool("isAdmin") (
        c.forbidden("not your theme")
        return
    )
    fs.remove(themePath(theme.id.toStr()))
    fs.remove(themePreviewPath(theme.id.toStr()))
    c.json(200, {ok: true})
)

def handleLikeTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok or result.theme.published != true (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    array likes = theme.likes.assertElse(array, [])
    string user = normalizeUsername(c.getString("username"))
    if likes.contains(user) (
        array kept = []
        for i likes.len (
            if likes[i].toStr() != user (
                kept.append(likes[i])
            )
        )
        likes = kept
    ) else (
        likes.append(user)
    )
    theme.likes = likes
    saveTheme(theme)
    c.json(200, {ok: true, liked: likes.contains(user), likes: likes.len})
)

def handleSaveTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok or result.theme.published != true (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    array savedBy = themeSavedBy(theme)
    string user = normalizeUsername(c.getString("username"))
    if !savedBy.contains(user) (
        savedBy.append(user)
    )
    theme.savedBy = savedBy
    saveTheme(theme)
    c.json(200, {ok: true, saved: true})
)

def themeCommerceSplits(object theme) array (
    number platformPoints = mistwarpBenefitsForUserId((theme.ownerId ?? "").toStr()).salesFeeBasisPoints.toNum().toInt()
    array splits = []
    string platformUser = mistwarpAccountUser()
    if platformUser != "" and platformPoints > 0 (
        splits.append({username: platformUser, basis_points: platformPoints})
    )
    splits.append({username: theme.owner, basis_points: 10000 - platformPoints})
    return splits
)

def verifyThemePayment(string paymentId, string buyer, object theme, array expectedSplits) boolean (
    if commerceServiceKey == "" or paymentId == "" (
        return false
    )
    object response = requests.get(roturBase ++ "/v2/commerce/payments/" ++ url.escape(paymentId) ++ "/verify?source=mistwarp", {headers: {"X-Commerce-Key": commerceServiceKey}})
    if !response.success or response.status.toInt() != 200 (
        return false
    )
    auto parsed = json.parse(response.body, {type: "object"})
    if parsed.isErr() (
        return false
    )
    object payment = parsed.unwrap().assert(object).payment.assert(object)
    if payment.status.toStr() != "completed" or payment.source.toStr() != "mistwarp" or payment.kind.toStr() != "theme_sale" (
        return false
    )
    if payment.resource_type.toStr() != "theme" or payment.resource_id.toStr() != theme.id.toStr() (
        return false
    )
    if normalizeUsername(payment.payer.toStr()) != normalizeUsername(buyer) or payment.amount.toNum() + 0.001 < themePrice(theme) (
        return false
    )
    array actual = payment.recipients.assert(array)
    if actual.len != expectedSplits.len (
        return false
    )
    for i expectedSplits.len (
        object expected = expectedSplits[i].assert(object)
        boolean found = false
        for j actual.len (
            object recipient = actual[j].assert(object)
            if normalizeUsername(recipient.username.toStr()) == normalizeUsername(expected.username.toStr()) and recipient.basis_points.toNum().toInt() == expected.basis_points.toNum().toInt() (
                found = true
            )
        )
        if !found (
            return false
        )
    )
    return true
)

def handleThemePurchaseIntent(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok or result.theme.published != true (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    number price = themePrice(theme)
    if price <= 0 or themeOwner(theme, c) (
        c.badRequest("this theme does not need to be purchased")
        return
    )
    if hasBoughtTheme(theme, c.getString("username")) (
        c.json(200, {ok: true, already: true, theme: themeResponse(theme, c, false)})
        return
    )
    string key = "mwtheme_" ++ randomString(16)
    object store = prunePurchaseKeys(loadPurchaseKeys())
    object keys = store.keys
    keys[key] = {type: "theme_sale", themeId: theme.id, buyer: normalizeUsername(c.getString("username")), price: price, at: timestamp}
    store.keys = keys
    savePurchaseKeys(store)
    c.json(200, {ok: true, key: key, amount: price, title: theme.name, splits: themeCommerceSplits(theme)})
)

def handleThemePurchaseConfirm(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    object body = c.bodyJSON()
    string key = (body.key ?? "").toStr()
    string paymentId = (body.paymentId ?? "").toStr()
    object store = loadPurchaseKeys()
    object keys = store.keys
    if !keys.contains(key) (
        c.badRequest("this purchase request expired")
        return
    )
    object pending = keys[key].assert(object)
    string buyer = c.getString("username")
    if pending.type.toStr() != "theme_sale" or pending.themeId.toStr() != theme.id.toStr() or normalizeUsername(pending.buyer.toStr()) != normalizeUsername(buyer) (
        c.badRequest("this purchase request does not match")
        return
    )
    array splits = themeCommerceSplits(theme)
    if !verifyThemePayment(paymentId, buyer, theme, splits) (
        c.json(402, {ok: false, pending: true, error: "payment has not been verified yet"})
        return
    )
    keys.delete(key)
    store.keys = keys
    savePurchaseKeys(store)
    array buyers = themeBuyers(theme)
    buyers.append({user: buyer, at: timestamp, amount: themePrice(theme)})
    theme.buyers = buyers
    number ownerPoints = 10000 - mistwarpBenefitsForUserId((theme.ownerId ?? "").toStr()).salesFeeBasisPoints.toNum()
    theme.revenue = (theme.revenue ?? 0).toNum() + ((themePrice(theme) * ownerPoints) / 10000)
    saveTheme(theme)
    c.json(200, {ok: true, theme: themeResponse(theme, c, false)})
)

def handleDownloadTheme(*serve.Context c) (
    auto result = loadTheme(c.param("id"))
    if !result.ok or result.theme.published != true (
        c.notFound("theme not found")
        return
    )
    object theme = result.theme.assert(object)
    string userId = c.getString("userId")
    if userId != "" (
        array downloaders = themeDownloaders(theme)
        if !downloaders.contains(userId) (
            downloaders.append(userId)
            theme.downloaders = downloaders
            saveTheme(theme)
        )
    )
    c.json(200, {ok: true, id: theme.id, name: theme.name, author: theme.owner, theme: theme.theme})
)

def purgeThemesForUser(string userId, string username) (
    array files = fs.readDir(themesDir).toArray()
    for i files.len (
        string file = files[i].toStr()
        if file.endsWith(".json") (
            auto result = readFile(themesDir ++ file)
            if result.ok (
                object theme = result.data.assert(object)
                if identityMatches((theme.ownerId ?? "").toStr(), theme.owner.toStr(), userId, username) (
                    fs.remove(themePath(theme.id.toStr()))
                    fs.remove(themePreviewPath(theme.id.toStr()))
                )
            )
        )
    )
)
