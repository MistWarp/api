import "std:testing"
import "./project-sharing-policy.osl"

array projects = [{}, {seeInside: true}, {seeInside: false}, {seeInside: true, price: 10}, {seeInside: false, price: 10}]
for i projects.len (
  object project = projects[i].assert(object)
  testing.assert(projectSourcePolicyAllows(project, true), "owners retain source access")
  boolean expected = !(project.contains("seeInside") and project.seeInside == false)
  testing.assert(projectSourcePolicyAllows(project, false) == expected, "everyone else follows See inside, whatever the old price")
)
