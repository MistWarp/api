import "std:testing"
import "./project-sharing-policy.osl"

testing.assert(remixIsContributionOnly({}, 10), "paid project remixes are contribution-only")
testing.assert(remixIsContributionOnly({contributionOnly: true}, 0), "the restriction follows later remixes")
testing.assert(!remixIsContributionOnly({}, 0), "free project remixes can still be shared")

array projects = [{}, {seeInside: true}, {seeInside: false}]
array prices = [0, 10]
for i projects.len (
  for j prices.len (
    object project = projects[i].assert(object)
    number price = prices[j].toNum()
    testing.assert(projectSourcePolicyAllows(project, price, true), "owners retain source access")
    boolean expected = price == 0 and !(project.contains("seeInside") and project.seeInside == false)
    testing.assert(projectSourcePolicyAllows(project, price, false) == expected, "nonowners need free and open source")
  )
)
