def validateZipArchive(any body, number maxCompressedBytes, number maxExpandedBytes, number maxFiles, boolean readContents) boolean (
    return raw("func() bool { data, ok := body.([]byte); if !ok || len(data) < 22 || int64(len(data)) > int64(maxCompressedBytes) { return false }; read16 := func(offset int) uint64 { return uint64(data[offset]) | uint64(data[offset+1])<<8 }; read32 := func(offset int) uint64 { return read16(offset) | read16(offset+2)<<16 }; eocd := -1; searchStart := len(data)-22-65535; if searchStart < 0 { searchStart = 0 }; for offset := len(data)-22; offset >= searchStart; offset-- { if data[offset] == 0x50 && data[offset+1] == 0x4b && data[offset+2] == 0x05 && data[offset+3] == 0x06 && offset+22+int(read16(offset+20)) == len(data) { eocd = offset; break } }; if eocd < 0 || read16(eocd+4) != 0 || read16(eocd+6) != 0 { return false }; entries := read16(eocd+10); if entries == 0 || entries == 65535 || read16(eocd+8) != entries || entries > uint64(maxFiles) { return false }; directorySize := read32(eocd+12); directoryOffset := read32(eocd+16); if directoryOffset+directorySize != uint64(eocd) || directoryOffset > uint64(len(data)) { return false }; position := int(directoryOffset); directoryEnd := int(directoryOffset+directorySize); counted := uint64(0); for position < directoryEnd { if position+46 > directoryEnd || data[position] != 0x50 || data[position+1] != 0x4b || data[position+2] != 0x01 || data[position+3] != 0x02 { return false }; position += 46+int(read16(position+28))+int(read16(position+30))+int(read16(position+32)); counted++; if position > directoryEnd || counted > uint64(maxFiles) { return false } }; if position != directoryEnd || counted != entries { return false }; reader, err := OSLgozip.NewReader(OSLbytes.NewReader(data), int64(len(data))); if err != nil || len(reader.File) != int(entries) { return false }; paths := map[string]bool{}; requiredDirs := map[string]bool{}; var declaredBytes uint64; var actualBytes uint64; expandedLimit := uint64(maxExpandedBytes); for _, item := range reader.File { name := item.Name; cleanName := OSLstrings.TrimSuffix(name, \"/\"); unsafe := cleanName == \"\" || len(name) > 1024 || OSLstrings.HasPrefix(cleanName, \"/\") || OSLstrings.Contains(cleanName, \"\\\\\") || OSLstrings.ContainsRune(cleanName, 0); parts := OSLstrings.Split(cleanName, \"/\"); for _, part := range parts { if part == \"\" || part == \".\" || part == \"..\" { unsafe = true } }; directory := item.FileInfo().IsDir(); if unsafe || item.Mode()&OSLos.ModeSymlink != 0 { return false }; if _, exists := paths[cleanName]; exists || !directory && requiredDirs[cleanName] { return false }; parent := \"\"; for index := 0; index < len(parts)-1; index++ { if parent == \"\" { parent = parts[index] } else { parent += \"/\" + parts[index] }; if parentDirectory, exists := paths[parent]; exists && !parentDirectory { return false }; requiredDirs[parent] = true }; paths[cleanName] = directory; if directory { if item.UncompressedSize64 != 0 { return false }; continue }; if !item.Mode().IsRegular() || item.Method != OSLgozip.Store && item.Method != OSLgozip.Deflate { return false }; if item.UncompressedSize64 > expandedLimit-declaredBytes { return false }; declaredBytes += item.UncompressedSize64; if !readContents { continue }; source, openErr := item.Open(); if openErr != nil { return false }; copied, copyErr := OSLio.Copy(OSLio.Discard, OSLio.LimitReader(source, int64(expandedLimit-actualBytes)+1)); closeErr := source.Close(); if copyErr != nil || closeErr != nil || copied < 0 || uint64(copied) != item.UncompressedSize64 || uint64(copied) > expandedLimit-actualBytes { return false }; actualBytes += uint64(copied) }; return !readContents || actualBytes == declaredBytes }()")
)
