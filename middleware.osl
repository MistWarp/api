def authMiddleware(*serve.Context c) (
  boolean authenticated = false
  string username = ""
  string userId = ""
  boolean isAdmin = false
  boolean isStudent = false
  boolean isMinor = false
  string sessionScope = ""

  string token = requestToken(c)
  if token != "" (
    object session = getSession(token)
    if session.ok == true and !isBannedUser(session.username.toStr()) (
      authenticated = true
      username = session.username.toStr()
      userId = session.userId.toStr()
      isMinor = session.minor == true
      sessionScope = (session.scope ?? "").toStr()
      if isStudentUserId(userId) (
        object student = loadStudent(userId)
        isStudent = true
        if student.len == 0 or student.disabled == true (
          authenticated = false
          username = ""
          userId = ""
        )
      ) else (
        isAdmin = sessionScope == "" and isAdminUser(username)
      )
    )
  )

  c.set("authenticated", authenticated)
  c.set("username", username)
  c.set("userId", userId)
  c.set("isAdmin", isAdmin)
  c.set("isStudent", isStudent and authenticated)
  c.set("isMinor", (isMinor or isStudent) and authenticated)
  c.set("sessionScope", if authenticated then sessionScope else "")

  c.next()
)

def requireAuth(*serve.Context c) (
  if !contextBool(c, "authenticated") (
    c.json(401, {ok: false, error: "not authenticated"})
    c.abort()
    return
  )
  c.next()
)

def requireAdmin(*serve.Context c) (
  if !contextBool(c, "authenticated") (
    c.json(401, {ok: false, error: "not authenticated"})
    c.abort()
    return
  )
  if !contextBool(c, "isAdmin") (
    c.json(403, {ok: false, error: "admin access required"})
    c.abort()
    return
  )
  c.next()
)

def editorSessionGuard(*serve.Context c) (
  if contextString(c, "sessionScope") == "editor" and !editorRouteAllowed(c.method(), escapedRequestPath(c.fullURL(), c.scheme() ++ "://" ++ c.host()), c.path()) (
    c.json(403, {ok: false, code: "editor_scope", error: "Open MistWarp to do this."})
    c.abort()
    return
  )
  c.next()
)
