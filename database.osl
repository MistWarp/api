import "std:process"

// The database and its collections are opened once at startup. A failure here
// means the API cannot serve anything, so report the reason and stop instead of
// carrying on with a half-initialized database.
def openCommunityDatabase(string path) *db.DB (
  *db.DB database = db.open(path) catch (err) (
    log "FATAL: could not open " ++ path ++ ": " ++ err.toStr()
    process.exit(1)
  )
  return database
)

def openCollection(*db.DB database, string name) *db.Collection (
  *db.Collection collection = database.collection(name) catch (err) (
    log "FATAL: could not open collection " ++ name ++ ": " ++ err.toStr()
    process.exit(1)
  )
  return collection
)

*db.DB communityDb = openCommunityDatabase("data/community.db")
*db.Collection projectSearchDocs = openCollection(communityDb, "project_search")
*db.Collection profileSearchDocs = openCollection(communityDb, "profile_search")
*db.Collection spaceDocs = openCollection(communityDb, "spaces")
*db.Collection spaceMemberDocs = openCollection(communityDb, "space_members")
*db.Collection releaseDocs = openCollection(communityDb, "releases")
*db.Collection previewDocs = openCollection(communityDb, "previews")
*db.Collection diagnosticDocs = openCollection(communityDb, "diagnostics")
*db.Collection errorDocs = openCollection(communityDb, "site_errors")
*db.Collection feedbackDocs = openCollection(communityDb, "project_feedback")
*db.Collection ideaDocs = openCollection(communityDb, "roadmap_ideas")
*db.Collection developmentDocs = openCollection(communityDb, "development_pulls")
*db.Collection playtimeDocs = openCollection(communityDb, "project_playtime")
*db.Collection playtimeSessionDocs = openCollection(communityDb, "project_playtime_sessions")
*db.Collection reviewDocs = openCollection(communityDb, "project_reviews")
*db.Collection pullDocs = openCollection(communityDb, "project_pulls")
*db.Collection likeMilestoneDocs = openCollection(communityDb, "like_milestones")
*db.Collection bountyWorkerDocs = openCollection(communityDb, "bounty_workers")
*db.Collection classDocs = openCollection(communityDb, "classroom_classes")
*db.Collection studentDocs = openCollection(communityDb, "classroom_students")
*db.Collection classroomPlanDocs = openCollection(communityDb, "classroom_plans")
*db.Collection assignmentDocs = openCollection(communityDb, "classroom_assignments")
*db.Collection submissionDocs = openCollection(communityDb, "classroom_submissions")
*db.Collection classroomAuditDocs = openCollection(communityDb, "classroom_audit")
*db.Collection classroomGroupDocs = openCollection(communityDb, "classroom_groups")
*db.Collection commentIndexDocs = openCollection(communityDb, "comment_index")

def putDocument(*db.Collection collection, string id, object value) boolean (
  value["_id"] = id
  if collection.exists({_id: id}) (
    return collection.replaceOne({_id: id}, value) == 1
  )
  return collection.insertOne(value).isOk()
)

def deleteDocumentsByField(*db.Collection collection, string field, string value) number (
  array documents = collection.where(field, "==", value).all()
  for i documents.len (
    object document = documents[i].assert(object)
    void collection.deleteOne({_id: document["_id"]})
  )
  return documents.len
)

def cleanupExpiredCommunityRecords() boolean (
  array previews = previewDocs.all() catch (err) (
    log "WARNING: could not read previews for cleanup: " ++ err.toStr()
    return false
  )
  for i previews.len (
    object preview = previews[i].assert(object)
    if preview.expiresAt.toNum() <= timestamp (
      void previewDocs.deleteOne({_id: preview["_id"]}) catch (err) (
        log "WARNING: could not delete expired preview: " ++ err.toStr()
        return false
      )
    )
  )
  array sessions = playtimeSessionDocs.all() catch (err) (
    log "WARNING: could not read playtime sessions for cleanup: " ++ err.toStr()
    return false
  )
  for i sessions.len (
    object session = sessions[i].assert(object)
    if timestamp - session.lastSeen.toNum() > 86400000 (
      void playtimeSessionDocs.deleteOne({_id: session["_id"]}) catch (err) (
        log "WARNING: could not delete expired playtime session: " ++ err.toStr()
        return false
      )
    )
  )
  return true
)

def deleteProjectCommunityRecords(string projectId) boolean (
  array releases = releaseDocs.where("projectId", "==", projectId).all()
  for i releases.len (
    object release = releases[i].assert(object)
    string jsonKey = (release.jsonKey ?? "").toStr()
    void fs.remove(releasesDir ++ release["_id"].toStr().replace(":", "-") ++ ".json")
    void releaseDocs.deleteOne({_id: release["_id"]})
    if jsonKey != "" (
      removeProjectStorageKeyIfOrphaned(jsonKey, projectId, false)
    )
  )
  deleteDocumentsByField(previewDocs, "projectId", projectId)
  deleteDocumentsByField(diagnosticDocs, "projectId", projectId)
  deleteDocumentsByField(feedbackDocs, "projectId", projectId)
  deleteDocumentsByField(reviewDocs, "projectId", projectId)
  deleteDocumentsByField(playtimeDocs, "projectId", projectId)
  deleteDocumentsByField(playtimeSessionDocs, "projectId", projectId)
  deleteDocumentsByField(pullDocs, "targetProjectId", projectId)
  deleteDocumentsByField(pullDocs, "sourceProjectId", projectId)
  return true
)

def syncSearchProject(object project) boolean (
  object entry = indexEntryFromProject(project)
  if entry.remixRoot.toStr() == "" and entry.remixParent.toStr() != "" (
    object parent = (projectSearchDocs.findById(entry.remixParent.toStr()) ?? {})
    if parent.len > 0 (
      entry.remixRoot = parent.id
      if parent.contains("remixRoot") and parent.remixRoot.toStr() != "" (
        entry.remixRoot = parent.remixRoot
      )
    )
  )
  boolean saved = putDocument(projectSearchDocs, project.id.toStr(), entry)
  if saved (
    sharedProjectsCache.delete("projects")
  )
  return saved
)

def syncSearchProfile(object profile) boolean (
  string key = normalizeUsername(profile.username.toStr())
  array followers = profile.followers.assert(array)
  string userId = ""
  if profile.contains("userId") and profile.userId != null (
    userId = profile.userId.toStr()
  )
  number created = if profile.contains("created") then profile.created.toNum() else 0
  object entry = {_id: key, userId: userId, username: profile.username, usernameKey: key, bio: profile.bio, followers: followers.len, created: created, minor: profileIsMinor(profile), standing: (profile.standing ?? "good").toStr(), edited: timestamp}
  return putDocument(profileSearchDocs, key, entry)
)

def removeSearchProject(string id) boolean (
  void projectSearchDocs.deleteOne({_id: id})
  sharedProjectsCache.delete("projects")
  return true
)

def migratePullCommentCounts() boolean (
  string migrationId = "migration:pull-comment-count-v1"
  if (diagnosticDocs.findById(migrationId) ?? {}).len > 0 (
    return true
  )
  array pulls = pullDocs.all()
  for i pulls.len (
    object pull = pulls[i].assert(object)
    if !pull.contains("commentCount") or pull.commentCount == null (
      pull.commentCount = loadComments(pullCommentKey(pull)).len
      if !putDocument(pullDocs, pull["_id"].toStr(), pull) (
        return false
      )
    )
  )
  return putDocument(diagnosticDocs, migrationId, {_id: migrationId, completedAt: timestamp})
)

def initCommunityDatabase() boolean (
  if projectSearchDocs.count({}) == 0 (
    array projectFiles = fs.readDir(projectsDir).unwrapOr([])
    for i projectFiles.len (
      string file = projectFiles[i].toStr()
      if file.endsWith(".json") (
        string id = file.replace(".json", "")
        auto loaded = loadProject(id)
        if loaded.ok (
          object entry = indexEntryFromProject(loaded.project.assert(object))
          entry["_id"] = id
          void projectSearchDocs.insertOne(entry)
        )
      )
    )
  )
  if profileSearchDocs.count({}) == 0 (
    array names = fs.readDir(usersDir).unwrapOr([])
    for i names.len (
      string file = names[i].toStr()
      if file.endsWith(".json") (
        syncSearchProfile(loadProfile(file.replace(".json", "")))
      )
    )
  )
  array profileEntries = profileSearchDocs.all()
  for i profileEntries.len (
    object entry = profileEntries[i].assert(object)
    if !entry.contains("created") (
      object profile = loadProfile(entry.usernameKey.toStr())
      entry.created = if profile.contains("created") then profile.created.toNum() else 0
      putDocument(profileSearchDocs, entry["_id"].toStr(), entry)
    )
  )
  array projectEntries = projectSearchDocs.all()
  object projectsById = {}
  for i projectEntries.len (
    object entry = projectEntries[i].assert(object)
    projectsById[entry.id.toStr()] = entry
  )
  for i projectEntries.len (
    object entry = projectEntries[i].assert(object)
    string id = entry.id.toStr()
    boolean changed = false
    string ownerKey = normalizeUsername(entry.owner.toStr())
    if !entry.contains("ownerKey") or entry.ownerKey.toStr() != ownerKey (
      entry.ownerKey = ownerKey
      changed = true
    )
    string root = id
    string current = id
    number hops = 0
    boolean walking = true
    while walking and hops < 100 (
      object cursor = projectsById[current]
      string parent = cursor.remixParent.toStr()
      if parent != "" and parent != current and projectsById.contains(parent) (
        root = parent
        current = parent
      ) else (
        walking = false
      )
      hops += 1
    )
    string remixRoot = ""
    if root != id (
      remixRoot = root
    )
    if !entry.contains("remixRoot") or entry.remixRoot.toStr() != remixRoot (
      entry.remixRoot = remixRoot
      changed = true
    )
    if changed (
      putDocument(projectSearchDocs, id, entry)
    )
  )
  array reviews = reviewDocs.all()
  for i reviews.len (
    object review = reviews[i].assert(object)
    if !review.contains("authorKey") (
      review.authorKey = normalizeUsername(review.author.toStr())
      putDocument(reviewDocs, review["_id"].toStr(), review)
    )
  )
  return migratePullCommentCounts() and migrateCommentIndex()
)

def validPreviewKey(string projectId, string key) boolean (
  if key == "" (
    return false
  )
  object preview = previewDocs.findOne({projectId: projectId, key: key}) ?? {}
  if preview.len == 0 (
    return false
  )
  return preview.expiresAt.toNum() > timestamp
)

def projectPlaytimeRecord(string projectId, string username) object (
  if username == "" (
    return {}
  )
  string identityKey = userIdForUsername(username)
  if identityKey == "" (
    identityKey = normalizeUsername(username)
  )
  object entry = (playtimeDocs.findById(projectId ++ ":" ++ identityKey) ?? {})
  if entry.len == 0 and identityKey != normalizeUsername(username) (
    entry = (playtimeDocs.findById(projectId ++ ":" ++ normalizeUsername(username)) ?? {})
  )
  return entry
)

def projectPlaytime(string projectId, string username) number (
  object entry = projectPlaytimeRecord(projectId, username)
  return if entry.len == 0 then 0 else (entry.duration ?? 0).toNum()
)

def projectLastPlayed(string projectId, string username) number (
  object entry = projectPlaytimeRecord(projectId, username)
  return if entry.len == 0 then 0 else (entry.updated ?? 0).toNum()
)

def projectTotalPlaytime(string projectId) number (
  number total = 0
  array records = playtimeDocs.where("projectId", "==", projectId).all()
  for i records.len (
    object record = records[i].assert(object)
    total += record.duration.toNum()
  )
  return total
)
