auto communityDb = db.open("data/community.db")
auto projectSearchDocs = communityDb.collection("project_search")
auto profileSearchDocs = communityDb.collection("profile_search")
auto spaceDocs = communityDb.collection("spaces")
auto releaseDocs = communityDb.collection("releases")
auto previewDocs = communityDb.collection("previews")
auto diagnosticDocs = communityDb.collection("diagnostics")
auto feedbackDocs = communityDb.collection("project_feedback")
auto ideaDocs = communityDb.collection("roadmap_ideas")
auto playtimeDocs = communityDb.collection("project_playtime")
auto reviewDocs = communityDb.collection("project_reviews")

def putDocument(auto collection, string id, object value) boolean (
    value._id = id
    if collection.exists({_id: id}) (
        return collection.replaceOne({_id: id}, value) == 1
    )
    return collection.insertOne(value) != null
)

def syncSearchProject(object project) boolean (
    object entry = indexEntryFromProject(project)
    return putDocument(projectSearchDocs, project.id.toStr(), entry)
)

def syncSearchProfile(object profile) boolean (
    string key = normalizeUsername(profile.username.toStr())
    array followers = profile.followers.assert(array)
    object entry = {_id: key, username: profile.username, usernameKey: key, bio: profile.bio, followers: followers.len, edited: timestamp}
    return putDocument(profileSearchDocs, key, entry)
)

def removeSearchProject(string id) boolean (
    projectSearchDocs.deleteOne({_id: id})
    return true
)

def initCommunityDatabase() boolean (
    if projectSearchDocs.count({}) == 0 (
        object index = loadIndex()
        object projects = index.projects.assert(object)
        array keys = projects.getKeys().toArray()
        for i keys.len (
            string id = keys[i].toStr()
            auto loaded = loadProject(id)
            if loaded.ok (
                object entry = indexEntryFromProject(loaded.project.assert(object))
                entry._id = id
                projectSearchDocs.insertOne(entry)
            )
        )
    )
    if profileSearchDocs.count({}) == 0 (
        array names = fs.readDir(usersDir).toArray()
        for i names.len (
            string file = names[i].toStr()
            if file.endsWith(".json") (
                syncSearchProfile(loadProfile(file.replace(".json", "")))
            )
        )
    )
    return true
)

def validPreviewKey(string projectId, string key) boolean (
    if key == "" (
        return false
    )
    object preview = previewDocs.findOne({projectId: projectId, key: key})
    if preview.isEmpty() (
        return false
    )
    return preview.expiresAt.toNum() > timestamp
)

def projectPlaytime(string projectId, string username) number (
    if username == "" (
        return 0
    )
    object entry = playtimeDocs.findById(projectId ++ ":" ++ normalizeUsername(username))
    if entry.isEmpty() (
        return 0
    )
    return entry.duration.toNum()
)
