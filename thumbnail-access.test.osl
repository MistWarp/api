import "std:testing"
import "std:fs"
import "std:crypto"
import "./thumbnail-access.osl"

string secretPath = "data/tmp/thumbnail-access-secret.test"
void fs.mkdir("data/tmp", {recursive: true})
void fs.remove(secretPath)
string secret = loadThumbnailSecret(secretPath)
testing.assert(secret.len == 32, "makes a new secret when none is saved")
testing.assert(loadThumbnailSecret(secretPath) == secret, "keeps the saved secret across restarts")
void fs.remove(secretPath)

string key = thumbnailKey(secret, "p1", "view1")
testing.assert(key.len == 24, "keys are 24 characters")
testing.assert(thumbnailKeyMatches(secret, "p1", "view1", key), "a project's own key opens its thumbnail")
testing.assert(!thumbnailKeyMatches(secret, "p2", "view1", key), "one project's key doesn't open another's thumbnail")
testing.assert(!thumbnailKeyMatches(secret, "p1", "view2", key), "a new view key retires the old thumbnail key")
testing.assert(!thumbnailKeyMatches("other", "p1", "view1", key), "keys change with the secret")
testing.assert(!thumbnailKeyMatches(secret, "p1", "view1", ""), "no key opens nothing")
testing.assert(!thumbnailKeyMatches("", "p1", "view1", thumbnailKey("", "p1", "view1")), "nothing opens without a secret")

testing.assert(thumbnailIsPublic("public", false), "shared projects' thumbnails are public")
testing.assert(thumbnailIsPublic("unlisted", false), "unlisted projects' thumbnails are public")
testing.assert(!thumbnailIsPublic("private", false), "private projects' thumbnails need a key")
testing.assert(!thumbnailIsPublic("public", true), "banned owners' thumbnails aren't public")

object publicHeaders = thumbnailCacheHeaders(true)
testing.assert(publicHeaders.cdn.toStr() == "public, max-age=60", "Cloudflare keeps public thumbnails for a minute")
object privateHeaders = thumbnailCacheHeaders(false)
testing.assert(privateHeaders.cache.toStr().startsWith("private"), "keyed thumbnails are private to the browser")
testing.assert(privateHeaders.cdn.toStr() == "private, no-store", "Cloudflare never stores keyed thumbnails")
