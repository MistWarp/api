number playerContactTermsVersion = 1
number playerContactMaxContact = 200

object playerContactTurboWarpNames = {
  "cloudlink.js": "CloudLink V4",
  "godslayerakp/ws.js": "WebSocket"
}

object playerContactMistiumNames = {
  "WebsocketPlus.js": "WebsocketPlus",
  "OriginChats.js": "OriginChats",
  "Rotur.js": "Rotur",
  "roturVoice.js": "roturVoice",
  "roturVoice Advanced.js": "roturVoice Advanced",
  "Cloudlink4_Improved.js": "Cloudlink4_Improved"
}

object playerContactIdNames = {
  "cloudlink": "CloudLink",
  "gsaWebsocket": "WebSocket",
  "webSocketPlus": "WebsocketPlus",
  "mistiumoriginchats": "OriginChats",
  "roturEXT": "Rotur",
  "roturCall": "roturVoice"
}

array playerContactGalleryUrls = [
  "https://extensions.turbowarp.org/cloudlink.js",
  "https://extensions.turbowarp.org/godslayerakp/ws.js",
  "https://extensions.mistium.com/featured/WebsocketPlus.js",
  "https://extensions.mistium.com/featured/OriginChats.js",
  "https://extensions.mistium.com/featured/Rotur.js",
  "https://extensions.mistium.com/featured/roturVoice.js",
  "https://extensions.mistium.com/files/roturVoice%20Advanced.js",
  "https://extensions.mistium.com/files/Cloudlink4_Improved.js"
]

array playerChatOwnerCategories = ["spam", "harassment", "hate", "scam", "other"]

def playerContactUrlPath(string extensionUrl, string host) string (
  if !url.isValid(extensionUrl) (
    return ""
  )
  object parts = url.parse(extensionUrl)
  if (parts.scheme ?? "").toLower() != "https" or (parts.hostname ?? "").toLower() != host (
    return ""
  )
  string path = (parts.path ?? "")
  while path.contains("/./") (
    path = path.replace("/./", "/")
  )
  while path.contains("//") (
    path = path.replace("//", "/")
  )
  array kept = []
  for segment in path.split("/") (
    string part = segment
    if part == ".." (
      if kept.len > 0 (
        kept.pop()
      )
    ) else if part != "" and part != "." (
      kept.append(part)
    )
  )
  return kept.join("/")
)

def playerContactGalleryName(string extensionUrl) string (
  string turboWarpPath = playerContactUrlPath(extensionUrl, "extensions.turbowarp.org")
  if turboWarpPath != "" and playerContactTurboWarpNames.contains(turboWarpPath) (
    return playerContactTurboWarpNames[turboWarpPath].toStr()
  )
  string mistiumPath = playerContactUrlPath(extensionUrl, "extensions.mistium.com")
  if mistiumPath != "" (
    array parts = mistiumPath.split("/")
    string fileName = parts[parts.len].toStr()
    if playerContactMistiumNames.contains(fileName) (
      return playerContactMistiumNames[fileName].toStr()
    )
  )
  return ""
)

def playerContactIdName(string extensionId) string (
  if extensionId != "" and playerContactIdNames.contains(extensionId) (
    return playerContactIdNames[extensionId].toStr()
  )
  return ""
)

def playerContactFileName(string extensionUrl) string (
  if !url.isValid(extensionUrl) (
    return ""
  )
  array parts = (url.parse(extensionUrl).path ?? "").split("/")
  string fileName = parts[parts.len].toStr()
  if fileName.endsWith(".js") (
    fileName = fileName.trim(1, fileName.len - 3)
  )
  return fileName
)

def playerContactBuiltInHash(string hash) boolean (
  for i playerContactGalleryUrls.len (
    if playerContactGalleryUrls[i].toStr().hashSHA256() == hash (
      return true
    )
  )
  return false
)

def playerContactContactIsLink(string contact) boolean (
  string trimmed = contact.strip()
  return trimmed.toLower().startsWith("https://") and !trimmed.contains(" ")
)

def playerContactContactValid(string contact) boolean (
  string trimmed = contact.strip()
  return trimmed.len >= 3 and trimmed.len <= playerContactMaxContact and !trimmed.contains("\n") and !trimmed.contains("\r")
)

def playerContactDeclared(object declaration) boolean (
  if declaration.len == 0 or (declaration.declared ?? false) != true (
    return false
  )
  return playerContactContactValid((declaration.contact ?? "").toStr()) and (declaration.termsVersion ?? 0).toNum() >= 1
)

def playerContactTermsCurrent(object declaration) boolean (
  return playerContactDeclared(declaration) and (declaration.termsVersion ?? 0).toNum() == playerContactTermsVersion
)

def playerContactMissing(boolean connects, object declaration) boolean (
  return connects and !playerContactDeclared(declaration)
)

def playerContactShareAllowed(boolean connects, object declaration, string target) boolean (
  if target == "private" (
    return true
  )
  return !playerContactMissing(connects, declaration)
)

def playerContactCanWithdraw(boolean connects, string visibility) boolean (
  return !connects or visibility == "private"
)

def playerChatReportNotifiesOwner(string category) boolean (
  return playerChatOwnerCategories.contains(category)
)
