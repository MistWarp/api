def dotenvValue(string name) string (
    if !fs.exists(".env") (
        return ""
    )
    array lines = fs.readFile(".env").split("\n")
    for i lines.len (
        string line = lines[i].toStr().strip()
        if line != "" and !line.startsWith("#") and line.contains("=") (
            array parts = line.split("=")
            string key = parts[1].toStr().strip()
            if key == name (
                string value = parts[2].toStr().strip()
                for p parts.len (
                    if p > 2 (
                        value = value ++ "=" ++ parts[p].toStr()
                    )
                )
                return value.replace("\"", "").replace("'", "")
            )
        )
    )
    return ""
)

def configValue(string name, string defaultValue) string (
    string value = env.getDefault(name, "")
    if value != "" (
        return value
    )
    value = dotenvValue(name)
    if value != "" (
        return value
    )
    return defaultValue
)

