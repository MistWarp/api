import "go:mistwarp.local/gitinspection"
import "go:mistwarp.local/runtimeinfo"
import "go:mistwarp.local/r2inventory"
import "go:mistwarp.local/storagefs"
import "go:mistwarp.local/sharecard"

import "./src/config"
import "./src/core"
import "./src/http"
import "./src/storage"
import "./src/git"
import "./src/rotur"
import "./src/auth"
import "./src/projects"
import "./src/history"
import "./src/games"
import "./src/realtime"
import "./src/community"
import "./src/admin"
import "./src/classroom"

ensureDirectories()
string thumbnailSecret = loadThumbnailSecret(thumbnailSecretFile)
void initCommunityDatabase() catch (err) (
  log "FATAL: could not initialize the community database: " ++ err.toStr()
  process.exit(1)
)
void migratePolicyNewsPosts() catch (err) (
  log "FATAL: could not migrate policy news posts: " ++ err.toStr()
  process.exit(1)
)
void migrateSpaceMemberships() catch (err) (
  log "FATAL: could not migrate space memberships: " ++ err.toStr()
  process.exit(1)
)
void migrateExtensionUsage() catch (err) (
  log "FATAL: could not migrate extension usage: " ++ err.toStr()
  process.exit(1)
)
void refreshIndexUrls() catch (err) (
  log "FATAL: could not refresh index URLs: " ++ err.toStr()
  process.exit(1)
)
void fs.mkdir(localBlobsDir, {recursive: true})
if r2Local (
  log "R2 not configured; storing blobs on local disk at " ++ localBlobsDir
)
if !r2Local and appURL == "http://localhost:5627" (
  log "WARNING: APP_URL points to localhost but R2 is configured; thumbnails and pending project.json are served from APP_URL and will be unreachable. Set APP_URL to the public https API base."
)

array commandArgs = process.args()
if commandArgs.len >= 1 and commandArgs[1].toStr() == "storage-report" (
  if commandArgs.len != 2 (
    log "usage: main storage-report <file>"
    process.exit(1)
  )
  result measured = try(backfillReleaseJsonBytes())
  if measured.isErr() or !measured.unwrap() (
    log "Some release sizes couldn't be measured, so the report counts them from what's on this machine"
  )
  result report = try(storageReport())
  if report.isErr() (
    log "Couldn't work out what MistWarp stores: " ++ report.unwrapErr().toStr()
    process.exit(1)
  )
  string reportPath = commandArgs[2].toStr()
  if !writeFile(reportPath, report.unwrap()) (
    log "Couldn't write the storage report to " ++ reportPath
    process.exit(1)
  )
  log "Wrote what MistWarp stores to " ++ reportPath
  process.exit(0)
)
logLedgerSetup()

def stagedFlushLoop() (
  while true (
    wait 300
    sweepStagedProjects()
    cleanupExpiredStagedUploadParts()
    flushR2UploadQueue()
    void cleanupExpiredCommunityRecords()
    void sweepSiteErrors()
    cleanupExpiredSessions()
  )
)

sweepStagedProjects()
cleanupExpiredStagedUploadParts()
cleanupExpiredSessions()
void cleanupExpiredCommunityRecords()
void sweepSiteErrors()
thread.new(reconcileLoop)
thread.new(processRoturWebhooks)
thread.new(stagedFlushLoop)
void startClassroomTimers()
thread.new(generateMissingProjectHistories)
thread.new(backfillProjectHistoryBytes)
thread.new(backfillReleaseJsonBytes)
thread.new(storageSettleLoop)
thread.new(developmentFeedLoop)
thread.new(vanityLapseLoop)

*serve.Router app = serve.new()
*ws.Server gameRealtimeSocket = ws.New()
*ws.Server siteRealtimeSocket = ws.New()

app.bodyLimit(maxAppRequestBytes)
app.use(realtimeUpgradeGuard)
app.use(serve.corsOpen())
app.use(serve.logger())

registerBlobRoutes(app)

app.use(authMiddleware)
app.use(editorSessionGuard)
app.use(classroomSwitchGuard)
app.use(classroomAccessGuard)
setupGameRealtime()
setupSiteRealtime()

def setupUploadRoutes(*serve.Router uploads) (
  registerProjectUploadRoutes(uploads)
  registerStorageUploadRoutes(uploads)
  registerCommunityUploadRoutes(uploads)
)

def setupApiRoutes(*serve.Router api) (
  api.use(serve.maxBodySize(maxStandardRequestBytes))

  registerAuthRoutes(api)
  registerRoturRoutes(api)
  registerCommunityRoutes(api)
  registerProjectRoutes(api)
  registerGameRoutes(api)
  registerStorageRoutes(api)
  registerClassroomRoutes(api)
  registerGitRoutes(api)
  registerHistoryRoutes(api)
  registerAdminRoutes(api)
)

*serve.Router uploadsV1 = app.group("/v1")
setupUploadRoutes(uploadsV1)
*serve.Router apiV1 = app.group("/v1")
setupApiRoutes(apiV1)

*serve.Router legacyUploads = app.group("/api")
setupUploadRoutes(legacyUploads)
*serve.Router legacyApi = app.group("/api")
setupApiRoutes(legacyApi)

log "MistWarp API listening on " ++ appURL
app.run(":" ++ port) catch (err) (
  log "FATAL: the MistWarp API stopped: " ++ err.toStr()
  process.exit(1)
)
