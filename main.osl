import "go/time"

def dotenvValue(string name) string (
    if !fs.exists(".env") (
        return ""
    )
    array lines = fs.readFile(".env").split("\n")
    for i lines.len (
        string line = lines[i].toStr().strip()
        if line != "" and !line.startsWith("#") and line.contains("=") (
            array parts = line.split("=")
            string key = parts[1].toStr().strip()
            if key == name (
                string value = parts[2].toStr().strip()
                for p parts.len (
                    if p > 2 (
                        value = value ++ "=" ++ parts[p].toStr()
                    )
                )
                return value.replace("\"", "").replace("'", "")
            )
        )
    )
    return ""
)

def configValue(string name, string defaultValue) string (
    string value = env.getDefault(name, "")
    if value != "" (
        return value
    )
    value = dotenvValue(name)
    if value != "" (
        return value
    )
    return defaultValue
)

string projectsDir = "data/projects/"
string indexFile = "data/projects-index.json"
string assetsIndexFile = "data/assets-index.json"
string usersDir = "data/users/"
string sessionsDir = "data/sessions/"
string commentsDir = "data/comments/"
string reportsDir = "data/reports/"
string reportsFile = reportsDir ++ "reports.json"
string newsFile = "data/news.json"
string notificationsDir = "data/notifications/"
string activityDir = "data/activity/"
string userSettingsDir = "data/usersettings/"
string tmpDir = "data/tmp/"
string stagingDir = "data/staging/"
string thumbnailsDir = "data/thumbnails/"

number maxProjectJsonBytes = 20971520
number maxAssetBytes = 10485760
number maxThumbBytes = 1048576
number maxAssetCount = 2000
number uploadDebounceMs = 86400000

string appURL = configValue("APP_URL", "https://mwapi.mistium.com")
string port = configValue("PORT", "5627")
string roturAppKey = configValue("ROTUR_APP_KEY", "mistwarp")
string r2Endpoint = configValue("R2_ENDPOINT", "")
string r2Bucket = configValue("R2_BUCKET", "mistwarp")
string r2AccessKeyId = configValue("R2_ACCESS_KEY_ID", "")
string r2SecretAccessKey = configValue("R2_SECRET_ACCESS_KEY", "")
string r2PublicBase = configValue("R2_PUBLIC_BASE", "")
string giteaURL = configValue("GITEA_URL", "https://git.rotur.dev")
string giteaAdminToken = configValue("GITEA_ADMIN_TOKEN", "")
string editorOrigin = configValue("EDITOR_ORIGIN", "https://warp.mistium.com")
array adminUsers = configValue("ADMIN_USERS", "mist").toLower().split(",")

boolean r2Local = r2Endpoint == "" or r2AccessKeyId == ""
string localBlobsDir = "data/blobs/"

auto r2Client = s3.new({
    "endpoint": r2Endpoint,
    "bucket": r2Bucket,
    "access_key_id": r2AccessKeyId,
    "secret_access_key": r2SecretAccessKey,
    "region": "auto"
})

import "./utils.osl"
import "./storage.osl"
