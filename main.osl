def stagedFlushLoop() (
  while true (
    process.sleep(300)
    sweepStagedProjects()
    cleanupExpiredCommunityRecords()
  )
)

sweepStagedProjects()
cleanupExpiredSessions()
cleanupExpiredCommunityRecords()
thread.new(reconcileLoop)
thread.new(stagedFlushLoop)
thread.new(generateMissingProjectHistories)

