ensureDirectories()
refreshIndexUrls()
fs.mkdirAll(localBlobsDir)
if r2Local (
    log "R2 not configured; storing blobs on local disk at " ++ localBlobsDir
)
if !r2Local and appURL == "http://localhost:5627" (
    log "WARNING: APP_URL points to localhost but R2 is configured; thumbnails and pending project.json are served from APP_URL and will be unreachable. Set APP_URL to the public https API base."
)
sweepStagedProjects()
cleanupExpiredSessions()

*serve.Router app = serve.new()

app.use(corsMiddleware)

app.static("/thumbnails", "./data/thumbnails")
app.GET("/blobs/assets/:name", handleGetAssetBlob)
app.GET("/blobs/projects/:id/project.json", handleGetProjectBlob)
if r2Local (
    app.static("/blobs", "./data/blobs")
)

app.GET("/", handleSiteMetaPage)
app.GET("/explore", handleSiteMetaPage)
app.GET("/news", handleSiteMetaPage)
app.GET("/leaderboard", handleSiteMetaPage)
app.GET("/project/:id", handleProjectMetaPage)
app.GET("/users/:name", handleUserMetaPage)
app.GET("/users/:name/followers", handleUserMetaPage)

app.use(authMiddleware)

*serve.Router uploads = app.group("/api")
uploads.use(serve.maxBodySize(268435456))
uploads.POST("/projects/:id/upload", requireAuth, handleUploadProject)
uploads.POST("/projects/:id/thumbnail", requireAuth, handleSetThumbnail)

*serve.Router api = app.group("/api")
api.use(serve.maxBodySize(262144))

api.GET("/health", handleHealth)
api.GET("/oembed", handleOembed)
api.POST("/auth", handleRoturAuth)
