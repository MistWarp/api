def normalizeRoturTier(string rawTier) string (
  string tier = rawTier.toLower().strip()
  if tier == "lite" (
    return "Lite"
  )
  if tier == "plus" (
    return "Plus"
  )
  if tier == "pro" or tier == "drive" or tier == "max" (
    return "Pro"
  )
  return "Free"
)

def fetchRoturTier(string userId) object (
  object plan = roturApp("GET", "/users/" ++ url.escape(userId) ++ "/plan", {})
  object data = plan.data.assertElse(object, {})
  if plan.ok and data.contains("tier") (
    return {reached: true, tier: normalizeRoturTier(data.tier.toStr())}
  )
  number status = plan.status.toNum()
  if (status == 0 and roturAppReady()) or status >= 500 (
    return {reached: false, tier: "Free"}
  )
  return profileRoturTier(userId)
)
