# Copy to .env and fill in. The server loads this file automatically.
# Real environment variables still override values in .env.

# Server
PORT=5627
HISTORY_MIGRATION_WORKERS=4
APP_URL=https://mwapi.mistium.com
FRONTEND_ORIGIN=http://localhost:5173
EDITOR_ORIGIN=http://localhost:5173

# Rotur login (app key must match the frontend's APP_KEY in src/api.js)
ROTUR_APP_KEY=mistwarp
COMMERCE_SERVICE_KEY=
REALTIME_URL=wss://mwapi.mistium.com/v1/connect
ADMIN_USERS=mist

# Development feed: open and recently merged pull requests from MistWarp's own
# GitHub repositories, shown on /roadmap under "Changes".
#
# GitHub's search quota is 10 requests a minute for an unauthenticated caller,
# counted per IP. The feed spends two every five minutes, and never spends one
# it does not need: a stored snapshot is reused until it ages out, so restarts
# are free, and a refresh is refused outright when the remaining quota would
# not cover it. Set a token only if you want more headroom.
GITHUB_ORG=MistWarp
GITHUB_TOKEN=

# Cloudflare R2 (this is where projects/thumbnails/assets are stored)
# Create a bucket in the Cloudflare dashboard > R2, then an R2 API token
# (Account > R2 > Manage API Tokens) for the access key id + secret.
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_BUCKET=mistwarp
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Public base URL for reads: enable a public r2.dev URL or attach a custom
# domain to the bucket (R2 > your bucket > Settings > Public access).
# This must resolve publicly or thumbnails/players will fail to load.
R2_PUBLIC_BASE=https://<your-bucket-public-domain>

# Optional git remote (only used if a user connects rotur git as their remote)
GITEA_URL=https://git.rotur.dev
GITEA_ADMIN_TOKEN=
