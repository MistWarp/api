import "std:testing"
import "std:fs"
import "std:serve"
import "std:s3"
import "std:requests"
import "std:thread"
import "go:mistwarp.local/storagefs"
import "std:process"
import "std:url"

string testDir = "/tmp/mistwarp-snapshot-test-" ++ timestamp.toStr()
fs.mkdirAll(testDir)
boolean r2Local = false

// Fake R2: serves whatever the current case stages.
number stubStatus = 200
boolean stubGzip = false
string stubBodyPath = testDir ++ "/stub-body.bin"
number fetchCount = 0

def handleStubFetch(*serve.Context c) (
  fetchCount += 1
  if stubGzip (
    c.setHeader("Content-Encoding", "gzip")
  )
  c.data(stubStatus.toInt(), "application/octet-stream", fs.readFileBytes(stubBodyPath))
)

*serve.Router stubApp = serve.new()
stubApp.GET("/test/{key...}", handleStubFetch)

def runStubServer() (
  stubApp.serve(":18331")
)

auto r2Client = s3.new({endpoint: "http://127.0.0.1:18331", bucket: "test", access_key_id: "test", secret_access_key: "test"})

def isSafeBlobKey(string key) boolean (
  return key != "" and !key.contains("..")
)

def localBlobPath(string key) string (
  return testDir ++ "/" ++ key
)

import "./r2-snapshot-serving.osl"

*serve.Router app = serve.new()

def handleTestSnapshot(*serve.Context c) (
  serveProjectJsonStorageKey(c, c.param("key"), c.query("gzip") == "1")
)

app.GET("/snap/:key", handleTestSnapshot)

def runAppServer() (
  app.serve(":18332")
)

def waitForServer(string baseUrl) (
  for i 50 (
    auto probe = requests.get(baseUrl ++ "/not-a-route")
    if probe.success (
      return
    )
    process.sleep(0.1)
  )
)

thread.new(runStubServer)
thread.new(runAppServer)
waitForServer("http://127.0.0.1:18331")
waitForServer("http://127.0.0.1:18332")

def requestSnapshot(string key, boolean gzip, string etag) object (
  string gzipParam = "0"
  if gzip (
    gzipParam = "1"
  )
  auto res = requests.get("http://127.0.0.1:18332/snap/" ++ url.escape(key), {params: {gzip: gzipParam}, headers: {"If-None-Match": etag, "Accept-Encoding": "identity"}})
  return {status: res.status.toInt(), body: res.body.toStr(), encoding: (res.headers["Content-Encoding"] ?? "").toStr(), type: (res.headers["Content-Type"] ?? "").toStr(), etag: (res.headers["Etag"] ?? "").toStr()}
)

string plain = "{\"targets\":[],\"meta\":{\"name\":\"burger 🍔\"}}"
stubStatus = 200
stubGzip = false
fs.writeFile(stubBodyPath, plain)
object response = requestSnapshot("plain.json", false, "")
testing.assert(response.status == 200 and response.body == plain, "remote JSON is returned verbatim without base64 decoding")
testing.assert(response.type == "application/json" and response.encoding == "", "plain JSON has the correct headers")

array gzipBytes = [31, 139, 8, 0, 0, 0, 0, 0, 2, 255, 171, 86, 42, 73, 44, 74, 79, 45, 41, 86, 178, 138, 142, 173, 5, 0, 138, 235, 35, 179, 14, 0, 0, 0]
string gzipPath = testDir ++ "/compressed.json.gz"
fs.writeFileBytes(gzipPath, gzipBytes)
string compressed = fs.readFile(gzipPath)
stubGzip = true
fs.writeFile(stubBodyPath, compressed)
response = requestSnapshot("compressed.json.gz", true, "")
testing.assert(response.status == 200 and response.body == compressed, "remote binary gzip bytes are preserved exactly")
testing.assert(response.encoding == "gzip", "remote compressed snapshots retain Content-Encoding")

number before = fetchCount
response = requestSnapshot("compressed.json.gz", true, "\"compressed.json.gz\"")
testing.assert(response.status == 304 and fetchCount == before, "matching ETags skip storage fetches")

stubStatus = 404
stubGzip = false
response = requestSnapshot("missing.json", false, "")
testing.assert(response.status == 404, "missing remote snapshots return 404")

fs.writeFile(localBlobPath("local.json"), plain)
before = fetchCount
response = requestSnapshot("local.json", false, "")
testing.assert(response.status == 200 and response.body == plain and fetchCount == before, "local snapshots bypass R2")
r2Local = true
response = requestSnapshot("missing.json", false, "")
testing.assert(response.status == 404 and fetchCount == before, "local-only missing snapshots return 404 without R2")
response = requestSnapshot("../unsafe.json", false, "")
testing.assert(response.status == 404 and fetchCount == before, "unsafe keys cannot reach storage")
fs.remove(testDir)
