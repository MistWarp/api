def loadNotifications(string username) array (
    string key = normalizeUsername(username)
    if !isSafePathPart(key) (
        return []
    )
    auto result = readFile(notificationsDir ++ key ++ ".json")
    if !result.ok (
        return []
    )
    object data = result.data.assert(object)
    return data.items.assert(array)
)


def saveNotifications(string username, array items) boolean (
    string key = normalizeUsername(username)
    if !isSafePathPart(key) (
        return false
    )
    return writeFile(notificationsDir ++ key ++ ".json", {items: items})
)


def sanitizeNotificationPayload(object payload, string notifType, string actor) object (
    object data = {}
    if payload == null or typeof(payload) != "object" (
        return data
    )
    array keys = payload.getKeys().toArray()
    for i keys.len (
        string key = keys[i].toStr()
        data[key] = payload[key]
    )
    if !data.contains("type") (
        data.type = notifType
    )
    if !data.contains("actor") and actor != "" (
        data.actor = actor
    )
    return data
)


def notificationBody(string actor, string notifType, object extra) string (
    string projectTitle = ""
    if extra.contains("projectTitle") (
        projectTitle = extra.projectTitle.toStr()
    )
    string projectLink = ""
    if extra.contains("projectId") and extra.projectId != null (
        projectLink = editorOrigin ++ "/project/" ++ extra.projectId.toStr()
    )
    if notifType == "love" (
        if projectTitle != "" (
            return actor ++ " loved " ++ projectTitle ++ ": " ++ projectLink
        )
        if projectLink != "" (
            return actor ++ " loved your project: " ++ projectLink
        )
        return actor ++ " loved your project"
    )
    if notifType == "comment" (
        if projectTitle != "" (
            return actor ++ " commented on " ++ projectTitle ++ ": " ++ projectLink
        )
        if projectLink != "" (
            return actor ++ " commented on your project: " ++ projectLink
        )
        return actor ++ " commented on your project"
    )
    if notifType == "profile_comment" (
        return actor ++ " commented on your profile"
    )
    if notifType == "roadmap_comment" (
        string roadmapTitle = "your roadmap suggestion"
        if extra.contains("roadmapTitle") (
            roadmapTitle = extra.roadmapTitle.toStr()
        )
        string roadmapLink = editorOrigin ++ "/roadmap"
        if extra.contains("roadmapId") (
            roadmapLink = roadmapLink ++ "#idea-" ++ extra.roadmapId.toStr()
        )
        return actor ++ " commented on " ++ roadmapTitle ++ ": " ++ roadmapLink
    )
    if notifType == "reply" (
        if projectLink != "" (
            return actor ++ " replied to your comment: " ++ projectLink
        )
        return actor ++ " replied to your comment"
    )
    if notifType == "mention" (
        if projectTitle != "" (
            return actor ++ " mentioned you on " ++ projectTitle ++ ": " ++ projectLink
        )
        if projectLink != "" (
            return actor ++ " mentioned you in a comment: " ++ projectLink
        )
        return actor ++ " mentioned you in a comment"
    )
    if notifType == "follow" (
        return actor ++ " followed you"
    )
    if notifType == "remix" (
        if projectTitle != "" (
            return actor ++ " remixed " ++ projectTitle ++ ": " ++ projectLink
        )
        if projectLink != "" (
            return actor ++ " remixed your project: " ++ projectLink
        )
        return actor ++ " remixed your project"
    )
    if notifType == "purchase" (
        if projectTitle != "" (
            return actor ++ " bought " ++ projectTitle ++ ": " ++ projectLink
        )
        if projectLink != "" (
            return actor ++ " bought your project: " ++ projectLink
        )
        return actor ++ " bought your project"
    )
    if notifType == "donation" (
        return actor ++ " donated credits to you"
    )
    if notifType == "standing" (
        string level = "changed"
        if extra.contains("level") (
            level = extra.level.toStr()
        )
        string reason = ""
        if extra.contains("reason") (
            reason = extra.reason.toStr()
        )
        if reason != "" (
            return "Your account standing is now " ++ level ++ ": " ++ reason
        )
        return "Your account standing is now " ++ level
    )
    if notifType == "moderation" (
        if extra.contains("message") (
            return extra.message.toStr()
        )
        return "A moderator sent you a message"
    )
    if notifType == "news" (
        if extra.contains("title") (
            return extra.title.toStr()
        )
        return "New announcement"
    )
    if notifType == "report_update" (
        return "Your report was reviewed"
    )
    if notifType == "space_project" (
        return actor ++ " added a project to " ++ extra.spaceTitle.toStr()
    )
    if notifType == "space_comment" (
        return actor ++ " commented on " ++ extra.spaceTitle.toStr()
    )
    if notifType == "space_curator_invite" (
        return actor ++ " invited you to curate " ++ extra.spaceTitle.toStr()
    )
    if notifType == "space_curator_accepted" (
        return actor ++ " accepted your invitation to curate " ++ extra.spaceTitle.toStr()
    )
    if notifType == "space_curator_declined" (
        return actor ++ " declined your invitation to curate " ++ extra.spaceTitle.toStr()
    )
    if notifType == "space_curator_removed" (
        return actor ++ " removed you as a curator of " ++ extra.spaceTitle.toStr()
    )
    if notifType == "contribution" (
        return actor ++ " sent changes for " ++ projectTitle ++ ": " ++ projectLink
    )
    if notifType == "project_feedback" (
        return actor ++ " sent " ++ extra.feedbackType.toStr() ++ " feedback for " ++ projectTitle ++ ": " ++ projectLink
    )
    if notifType == "project_review" (
        return actor ++ " rated " ++ projectTitle ++ " " ++ extra.rating.toStr() ++ " out of 5: " ++ projectLink
    )
    return actor ++ " sent you a notification"
)


def notifyRequestBody(string target, string actor, string notifType, object extra) object (
    object data = {}
    if extra != null and typeof(extra) == "object" (
        array keys = extra.getKeys().toArray()
        for i keys.len (
            string key = keys[i].toStr()
            data[key] = extra[key]
        )
    )
    data.from = actor
    return {
        source: "mistwarp",
        title: actor,
        body: notificationBody(actor, notifType, extra),
        data: data,
        users: [target]
    }
)


def notifyHeaders() object (
    return {
        "Authorization": "Bearer " ++ mistwarpRoturToken,
        "Content-Type": "application/json"
    }
)


def postRoturNotification(string target, string actor, string notifType, object extra) boolean (
    if mistwarpRoturToken == "" (
        return false
    )
    object payload = sanitizeNotificationPayload(extra, notifType, actor)
    object resp = requests.post(roturBase ++ "/v2/notifications", {
        headers: notifyHeaders(),
        body: json.stringify({target: target, actor: actor, type: notifType, data: payload, platform: "mistwarp", platform_data: payload})
    })
    return resp.success and resp.status.toInt() == 200
)


def addNotification(string target, string actor, string notifType, object extra) (
    object payload = sanitizeNotificationPayload(extra, notifType, actor)
    string targetKey = normalizeUsername(target)
    if targetKey == "" or targetKey == normalizeUsername(actor) (
        return
    )

    object item = {
        id: "n" ++ randomString(12),
        type: notifType,
        actor: actor,
        created: timestamp,
        platform: "mistwarp",
        platform_data: payload,
        read: false
    }

    if postRoturNotification(targetKey, actor, notifType, payload) (
        return
    )

    array items = loadNotifications(targetKey)
    array next = [item]
    number kept = 1
    for i items.len (
        object existing = items[i]
        boolean same = existing.type.toStr() == notifType and normalizeUsername(existing.actor.toStr()) == normalizeUsername(actor)
        object existingPd = {}
        if typeof(existing.platform_data) == "object" (
            existingPd = existing.platform_data
        )
        array payloadKeys = payload.getKeys().toArray()
        for j payloadKeys.len (
            string k = payloadKeys[j].toStr()
            if !existingPd.contains(k) or existingPd[k] != payload[k] (
                same = false
            )
        )
        if same (
            continue
        )
        if kept < 50 (
            next.append(existing)
            kept = kept + 1
        )
    )
    saveNotifications(targetKey, next)
)


def handleGetNotifications(*serve.Context c) (
    string username = c.getString("username")
    array local = loadNotifications(username)
    c.json(200, {ok: true, notifications: local})
)


def handleReadNotifications(*serve.Context c) (
    string username = c.getString("username")
    array items = loadNotifications(username)
    for i items.len (
        object item = items[i]
        item.read = true
    )
    saveNotifications(username, items)
    c.json(200, {ok: true})
)
