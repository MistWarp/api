def loadNotifications(string username) array (
    string key = normalizeUsername(username)
    if !isSafePathPart(key) (
        return []
    )
    auto result = readFile(notificationsDir ++ key ++ ".json")
    if !result.ok (
        return []
    )
    object data = result.data.assert(object)
    return data.items.assert(array)
)


def saveNotifications(string username, array items) boolean (
    string key = normalizeUsername(username)
    if !isSafePathPart(key) (
        return false
    )
    return writeFile(notificationsDir ++ key ++ ".json", {items: items})
)


def normalizeNotification(object item) object (
    object out = {}
    array keys = item.getKeys().toArray()
    for i keys.len (
        string key = keys[i].toStr()
        out[key] = item[key]
    )
    if !out.contains("created") and out.contains("timestamp") and out.timestamp != null (
        out.created = out.timestamp
    )
    if !out.contains("timestamp") and out.contains("created") and out.created != null (
        out.timestamp = out.created
    )
    if !out.contains("read") (
        out.read = false
    )
    if !out.contains("actor") and out.contains("from") (
        out.actor = out.from
    )
    if !out.contains("platform") (
        out.platform = "mistwarp"
    )
    if !out.contains("platform_data") (
        out.platform_data = {}
    )
    if out.created == null (
        out.created = 0
    )
    if out.timestamp == null (
        out.timestamp = 0
    )
    if out.read != true (
        out.read = false
    )
    return out
)


def sanitizeNotificationPayload(object payload, string notifType, string actor) object (
    object data = {}
    if payload == null or payload.toType() != "object" (
        return data
    )
    array keys = payload.getKeys().toArray()
    for i keys.len (
        string key = keys[i].toStr()
        data[key] = payload[key]
    )
    if !data.contains("type") (
        data.type = notifType
    )
    if !data.contains("actor") and actor != "" (
        data.actor = actor
    )
    return data
)


def mergeNotificationArrays(array primary, array secondary) array (
    array merged = []
    object seen = {}
    for i primary.len (
        object item = primary[i].assert(object)
        string id = item.contains("id") and item.id != null ? item.id.toStr() ""
        if id != "" and seen[id] == true (
            continue
        )
        seen[id] = true
        merged.append(normalizeNotification(item))
    )
    for i secondary.len (
        object item = secondary[i].assert(object)
        string id = item.contains("id") and item.id != null ? item.id.toStr() ""
        if id != "" and seen[id] == true (
            continue
        )
        seen[id] = true
        merged.append(normalizeNotification(item))
    )
    return merged
)


def notifyRequestBody(string target, string actor, string notifType, object extra) object (
    return {
        target: target,
        actor: actor,
        type: notifType,
        platform: "mistwarp",
        data: extra,
        platform_data: extra
    }
)


def notifyHeaders() object (
    return {
        "Authorization": "Bearer " ++ mistwarpRoturToken,
        "Content-Type": "application/json"
    }
)


def postRoturNotification(string target, string actor, string notifType, object extra) boolean (
    if mistwarpRoturToken == "" (
        return false
    )
    object resp = requests.post(roturBase ++ "/v2/notifications", {
        headers: notifyHeaders(),
        body: json.stringify(notifyRequestBody(target, actor, notifType, extra))
    })
    return resp.success and resp.status.toInt() == 200
)


def markRoturNotificationsRead() boolean (
    if mistwarpRoturToken == "" (
        return false
    )
    object resp = requests.post(roturBase ++ "/v2/notifications/read", {
        headers: notifyHeaders(),
        body: "{}"
    })
    return resp.success and resp.status.toInt() == 200
)


def fetchRoturNotifications() object (
    if mistwarpRoturToken == "" (
        return {
            ok: false,
            notifications: []
        }
    )

    object resp = requests.get(roturBase ++ "/v2/notifications", {headers: notifyHeaders()})
    if !resp.success or resp.status.toInt() != 200 (
        return {ok: false, notifications: []}
    )

    auto parsed = json.parse(resp.body, {type: "array"})
    if parsed.isErr() (
        return {ok: false, notifications: []}
    )

    array remote = []
    array list = parsed.unwrap().assert(array)
    for i list.len (
        auto item = list[i]
        if typeof(item) != "object" (
            continue
        )
        remote.append(normalizeNotification(item.assert(object)))
    )
    return {ok: true, notifications: remote}
)


def addNotification(string target, string actor, string notifType, object extra) (
    object payload = sanitizeNotificationPayload(extra, notifType, actor)
    string targetKey = normalizeUsername(target)
    if targetKey == "" or targetKey == normalizeUsername(actor) (
        return
    )

    object item = {
        id: "n" ++ randomString(12),
        type: notifType,
        actor: actor,
        created: timestamp,
        platform: "mistwarp",
        platform_data: payload,
        read: false
    }
    array payloadKeys = payload.getKeys().toArray()
    for i payloadKeys.len (
        string k = payloadKeys[i].toStr()
        item[k] = payload[k]
    )

    if postRoturNotification(targetKey, actor, notifType, payload) (
        return
    )

    array items = loadNotifications(targetKey)
    array next = [item]
    number kept = 1
    for i items.len (
        object existing = items[i]
        boolean same = existing.type.toStr() == notifType and normalizeUsername(existing.actor.toStr()) == normalizeUsername(actor)
        for j payloadKeys.len (
            string k = payloadKeys[j].toStr()
            if !existing.contains(k) or existing[k] != payload[k] (
                same = false
            )
        )
        if same (
            continue
        )
        if kept < 50 (
            next.append(existing)
            kept = kept + 1
        )
    )
    saveNotifications(targetKey, next)
)


def handleGetNotifications(*serve.Context c) (
    string username = c.getString("username")
    object remote = fetchRoturNotifications()
    array remoteList = remote.notifications.assert(array)
    array local = loadNotifications(username)
    c.json(200, {ok: true, notifications: mergeNotificationArrays(remoteList, local)})
)


def handleReadNotifications(*serve.Context c) (
    string username = c.getString("username")
    markRoturNotificationsRead()

    array items = loadNotifications(username)
    for i items.len (
        object item = items[i]
        item.read = true
    )
    saveNotifications(username, items)
    c.json(200, {ok: true})
)
