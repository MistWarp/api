def profileLayoutCatalog() array (
    return [
        {id: "classic", name: "Classic", description: "MistWarp's balanced profile layout.", price: 0},
        {id: "showcase", name: "Showcase", description: "A wide featured project with a cinematic project grid.", price: 30},
        {id: "portfolio", name: "Portfolio", description: "A creator-first layout with denser project shelves.", price: 60},
        {id: "compact", name: "Compact", description: "A clean, information-dense profile for prolific creators.", price: 20}
    ]
)

def profileLayoutById(string id) object (
    array layouts = profileLayoutCatalog()
    for i layouts.len (
        object layout = layouts[i].assert(object)
        if layout.id.toStr() == id (
            return {ok: true, layout: layout}
        )
    )
    return {ok: false}
)

def unlockedProfileLayouts(object profile) array (
    array unlocked = ["classic"]
    if profile.contains("unlockedLayouts") and profile.unlockedLayouts != null (
        array stored = profile.unlockedLayouts.assertElse(array, [])
        for i stored.len (
            string id = stored[i].toStr()
            if !unlocked.contains(id) and profileLayoutById(id).ok (
                unlocked.append(id)
            )
        )
    )
    return unlocked
)

def verifyProfileLayoutPayment(string paymentId, string buyer, string layoutId, number amount) boolean (
    if commerceServiceKey == "" or paymentId == "" (
        return false
    )
    object response = requests.get(roturBase ++ "/v2/commerce/payments/" ++ url.escape(paymentId) ++ "/verify?source=mistwarp", {headers: {"X-Commerce-Key": commerceServiceKey}})
    if !response.success or response.status.toInt() != 200 (
        return false
    )
    auto parsed = json.parse(response.body, {type: "object"})
    if parsed.isErr() (
        return false
    )
    object payment = parsed.unwrap().assert(object).payment.assert(object)
    if payment.status.toStr() != "completed" or payment.source.toStr() != "mistwarp" or payment.kind.toStr() != "profile_layout" or payment.resource_type.toStr() != "profile_layout" or payment.resource_id.toStr() != layoutId or normalizeUsername(payment.payer.toStr()) != normalizeUsername(buyer) or payment.amount.toNum() + 0.001 < amount (
        return false
    )
    string recipient = normalizeUsername(mistwarpAccountUser())
    array recipients = payment.recipients.assertElse(array, [])
    for i recipients.len (
        object paidRecipient = recipients[i].assert(object)
        if normalizeUsername(paidRecipient.username.toStr()) == recipient and paidRecipient.basis_points.toNum().toInt() == 10000 (
            return true
        )
    )
    return false
)

def handleListProfileLayouts(*serve.Context c) (
    array unlocked = ["classic"]
    string active = "classic"
    if c.getBool("authenticated") (
        object profile = loadProfile(c.getString("username"))
        unlocked = unlockedProfileLayouts(profile)
        if profile.contains("profileLayout") and unlocked.contains(profile.profileLayout.toStr()) (
            active = profile.profileLayout.toStr()
        )
    )
    c.json(200, {ok: true, layouts: profileLayoutCatalog(), unlocked: unlocked, active: active})
)

def handleProfileLayoutIntent(*serve.Context c) (
    object found = profileLayoutById(c.param("id"))
    if !found.ok (
        c.notFound("profile layout not found")
        return
    )
    object layout = found.layout.assert(object)
    object profile = loadProfile(c.getString("username"))
    if unlockedProfileLayouts(profile).contains(layout.id.toStr()) (
        c.json(200, {ok: true, already: true})
        return
    )
    string recipient = mistwarpAccountUser()
    if recipient == "" (
        c.internalError("profile layout purchases are unavailable")
        return
    )
    c.json(200, {ok: true, already: false, amount: layout.price, to: recipient, layout: layout})
)

def handleConfirmProfileLayout(*serve.Context c) (
    object found = profileLayoutById(c.param("id"))
    if !found.ok (
        c.notFound("profile layout not found")
        return
    )
    object layout = found.layout.assert(object)
    object profile = loadProfile(c.getString("username"))
    array unlocked = unlockedProfileLayouts(profile)
    if unlocked.contains(layout.id.toStr()) (
        c.json(200, {ok: true, unlocked: unlocked})
        return
    )
    string paymentId = c.bodyJSON().paymentId.toStr().strip()
    if !verifyProfileLayoutPayment(paymentId, c.getString("username"), layout.id.toStr(), layout.price.toNum()) (
        c.json(402, {ok: false, error: "could not verify the profile layout purchase"})
        return
    )
    unlocked.append(layout.id)
    profile.unlockedLayouts = unlocked
    profile.profileLayout = layout.id
    saveProfile(profile)
    c.json(200, {ok: true, unlocked: unlocked, active: layout.id})
)
