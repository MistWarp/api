def perkPlan(string tier) object (
    return {
        tier: tier,
        mistwarp: mistwarpBenefitsForTier(tier),
        rotur: roturBenefitsForTier(tier)
    }
)

def currentPerks(*serve.Context c) object (
    string tier = "Free"
    if c.getBool("authenticated") (
        tier = roturTierForUser(c.getString("userId"))
    )
    return {tier: tier, mistwarp: mistwarpBenefitsForTier(tier), rotur: roturBenefitsForTier(tier)}
)

def trimDayHistory(object history, number days) object (
    if days <= 0 (
        return history
    )
    object kept = {}
    number today = (timestamp / 86400000).toInt()
    array keys = history.getKeys().toArray()
    for i keys.len (
        string key = keys[i].toStr()
        if today - key.toNum() < days (
            kept[key] = history[key]
        )
    )
    return kept
)

def trimTimedEntries(array entries, number days) array (
    if days <= 0 (
        return entries
    )
    array kept = []
    number cutoff = timestamp - (days * 86400000)
    for i entries.len (
        object entry = entries[i].assert(object)
        if entry.contains("at") and entry.at.toNum() >= cutoff (
            kept.append(entry)
        )
    )
    return kept
)

def handleGetPerks(*serve.Context c) (
    object current = currentPerks(c)
    c.json(200, {
        ok: true,
        current: current,
        plans: [perkPlan("Free"), perkPlan("Lite"), perkPlan("Plus"), perkPlan("Pro")],
        roturMembershipUrl: "https://rotur.dev/premium"
    })
)
