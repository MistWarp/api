def normalizeRoturTier(string rawTier) string (
    string tier = rawTier.toLower().strip()
    if tier == "lite" (
        return "Lite"
    )
    if tier == "plus" (
        return "Plus"
    )
    if tier == "pro" or tier == "drive" or tier == "max" (
        return "Pro"
    )
    return "Free"
)

def roturTierForUser(string userId) string (
    if userId == "" (
        return "Free"
    )
    if paidPerksCache.has(userId) (
        object cached = paidPerksCache.get(userId).assertElse(object, {})
        if cached.contains("expires") and cached.expires.toNum() > timestamp (
            return cached.tier.toStr()
        )
    )
    object response = requests.get(roturBase ++ "/profile?id=" ++ url.escape(userId) ++ "&include_posts=0")
    if !response.success or response.status.toInt() != 200 (
        return "Free"
    )
    auto parsed = json.parse(response.body, {type: "object"})
    if parsed.isErr() (
        return "Free"
    )
    object profile = parsed.unwrap().assert(object)
    string tier = "Free"
    if profile.contains("subscription") and profile.subscription != null (
        tier = normalizeRoturTier(profile.subscription.toStr())
    )
    paidPerksCache.set(userId, {tier: tier, expires: timestamp + 300000})
    return tier
)

def mistwarpBenefitsForTier(string rawTier) object (
    string tier = normalizeRoturTier(rawTier)
    object benefits = {
        weeklyUploadBytes: 104857600,
        maxProjectAssetBytes: 10485760,
        maxProjectAssetsBytes: 52428800,
        recoveryDays: 7,
        analyticsDays: 7,
        collaborationLimit: 3,
        salesFeeBasisPoints: 1000,
        maxProjectPrice: 100,
        themeListingLimit: 5
    }
    if tier == "Lite" (
        benefits.weeklyUploadBytes = 262144000
        benefits.maxProjectAssetBytes = 26214400
        benefits.maxProjectAssetsBytes = 104857600
        benefits.recoveryDays = 14
        benefits.analyticsDays = 30
        benefits.collaborationLimit = 5
        benefits.themeListingLimit = 10
    ) else if tier == "Plus" (
        benefits.weeklyUploadBytes = 1073741824
        benefits.maxProjectAssetBytes = 52428800
        benefits.maxProjectAssetsBytes = 262144000
        benefits.recoveryDays = 30
        benefits.analyticsDays = 365
        benefits.collaborationLimit = 10
        benefits.salesFeeBasisPoints = 700
        benefits.maxProjectPrice = 250
        benefits.themeListingLimit = 25
    ) else if tier == "Pro" (
        benefits.weeklyUploadBytes = 5368709120
        benefits.maxProjectAssetBytes = 104857600
        benefits.maxProjectAssetsBytes = 1073741824
        benefits.recoveryDays = 90
        benefits.analyticsDays = 0
        benefits.collaborationLimit = 25
        benefits.salesFeeBasisPoints = 500
        benefits.maxProjectPrice = 500
        benefits.themeListingLimit = 100
    )
    return benefits
)

def mistwarpBenefitsForUserId(string userId) object (
    return mistwarpBenefitsForTier(roturTierForUser(userId))
)

def mistwarpBenefitsForUsername(string username) object (
    return mistwarpBenefitsForUserId(userIdForUsername(username))
)

def mistwarpBenefitsForProject(object project) object (
    string ownerId = ""
    if project.contains("ownerId") and project.ownerId != null (
        ownerId = project.ownerId.toStr()
    )
    if ownerId == "" (
        ownerId = userIdForUsername(project.owner.toStr())
    )
    return mistwarpBenefitsForUserId(ownerId)
)

