import "./live-collaboration-policy.osl"

// Temporary approvals are leases; explicitly shared Editor access persists.
auto liveEditorSessions = cache.create(10000, 90)
auto projectEditorPresence = cache.create(10000, 90)

def handleGetSharedProjects(*serve.Context c) (
  string username = normalizeUsername(c.getString("username"))
  array projects = []
  array entries = projectSearchDocs.all()
  for i entries.len (
    object entry = entries[i].assert(object)
    array contributors = entry.contributors.assertElse(array, [])
    boolean candidate = false
    for j contributors.len (
      if normalizeUsername(contributors[j].toStr()) == username (
        candidate = true
      )
    )
    if candidate (
      auto result = loadProject(entry.id.toStr())
      if result.ok (
        object project = result.project.assert(object)
        string role = projectRole(project, username)
        if role != "" and role != "owner" and canViewProject(project, c) (
          projects.append(projectResponse(project, c))
        )
      )
    )
  )
  projects.sortBy("edited", "descending")
  c.json(200, {ok: true, projects: projects})
)

def liveSession(object project, string branch) object (
  object session = liveEditorSessions.get(liveSessionKey(project, branch)).assertElse(object, {})
  if session.getKeys().len == 0 or session.expires.toNum() <= timestamp (
    return {}
  )
  string role = projectRole(project, session.host.toStr())
  if !isSharedEditorRole(role) (
    return {}
  )
  return session
)

def canSaveLiveProject(object project,*serve.Context c) boolean (
  if canEditProject(project, c) return true
  if !c.getBool("authenticated") return false
  string username = normalizeUsername(c.getString("username"))
  string role = projectRole(project, username)
  if role == "editor" return true
  if role == "" or role == "tester" return false
  string branch = c.formValue("collaborationBranch")
  if branch == "" (
    branch = project.gitBranch.assertElse(string, "main")
  )
  object session = liveSession(project, branch)
  if session.getKeys().len == 0 return false
  object members = session.members.assertElse(object, {})
  if !members.contains(username) return false
  object member = members[username].assert(object)
  return liveMemberCanSave(member, timestamp)
)

def handleLiveCollaboration(*serve.Context c) (
  auto result = loadProject(c.param("id"))
  if !result.ok (
    c.notFound("project not found")
    return
  )
  object project = result.project.assert(object)
  string username = normalizeUsername(c.getString("username"))
  string role = projectRole(project, username)
  if role == "" (
    c.forbidden("only project team members can discover editing sessions")
    return
  )
  object body = c.bodyJSON()
  string branch = body.branch.assertElse(string, project.gitBranch.assertElse(string, "main")).strip()
  if branch == "" or branch.len > 200 (
    c.badRequest("a project branch is required")
    return
  )
  string sessionKey = liveSessionKey(project, branch)
  string action = body.action.assertElse(string, "list")
  string lockName = "live-editor:" ++ project.id.toStr()
  sync.lock(lockName)
  // Release the lease lock even if malformed state raises a runtime error.
  raw("defer sync.unlock(lockName)")
  object session = liveSession(project, branch)
  object editors = projectEditorPresence.get(project.id.toStr()).assertElse(object, {})
  for key in editors.getKeys() (
    if editors[key].expires.toNum() <= timestamp or projectRole(project, editors[key].username.toStr()) == "" (
      editors.delete(key)
    )
  )
  string presenceKey = username ++ ":" ++ branch
  if action == "presence" or action == "host" or action == "heartbeat" (
    editors[presenceKey] = {username: username, branch: branch, expires: timestamp + 90000}
  )
  if action == "away" (
    editors.delete(presenceKey)
  )
  projectEditorPresence.set(project.id.toStr(), editors)
  string errorMessage = ""
  if session.getKeys().len != 0 (
    object activeMembers = session.members.assert(object)
    for key in activeMembers.getKeys() (
      string memberRole = projectRole(project, key)
      if activeMembers[key].expires.toNum() <= timestamp or memberRole == "" or memberRole == "tester" (
        activeMembers.delete(key)
      )
    )
    session.members = activeMembers
  )
  if action == "host" (
    string room = body.roomId.assertElse(string, "").strip()
    if !isSharedEditorRole(role) or room == "" or room.len > 128 (
      errorMessage = "only a project editor can host a project session"
    ) else (
      if session.getKeys().len == 0 and body.sessionId.assertElse(string, "") != "" (
        errorMessage = "this editing session expired; start a new session"
      ) else if session.getKeys().len != 0 and (session.id.toStr() != body.sessionId.assertElse(string, "") or session.host.toStr() != username) (
        errorMessage = "an editing session is already active"
      ) else (
        if session.getKeys().len == 0 (
          session = {id: randomString(32), host: username, roomId: room, branch: branch, members: {}, public: body.public.assertElse(boolean, false)}
        )
        session.expires = timestamp + 90000
        session.title = project.title
        liveEditorSessions.set(sessionKey, session)
      )
    )
  )
  if action == "end" and session.getKeys().len != 0 (
    if session.host.toStr() != username or session.id.toStr() != body.sessionId.assertElse(string, "") (
      errorMessage = "only the session host can end this session"
    ) else (
      liveEditorSessions.delete(sessionKey)
      session = {}
    )
  )
  if action == "request" or action == "heartbeat" or action == "approve" or action == "deny" or action == "leave" (
    if session.getKeys().len == 0 or session.id.toStr() != body.sessionId.assertElse(string, "") (
      errorMessage = "this editing session has ended"
    ) else (
      object members = session.members.assert(object)
      for key in members.getKeys() (
        if members[key].expires.toNum() <= timestamp (
          members.delete(key)
        )
      )
      if action == "request" (
        string peerId = body.peerId.assertElse(string, "")
        if !canJoinLiveSession(session, role) (
          errorMessage = "this session is not open to your account"
        ) else if peerId == "" or peerId.len > 200 or role == "tester" (
          errorMessage = "a contributor account and connected room are required"
        ) else (
          if !members.contains(username) or members[username].peerId.toStr() != peerId (
            boolean approved = role != "" and role != "tester"
            members[username] = {username: username, peerId: peerId, approved: approved, expires: timestamp + 90000}
          )
        )
      )
      if action == "heartbeat" and members.contains(username) (
        members[username].expires = timestamp + 90000
      )
      if action == "leave" (
        members.delete(username)
      )
      if action == "approve" or action == "deny" (
        string memberName = normalizeUsername(body.username.assertElse(string, ""))
        if session.host.toStr() != username or !members.contains(memberName) (
          errorMessage = "only the host can answer a pending request"
        ) else (
          if action == "approve" (
            members[memberName].approved = true
          ) else (
            members.delete(memberName)
          )
        )
      )
      session.members = members
      liveEditorSessions.set(sessionKey, session)
    )
  )
  object response = {}
  if session.getKeys().len != 0 (
    array responseMembers = []
    for key in session.members.assert(object).getKeys() (
      object member = session.members[key].assert(object)
      if member.expires.toNum() > timestamp and (session.host.toStr() == username or key == username) (
        responseMembers.append(member)
      )
    )
    response = {public: session.public.assertElse(boolean, false), id: session.id, host: session.host, title: session.title, roomId: session.roomId, branch: branch, members: responseMembers}
  )
  if errorMessage != "" (
    c.json(409, {ok: false, error: errorMessage})
    return
  )
  array presence = []
  for key in editors.getKeys() (
    object editor = editors[key].assert(object)
    if body.allBranches.assertElse(boolean, false) or editor.branch.toStr() == branch (
      presence.append({username: editor.username, branch: editor.branch})
    )
  )
  c.json(200, {ok: true, editors: presence, session: response, myRole: role, hasTeam: project.collaborators.assertElse(array, []).len > 0})
)
