def serveProjectJsonStorageKey(*serve.Context c, string key, boolean gzip) (
  if !isSafeBlobKey(key) (
    c.notFound("project snapshot not found")
    return
  )
  string etag = "\"" ++ key ++ "\""
  c.setHeader("ETag", etag)
  c.setHeader("Cache-Control", "no-cache")
  if (c.header("If-None-Match") ?? "").contains(etag) (
    c.status(304)
    return
  )
  string localPath = localBlobPath(key)
  if fs.exists(localPath) (
    c.setHeader("Content-Type", "application/json")
    if gzip (
      c.setHeader("Content-Encoding", "gzip")
    )
    c.file(localPath)
    return
  )
  if r2Local (
    c.notFound("project snapshot not found")
    return
  )
  string signedUrl = r2Client.presignURL(key, {expires: 60000})
  // An explicit encoding prevents the HTTP client from decompressing R2's body.
  auto fetched = requests.get(signedUrl, {headers: {"Accept-Encoding": "identity"}}).unwrapOr({body: null, error: "request failed", headers: {}, raw: null, status: 0, success: false})
  if fetched.status != 200 (
    c.notFound("project snapshot not found")
    return
  )
  if gzip (
    c.setHeader("Content-Encoding", "gzip")
  )
  // HTTP responses contain a raw binary string; asserting byte[] would decode it as base64.
  string snapshotBody = fetched.body
  c.send(200, "application/json", storagefs.Bytes(snapshotBody))
)
